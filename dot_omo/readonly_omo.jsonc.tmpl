{{- /* The agent/category model mappings are data-driven: edit
       .chezmoidata/agents.yaml (.agents.opencode.ohMyOpenagent), not this file.
       toPrettyJson emits them tab-indented with keys sorted alphabetically;
       the replace shifts the block two tabs to sit inside the "[opencode]"
       object. All plugin settings nest under "[opencode]" because this repo
       configures only the OpenCode harness. */ -}}
{
	"$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
	"[opencode]": {
		"agents": {{ toPrettyJson "\t" .agents.opencode.ohMyOpenagent.agents | trim | replace "\n" "\n\t\t" }},
		"categories": {{ toPrettyJson "\t" .agents.opencode.ohMyOpenagent.categories | trim | replace "\n" "\n\t\t" }},
		"claude_code": {
			"mcp": false,
			"commands": false,
			"skills": false,
			"agents": false,
			"hooks": false,
			"plugins": false
		},
		"disabled_mcps": ["playwright", "lsp"],
		"disabled_skills": ["playwright"],
		"disabled_hooks": [
			"session-notification",
			"no-sisyphus-gpt",
			"claude-code-hooks",
			"no-hephaestus-non-gpt"
		],
		"browser_automation_engine": { "provider": "agent-browser" },
		"git_master": {
			"commit_footer": false,
			"include_co_authored_by": false,
			"git_env_prefix": "GIT_MASTER=1"
		},
		"notification": { "force_enable": true }
	}
}
