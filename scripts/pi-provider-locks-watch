#!/usr/bin/env python3
"""Snapshot the models Pi may offer from OpenAI and Anthropic.

`--provider openai|anthropic` fetches that provider's model list with its API
key, intersects it with the chat models of Pi's built-in catalog at the
revision `packages/pi-release.json` pins, and prints the result, or with
`--snapshot FILE` rewrites the committed snapshot and leaves FILE untouched
unless the content changes. The snapshot is `{"data": [{"id": ...}]}` sorted by
`id`: Pi's built-in catalog supplies every other model detail.

The key comes from OPENAI_API_KEY or ANTHROPIC_API_KEY and travels on the fetch
command's stdin, never in its argv. Key-bearing requests go to one fixed URL
and refuse redirects, so a custom key header never reaches another host. The
two Pi catalog fetches carry no key.

Anthropic's list is requested with `lifecycle=active` in one request. A
response that still reports `has_more` is refused. The helper refuses to write,
and exits non-zero, when a fetch fails twice, when the list is not in the
expected shape, or when the intersection is empty. It applies no retention
floor: the first refresh of a snapshot seeded from Pi's full catalog
legitimately drops most of it.

`--catalog FILE` reads the provider list from a file, and `--pi-catalog FILE`
reads Pi's catalog (a JSON object of provider to model rows) from a file
instead of fetching them.
"""

import argparse
import json
import os
import sys
import time

# The shared module sits beside this script, also when a test loads it by
# path or Python runs it isolated.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from catalog_snapshot import (  # noqa: E402
    Failure,
    read_json,
    run_fetch,
    write_if_changed,
)

DEFAULT_RELEASE = "packages/pi-release.json"
DEFAULT_RETRY_WAIT = 30
ANTHROPIC_VERSION = "2026-10-21"
PI_REPOSITORY = "earendil-works/pi"
PROVIDERS = {
    "openai": {
        "key_variable": "OPENAI_API_KEY",
        "url": "https://api.openai.com/v1/models",
        "headers": ["Authorization: Bearer {key}"],
    },
    "anthropic": {
        "key_variable": "ANTHROPIC_API_KEY",
        "url": "https://api.anthropic.com/v1/models?lifecycle=active&limit=1000",
        "headers": ["x-api-key: {key}", f"anthropic-version: {ANTHROPIC_VERSION}"],
    },
}


def fetch(url, retry_wait, key="", key_variable="", headers=None, redirects=True):
    extra = () if redirects else ("--max-redirs", "0")
    for attempt in (1, 2):
        proc = run_fetch(url, key, key_variable, headers, extra)
        if proc.returncode == 0:
            try:
                return json.loads(proc.stdout)
            except json.JSONDecodeError:
                problem = "a body that is not JSON"
        else:
            problem = f"status {proc.returncode}"
            reason = proc.stderr.strip().splitlines()[-1:] if proc.stderr else []
            if reason and (not key or key not in reason[0]):
                problem += f" ({reason[0]})"
        print(f"pi-provider-locks-watch: fetching {url} attempt {attempt}: {problem}", file=sys.stderr)
        if attempt == 1:
            time.sleep(retry_wait)
    raise Failure(f"fetching {url} failed twice")


def listed_ids(provider, body):
    data = body.get("data") if isinstance(body, dict) else None
    if not isinstance(data, list):
        raise Failure(f"the {provider} list has no data list")
    if provider == "anthropic" and body.get("has_more") is True:
        raise Failure("the anthropic list reports more pages than one request returns")
    ids = set()
    for row in data:
        model_id = row.get("id") if isinstance(row, dict) else None
        if not isinstance(model_id, str) or model_id == "":
            print(f"pi-provider-locks-watch: skipping a {provider} list entry without an id", file=sys.stderr)
            continue
        if provider == "anthropic" and row.get("lifecycle", "active") != "active":
            continue
        ids.add(model_id)
    return ids


def pi_catalog(retry_wait, release_path):
    rev = read_json(release_path).get("source", {}).get("rev")
    if not isinstance(rev, str) or not rev:
        raise Failure(f"{release_path} names no source revision")
    pin_url = f"https://raw.githubusercontent.com/{PI_REPOSITORY}/{rev}/nix/model-catalog.json"
    revision = fetch(pin_url, retry_wait).get("revision")
    if not isinstance(revision, str) or not revision:
        raise Failure(f"{pin_url} names no catalog revision")
    return fetch(f"https://pi.dev/api/models/revisions/{revision}?types=chat,image,classifier", retry_wait)


def chat_ids(provider, catalog):
    rows = catalog.get(provider) if isinstance(catalog, dict) else None
    if not isinstance(rows, list):
        raise Failure(f"Pi's catalog has no {provider} models")
    return {
        row["id"]
        for row in rows
        if isinstance(row, dict) and isinstance(row.get("id"), str) and row.get("type", "chat") == "chat"
    }


def snapshot_text(ids):
    if not ids:
        raise Failure("no listed model is a chat model of Pi's catalog")
    return json.dumps({"data": [{"id": model_id} for model_id in sorted(ids)]}, indent=2) + "\n"


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--provider", choices=sorted(PROVIDERS), required=True)
    parser.add_argument("--catalog", help="Read the provider's model list from this JSON file instead of fetching it")
    parser.add_argument("--pi-catalog", help="Read Pi's catalog from this JSON file instead of fetching it")
    parser.add_argument("--release", default=DEFAULT_RELEASE, help="Pi release pin (default: %(default)s)")
    parser.add_argument("--snapshot", metavar="FILE", help="Rewrite this snapshot instead of printing it")
    parser.add_argument(
        "--retry-wait",
        type=float,
        default=DEFAULT_RETRY_WAIT,
        help="Seconds to wait before the one retry (default: %(default)s)",
    )
    args = parser.parse_args(argv)
    provider = PROVIDERS[args.provider]

    try:
        if args.catalog:
            body = read_json(args.catalog)
        else:
            key = os.environ.get(provider["key_variable"], "")
            if not key:
                raise Failure(f"{provider['key_variable']} is not set")
            body = fetch(
                provider["url"],
                args.retry_wait,
                key,
                provider["key_variable"],
                provider["headers"],
                redirects=False,
            )
        listed = listed_ids(args.provider, body)
        catalog = read_json(args.pi_catalog) if args.pi_catalog else pi_catalog(args.retry_wait, args.release)
        text = snapshot_text(listed & chat_ids(args.provider, catalog))
        if args.snapshot:
            write_if_changed(args.snapshot, text)
        else:
            sys.stdout.write(text)
        return 0
    except (Failure, OSError) as exc:
        print(f"pi-provider-locks-watch: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
