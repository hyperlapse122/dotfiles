#!/usr/bin/env python3
"""Reconcile Pi's native user settings and optional staged authentication."""
import argparse
import json
import os
from pathlib import Path
import tempfile


def read(path):
    if not path.exists():
        return {}
    if path.is_symlink():
        raise ValueError('Pi state must be a writable regular file')
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError('Pi state must contain an object')
    return value


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(value, stream, indent=2)
            stream.write('\n')
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def staged_key(path, label):
    key = path.read_text().strip()
    if not key or '\n' in key:
        raise ValueError(f'Staged {label} credential is invalid')
    return key


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--agent', type=Path, required=True)
    parser.add_argument('--plugin')
    parser.add_argument('--auth-only', action='store_true')
    parser.add_argument('--key', type=Path)
    parser.add_argument('--credential', action='append', default=[], metavar='PROVIDER=FILE')
    parser.add_argument('--hide-model', action='append', default=[])
    parser.add_argument('--model', action='append', default=[], metavar='PROVIDER/ID')
    args = parser.parse_args()
    agent = args.agent
    if not args.auth_only:
        ids = [model['id'] for model in json.loads((agent / 'models.json').read_text())['providers']['synthetic']['models']]
        hidden_models = set(args.hide_model)
        visible_ids = [model for model in ids if f'synthetic/{model}' not in hidden_models]
        value = read(agent / 'settings.json')
        for name in ('packages', 'extensions'):
            if not isinstance(value.get(name, []), list):
                raise ValueError('Pi resources must be lists')
        packages = []
        for item in value.get('packages', []):
            source = item.get('source', '') if isinstance(item, dict) else item
            if not isinstance(source, str):
                raise ValueError('Pi package source must be a string')
            local = Path(source)
            if not local.is_absolute():
                local = agent / local
            managed = local.resolve() == Path(args.plugin).resolve()
            manifest = local / 'package.json'
            if not managed and manifest.is_file():
                metadata = json.loads(manifest.read_text())
                managed = (metadata.get('name') == 'compound-engineering' and
                           metadata.get('repository') == 'https://github.com/EveryInc/compound-engineering-plugin')
            if not managed:
                packages.append(item)
        value['packages'] = packages + [args.plugin]
        extensions = [str(agent / name) for name in ('dotfiles-web.ts', 'dotfiles-question.ts')]
        # An earlier activation also managed the model policy extension, which no longer exists.
        retired = extensions + [str(agent / 'dotfiles-policy.ts')]
        value['extensions'] = [item for item in value.get('extensions', []) if item not in retired] + extensions
        if value.get('defaultProvider') != 'synthetic' or value.get('defaultModel') not in visible_ids:
            value['defaultModel'] = min(visible_ids)
        value['defaultProjectTrust'] = 'ask'
        value['defaultProvider'] = 'synthetic'
        synthetic = [f'synthetic/{model}' for model in visible_ids] if hidden_models else ['synthetic/*']
        value['enabledModels'] = synthetic + args.model
        write(agent / 'settings.json', value)
    updates = {}
    if args.key:
        updates['synthetic'] = staged_key(args.key, 'Synthetic')
    for item in args.credential:
        provider, _, path = item.partition('=')
        if not provider or not path or '/' in provider:
            raise ValueError('Credential must be PROVIDER=FILE')
        try:
            updates[provider] = staged_key(Path(path), provider)
        except FileNotFoundError:
            pass
    if updates:
        auth = read(agent / 'auth.json')
        for provider, key in updates.items():
            auth[provider] = {'type': 'api_key', 'key': key}
        write(agent / 'auth.json', auth)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError):
        raise SystemExit('Cannot reconcile Pi state; check its files and staged credential.') from None
