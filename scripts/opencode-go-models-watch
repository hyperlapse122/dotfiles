#!/usr/bin/env python3
"""Snapshot the OpenCode Go model catalog.

Fetches OpenCode Go's public model list, which answers without a key, and
prints a snapshot to stdout, or with `--snapshot FILE` rewrites the committed
snapshot and leaves FILE untouched unless the content changes. The snapshot
keeps every well-formed row, sorted by `id`, trimmed to the fields the
provider render reads: `id`, `name`, `recommended_api`, the `api` base URL of
each protocol the model is served over, `limit`, and the text `cost` when the
row has one. The endpoint serves four protocols (chat-completions, responses,
messages, generate-content), and a row naming any other is malformed.

A malformed row is skipped with a warning naming it on stderr, keeping its
previous entry from FILE when one exists. A fetch that fails is retried once
after a wait. It refuses to write, and exits non-zero, when the fetch fails
twice, when no row is left, or when the valid rows shrink below the retention
floor of FILE.

`--catalog FILE` reads the list from a JSON file instead of fetching it.
"""

import argparse
import json
import os
import sys
import time

# The shared module sits beside this script, also when a test loads it by
# path or Python runs it isolated.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from catalog_snapshot import (  # noqa: E402
    Failure,
    check_shrink_floor,
    existing_rows,
    is_int,
    read_json,
    run_fetch,
    write_if_changed,
)

DEFAULT_URL = "https://opencode.ai/inference/go/v1/models"
DEFAULT_RETRY_WAIT = 30
PROTOCOLS = ("chat-completions", "responses", "messages", "generate-content")


def fetch(url, retry_wait):
    """Return the catalog body, retrying once after a wait."""
    for attempt in (1, 2):
        proc = run_fetch(url, "", "OPENCODE_GO_API_KEY")
        if proc.returncode == 0:
            try:
                return json.loads(proc.stdout)
            except json.JSONDecodeError:
                problem = "a body that is not JSON"
        else:
            problem = f"status {proc.returncode}"
            reason = proc.stderr.strip().splitlines()[-1:] if proc.stderr else []
            if reason:
                problem += f" ({reason[0]})"
        print(f"opencode-go-models-watch: fetching {url} attempt {attempt}: {problem}", file=sys.stderr)
        if attempt == 1:
            time.sleep(retry_wait)
    raise Failure(f"fetching {url} failed twice")


def snapshot_row(row):
    """The trimmed row for one catalog entry, or a Failure naming the bad field."""
    model_id = row.get("id") if isinstance(row, dict) else None
    if not isinstance(model_id, str) or model_id == "":
        raise Failure(f"catalog entry {json.dumps(row)[:120]} has no valid id")
    name = row.get("name")
    if not isinstance(name, str) or name == "":
        raise Failure(f"catalog entry {model_id} has no valid name")
    api = row.get("api")
    if not isinstance(api, dict) or not api:
        raise Failure(f"catalog entry {model_id} has no valid api")
    urls = {}
    for protocol, block in api.items():
        base_url = block.get("base_url") if isinstance(block, dict) else None
        if protocol not in PROTOCOLS or not isinstance(base_url, str) or not base_url.startswith("https://"):
            raise Failure(f"catalog entry {model_id} has no valid {protocol} api block")
        urls[protocol] = {"base_url": base_url}
    recommended = row.get("recommended_api")
    if recommended not in urls:
        raise Failure(f"catalog entry {model_id} recommends a protocol its api lacks")
    limit = row.get("limit")
    if not isinstance(limit, dict) or not is_int(limit.get("context")) or not is_int(limit.get("output")):
        raise Failure(f"catalog entry {model_id} has no valid limit")
    kept = {
        "id": model_id,
        "name": name,
        "recommended_api": recommended,
        "api": {protocol: urls[protocol] for protocol in sorted(urls)},
        "limit": {"context": limit["context"], "output": limit["output"]},
    }
    cost = row.get("cost")
    if cost is not None:
        text = cost.get("text") if isinstance(cost, dict) else None
        if not isinstance(text, dict):
            raise Failure(f"catalog entry {model_id} has a cost without a text block")
        kept["cost"] = {"text": text}
    return kept


def catalog_snapshot(catalog, previous=None):
    """The snapshot text for every well-formed catalog row."""
    data = catalog.get("data") if isinstance(catalog, dict) else None
    if not isinstance(data, list):
        raise Failure("the catalog has no data list")
    previous = previous or {}
    kept, fresh = {}, set()
    for row in data:
        try:
            entry = snapshot_row(row)
        except Failure as exc:
            model_id = row.get("id") if isinstance(row, dict) else None
            if isinstance(model_id, str) and model_id in previous:
                kept.setdefault(model_id, previous[model_id])
            print(f"opencode-go-models-watch: skipping {exc}", file=sys.stderr)
            continue
        kept[entry["id"]] = entry
        fresh.add(entry["id"])
    if not fresh:
        raise Failure("the catalog lists no well-formed models")
    check_shrink_floor(len(fresh), len(previous))
    return json.dumps({"data": [kept[i] for i in sorted(kept)]}, indent=2) + "\n"


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--url", default=DEFAULT_URL, help="Catalog URL (default: %(default)s)")
    parser.add_argument("--catalog", help="Read the catalog from this JSON file instead of fetching it")
    parser.add_argument("--snapshot", metavar="FILE", help="Rewrite this snapshot instead of printing it")
    parser.add_argument(
        "--retry-wait",
        type=float,
        default=DEFAULT_RETRY_WAIT,
        help="Seconds to wait before the one retry (default: %(default)s)",
    )
    args = parser.parse_args(argv)

    try:
        catalog = read_json(args.catalog) if args.catalog else fetch(args.url, args.retry_wait)
        previous = existing_rows(args.snapshot, snapshot_row) if args.snapshot else {}
        text = catalog_snapshot(catalog, previous)
        if args.snapshot:
            write_if_changed(args.snapshot, text)
        else:
            sys.stdout.write(text)
        return 0
    except (Failure, OSError) as exc:
        print(f"opencode-go-models-watch: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
