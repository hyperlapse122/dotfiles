#!/usr/bin/env python3
"""Install one validated age identity from stdin.

The caller decrypts the bootstrap ciphertext as the normal user and places one
explicit sudo boundary in front of this command. This process never invokes
GPG, sudo, or a user-controlled destination path.
"""

import argparse
import os
import re
import stat
import subprocess
import sys
import tempfile


TARGET = "/var/lib/sops-nix/key.txt"
MAX_IDENTITY_BYTES = 8192
AGE_KEYGEN = "@AGE_KEYGEN@"
RECIPIENT_RE = re.compile(r"^age1[0-9a-z]+$")


def _fail(message):
    print(f"restore-age-identity: {message}", file=sys.stderr)
    return False


def _prepare_directory(parent):
    """Create the fixed parent or verify it is a root-owned real directory."""
    try:
        try:
            info = os.lstat(parent)
        except FileNotFoundError:
            os.mkdir(parent, 0o700)
            info = os.lstat(parent)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            return _fail("identity directory is not a real directory")
        if info.st_uid != 0 or info.st_gid != 0:
            return _fail("identity directory is not root-owned")
        os.chmod(parent, 0o700)
    except OSError as error:
        return _fail(f"cannot prepare identity directory: {error.strerror}")
    return True


def _derive_recipient(identity_path):
    try:
        result = subprocess.run(
            [AGE_KEYGEN, "-y", identity_path],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def install_identity(payload, expected_recipient):
    """Validate *payload*, then atomically install it at the fixed target."""
    if os.geteuid() != 0:
        return _fail("must run as root")
    if not RECIPIENT_RE.fullmatch(expected_recipient):
        return _fail("expected recipient is invalid")
    if not payload or len(payload) > MAX_IDENTITY_BYTES:
        return _fail("identity is empty or too large")
    if b"\x00" in payload:
        return _fail("identity contains NUL bytes")

    parent = os.path.dirname(TARGET)
    if not _prepare_directory(parent):
        return False

    input_path = None
    staged_path = None
    try:
        with tempfile.NamedTemporaryFile(mode="wb", dir=parent, prefix=".key-input-", delete=False) as stream:
            input_path = stream.name
            os.chmod(input_path, 0o600)
            os.chown(input_path, 0, 0)
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())

        derived = _derive_recipient(input_path)
        if derived != expected_recipient:
            return _fail("recipient mismatch; existing identity was preserved")

        with tempfile.NamedTemporaryFile(mode="wb", dir=parent, prefix=".key-install-", delete=False) as stream:
            staged_path = stream.name
            os.chmod(staged_path, 0o600)
            os.chown(staged_path, 0, 0)
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())

        os.replace(staged_path, TARGET)
        staged_path = None
        return True
    except OSError as error:
        return _fail(f"identity installation failed: {error.strerror}")
    finally:
        for path in (input_path, staged_path):
            if path is not None:
                try:
                    os.unlink(path)
                except FileNotFoundError:
                    pass


def main(argv=None):
    parser = argparse.ArgumentParser(prog="restore-age-identity", description="install a validated age identity from stdin")
    parser.add_argument("--recipient", required=True)
    args = parser.parse_args(argv)
    if os.geteuid() != 0:
        _fail("must run as root")
        return 2
    payload = sys.stdin.buffer.read(MAX_IDENTITY_BYTES + 1)
    if len(payload) > MAX_IDENTITY_BYTES:
        _fail("identity is empty or too large")
        return 1
    return 0 if install_identity(payload, args.recipient) else 1


if __name__ == "__main__":
    raise SystemExit(main())
