#!/usr/bin/env python3
"""Seed OpenCode's credential store from published API key files.

OpenCode v2 keeps credentials for catalog providers in its own database and
ignores any key written into its configuration, so activation imports them
with `opencode auth import`. That command skips a credential that is already
stored, even when its key has changed, so this script reads the stored
credentials back first and logs out an account whose key differs before it
imports the new one. An account whose stored key already matches is left
alone, and accounts under other labels are never touched.

Each `--credential INTEGRATION=KEYFILE` names an integration and the file that
holds its key. The keys are read from those files and handed over in a
temporary import file inside a private directory (mode 0700, file 0600) that
is removed before the script exits; no key reaches an argument list, the
environment, or any output. A missing, unreadable, or empty key file stops the
run before OpenCode is touched.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile

LABEL = "nix-config"


class Failure(Exception):
    """A refusal that should stop the run with a readable message."""


def opencode(binary, *args):
    proc = subprocess.run(
        [binary, "auth", *args, "--standalone"],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        # Stderr can echo the import path, never a key, but trim it anyway.
        detail = proc.stderr.strip().splitlines()[-1:] or [f"status {proc.returncode}"]
        raise Failure(f"opencode auth {args[0]} failed: {detail[0][:200]}")
    return proc.stdout


def read_key(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            key = f.read().strip()
    except OSError as exc:
        raise Failure(f"cannot read the key file {path}: {exc.strerror}") from None
    if not key:
        raise Failure(f"the key file {path} is empty")
    return key


def stored_keys(binary, label):
    """{integration: key} for the accounts stored under label."""
    try:
        exported = json.loads(opencode(binary, "export") or "[]")
    except json.JSONDecodeError:
        raise Failure("opencode auth export printed no JSON") from None
    if not isinstance(exported, list):
        raise Failure("opencode auth export printed no list")
    found = {}
    for entry in exported:
        value = entry.get("value") if isinstance(entry, dict) else None
        if (
            isinstance(entry, dict)
            and entry.get("label") == label
            and isinstance(value, dict)
            and value.get("type") == "key"
        ):
            found[entry.get("integrationID")] = value.get("key")
    return found


def sync(binary, label, credentials):
    keys = {integration: read_key(path) for integration, path in credentials}
    stored = stored_keys(binary, label)
    stale = [i for i in keys if i in stored and stored[i] != keys[i]]
    for integration in stale:
        opencode(binary, "logout", integration, label)
    changed = [i for i in keys if stored.get(i) != keys[i]]
    if not changed:
        return
    with tempfile.TemporaryDirectory(prefix="opencode-auth-") as directory:
        os.chmod(directory, 0o700)
        path = os.path.join(directory, "credentials.json")
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(
                [
                    {
                        "id": integration,
                        "integrationID": integration,
                        "label": label,
                        "active": True,
                        "value": {"type": "key", "key": keys[integration]},
                    }
                    for integration in changed
                ],
                f,
            )
        opencode(binary, "import", path)


def credential(text):
    integration, separator, path = text.partition("=")
    if not separator or not integration or not path:
        raise argparse.ArgumentTypeError("expected INTEGRATION=KEYFILE")
    return integration, path


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--opencode", required=True, help="the opencode binary to run")
    parser.add_argument("--label", default=LABEL, help="the account label this script owns (default: %(default)s)")
    parser.add_argument(
        "--credential",
        action="append",
        type=credential,
        required=True,
        metavar="INTEGRATION=KEYFILE",
        help="an integration and the file holding its key; repeatable",
    )
    args = parser.parse_args(argv)
    try:
        sync(args.opencode, args.label, args.credential)
    except Failure as exc:
        print(f"opencode-auth-sync: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
