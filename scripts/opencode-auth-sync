#!/usr/bin/env python3
"""Seed OpenCode's credential store from published API key files.

OpenCode v2 keeps credentials for catalog providers in its own database and
ignores any key written into its configuration, so activation imports them
with `opencode auth import`. That command skips a credential that is already
stored, even when its key has changed, so this script reads the stored
credentials back first and logs out an account whose key differs before it
imports the new one. Rotation preserves the active account. An account whose
stored key already matches is left alone.

Each `--credential INTEGRATION=KEYFILE` names an integration and the file that
holds its key. The keys are read from those files and handed over in a
temporary import file inside a private directory (mode 0700, file 0600) that
is removed before the script exits; no key reaches an argument list, the
environment, or any output. A missing, unreadable, or empty key file stops the
run before OpenCode is touched.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
import uuid
from pathlib import Path

LABEL = "nix-config"


class Failure(Exception):
    """A refusal that should stop the run with a readable message."""


def opencode(binary, *args):
    proc = subprocess.run(
        [binary, "auth", *args, "--standalone"],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise Failure(f"opencode auth {args[0]} failed (status {proc.returncode})")
    return proc.stdout


def read_key(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            key = f.read().strip()
    except OSError as exc:
        raise Failure(f"cannot read the key file {path}: {exc.strerror}") from None
    if not key:
        raise Failure(f"the key file {path} is empty")
    return key


def exported_accounts(binary):
    try:
        exported = json.loads(opencode(binary, "export") or "[]")
    except json.JSONDecodeError:
        raise Failure("opencode auth export printed no JSON") from None
    if not isinstance(exported, list):
        raise Failure("opencode auth export printed no list")
    return [entry for entry in exported if isinstance(entry, dict)]


def managed_accounts(accounts, label):
    return {
        entry["integrationID"]: entry
        for entry in accounts
        if entry.get("label") == label
        and isinstance(entry.get("value"), dict)
        and entry["value"].get("type") == "key"
    }


def pending_path():
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state")
    return state / "nix-config" / "opencode-auth-selection.json"


def remember_selection(path, pending):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, mode="w", delete=False) as file:
        draft = Path(file.name)
        try:
            json.dump(pending, file)
            file.close()
            draft.replace(path)
        finally:
            draft.unlink(missing_ok=True)


def sync(binary, label, credentials):
    keys = {integration: read_key(path) for integration, path in credentials}
    stored = managed_accounts(exported_accounts(binary), label)
    changed = [i for i, key in keys.items() if i not in stored or stored[i]["value"].get("key") != key]
    stale = [i for i in changed if i in stored]
    path = pending_path()
    pending = json.loads(path.read_text()) if path.exists() else {}
    ids = {i: stored[i]["id"] if i in stored else pending.get(i) or str(uuid.uuid4()) for i in changed}
    selected = {i: ids[i] for i in stale if stored[i].get("active")}
    if selected:
        pending.update(selected)
        remember_selection(path, pending)
    for integration in stale:
        opencode(binary, "logout", integration, ids[integration])
    imported = stored
    if changed:
        with tempfile.TemporaryDirectory(prefix="opencode-auth-") as directory:
            os.chmod(directory, 0o700)
            bundle = os.path.join(directory, "credentials.json")
            fd = os.open(bundle, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump(
                    [
                        {
                            "id": ids[integration],
                            "integrationID": integration,
                            "label": label,
                            "active": True,
                            "value": {"type": "key", "key": keys[integration]},
                        }
                        for integration in changed
                    ],
                    f,
                )
            opencode(binary, "import", bundle)
        imported = managed_accounts(exported_accounts(binary), label)
    for integration in changed:
        account = imported.get(integration)
        if not account or account.get("id") != ids[integration] or account["value"].get("key") != keys[integration]:
            raise Failure(f"OpenCode did not register the managed {integration} account")
    restore = pending.keys() & keys.keys()
    for integration in sorted(restore):
        account = imported[integration]
        if account.get("id") == pending[integration] and not account.get("active"):
            opencode(binary, "switch", integration, pending[integration])
    if restore:
        remaining = {i: id_ for i, id_ in pending.items() if i not in restore}
        if remaining:
            remember_selection(path, remaining)
        else:
            path.unlink()


def credential(text):
    integration, separator, path = text.partition("=")
    if not separator or not integration or not path:
        raise argparse.ArgumentTypeError("expected INTEGRATION=KEYFILE")
    return integration, path


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--opencode", required=True, help="the opencode binary to run")
    parser.add_argument(
        "--credential",
        action="append",
        type=credential,
        required=True,
        metavar="INTEGRATION=KEYFILE",
        help="an integration and the file holding its key; repeatable",
    )
    args = parser.parse_args(argv)
    try:
        sync(args.opencode, LABEL, args.credential)
    except Failure as exc:
        print(f"opencode-auth-sync: {exc}", file=sys.stderr)
        return 1
    except (OSError, json.JSONDecodeError):
        print("opencode-auth-sync: cannot access local credential sync state", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
