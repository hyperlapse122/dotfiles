#!/usr/bin/env python3
"""Resolve the newest stable omp release and the commit its tag names.

Reads can1357/oh-my-pi's latest release, the sha256 digest GitHub records for
the single-file binary packages/omp.nix installs on each supported system, and
the commit the release tag names, which the `omp` flake input must lock to.
Refuses to write a pin for a prerelease, a draft, a non-release tag, a release
missing any of those binaries or their digests, or a tag whose commit cannot be
read, and refuses a version that is not strictly newer than the one already
pinned, so neither an incomplete release nor a downgrade reaches the pin file.
"""

import argparse
import json
import re
import sys

from release_pin import Failure, fetch, hex_to_sri, pinned_version, version_tuple

API = "https://api.github.com/repos/can1357/oh-my-pi"

# Every system a host in this flake can be, and the binary installed on it.
TARGET_ASSETS = {
    "x86_64-linux": "omp-linux-x64",
    "aarch64-darwin": "omp-darwin-arm64",
}

TAG_PATTERN = re.compile(r"^v(\d+\.\d+\.\d+)$")
DIGEST_PATTERN = re.compile(r"^sha256:([0-9a-fA-F]{64})$")
SHA_PATTERN = re.compile(r"^[0-9a-f]{40}$")


def load_json(body, what):
    try:
        return json.loads(body)
    except json.JSONDecodeError as exc:
        raise Failure(f"{what} is not JSON: {exc}") from None


def resolve(api):
    """Return the pin for the latest stable release."""
    item = load_json(fetch(f"{api}/releases/latest"), "release response")
    if not isinstance(item, dict):
        raise Failure("release response is not a JSON object")
    tag = item.get("tag_name")
    match = TAG_PATTERN.match(tag) if isinstance(tag, str) else None
    if item.get("prerelease") is not False or item.get("draft") or not match:
        raise Failure(f"latest release {tag!r} is not a stable vX.Y.Z release")
    version = match.group(1)

    assets = item.get("assets")
    assets = assets if isinstance(assets, list) else []
    platforms = {}
    for system, name in TARGET_ASSETS.items():
        matches = [a for a in assets if isinstance(a, dict) and a.get("name") == name]
        if len(matches) != 1:
            raise Failure(
                f"release {tag} lists {len(matches)} {name} assets, "
                "expected exactly one; refusing to write an incomplete pin"
            )
        digest = matches[0].get("digest")
        digest_match = DIGEST_PATTERN.match(digest) if isinstance(digest, str) else None
        if not digest_match:
            raise Failure(f"invalid sha256 digest for {name} in {tag}: {digest!r}")
        sha256_hex = digest_match.group(1).lower()
        platforms[system] = {"asset": name, "sha256": sha256_hex, "hash": hex_to_sri(sha256_hex)}

    commit = load_json(fetch(f"{api}/commits/{tag}"), "commit response")
    rev = commit.get("sha") if isinstance(commit, dict) else None
    if not isinstance(rev, str) or not SHA_PATTERN.match(rev):
        raise Failure(f"tag {tag} names no usable commit: {rev!r}")
    return {"version": version, "rev": rev, "platforms": platforms}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--api", default=API, help="GitHub API base URL of the omp repository")
    parser.add_argument("--output", "-o", help="Path to the omp-release.json pin file to write or update")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print the resolved pin JSON to stdout without modifying files",
    )
    args = parser.parse_args(argv)

    try:
        resolved = resolve(args.api)
        current_version = pinned_version(args.output) if args.output and not args.dry_run else None
        if current_version is not None:
            try:
                is_newer = version_tuple(resolved["version"]) > version_tuple(current_version)
            except ValueError:
                is_newer = True
            if not is_newer:
                print(
                    f"{args.output} is already up to date at version {current_version} "
                    f"(resolved {resolved['version']} is not newer)"
                )
                return 0

        out_json = json.dumps(resolved, indent=2) + "\n"
        if args.dry_run or not args.output:
            sys.stdout.write(out_json)
            return 0

        with open(args.output, "w", encoding="utf-8") as f:
            f.write(out_json)
        print(f"updated {args.output} to version {resolved['version']}")
        return 0

    except (Failure, OSError) as exc:
        print(f"omp-release: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
