#!/usr/bin/env python3
"""Build the model list Pi and OpenCode declare for OpenAI or Anthropic.

`--provider openai|anthropic` fetches that provider's model list with its API
key, keeps the ids that fully match the provider's id filter, takes each
model's details from models.dev, and prints the result, or with
`--snapshot FILE` rewrites the committed snapshot and leaves FILE untouched
unless the content changes.

The snapshot is `{"models": [...]}` sorted by `id`. A row has the shape of a
Pi `models.json` entry: `id`, `name`, `reasoning`, `input`, `cost` (`input`,
`output`, `cacheRead`, `cacheWrite`), `contextWindow`, and `maxTokens`.

OpenAI ids must fully match `gpt-(?:[0-9.]+)-(?:\\w+)` and have a version of
6.1 or higher. Anthropic ids must fully match `claude-(?:\\w+)-(?:[0-9\\-.]+)`
and be active. For Anthropic, the list API's `max_input_tokens` and
`max_tokens` replace models.dev's context and output limits when they are not
null; cost always comes from models.dev. An id that passes the filter but has
no usable models.dev entry stays out of the snapshot and is named on stderr.

The key comes from OPENAI_API_KEY or ANTHROPIC_API_KEY and travels on the fetch
command's stdin, never in its argv. Key-bearing requests go to one fixed URL
and refuse redirects, so a custom key header never reaches another host. The
models.dev fetch carries no key. The helper refuses to write, and exits
non-zero, when a fetch fails twice, when a list is not in the expected shape,
or when no model remains.

`--catalog FILE` reads the provider list from a file and `--models-dev FILE`
reads the models.dev document from a file instead of fetching them.
"""

import argparse
import json
import os
import re
import sys
import time

# The shared module sits beside this script, also when a test loads it by
# path or Python runs it isolated.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from catalog_snapshot import (  # noqa: E402
    Failure,
    is_int,
    read_json,
    run_fetch,
    write_if_changed,
)

DEFAULT_RETRY_WAIT = 30
ANTHROPIC_VERSION = "2026-10-21"
MODELS_DEV_URL = "https://models.dev/api.json"
OPENAI_FLOOR = (6, 1)
PROVIDERS = {
    "openai": {
        "key_variable": "OPENAI_API_KEY",
        "url": "https://api.openai.com/v1/models",
        "headers": ["Authorization: Bearer {key}"],
        "filter": re.compile(r"gpt-([0-9.]+)-\w+"),
    },
    "anthropic": {
        "key_variable": "ANTHROPIC_API_KEY",
        "url": "https://api.anthropic.com/v1/models?lifecycle=active&limit=1000",
        "headers": ["x-api-key: {key}", f"anthropic-version: {ANTHROPIC_VERSION}"],
        "filter": re.compile(r"claude-\w+-[0-9\-.]+"),
    },
}


def log(message):
    print(f"provider-models-watch: {message}", file=sys.stderr)


def fetch(url, retry_wait, key="", key_variable="", headers=None, redirects=True):
    extra = () if redirects else ("--max-redirs", "0")
    for attempt in (1, 2):
        proc = run_fetch(url, key, key_variable, headers, extra)
        if proc.returncode == 0:
            try:
                return json.loads(proc.stdout)
            except json.JSONDecodeError:
                problem = "a body that is not JSON"
        else:
            problem = f"status {proc.returncode}"
            reason = proc.stderr.strip().splitlines()[-1:] if proc.stderr else []
            if reason and (not key or key not in reason[0]):
                problem += f" ({reason[0]})"
        log(f"fetching {url} attempt {attempt}: {problem}")
        if attempt == 1:
            time.sleep(retry_wait)
    raise Failure(f"fetching {url} failed twice")


def listed_rows(provider, body):
    data = body.get("data") if isinstance(body, dict) else None
    if not isinstance(data, list):
        raise Failure(f"the {provider} list has no data list")
    if provider == "anthropic" and body.get("has_more") is True:
        raise Failure("the anthropic list reports more pages than one request returns")
    rows = {}
    for row in data:
        model_id = row.get("id") if isinstance(row, dict) else None
        if not isinstance(model_id, str) or model_id == "":
            log(f"skipping a {provider} list entry without an id")
            continue
        if provider == "anthropic" and row.get("lifecycle", "active") != "active":
            continue
        rows[model_id] = row
    return rows


def passes_filter(provider, model_id):
    match = PROVIDERS[provider]["filter"].fullmatch(model_id)
    if not match:
        return False
    if provider != "openai":
        return True
    parts = match.group(1).split(".")
    if len(parts) > 2 or not all(part.isascii() and part.isdigit() for part in parts):
        log(f"{model_id} has a version this tool cannot read; leaving it out")
        return False
    version = (int(parts[0]), int(parts[1]) if len(parts) == 2 else 0)
    return version >= OPENAI_FLOOR


def number(value, default=0):
    return value if isinstance(value, (int, float)) and not isinstance(value, bool) else default


def model_row(provider, model_id, details, listed):
    limit = details.get("limit") if isinstance(details.get("limit"), dict) else {}
    context, output = limit.get("context"), limit.get("output")
    if provider == "anthropic":
        if is_int(listed.get("max_input_tokens")):
            context = listed["max_input_tokens"]
        if is_int(listed.get("max_tokens")):
            output = listed["max_tokens"]
    if not (is_int(context) and context > 0 and is_int(output) and output > 0):
        raise Failure("no usable context and output limits")
    modalities = details.get("modalities")
    kinds = modalities.get("input") if isinstance(modalities, dict) else None
    kept = [kind for kind in ("text", "image") if isinstance(kinds, list) and kind in kinds]
    cost = details.get("cost") if isinstance(details.get("cost"), dict) else {}
    name = details.get("name")
    return {
        "id": model_id,
        "name": name if isinstance(name, str) and name else model_id,
        "reasoning": details.get("reasoning") is True,
        "input": kept or ["text"],
        "cost": {
            "input": number(cost.get("input")),
            "output": number(cost.get("output")),
            "cacheRead": number(cost.get("cache_read")),
            "cacheWrite": number(cost.get("cache_write")),
        },
        "contextWindow": context,
        "maxTokens": output,
    }


def snapshot_rows(provider, listed, models_dev):
    section = models_dev.get(provider) if isinstance(models_dev, dict) else None
    known = section.get("models") if isinstance(section, dict) else None
    if not isinstance(known, dict):
        raise Failure(f"models.dev has no {provider} models")
    rows = []
    for model_id in sorted(listed):
        if not passes_filter(provider, model_id):
            continue
        details = known.get(model_id)
        if not isinstance(details, dict):
            log(f"{model_id} passes the {provider} filter but models.dev has no entry for it; leaving it out")
            continue
        try:
            rows.append(model_row(provider, model_id, details, listed[model_id]))
        except Failure as exc:
            log(f"{model_id}: {exc}; leaving it out")
    if not rows:
        raise Failure(f"no listed {provider} model passes the filter and has a models.dev entry")
    return rows


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--provider", choices=sorted(PROVIDERS), required=True)
    parser.add_argument("--catalog", help="Read the provider's model list from this JSON file instead of fetching it")
    parser.add_argument("--models-dev", help="Read the models.dev document from this JSON file instead of fetching it")
    parser.add_argument("--snapshot", metavar="FILE", help="Rewrite this snapshot instead of printing it")
    parser.add_argument(
        "--retry-wait",
        type=float,
        default=DEFAULT_RETRY_WAIT,
        help="Seconds to wait before the one retry (default: %(default)s)",
    )
    args = parser.parse_args(argv)
    provider = PROVIDERS[args.provider]

    try:
        if args.catalog:
            body = read_json(args.catalog)
        else:
            key = os.environ.get(provider["key_variable"], "")
            if not key:
                raise Failure(f"{provider['key_variable']} is not set")
            body = fetch(
                provider["url"],
                args.retry_wait,
                key,
                provider["key_variable"],
                provider["headers"],
                redirects=False,
            )
        listed = listed_rows(args.provider, body)
        models_dev = read_json(args.models_dev) if args.models_dev else fetch(MODELS_DEV_URL, args.retry_wait)
        text = json.dumps({"models": snapshot_rows(args.provider, listed, models_dev)}, indent=2) + "\n"
        if args.snapshot:
            write_if_changed(args.snapshot, text)
        else:
            sys.stdout.write(text)
        return 0
    except (Failure, OSError) as exc:
        log(str(exc))
        return 1


if __name__ == "__main__":
    sys.exit(main())
