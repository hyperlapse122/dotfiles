#!/usr/bin/env python3
import os
import signal
import subprocess
import sys


def main():
    args = sys.argv[1:]
    # Git's OpenPGP signing invocation. Verification and arbitrary GPG calls
    # pass through without touching the card or consuming their input.
    if len(args) == 3 and args[:2] == ["--status-fd=2", "-bsau"]:
        try:
            subprocess.run(
                ["gpg", "--batch", "--card-status"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
            )
        except (OSError, subprocess.TimeoutExpired):
            pass
    # Undo Python's ignored signals before handing control to GPG.
    for name in ("SIGPIPE", "SIGXFZ", "SIGXFSZ"):
        if hasattr(signal, name):
            signal.signal(getattr(signal, name), signal.SIG_DFL)
    # Preserve GPG's streams and status. In particular, never
    # retry a signing operation that might already have submitted a bad PIN.
    os.execvp("gpg", ["gpg", *args])


if __name__ == "__main__":
    main()
