#!/bin/sh
set -eu
unset CDPATH

usage() {
  printf '%s\n' 'Usage: agent-check [--registry-policy ABSOLUTE_PATH] [--staged | --range BASE HEAD]

Check local changes in this dotfiles checkout by default.
--staged checks the Git index. --range checks the committed HEAD tree against BASE.
--registry-policy runs only registry lookups using an approved policy outside the checkout.'
}

policy=
if [ "${1:-}" = --registry-policy ]; then
  case ${2:-} in
    /*) ;;
    *) usage >&2; exit 2 ;;
  esac
  policy=$2
  shift 2
fi
case $0 in
  */*) script_dir=${0%/*} ;;
  *) script_dir=. ;;
esac
script_dir=$(cd -- "$script_dir" && pwd -P)

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --staged) expected=1; mode=staged ;;
  --range) expected=3; mode=range ;;
  "") expected=0; mode=worktree ;;
  *) usage >&2; exit 2 ;;
esac
if [ "$#" -ne "$expected" ]; then
  usage >&2
  exit 2
fi
if [ -n "$policy" ]; then
  # Only the pinned interpreter may start with registry credentials in its environment.
  case ${AGENT_CHECK_PYTHON:-} in
    /nix/store/*/bin/python3) ;;
    *) printf '%s\n' 'agent-check: run registry checks with nix develop .#agent-check' >&2; exit 1 ;;
  esac
  exec "$AGENT_CHECK_PYTHON" -I "$script_dir/agent-check-inspect.py" --policy "$policy" \
    --snapshot "$mode" --base "${2:-}" --head "${3:-}"
fi
checkout_root=$(cd "$script_dir/.." && pwd -P)
root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  printf 'agent-check: run from this dotfiles checkout\n' >&2
  exit 1
}
root=$(cd "$root" && pwd -P)
if [ "$root" != "$checkout_root" ]; then
  printf 'agent-check: run from this dotfiles checkout\n' >&2
  exit 1
fi
cd "$root"
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT

case $mode in
  worktree)
    git diff --cached --no-renames --name-only -z > "$tmp/paths"
    git diff --no-renames --name-only -z >> "$tmp/paths"
    git ls-files --others --exclude-standard -z >> "$tmp/paths"
    ;;
  staged)
    git diff --cached --no-renames --name-only -z > "$tmp/paths"
    ;;
  range)
    base=$(git rev-parse --verify --end-of-options "$2^{tree}")
    head=$(git rev-parse --verify --end-of-options "$3^{commit}")
    git diff --no-renames --name-only -z "$base" "$head" > "$tmp/paths"
    ;;
esac
[ -s "$tmp/paths" ] || exit 0
sort -zu "$tmp/paths" > "$tmp/files"
export AGENT_CHECK_FILES="$tmp/files"
export AGENT_CHECK_MODE="$mode"

if [ "$mode" != worktree ]; then
  mkdir "$tmp/tree"
  if [ "$mode" = range ]; then
    export GIT_INDEX_FILE="$tmp/index"
    git read-tree "$head"
  fi
  git --work-tree="$tmp/tree" checkout-index --all --prefix="$tmp/tree/"
  # A hook inherits Git's index and directory overrides. Keep those out of the task.
  git rev-parse --local-env-vars > "$tmp/git-vars"
  while IFS= read -r name; do unset "$name"; done < "$tmp/git-vars"
  cd "$tmp/tree"
  # mise shims need to resolve tools in the temporary checkout.
  export MISE_TRUSTED_CONFIG_PATHS="$(pwd -P)"
  export MISE_SAFE=1
fi

inspection_status=0
task_status=0
python3 -I "$script_dir/agent-check-inspect.py" --paths "$AGENT_CHECK_FILES" > "$tmp/inspection" || inspection_status=$?
bash scripts/check-changed-files > "$tmp/output" 2>&1 || task_status=$?
cat "$tmp/inspection" >&2
if [ "$task_status" -ne 0 ]; then
  head -n 100 "$tmp/output" >&2
  exit "$task_status"
fi
exit "$inspection_status"
