#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: agent-check [--registry-policy ABSOLUTE_PATH] [--staged | --range BASE HEAD]

Run the repository's agent-check task on local changes by default.
--staged checks the Git index. --range checks the committed HEAD tree against BASE.
--registry-policy runs only registry lookups using an approved policy outside the checkout.
EOF
}

policy=
if [[ ${1:-} == --registry-policy ]]; then
  if [[ $# -lt 2 || $2 != /* ]]; then
    usage >&2
    exit 2
  fi
  policy=$2
  shift 2
fi
if [[ ${inspection[0]+set} != set ]]; then
  inspection=(python3 -I "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/agent-check-inspect.py")
fi

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  --staged) expected=1; mode=staged ;;
  --range) expected=3; mode=range ;;
  "") expected=0; mode=worktree ;;
  *) usage >&2; exit 2 ;;
esac
if [[ $# -ne $expected ]]; then
  usage >&2
  exit 2
fi
if [[ -n $policy ]]; then
  PATH="${inspection_path:-$PATH}" exec "${inspection[@]}" --policy "$policy" \
    --snapshot "$mode" --base "${2:-}" --head "${3:-}"
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root"
root=$(pwd -P)
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT

case $mode in
  worktree)
    git diff --cached --no-renames --name-only -z > "$tmp/paths"
    git diff --no-renames --name-only -z >> "$tmp/paths"
    git ls-files --others --exclude-standard -z >> "$tmp/paths"
    ;;
  staged)
    git diff --cached --no-renames --name-only -z > "$tmp/paths"
    ;;
  range)
    base=$(git rev-parse --verify --end-of-options "$2^{tree}")
    head=$(git rev-parse --verify --end-of-options "$3^{commit}")
    git diff --no-renames --name-only -z "$base" "$head" > "$tmp/paths"
    ;;
esac
[[ -s $tmp/paths ]] || exit 0
sort -zu "$tmp/paths" > "$tmp/files"
export AGENT_CHECK_FILES="$tmp/files"
export AGENT_CHECK_MODE="$mode"
check_path=$PATH

if [[ $mode != worktree ]]; then
  mkdir "$tmp/tree"
  if [[ $mode == range ]]; then
    export GIT_INDEX_FILE="$tmp/index"
    git read-tree "$head"
  fi
  git --work-tree="$tmp/tree" checkout-index --all --prefix="$tmp/tree/"
  # A hook inherits Git's index and directory overrides. Keep those out of the task.
  git rev-parse --local-env-vars > "$tmp/git-vars"
  while IFS= read -r name; do unset "$name"; done < "$tmp/git-vars"
  cd "$tmp/tree"
  MISE_TRUSTED_CONFIG_PATHS=$(pwd -P)
  export MISE_TRUSTED_CONFIG_PATHS
fi

check_and_run() {
  local check_status=0 task_status=0
  PATH="$check_path" "${inspection[@]}" --paths "$AGENT_CHECK_FILES" \
    > "$tmp/inspection" || check_status=$?
  "$@" || task_status=$?
  if [[ $task_status -ne 0 ]]; then
    return "$task_status"
  fi
  return "$check_status"
}

run_task() (
  local tasks file project
  export PATH="$root/node_modules/.bin:$PATH"
  # A task of the same name from a parent or global mise config is not this project's task.
  if command -v mise >/dev/null; then
    project=$(pwd -P)
    MISE_CEILING_PATHS=$(dirname "$project")
    export MISE_CEILING_PATHS
    tasks=$(mise tasks ls --name-only --no-global --hidden) || return
    if [[ $'\n'$tasks$'\n' == *$'\n'agent-check$'\n'* ]]; then
      check_and_run mise run --force --skip-tools agent-check
      return
    fi
  fi

  for file in justfile Justfile .justfile .Justfile; do
    [[ -f $file ]] || continue
    tasks=$(just --justfile "$file" --summary) || return
    if [[ " $tasks " == *" agent-check "* ]]; then
      check_and_run just --justfile "$file" agent-check
      return
    fi
    break
  done

  for file in GNUmakefile makefile Makefile; do
    [[ -f $file ]] || continue
    # Even make -q evaluates expansions and can rebuild included makefiles.
    if PATH="$check_path" awk '
      continued { continued = /\\$/; next }
      { continued = /\\$/ }
      /^\t/ { next }
      /^[ ]*((override|export|private)[ ]+)*define[ ]/ { definitions++; next }
      /^[ ]*endef([ ]|$)/ { definitions--; next }
      !definitions && /^[ ]*agent-check[ ]*:/ {
        sub(/^[ ]*agent-check[ ]*::?/, "")
        sub(/[;#].*$/, "")
        if ($0 !~ /=/) { found = 1; exit }
      }
      END { exit !found }
    ' "$file"; then
      check_and_run make --file "$file" agent-check
      return
    fi
    break
  done
)

status=0
run_task > "$tmp/output" 2>&1 || status=$?
if [[ -f $tmp/inspection ]]; then
  cat "$tmp/inspection" >&2
fi
if [[ $status -ne 0 ]]; then
  head -n 100 "$tmp/output" >&2
  exit "$status"
fi
