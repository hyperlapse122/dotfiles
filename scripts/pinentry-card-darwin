#!/usr/bin/env python3
"""Darwin front stage of pinentry-card: lets pinentry_mac save a card PIN in
the macOS Keychain.

gpg-agent sends SETKEYINFO --clear for card PINs, and pinentry_mac offers its
"Save in Keychain" box, and reads a saved PIN back, only when a key id is set.
This filter runs the darwin render of scripts/pinentry-card as its child.  It
answers the agent's SETKEYINFO itself and, at GETPIN, gives the child the key
id it chose: one derived from the card serial on a clean card prompt, or
--clear on a rejected one, so a PIN the card refused is never replayed.  The
agent sees exactly one reply per command it sent.

The Nix package replaces the two @...@ constants.
"""

import importlib.machinery
import importlib.util
import os
import signal
import subprocess
import sys
import threading
import time

PROXY_PATH = "@PINENTRY_CARD_PROXY@"
SECURITY_PATH = "@SECURITY@"
# pinentry_mac stores a PIN as a generic password with this service and the
# key id after its "<cache mode>/" prefix as the account (KeychainSupport.m,
# AppDelegate.m mac_cmd_handler).  It saves nothing for cache mode "u".
KEYCHAIN_SERVICE = "GnuPG"
KEYINFO_PREFIX = "n/"
ACCOUNT_PREFIX = "gnupg-card-pin-"
CLEAR_KEYINFO = b"SETKEYINFO --clear\n"
# How long to wait for the child to exit after stdin closes or a signal: the
# child itself takes up to about 16 seconds to reap its delegate and exit.
CHILD_EXIT_GRACE = 20


def load_proxy():
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("pinentry_card_proxy", PROXY_PATH)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


proxy = load_proxy()


def keychain_account(serial):
    return ACCOUNT_PREFIX + serial


def delete_saved_pin(serial):
    """Drop the PIN pinentry_mac saved for one card.  Never raises: a Keychain
    that is absent, slow, or failing must not stop the prompt."""
    argv = [SECURITY_PATH, "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", keychain_account(serial)]
    try:
        subprocess.run(
            argv,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=proxy.KEYRING_LOOKUP_TIMEOUT,
        )
    except (subprocess.TimeoutExpired, OSError):
        return


def is_reply(line):
    return line == b"OK\n" or line.startswith((b"OK ", b"ERR "))


class Replies:
    """The child replies still owed, oldest first, each marked with whether
    it goes to the agent.  The greeting is the first."""

    def __init__(self):
        self.changed = threading.Condition()
        self.pending = [True]
        self.ended = False
        # When the relay's current write to the agent began, or None.
        self.writing_since = None

    def expect(self, relay):
        with self.changed:
            self.pending.append(relay)

    def received(self):
        """True when the reply just read goes to the agent."""
        with self.changed:
            relay = self.pending.pop(0) if self.pending else True
            self.changed.notify_all()
        return relay

    def end(self):
        with self.changed:
            self.ended = True
            self.changed.notify_all()

    def wait_answered(self):
        """Wait until the child has answered everything sent so far; False
        once it has stopped answering."""
        with self.changed:
            self.changed.wait_for(lambda: self.ended or not self.pending)
            return not self.ended

    def owes_reply(self):
        # A reply leaves pending under the output lock it is written under.
        return bool(self.pending)


def pump(child_stdout, client_out, output_lock, replies):
    # Ends the replies on every exit, a write to a vanished agent included,
    # so the main thread never waits on a reply that can no longer arrive.
    try:
        while True:
            line = child_stdout.readline()
            if not line:
                return
            # Under the lock, so a reply counted as answered has been written
            # before the main thread writes a reply of its own.
            with output_lock:
                if is_reply(line) and not replies.received():
                    continue
                replies.writing_since = time.monotonic()
                client_out.write(line)
                client_out.flush()
                replies.writing_since = None
    except (BrokenPipeError, OSError):
        return
    finally:
        replies.end()


def main():
    client_in = sys.stdin.buffer
    client_out = sys.stdout.buffer
    child = subprocess.Popen(
        [sys.executable, PROXY_PATH] + sys.argv[1:],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        close_fds=True,
    )
    output_lock = threading.Lock()
    replies = Replies()
    relay = threading.Thread(target=pump, args=(child.stdout, client_out, output_lock, replies), daemon=True)
    relay.start()
    state = proxy.Prompt()
    agent_keyinfo = CLEAR_KEYINFO
    stopped = threading.Event()

    def reap():
        try:
            child.wait(timeout=CHILD_EXIT_GRACE)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
        return child.returncode

    # Every exit ends in os._exit, as in the shared proxy: interpreter
    # shutdown aborts when the daemon relay thread is inside a stdout write.
    def shutdown():
        stopped.set()
        try:
            child.stdin.close()
        except OSError:
            pass
        status = reap()
        # A killed child answers nothing more.
        proxy.drain_relay(relay, replies, lambda: child.returncode >= 0, client_out)
        if output_lock.acquire(timeout=2):
            try:
                client_out.flush()
            except OSError:
                pass
        os._exit(status)

    def on_signal(signum, frame):
        del frame
        # The child runs the shared proxy's own signal handling, which reaps
        # the delegate within its dialog grace.
        try:
            child.send_signal(signum)
        except OSError:
            pass
        # The main thread is already reaping the child and exits once it
        # does; waiting here too could deadlock on Popen's waitpid lock.
        if stopped.is_set():
            return
        stopped.set()
        os._exit(reap())

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)

    def send(line, relay_reply):
        replies.expect(relay_reply)
        try:
            child.stdin.write(line)
            child.stdin.flush()
        except (BrokenPipeError, OSError):
            shutdown()

    def await_child():
        if not replies.wait_answered():
            shutdown()

    while True:
        line = client_in.readline()
        if not line or not line.endswith(b"\n"):
            shutdown()
        command, _, argument = line[:-1].partition(b" ")
        if command == b"SETKEYINFO":
            agent_keyinfo = line
            # Earlier replies, the greeting included, reach the agent first.
            await_child()
            with output_lock:
                client_out.write(b"OK\n")
                client_out.flush()
            continue
        if command == b"GETPIN":
            serial = state.card_serial()
            if serial is None:
                keyinfo = agent_keyinfo
            elif state.rejected():
                # The rejection reaches a new pinentry process, so this
                # prompt is the only evidence of it: drop the saved PIN once
                # per serial and keep pinentry_mac off the Keychain.
                if serial not in state.cleared:
                    state.cleared.add(serial)
                    delete_saved_pin(serial)
                keyinfo = CLEAR_KEYINFO
            else:
                keyinfo = b"SETKEYINFO " + (KEYINFO_PREFIX + keychain_account(serial)).encode("ascii") + b"\n"
            # The child tracks SETERROR itself; this copy only guards the
            # GETPIN that follows it, as in the shared proxy.
            state.seen_error = False
            # The child must have answered this before GETPIN goes out: the
            # shared proxy may answer GETPIN itself, ahead of a reply from
            # pinentry_mac still in flight.
            send(keyinfo, False)
            await_child()
        elif command in (b"SETPROMPT", b"SETDESC", b"SETERROR"):
            state.remember(command, argument)
        send(line, True)
        if command == b"BYE":
            shutdown()


if __name__ == "__main__":
    main()
