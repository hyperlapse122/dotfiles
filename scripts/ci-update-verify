#!/usr/bin/env bash
set -euo pipefail

scope=$1
logs=$2
mkdir -p "$logs"
failed=0

check() {
  local name=$1 status
  shift
  set +e
  "$@" 2>&1 | tee "$logs/$name.log"
  status=${PIPESTATUS[0]}
  set -e
  if [ "$status" -ne 0 ]; then
    failed=1
    {
      printf '### %s verification failed\n\n```text\n' "$name"
      tail -n 80 "$logs/$name.log"
      printf '```\n'
    } >> "$GITHUB_STEP_SUMMARY"
  fi
}

build_targets() {
  local group=$1 targets names name
  targets=$(nix eval --json ".#$group" --apply builtins.attrNames)
  names=$(jq -r '.[] | select(. != "all")' <<< "$targets")
  if [ -z "$names" ]; then
    printf 'No verification targets in %s\n' "$group" >&2
    exit 1
  fi
  while IFS= read -r name; do
    # Keep only the current closure live so Nix can reclaim earlier builds.
    check "$group-$name" nix build --no-link --print-build-logs \
      --option min-free 8589934592 --option max-free 17179869184 \
      ".#$group.$name"
  done <<< "$names"
}

case "$scope" in
  dependencies)
    check fmt nix fmt -- --ci
    check check nix flake check --no-build --print-build-logs
    build_targets checks.x86_64-linux
    build_targets vmChecks
    ;;
  catalogs)
    check catalog nix build --no-link --print-build-logs \
      .#checks.x86_64-linux.pi .#checks.x86_64-linux.synthetic-models
    ;;
  *) printf 'Unknown verification scope: %s\n' "$scope" >&2; exit 2 ;;
esac
exit "$failed"
