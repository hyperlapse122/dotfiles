#!/usr/bin/env python3
"""Docker credential helper backed by SOPS secrets."""
import argparse
import json
import sys

CREDENTIAL_MAP = "@CREDENTIAL_MAP@"


def _miss():
    sys.stdout.write("credentials not found in native keychain\n")
    sys.exit(1)


def _load_map(map_path):
    try:
        with open(map_path, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict):
            return data
    except Exception:
        pass
    return None


def handle_get(map_path):
    try:
        registry = sys.stdin.read().strip()
        if not registry:
            _miss()

        table = _load_map(map_path)
        if table is None or registry not in table:
            _miss()

        entry = table[registry]
        if not isinstance(entry, dict):
            _miss()

        username = entry.get("username")
        secret_path = entry.get("secret")
        if not username or not secret_path:
            _miss()
        if not isinstance(username, str) or not isinstance(secret_path, str):
            _miss()

        try:
            with open(secret_path, "r", encoding="utf-8") as f:
                raw = f.read(16384)
        except Exception:
            _miss()

        secret = raw.rstrip()
        if not secret or len(secret) > 8192 or any(c.isspace() or ord(c) < 32 for c in secret):
            _miss()

        payload = {
            "ServerURL": registry,
            "Username": username,
            "Secret": secret,
        }
        sys.stdout.write(json.dumps(payload) + "\n")
        sys.exit(0)
    except SystemExit:
        raise
    except Exception:
        _miss()


def _handle_unsupported_mutation():
    try:
        sys.stdin.read()
    except Exception:
        pass
    sys.stderr.write("credentials are managed declaratively; this helper does not store them\n")
    sys.exit(0)


handle_store = _handle_unsupported_mutation
handle_erase = _handle_unsupported_mutation


def handle_list(map_path):
    table = _load_map(map_path)
    result = {}
    if table:
        for reg, entry in table.items():
            if isinstance(entry, dict) and "username" in entry and isinstance(entry["username"], str):
                result[reg] = entry["username"]
    sys.stdout.write(json.dumps(result) + "\n")
    sys.exit(0)


class HelperArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        sys.stderr.write(f"docker-credential-sops: {message}\n")
        sys.exit(1)


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]

    parser = HelperArgumentParser(
        prog="docker-credential-sops",
        description=__doc__,
        add_help=False,
    )
    parser.add_argument("--map", default=CREDENTIAL_MAP, dest="map_path")
    parser.add_argument("action", nargs="?")

    try:
        args = parser.parse_args(argv)
        if not args.action:
            sys.stderr.write("docker-credential-sops: action is required (get|store|erase|list)\n")
            sys.exit(1)
        if args.action not in ("get", "store", "erase", "list"):
            sys.stderr.write(f"docker-credential-sops: unknown action '{args.action}'\n")
            sys.exit(1)

        if args.action == "get":
            handle_get(args.map_path)
        elif args.action == "store":
            handle_store()
        elif args.action == "erase":
            handle_erase()
        elif args.action == "list":
            handle_list(args.map_path)
    except SystemExit:
        raise
    except Exception:
        sys.stderr.write("docker-credential-sops: unexpected error\n")
        sys.exit(1)


if __name__ == "__main__":
    main()
