#!/usr/bin/env python3
"""Extract a built-in subagent catalog from a pinned harness source tree."""

import argparse
import json
import os
from pathlib import Path
import re
import sys
import tempfile
import tomllib


class Failure(Exception):
    """The source does not establish a complete catalog."""


# Parse the complete supported registry, not occurrences of AgentRoleConfig.
# A new registration mechanism must be understood before publishing a catalog.
RUST_STRING = r'(?:r#*".*?"#*|"(?:[^"\\]|\\.)*")'
RUST_TOKEN = re.compile(
    r'(?P<string>r(?P<hashes>#*)".*?"(?P=hashes)|"(?:[^"\\]|\\.)*")'
    r'|//[^\n]*|/\*.*?\*/',
    re.DOTALL,
)
CODEX_REGISTRY = re.compile(
    r"\s*use super::\*;\s*"
    r"pub\(super\) fn configs\(\) -> &'static BTreeMap<String, AgentRoleConfig> \{\s*"
    r"static CONFIG: LazyLock<BTreeMap<String, AgentRoleConfig>> = LazyLock::new\(\|\| \{\s*"
    r"BTreeMap::from\(\[(?P<rows>.*?)\]\)\s*\}\);\s*&CONFIG\s*\}\s*"
    r"pub\(super\) fn config_file_contents\(path: &Path\) -> Option<&'static str> \{\s*"
    r"(?P<includes>.*?)match path\.to_str\(\)\? \{(?P<files>.*?)_ => None,\s*\}\s*\}\s*\}",
    re.DOTALL,
)
CODEX_ROLE = re.compile(
    rf'\s*\(\s*(?P<name>DEFAULT_ROLE_NAME|{RUST_STRING})\.to_string\(\),\s*'
    rf'AgentRoleConfig\s*\{{\s*description:\s*(?:None|Some\((?P<purpose>{RUST_STRING})\.to_string\(\)\)),\s*'
    r'config_file:\s*(?:None|Some\("(?P<file>[a-zA-Z0-9_.-]+\.toml)"'
    r'\.to_string\(\)\.parse\(\)\.unwrap_or_default\(\)\)),\s*'
    r'nickname_candidates:\s*None,\s*\},?\s*\)\s*(?:,|$)',
    re.DOTALL,
)
CODEX_INCLUDE = re.compile(
    r'\s*const (?P<name>[A-Z_]+): &str = include_str!\("(?P<path>[^"\n]+)"\);\s*',
)
CODEX_CONFIG_FILE = re.compile(r'\s*"(?P<file>[^"\n]+)" => Some\((?P<name>[A-Z_]+)\),\s*')

PI_ABSENCE = "Pi ships with powerful defaults but skips features like sub-agents and plan mode."
PI_EXTENSIONS = {"llama.cpp", "codemode", "tool-search", "mcp"}
PI_EXTENSION_ROW = re.compile(
    r'\s*\{ name: "([a-z.-]+)", factory: \w+, (?:replaceable: true, )?builtin: true \},\s*',
)


def rust_string(token):
    if token.startswith("r"):
        literal = re.fullmatch(r'r(?P<hashes>#*)"(.*)"(?P=hashes)', token, re.DOTALL)
        if literal is None:
            raise Failure("unsupported Rust raw string in the Codex registry")
        return literal[2]
    return json.loads(token)


def rows(pattern, content, label):
    while content.strip():
        entry = pattern.match(content)
        if not entry:
            line = content.strip().splitlines()[0]
            raise Failure(f"{label}: unsupported declaration {line[:120]!r}")
        yield entry
        content = content[entry.end():]


def codex_role_settings(path):
    config = tomllib.loads(path.read_text())
    allowed = {"model", "model_reasoning_effort", "features", "skills", "developer_instructions"}
    if unknown := set(config) - allowed:
        raise Failure(f"{path.name}: unsupported Codex role settings {', '.join(sorted(unknown))}")

    fields = {"model": {"inherited": True}}
    for upstream, catalog in (
        ("model", "model"),
        ("model_reasoning_effort", "modelReasoningEffort"),
        ("features", "features"),
        ("skills", "skills"),
    ):
        if upstream in config:
            expected = str if upstream in {"model", "model_reasoning_effort"} else dict
            if not isinstance(config[upstream], expected):
                raise Failure(f"{path.name}: {upstream} has an unsupported value")
            fields[catalog] = config[upstream]
    return fields


def codex_agents(source, version):
    cargo = tomllib.loads((source / "codex-rs/Cargo.toml").read_text())
    if cargo["workspace"]["package"]["version"] != version:
        raise Failure("Codex source version differs from the release pin")

    role_file = source / "codex-rs/core/src/agent/role.rs"
    rust = RUST_TOKEN.sub(lambda token: token["string"] or " ", role_file.read_text())
    prefix, separator, body = rust.partition("\nmod built_in {")
    registry, suffix = (None, "")
    if separator:
        module, _, suffix = body.partition("\n#[cfg(test)]")
        registry = CODEX_REGISTRY.fullmatch(module.strip())
    if registry is None or not re.fullmatch(r'\s*#\[path = "role_tests\.rs"\]\s*mod tests;\s*', suffix):
        raise Failure("unsupported Codex built-in role registry")

    defaults = re.findall(r'(?m)^pub const DEFAULT_ROLE_NAME: &str = ("[^"\\]+");$', prefix)
    if len(defaults) != 1:
        raise Failure("missing or ambiguous Codex default role")

    includes = {}
    for entry in rows(CODEX_INCLUDE, registry["includes"], "Codex role config includes"):
        if entry["name"] in includes:
            raise Failure(f"duplicate Codex role config include {entry['name']}")
        path = (role_file.parent / entry["path"]).resolve()
        if not path.is_relative_to(source.resolve()):
            raise Failure(f"Codex role config lies outside its source tree: {path}")
        includes[entry["name"]] = path

    files = {}
    for entry in rows(CODEX_CONFIG_FILE, registry["files"], "Codex role config lookup"):
        name = entry["name"]
        if entry["file"] in files or name not in includes:
            raise Failure(f"missing or ambiguous Codex role config {entry['file']}")
        files[entry["file"]] = includes[name]

    agents = {}
    for entry in rows(CODEX_ROLE, registry["rows"], "Codex built-in roles"):
        name = rust_string(defaults[0] if entry["name"] == "DEFAULT_ROLE_NAME" else entry["name"])
        if not name or name in agents:
            raise Failure(f"empty or duplicate Codex agent identifier {name!r}")
        agent = {"agentType": name}
        if entry["purpose"] is not None:
            agent["whenToUse"] = rust_string(entry["purpose"])
        config_file = entry["file"]
        if config_file is None:
            agent["model"] = {"inherited": True}
        elif config_file in files:
            agent.update(codex_role_settings(files[config_file]))
        else:
            raise Failure(f"{name}: Codex role config {config_file} is not embedded")
        agents[name] = agent

    if rust_string(defaults[0]) not in agents:
        raise Failure("Codex built-in registry has no default role")
    return [agents[name] for name in sorted(agents)]


def pi_agents(source, version):
    package = source / "packages/coding-agent"
    if json.loads((package / "package.json").read_text())["version"] != version:
        raise Failure("Pi source version differs from the release pin")
    if PI_ABSENCE not in (package / "README.md").read_text():
        raise Failure("Pi source no longer confirms the absence of built-in subagents")

    extensions = (package / "src/extensions/index.ts").read_text()
    extensions = re.sub(r"(?m)^\s*//[^\n]*", "", extensions)
    registry = re.search(
        r"export const builtInExtensions: InlineExtension\[\] = \[(.*?)\];\s*\Z",
        extensions,
        re.DOTALL,
    )
    if registry is None:
        raise Failure("unsupported Pi built-in extension registry")
    names = [item[1] for item in rows(PI_EXTENSION_ROW, registry[1], "Pi built-in extensions")]
    if len(names) != len(PI_EXTENSIONS) or set(names) != PI_EXTENSIONS:
        raise Failure("Pi built-in extensions changed; verify the subagent roster before updating")
    return []


def write_catalog(path, content):
    tmp = tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent, delete=False)
    temporary = Path(tmp.name)
    try:
        with tmp:
            tmp.write(content)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("harness", choices=("codex", "pi"))
    parser.add_argument("--source", required=True, type=Path, help="Unpacked pinned source tree")
    parser.add_argument("--pin", required=True, type=Path, help="Release manifest for the source")
    parser.add_argument("-o", "--output", type=Path, help="Write the catalog to this file")
    args = parser.parse_args()
    try:
        pin = json.loads(args.pin.read_text())
        extract = codex_agents if args.harness == "codex" else pi_agents
        catalog = {
            "version": pin["version"],
            "sourceRevision": pin["source"]["rev"],
            "agents": extract(args.source, pin["version"]),
        }
        output = json.dumps(catalog, indent=2, ensure_ascii=False) + "\n"
        if args.output:
            write_catalog(args.output, output)
        else:
            sys.stdout.write(output)
    except (Failure, ValueError, OSError, KeyError, TypeError) as error:
        print(f"{args.harness}-agents: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
