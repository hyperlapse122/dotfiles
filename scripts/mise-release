#!/usr/bin/env python3
"""Resolve the newest upstream mise release from its published SHASUMS256.txt.

Fetches the SHASUMS256.txt asset of jdx/mise's latest GitHub release, reads
the version and the checksums of the static linux-x64-musl and
linux-arm64-musl tarballs and the macos-arm64 tarball from it, and writes or
checks the pin file packages/mise.nix consumes. Refuses to write a pin for a
release missing any of those tarballs, or a version that is not strictly newer than the one already
pinned, so neither an incomplete release nor a downgrade ever reaches the pin
file.
"""

import argparse
import base64
import json
import re
import subprocess
import sys

# The /latest/download/ redirect resolves to the latest release's asset, so
# one request yields both the version (from the filenames) and the checksum
# without the GitHub REST API's unauthenticated rate limit.
DEFAULT_SOURCE_URL = "https://github.com/jdx/mise/releases/latest/download/SHASUMS256.txt"

# The Nix system each pinned asset serves. The musl builds are statically
# linked, so they run on NixOS without patching.
TARGET_ASSETS = {
    "x86_64-linux": "linux-x64-musl",
    "aarch64-linux": "linux-arm64-musl",
    "aarch64-darwin": "macos-arm64",
}

VERSION_PATTERN = re.compile(r"^\d+(?:\.\d+)*$")
SHA256_HEX_PATTERN = re.compile(r"^[0-9a-fA-F]{64}$")


class Failure(Exception):
    """A refusal that should stop the caller with a readable message."""


def fetch(url):
    """Fetch one URL with curl and return the raw body."""
    proc = subprocess.run(
        ["curl", "-sfL", "--max-time", "60", url],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise Failure(f"fetching {url} failed with status {proc.returncode}")
    return proc.stdout


def hex_to_sri(sha256_hex):
    """Convert a 64-character hex sha256 string to Nix SRI format."""
    return "sha256-" + base64.b64encode(bytes.fromhex(sha256_hex)).decode("ascii")


def parse_asset(content, asset):
    """Return the version and hex checksum of one tarball listed in SHASUMS256.txt."""
    pattern = re.compile(rf"^(\S+)\s+\./mise-v(\S+)-{re.escape(asset)}\.tar\.gz$")
    matches = [m for m in map(pattern.match, content.splitlines()) if m]
    if len(matches) != 1:
        raise Failure(
            f"SHASUMS256.txt lists {len(matches)} {asset}.tar.gz entries, "
            "expected exactly one; refusing to write an incomplete pin"
        )
    sha256_hex, version = matches[0].groups()
    if not VERSION_PATTERN.match(version):
        raise Failure(f"release version is not a plain version string: {version!r}")
    if not SHA256_HEX_PATTERN.match(sha256_hex):
        raise Failure(f"invalid sha256 hex string for {asset} {version}: {sha256_hex!r}")
    return version, sha256_hex.lower()


def parse_shasums(content):
    """Return the pin for every target tarball listed in SHASUMS256.txt."""
    versions = set()
    systems = {}
    for system, asset in TARGET_ASSETS.items():
        version, sha256_hex = parse_asset(content, asset)
        versions.add(version)
        systems[system] = {"asset": asset, "sha256": sha256_hex, "hash": hex_to_sri(sha256_hex)}
    if len(versions) != 1:
        raise Failure(f"SHASUMS256.txt lists more than one version: {sorted(versions)}")
    return {"version": versions.pop(), "systems": systems}


def version_tuple(version):
    if not isinstance(version, str):
        raise ValueError(f"not a version string: {version!r}")
    return tuple(int(part) for part in version.split("."))


def pinned_version(path):
    """Return the version already pinned at path, or None when unreadable."""
    try:
        with open(path, "r", encoding="utf-8") as f:
            current = json.load(f)
        return current.get("version")
    except Exception:
        return None


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--source-url",
        default=DEFAULT_SOURCE_URL,
        help="URL of the release's SHASUMS256.txt",
    )
    parser.add_argument(
        "--output",
        "-o",
        help="Path to the mise-release.json pin file to write or update",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print the resolved pin JSON to stdout without modifying files",
    )
    args = parser.parse_args(argv)

    try:
        resolved = parse_shasums(fetch(args.source_url))
        out_json = json.dumps(resolved, indent=2) + "\n"

        if args.dry_run or not args.output:
            sys.stdout.write(out_json)
            return 0

        current_version = pinned_version(args.output)
        if current_version is not None:
            try:
                is_newer = version_tuple(resolved["version"]) > version_tuple(current_version)
            except ValueError:
                is_newer = True
            if not is_newer:
                print(
                    f"{args.output} is already up to date at version {current_version} "
                    f"(resolved {resolved['version']} is not newer)"
                )
                return 0

        with open(args.output, "w", encoding="utf-8") as f:
            f.write(out_json)
        print(f"updated {args.output} to version {resolved['version']}")
        return 0

    except (Failure, OSError) as exc:
        print(f"mise-release: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
