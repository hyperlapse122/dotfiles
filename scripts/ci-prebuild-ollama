#!/usr/bin/env bash
set -euo pipefail

runtime="$RUNNER_TEMP/ollama-cuda"
nix build --out-link "$runtime" --impure --argstr target "${1-}" --expr '
  { target }:
  let
    configs = (builtins.getFlake (toString ./.)).nixosConfigurations;
    hosts = if target == "" then builtins.attrValues configs else [ (builtins.getAttr target configs) ];
    usesCuda = host: !host.config.my.bootstrap && host.config.my.cuda.enable;
  in map (host: host.pkgs.ollama-cuda) (builtins.filter usesCuda hosts)
'

# Keep the runtime and free its compiler inputs before building the host closure.
if [[ -L "$runtime" ]]; then
  nix store gc
fi
