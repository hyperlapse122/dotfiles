#!/usr/bin/env python3
"""Install one validated age identity from stdin for the invoking user.

The user-mode counterpart of restore-age-identity, for a non-NixOS host: the
identity lands at ~/.config/nix-config/age/key.txt, owned by the user, in a
0700 directory, and only when it derives the expected public recipient. An
existing identity is replaced atomically or not at all. Nothing read from
stdin is ever printed.
"""

import argparse
import os
import re
import stat
import subprocess
import sys
import tempfile


MAX_IDENTITY_BYTES = 8192
AGE_KEYGEN = "@AGE_KEYGEN@"
RECIPIENT_RE = re.compile(r"^age1[0-9a-z]+$")


def _fail(message):
    print(f"install-user-age-identity: {message}", file=sys.stderr)
    return False


def _private_directory(path):
    """Create *path* and its parents, and verify each is a real directory the user owns."""
    home = os.path.expanduser("~")
    current = home
    for part in os.path.relpath(path, home).split(os.sep):
        current = os.path.join(current, part)
        try:
            info = os.lstat(current)
        except FileNotFoundError:
            os.mkdir(current, 0o700)
            info = os.lstat(current)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            return _fail(f"{current} is not a real directory")
        if info.st_uid != os.getuid():
            return _fail(f"{current} is not owned by the invoking user")
    os.chmod(path, 0o700)
    return True


def _derive_recipient(identity_path):
    try:
        result = subprocess.run(
            [AGE_KEYGEN, "-y", identity_path],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except OSError:
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def install_identity(payload, expected_recipient):
    if not RECIPIENT_RE.fullmatch(expected_recipient):
        return _fail("expected recipient is invalid")
    if not payload or len(payload) > MAX_IDENTITY_BYTES:
        return _fail("identity is empty or too large")
    if b"\x00" in payload:
        return _fail("identity contains NUL bytes")

    target = os.path.expanduser("~/.config/nix-config/age/key.txt")
    parent = os.path.dirname(target)
    try:
        if not _private_directory(parent):
            return False
        if os.path.islink(target):
            return _fail(f"{target} is a symlink; existing identity was preserved")
    except OSError as error:
        return _fail(f"cannot prepare identity directory: {error.strerror}")

    staged_path = None
    try:
        with tempfile.NamedTemporaryFile(mode="wb", dir=parent, prefix=".key-install-", delete=False) as stream:
            staged_path = stream.name
            os.chmod(staged_path, 0o600)
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())

        if _derive_recipient(staged_path) != expected_recipient:
            return _fail("recipient mismatch; existing identity was preserved")

        os.replace(staged_path, target)
        staged_path = None
        return True
    except OSError as error:
        return _fail(f"identity installation failed: {error.strerror}")
    finally:
        if staged_path is not None:
            try:
                os.unlink(staged_path)
            except FileNotFoundError:
                pass


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="install-user-age-identity",
        description="install a validated age identity from stdin for the invoking user",
    )
    parser.add_argument("--recipient", required=True)
    args = parser.parse_args(argv)
    if os.geteuid() == 0:
        _fail("must not run as root; the identity belongs to the invoking user")
        return 2
    payload = sys.stdin.buffer.read(MAX_IDENTITY_BYTES + 1)
    return 0 if install_identity(payload, args.recipient) else 1


if __name__ == "__main__":
    raise SystemExit(main())
