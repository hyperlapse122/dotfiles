#!/usr/bin/env python3
"""Extract the catalog of subagents built into the Claude Code binary on PATH.

The release ships one Bun-compiled executable whose embedded JavaScript holds
each built-in agent as an object literal such as
`{agentType:"Explore",whenToUse:...,disallowedTools:[ft,...l4],source:"built-in",
baseDir:"built-in",...}`. Names inside it are minified and reused across Bun
modules, so each name is resolved inside the module that uses it: from its
single local definition, or through the single module whose `export{}` lists
the imported name. Getters and values computed at runtime are recorded as
conditional rather than guessed. Anything else that cannot be resolved is a
failure, and the output file is left as it was, so an unreadable release never
produces a catalog that describes something other than the binary.

Writes JSON with the binary's embedded version and one entry per agent, sorted
by agent type. System prompts are not extracted.
"""

import argparse
import bisect
import functools
import json
import mmap
import os
import re
import shutil
import sys
import tempfile

MODULE_HEADER = re.compile(rb"// @bun\b")
BUILT_IN_MARKER = re.compile(rb'baseDir:"built-in"')
VERSION_LINE = re.compile(rb"// Version: ([0-9][0-9A-Za-z.+-]*)")
AGENT_START = re.compile(r"\{agentType:")
IMPORT = re.compile(r"import\{([^}]*)\}from\"[^\"]*\"")
EXPORT = re.compile(rb"export\{([^}]*)\}")
IDENT_SOURCE = r"[A-Za-z_$][\w$]*"
IDENT = re.compile(IDENT_SOURCE)
MEMBER = re.compile(rf"({IDENT_SOURCE})\.({IDENT_SOURCE})")
REGEX_PRECEDERS = set("(,=:[!&|?{};+-*%<>~^")
REQUIRED_AGENTS = ("general-purpose", "Explore", "Plan")
FIELDS = ("whenToUse", "tools", "disallowedTools", "model")
CONDITIONAL = {"conditional": True}
MAX_DEPTH = 32


class Failure(Exception):
    """A refusal that should stop the caller with a readable message."""


def skip_string(text, i):
    """Return the index after the quoted string that starts at text[i]."""
    quote = text[i]
    i += 1
    while i < len(text):
        c = text[i]
        if c == "\\":
            i += 2
            continue
        if c == quote:
            return i + 1
        i += 1
    raise Failure("unterminated string literal")


def skip_template(text, i):
    """Return the index after the template literal that starts at text[i]."""
    i += 1
    while i < len(text):
        c = text[i]
        if c == "\\":
            i += 2
            continue
        if c == "`":
            return i + 1
        if c == "$" and text.startswith("${", i):
            i = skip_balanced(text, i + 1)
            continue
        i += 1
    raise Failure("unterminated template literal")


def skip_regex(text, i):
    """Return the index after the regular expression literal at text[i]."""
    i += 1
    in_class = False
    while i < len(text):
        c = text[i]
        if c == "\\":
            i += 2
            continue
        if c == "[":
            in_class = True
        elif c == "]":
            in_class = False
        elif c == "/" and not in_class:
            i += 1
            while i < len(text) and (text[i].isalnum() or text[i] == "$"):
                i += 1
            return i
        elif c == "\n":
            break
        i += 1
    raise Failure("unterminated regular expression literal")


def previous_significant(text, i):
    j = i - 1
    while j >= 0 and text[j].isspace():
        j -= 1
    return text[j] if j >= 0 else ""


def skip_atom(text, i):
    """Skip one string, template, regex, or comment at text[i], or return None."""
    c = text[i]
    if c in "\"'":
        return skip_string(text, i)
    if c == "`":
        return skip_template(text, i)
    if c == "/":
        nxt = text[i + 1] if i + 1 < len(text) else ""
        if nxt == "/":
            end = text.find("\n", i)
            return len(text) if end < 0 else end
        if nxt == "*":
            end = text.find("*/", i + 2)
            if end < 0:
                raise Failure("unterminated comment")
            return end + 2
        prev = previous_significant(text, i)
        if prev == "" or prev in REGEX_PRECEDERS:
            return skip_regex(text, i)
    return None


def skip_balanced(text, i):
    """Return the index after the bracket group that opens at text[i]."""
    closers = {"{": "}", "(": ")", "[": "]"}
    stack = [closers[text[i]]]
    i += 1
    while i < len(text):
        end = skip_atom(text, i)
        if end is not None:
            i = end
            continue
        c = text[i]
        if c in closers:
            stack.append(closers[c])
        elif c in ")]}":
            if c != stack.pop():
                raise Failure("unbalanced brackets")
            if not stack:
                return i + 1
        i += 1
    raise Failure("unterminated bracket group")


def split_top_level(text, start, end, separators):
    """Split text[start:end] at separator characters outside any nesting."""
    parts, i, part_start = [], start, start
    while i < end:
        atom_end = skip_atom(text, i)
        if atom_end is not None:
            i = atom_end
            continue
        c = text[i]
        if c in "{([":
            i = skip_balanced(text, i)
            continue
        if c in separators:
            parts.append(text[part_start:i].strip())
            part_start = i + 1
        i += 1
    tail = text[part_start:end].strip()
    if tail:
        parts.append(tail)
    return parts


def expression_end(text, i):
    """Return the end of the expression starting at text[i] (before , ; or a closer)."""
    while i < len(text):
        atom_end = skip_atom(text, i)
        if atom_end is not None:
            i = atom_end
            continue
        c = text[i]
        if c in "{([":
            i = skip_balanced(text, i)
            continue
        if c in ",;)]}\n":
            return i
        i += 1
    return i


def parse_object(text):
    """Map each top-level key of an object literal to ("value", source) or ("getter", source)."""
    properties = {}
    for part in split_top_level(text, 1, len(text) - 1, ","):
        if part.startswith("..."):
            # A spread could supply any field, so the object cannot be read
            # field by field.
            raise Failure(f"spread in object literal: {part[:40]!r}")
        match = re.match(rf"(get|set)\s+({IDENT_SOURCE})\s*\(", part)
        if match:
            properties[match.group(2)] = ("getter", part)
            continue
        match = re.match(rf"({IDENT_SOURCE}|\"[^\"]*\")\s*:", part)
        if match:
            key = match.group(1).strip('"')
            properties[key] = ("value", part[match.end():].strip())
            continue
        match = re.match(rf"(async\s+)?({IDENT_SOURCE})\s*\(", part)
        if match:
            properties[match.group(2)] = ("method", part)
            continue
        raise Failure(f"unrecognized object member {part[:40]!r}")
    return properties


class Module:
    def __init__(self, data, start, end):
        self.data, self.start, self.end = data, start, end

    @functools.cached_property
    def text(self):
        # latin-1 keeps byte offsets equal to string offsets; strings are
        # re-decoded as UTF-8 when emitted.
        return self.data[self.start:self.end].decode("latin-1")

    @functools.cached_property
    def imports(self):
        imports = {}
        for names in IMPORT.findall(self.text):
            for local, public in specifiers(names, "import"):
                imports.setdefault(local, set()).add(public)
        return imports

    def local_definitions(self, name):
        pattern = re.compile(r"(?<![\w$.])" + re.escape(name) + r"=(?![=>])")
        return [m.end() for m in pattern.finditer(self.text)]


def specifiers(names, kind):
    """Return (local, public) pairs from the inside of an import{} or export{}."""
    pairs = []
    for part in names.split(","):
        part = part.strip()
        if not part:
            continue
        if " as " in part:
            left, right = (p.strip() for p in part.split(" as ", 1))
        else:
            left = right = part
        pairs.append((right, left) if kind == "import" else (left, right))
    return pairs


class Binary:
    def __init__(self, data):
        starts = [m.start() for m in MODULE_HEADER.finditer(data)]
        if not starts:
            raise Failure("no embedded Bun modules found")
        self.starts = starts
        self.modules = [Module(data, s, e) for s, e in zip(starts, starts[1:] + [len(data)])]
        self.exports = {}
        for match in EXPORT.finditer(data):
            index = self.module_at(match.start())
            for local, public in specifiers(match.group(1).decode("latin-1"), "export"):
                self.exports.setdefault(public, []).append((index, local))
        versions = {m.group(1) for m in VERSION_LINE.finditer(data)}
        if len(versions) != 1:
            raise Failure(f"expected one embedded version, found {sorted(v.decode() for v in versions)}")
        self.version = versions.pop().decode("ascii")
        markers = [m.start() for m in BUILT_IN_MARKER.finditer(data)]
        self.built_in_markers = len(markers)
        self.agent_modules = sorted({self.module_at(offset) for offset in markers})
        self._definitions = {}

    def module_at(self, offset):
        return bisect.bisect_right(self.starts, offset) - 1

    def definition(self, index, name, depth=0):
        """Return (module index, expression source) that defines name in module index."""
        key = (index, name)
        if key not in self._definitions:
            self._definitions[key] = self._resolve(index, name, depth)
        return self._definitions[key]

    def _resolve(self, index, name, depth):
        if depth > MAX_DEPTH:
            raise Failure(f"{name}: reference chain too deep")
        module = self.modules[index]
        found = module.local_definitions(name)
        if len(found) > 1:
            raise Failure(f"{name}: defined {len(found)} times in one module")
        if found and name in module.imports:
            # An imported binding cannot be reassigned, so a local assignment
            # belongs to a nested scope and says nothing about the import.
            raise Failure(f"{name}: imported and also assigned locally")
        if found:
            start = found[0]
            return index, module.text[start:expression_end(module.text, start)].strip()
        publics = module.imports.get(name)
        if not publics:
            raise Failure(f"{name}: no definition or import")
        if len(publics) > 1:
            raise Failure(f"{name}: imported under several names")
        public = next(iter(publics))
        owners = self.exports.get(public, [])
        if len(owners) != 1:
            raise Failure(f"{name}: exported by {len(owners)} modules")
        owner, local = owners[0]
        return self.definition(owner, local, depth + 1)


def js_string(source):
    """Decode a JavaScript string literal into text."""
    body = source[1:-1]
    try:
        raw = body.encode("latin-1").decode("utf-8")
    except UnicodeDecodeError as error:
        raise Failure(f"string literal is not UTF-8: {error}")
    out, i = [], 0
    simple = {"n": "\n", "t": "\t", "r": "\r", "b": "\b", "f": "\f", "v": "\v", "0": "\0"}
    while i < len(raw):
        c = raw[i]
        if c != "\\":
            out.append(c)
            i += 1
            continue
        nxt = raw[i + 1]
        if nxt in simple:
            out.append(simple[nxt])
            i += 2
        elif nxt == "u" and raw[i + 2] == "{":
            end = raw.index("}", i)
            out.append(chr(int(raw[i + 3:end], 16)))
            i = end + 1
        elif nxt == "u":
            out.append(chr(int(raw[i + 2:i + 6], 16)))
            i += 6
        elif nxt == "x":
            out.append(chr(int(raw[i + 2:i + 4], 16)))
            i += 4
        elif nxt == "\n":
            i += 2
        else:
            out.append(nxt)
            i += 2
    return "".join(out)


def is_string_literal(source):
    return len(source) >= 2 and source[0] in "\"'" and skip_string(source, 0) == len(source)


def is_template_literal(source):
    return len(source) >= 2 and source[0] == "`" and skip_template(source, 0) == len(source)


def literal_like(source):
    return bool(is_string_literal(source) or is_template_literal(source) or IDENT.fullmatch(source))


class Evaluator:
    def __init__(self, binary):
        self.binary = binary

    def text(self, index, source, depth=0):
        """Resolve source to {"text", "interpolated"} or raise."""
        source = source.strip()
        if is_string_literal(source):
            return {"text": js_string(source), "interpolated": False}
        if is_template_literal(source):
            return {"text": js_string(source), "interpolated": "${" in source}
        if IDENT.fullmatch(source):
            owner, definition = self.binary.definition(index, source, depth)
            return self.text(owner, definition, depth + 1)
        raise Failure(f"not a string: {source[:60]!r}")

    def name(self, index, source):
        value = self.text(index, source)
        if value["interpolated"]:
            raise Failure(f"agent type is interpolated: {source[:60]!r}")
        return value["text"]

    def names(self, index, source, depth=0):
        """Resolve an array of tool names, following identifiers and spreads."""
        source = source.strip()
        if depth > MAX_DEPTH:
            raise Failure("tool list reference chain too deep")
        if IDENT.fullmatch(source):
            owner, definition = self.binary.definition(index, source, depth)
            return self.names(owner, definition, depth + 1)
        if not (source.startswith("[") and skip_balanced(source, 0) == len(source)):
            raise Failure(f"not an array: {source[:60]!r}")
        result = []
        for element in split_top_level(source, 1, len(source) - 1, ","):
            if element.startswith("..."):
                result.extend(self.names(index, element[3:], depth + 1))
            elif is_string_literal(element):
                result.append(js_string(element))
            elif IDENT.fullmatch(element):
                owner, definition = self.binary.definition(index, element, depth)
                if definition.startswith("["):
                    raise Failure(f"{element}: array used as a single tool name")
                result.append(self.name(owner, definition))
            else:
                raise Failure(f"unsupported tool list element {element[:60]!r}")
        return result

    def agent_object(self, index, name):
        owner, definition = self.binary.definition(index, name)
        if not definition.startswith("{agentType:"):
            raise Failure(f"{name}: not an agent definition")
        return owner, parse_object(definition[: skip_balanced(definition, 0)])

    def field(self, index, properties, key):
        """Evaluate one catalog field; None when absent, CONDITIONAL when computed."""
        entry = properties.get(key)
        if entry is None:
            return None
        kind, source = entry
        if kind != "value":
            return CONDITIONAL
        member = MEMBER.fullmatch(source)
        if member:
            owner, referenced = self.agent_object(index, member.group(1))
            return self.field(owner, referenced, member.group(2))
        if key in ("whenToUse", "model") and not literal_like(source):
            return CONDITIONAL
        if key == "whenToUse":
            return self.text(index, source)
        if key == "model":
            return self.name(index, source)
        if source.startswith("[") or IDENT.fullmatch(source):
            return self.names(index, source)
        return CONDITIONAL


def agents(binary):
    evaluator = Evaluator(binary)
    catalog = {}
    for index in binary.agent_modules:
        text = binary.modules[index].text
        for match in AGENT_START.finditer(text):
            start = match.start()
            try:
                literal = text[start: skip_balanced(text, start)]
                properties = parse_object(literal)
            except Failure:
                continue
            if properties.get("source") != ("value", '"built-in"'):
                continue
            if properties.get("baseDir") != ("value", '"built-in"'):
                continue
            _, type_source = properties["agentType"]
            try:
                agent_type = evaluator.name(index, type_source)
            except Failure as error:
                raise Failure(f"agent at module {index}: agentType: {error}")
            if agent_type in catalog:
                raise Failure(f"{agent_type}: defined more than once")
            entry = {"agentType": agent_type}
            for key in FIELDS:
                try:
                    entry[key] = evaluator.field(index, properties, key)
                except Failure as error:
                    raise Failure(f"{agent_type}: {key}: {error}")
            catalog[agent_type] = entry
    # Every built-in agent carries this marker, so a literal the parser skipped
    # or one written in a shape it does not recognize shows up as a shortfall.
    if binary.built_in_markers != len(catalog):
        raise Failure(f"{binary.built_in_markers} built-in agent markers but {len(catalog)} agents parsed")
    missing = [name for name in REQUIRED_AGENTS if name not in catalog]
    if missing:
        raise Failure(f"built-in agents not found: {', '.join(missing)}")
    return [catalog[name] for name in sorted(catalog)]


def binary_path():
    claude = shutil.which("claude")
    if claude is None:
        raise Failure("claude is not on PATH")
    path = os.path.join(os.path.dirname(os.path.realpath(claude)), ".claude-wrapped")
    if not os.path.isfile(path):
        raise Failure(f"{path} does not exist")
    return path


def extract(path):
    with open(path, "rb") as handle:
        with mmap.mmap(handle.fileno(), 0, access=mmap.ACCESS_READ) as data:
            binary = Binary(data)
            return {"version": binary.version, "agents": agents(binary)}


def write_json(path, value):
    directory = os.path.dirname(os.path.abspath(path))
    handle, temporary = tempfile.mkstemp(dir=directory, prefix=".claude-code-agents.")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as out:
            json.dump(value, out, indent=2, ensure_ascii=False)
            out.write("\n")
        os.replace(temporary, path)
    except BaseException:
        os.unlink(temporary)
        raise


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--output", required=True, help="catalog JSON file to write")
    args = parser.parse_args(argv)
    try:
        write_json(args.output, extract(binary_path()))
    except (Failure, OSError) as error:
        print(f"claude-code-agents: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
