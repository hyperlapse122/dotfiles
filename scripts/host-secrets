#!/usr/bin/env bash
# Decrypt and publish a non-NixOS host's CLI credentials and SSH key from the
# user-owned age identity. Home Manager activation runs it in two steps:
#
#   host-secrets stage   before any link changes: check the identity, decrypt
#                        every secret into a private staging directory, and
#                        validate it. Any failure exits non-zero and leaves
#                        nothing behind.
#   host-secrets publish after the links: move the staged tokens to the
#                        state directory, publish gh and glab
#                        configuration from them, and install the SSH key at
#                        the host key path.
#
# Both take --host NAME --tokens FILE --ssh FILE --state-dir DIR --ssh-key PATH
# --github-user U --gitlab-user U --jpi-user U. The identity path comes from
# $HOME, which activation sets to the user's home; DIR is where the tokens are
# published and PATH where the host's SSH private key is installed. Nothing decrypted is ever printed.
set -euo pipefail

tokens=(github_token gitlab_token jpi_token tokscale_token synthetic_api_key exa_api_key openrouter_api_key)
# Tokens no longer declared. publish only moves the names above, so it deletes
# these, or the last decrypted copy would stay in the state directory.
retired=(opencode_api_key)

die() {
  printf 'host-secrets: %s\n' "$*" >&2
  exit 1
}

command=${1:-}
[[ $command == stage || $command == publish ]] ||
  die 'usage: host-secrets stage|publish --host NAME --tokens FILE --ssh FILE --state-dir DIR --ssh-key PATH --github-user U --gitlab-user U --jpi-user U'
shift

host='' tokens_file='' ssh_file='' state='' ssh_key='' github_user='' gitlab_user='' jpi_user=''
while [[ $# -gt 0 ]]; do
  [[ $# -ge 2 ]] || die "missing value for $1"
  case $1 in
    --host) host=$2 ;;
    --tokens) tokens_file=$2 ;;
    --ssh) ssh_file=$2 ;;
    --state-dir) state=$2 ;;
    --ssh-key) ssh_key=$2 ;;
    --github-user) github_user=$2 ;;
    --gitlab-user) gitlab_user=$2 ;;
    --jpi-user) jpi_user=$2 ;;
    *) die "unexpected argument $1" ;;
  esac
  shift 2
done
[[ -n $host && -n $tokens_file && -n $ssh_file && -n $state && -n $ssh_key && -n $github_user && -n $gitlab_user && -n $jpi_user ]] ||
  die 'every option is required'
[[ $(id -u) -ne 0 ]] || die 'must run as the destination user, not root'

key=$HOME/.config/nix-config/age/key.txt
# Staged beside the state directory, so publishing is a rename on one filesystem.
state_parent=$(dirname -- "$state")
stage=$state_parent/.$(basename -- "$state")-stage
ssh_dir=$(dirname -- "$ssh_key")

publish_cli_auth() {
  publish-cli-auth --source "$1" --home "$2" \
    --github-user "$github_user" --gitlab-user "$gitlab_user" --jpi-user "$jpi_user"
}

# A path this script creates or replaces must never be a symlink someone
# planted to redirect the write.
refuse_symlink() {
  for path in "$@"; do
    [[ ! -L $path ]] || die "$path is a symlink; refusing to write through it"
  done
}

stage_secrets() {
  local recover="recover it with scripts/recover-age-identity --user --host $host, then apply the production output again"
  [[ ! -L $key && -f $key ]] || die "no age identity at $key; $recover"
  [[ $(stat -c %u -- "$key") == "$(id -u)" ]] || die "$key is not owned by $(id -un); $recover"
  [[ $(stat -c %a -- "$key") == 600 ]] || die "$key must have mode 0600; $recover"

  refuse_symlink "$state_parent" "$stage"
  mkdir -p -- "$state_parent"
  rm -rf -- "$stage"
  (umask 077 && mkdir -- "$stage")
  trap 'rm -rf -- "$stage"' EXIT

  local name
  for name in "${tokens[@]}"; do
    (umask 077 && SOPS_AGE_KEY_FILE=$key sops --decrypt --extract "[\"$name\"]" -- "$tokens_file" \
      >"$stage/$name") 2>/dev/null ||
      die "cannot decrypt $name with $key; it is not this host's identity, or the host is not a recipient of $tokens_file"
  done
  (umask 077 && SOPS_AGE_KEY_FILE=$key sops --decrypt --extract '["ssh_private_key"]' -- "$ssh_file" \
    >"$stage/ssh_key") 2>/dev/null ||
    die "cannot decrypt the host SSH key with $key; it is not this host's identity, or the host is not a recipient of $ssh_file"

  # Publishing into a scratch home inside the stage validates the tokens
  # exactly as the real publication will, before any link changes.
  mkdir -- "$stage/home"
  publish_cli_auth "$stage" "$stage/home" >/dev/null 2>&1 || die 'the decrypted tokens failed validation'
  rm -rf -- "${stage:?}/home"
  ssh-keygen -y -f "$stage/ssh_key" >/dev/null 2>&1 || die 'the decrypted SSH key is not a valid private key'

  trap - EXIT
}

publish_secrets() {
  [[ ! -L $stage && -d $stage ]] || die "nothing staged at $stage; run host-secrets stage first"
  trap 'rm -rf -- "$stage"' EXIT

  refuse_symlink "$state" "$ssh_dir" "$ssh_key"
  mkdir -p -- "$state"
  chmod 700 -- "$state"
  local name
  for name in "${tokens[@]}"; do
    chmod 400 -- "$stage/$name"
    mv -f -- "$stage/$name" "$state/$name"
  done
  for name in "${retired[@]}"; do
    rm -f -- "${state:?}/$name"
  done
  publish_cli_auth "$state" "$HOME" || die 'publishing gh and glab configuration failed'

  mkdir -p -- "$ssh_dir"
  chmod 700 -- "$ssh_dir"
  chmod 600 -- "$stage/ssh_key"
  mv -f -- "$stage/ssh_key" "$ssh_key"
}

case $command in
  stage) stage_secrets ;;
  publish) publish_secrets ;;
esac
