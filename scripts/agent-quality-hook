#!/usr/bin/env python3
"""Apply the shared quality checks to native harness hook input."""
from contextlib import ExitStack, redirect_stdout
from io import StringIO
from itertools import groupby
import json
import os
from pathlib import Path
import re
import runpy
import shlex
import stat
import sys

# pygit2 initializes OpenSSL even when it only opens a local checkout.
os.environ["SSL_CERT_FILE"] = "@caBundle@"
import pygit2

INSPECTOR = '@inspector@'
MAX_SOURCE_BYTES = 1024 * 1024
SHELL_TOOLS = {'bash', 'shell', 'exec_command', 'shell_command'}
EDIT_TOOLS = {'edit', 'write', 'multiedit', 'apply_patch', 'patch'}
PATCH_PATH = re.compile(r'^\*\*\* (?:Add File:|Update File:|Delete File:|Move to:)\s+(.+)$')
TEST_NAME = re.compile(r'(?i:^test_|(?:_test|\.test|\.spec)\.[^.]+$)|Tests?\.swift$')
ASSIGNMENT = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*=')


def open_checkout(cwd):
    git_dir = pygit2.discover_repository(str(cwd))
    if git_dir:
        repo = pygit2.Repository(git_dir)
        if repo.workdir:
            root = Path(repo.workdir).resolve()
            if cwd.resolve().is_relative_to(root):
                return root, repo
    return None, None


def skips_hooks(command):
    lexer = shlex.shlex(command.replace('\\\n', ''), posix=True, punctuation_chars=';&|()\n')
    lexer.whitespace = ' \t\r'
    lexer.whitespace_split = True
    lexer.commenters = '#'
    try:
        words = list(lexer)
    except ValueError:
        return False

    for separator, segment in groupby(words, lambda word: bool(re.fullmatch(r'[;&|()\n]+', word))):
        if separator:
            continue
        args = iter(segment)
        skip = False
        for arg in args:
            if arg in {'env', 'command', 'exec', 'then', 'do', 'else', '!'}:
                continue
            if not ASSIGNMENT.match(arg):
                break
            skip |= arg.startswith('SKIP=')
        else:
            continue
        if Path(arg).name != 'git':
            continue
        for arg in args:
            if arg in {'-C', '-c', '--git-dir', '--work-tree', '--namespace', '--config-env'}:
                next(args, None)
            elif not arg.startswith('-'):
                break
        else:
            continue
        if arg != 'commit':
            continue
        if skip:
            return True
        for arg in args:
            if arg == '--':
                break
            if arg == '--no-verify':
                return True
            if arg in {'--message', '--file', '--author', '--date', '--reuse-message',
                       '--reedit-message', '--fixup', '--squash', '--template',
                       '--trailer', '--pathspec-from-file'}:
                next(args, None)
            elif arg.startswith('-') and not arg.startswith('--'):
                for index, flag in enumerate(arg[1:], 1):
                    if flag == 'n':
                        return True
                    if flag == 'u':
                        break  # -u accepts an optional attached mode.
                    if flag in 'mFCctS':
                        if index == len(arg) - 1 and flag != 'S':
                            next(args, None)
                        break
    return False


def edit_paths(tool, inputs):
    if tool in {'apply_patch', 'patch'}:
        patch = inputs.get('patch') or inputs.get('patchText') or inputs.get('command')
        if isinstance(patch, str):
            for line in patch.splitlines():
                if matched := PATCH_PATH.match(line):
                    yield matched[1]
    else:
        path = inputs.get('file_path') or inputs.get('path') or inputs.get('filePath')
        if isinstance(path, str) and path:
            yield path


def frozen_path(cwd, paths):
    root, _ = open_checkout(cwd)
    for path in paths:
        absolute = cwd / path
        targets = {Path(os.path.abspath(absolute)), absolute.resolve()}
        for target in targets:
            directory = target.parent
            while not directory.is_dir():
                directory = directory.parent
            nested, _ = open_checkout(directory)
            for project in {root, nested} - {None}:
                if target.is_relative_to(project) and (project / '.agents/freeze-tests').is_file():
                    parts = target.relative_to(project).parts
                    if any(part.casefold() in {'test', 'tests', '__tests__', 'spec', 'specs'}
                           for part in parts[:-1]) or TEST_NAME.search(target.name):
                        return path


def scan_edits(root, cwd, paths):
    inspector = runpy.run_path(INSPECTOR)
    warnings = StringIO()
    with redirect_stdout(warnings):
        for path in dict.fromkeys(paths):
            absolute = Path(os.path.abspath(cwd / path))
            if absolute == root or not absolute.is_relative_to(root):
                continue
            relative = str(absolute.relative_to(root))
            rules = inspector['rules_for'](relative)
            if not rules:
                continue
            try:
                with ExitStack() as opened:
                    # Hold each directory open so a concurrent symlink swap
                    # cannot redirect the scanner outside the checkout.
                    directory = os.open('/', os.O_DIRECTORY)
                    opened.callback(os.close, directory)
                    for component in absolute.parts[1:-1]:
                        directory = os.open(component, os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
                        opened.callback(os.close, directory)
                    fd = os.open(absolute.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
                    with os.fdopen(fd, 'rb') as source:
                        metadata = os.fstat(fd)
                        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
                            continue
                        content = source.read(MAX_SOURCE_BYTES + 1)
                    if len(content) <= MAX_SOURCE_BYTES:
                        inspector['warn'](relative, content.decode(errors='replace'), rules)
            except OSError:
                continue
    return '\n'.join(warnings.getvalue().splitlines()[:50])


def feedback(options, phase, payload):
    tool = (payload.get('tool_name') or '').lower()
    inputs = payload.get('tool_input') or {}
    if phase == 'pre' and options['preShell'] and tool in SHELL_TOOLS:
        command = inputs.get('command')
        if isinstance(command, str) and skips_hooks(command):
            return 'Run git commit with its pre-commit hooks enabled. Remove the bypass flag or SKIP assignment.'
    directory = payload.get('cwd')
    if not isinstance(directory, str) or not os.path.isabs(directory):
        return None
    cwd = Path(directory)
    if phase == 'pre' and options['freezeTests'] and tool in EDIT_TOOLS:
        path = frozen_path(cwd, edit_paths(tool, inputs))
        if path:
            return f'Test files are frozen by .agents/freeze-tests. Leave {path!r} untouched.'
    post = phase == 'post' and options['postEdit'] and tool in EDIT_TOOLS
    stop = phase == 'stop' and options['stop'] and not payload.get('stop_hook_active')
    if options['trustedProjects'] and (post or stop):
        root, repo = open_checkout(cwd)
        if root is not None and str(root) in options['trustedProjects']:
            if post:
                return scan_edits(root, cwd.resolve(), edit_paths(tool, inputs))
            # libgit2 status does not execute external filters or fsmonitor hooks.
            if repo.status(untracked_files='normal'):
                return ('Run agent-check from the project root using your shell tool before finishing. '
                        'Use your current session permissions and report if the check cannot run.')
    return None


def main():
    spec, harness, phase = sys.argv[1:]
    options = json.loads(Path(spec).read_text())
    try:
        reason = feedback(options, phase, json.load(sys.stdin))
    except (OSError, ValueError, RuntimeError, pygit2.GitError):
        return
    if not reason:
        return
    if phase == 'post':
        if harness in {'claude', 'codex'}:
            print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PostToolUse', 'additionalContext': reason}}))
        else:
            print(reason)
    else:
        print(reason, file=sys.stderr if harness in {'claude', 'codex'} else sys.stdout)
        sys.exit(2)


if __name__ == '__main__':
    main()
