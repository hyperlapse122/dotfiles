{
  pkgs,
  self,
}:
let
  inherit (pkgs) lib;
  configurations = import ./lib/configurations.nix { inherit pkgs self; };
  roots = [
    ".claude/skills"
    ".codex/skills"
    ".pi/agent/skills"
    ".config/opencode/skills"
  ];
  homes = map (entry: entry.user.home-files or null) configurations.userEntries;
in
pkgs.runCommand "official-skills-tests" { nativeBuildInputs = [ pkgs.python3 ]; } ''
  ${configurations.guard}
  ${lib.optionalString (lib.any (home: home == null) homes) ''
    echo 'a configured user has no materialized home-files' >&2
    exit 1
  ''}
  python - ${
    lib.concatMapStringsSep " " (home: lib.escapeShellArg (toString home)) (
      lib.filter (home: home != null) homes
    )
  } <<'PY'
  import pathlib
  import re
  import sys
  from urllib.parse import unquote, urlsplit

  roots = ${builtins.toJSON roots}
  representatives = {
      "service-lenses": ("redis-core", "references/choose-data-structure.md", "Redis"),
      "platform-lenses": ("aws-storage", "references/s3-general-purpose-knowledge.md", "AWS"),
      "toolchain-lenses": ("gradle-best-practices", "references/detection.md", "Gradle"),
  }
  for home in map(pathlib.Path, sys.argv[1:]):
      for root in roots:
          for group, (name, asset, publisher) in representatives.items():
              directory = home / root / group
              entry = directory / "SKILL.md"
              assert entry.is_file() and not entry.is_symlink(), entry
              index = entry.read_text()
              assert f"name: {group}\n" in index, entry
              assert f"references/{name}/guide.md" in index and publisher in index, entry
              reference = directory / "references" / name
              assert (reference / "guide.md").is_file(), reference
              assert (reference / asset).is_file(), reference / asset
              assert (reference / "LICENSE").is_file(), reference
              nested = list((directory / "references").rglob("SKILL.md"))
              assert not nested, nested
              for guide in (directory / "references").glob("*/guide.md"):
                  assert any(p.is_file() for p in guide.parent.glob("LICENSE*")), guide
              for guide in (directory / "references").rglob("*.md"):
                  content = guide.read_text()
                  assert not re.search(r"\bnpx\s+(?:-y\s+)?skills(?:@\S+)?\s+(?:add|update|remove)\b", content), guide
                  for target in re.findall(r"\]\(([^ )]+)", content):
                      parsed = urlsplit(target)
                      path = unquote(parsed.path)
                      if not path or parsed.scheme or path.startswith("/"):
                          continue
                      # This is an example generated by the CLI, not a bundled asset.
                      if "playwright-cli" in guide.parts and (
                          path.startswith(".playwright-cli/") or path == "./settings-after.png"
                      ):
                          continue
                      assert (guide.parent / path).exists(), (guide, target)
  PY
  touch "$out"
''
