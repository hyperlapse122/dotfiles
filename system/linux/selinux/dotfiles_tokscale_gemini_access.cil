; ============================================================================
; dotfiles_tokscale_gemini_access.cil
; SELinux Policy Module granting tokscale write access to Antigravity's config
;
; WHY THIS IS A SEPARATE MODULE. dotfiles_protected_agent_configs.cil states one
; writer rule per protected type: ~/.gemini belongs to chezmoi and agy. tokscale
; is a third-party token-usage meter, not a harness, so its exception is kept
; out of that module's writer table. Installing this module IS the record of the
; exception, and removing it revokes the access with no edit to the base policy.
;
; WHAT tokscale ACTUALLY NEEDS. It opens Antigravity's SQLite conversation store
; at ~/.gemini/antigravity-cli/conversations/<uuid>.db to meter token usage. The
; audit log shows writes to the `.db-wal` and `.db-shm` sidecars and to the
; containing directory: SQLite in WAL mode requires all three even when the
; caller only reads rows. So "write" here is the price of READING that database,
; not of changing Antigravity's configuration.
;
; SCOPE THIS GRANT DELIBERATELY WIDENS. gemini_config_t covers all of ~/.gemini,
; so this module also lets tokscale write ~/.gemini/config/mcp_config.json — an
; MCP server definition, and therefore a code-execution surface. Narrowing it
; would take a separate type for the conversations subtree; until that exists,
; the trust placed in tokscale is the trust placed in that file.
;
; DEPENDENCY ON THE BASE MODULE. gemini_config_t, dotfiles_agent_domain and
; dotfiles_agent_exec are declared in dotfiles_protected_agent_configs.cil.
; semodule links every module in the store into one policy, so the references
; resolve as long as both are installed, and the apply script installs them in
; glob order where 'p' sorts before 't'. Reusing the two attributes is
; deliberate: they carry the base-policy privileges that keep a domain as
; capable as unconfined_t was, and a private copy here would drift from the
; original the first time that list changes.
;
; THE EXEC CHAIN. ~/.local/bin/tokscale is a symlink to a chezmoi-deployed bash
; wrapper in the command store; the wrapper execs `mise exec`, which runs node,
; which execs the real ELF under the mise npm install. The ELF is the process
; the audit log names, so it is the entrypoint that must carry the label; the
; wrapper carries it too, so the domain is entered at the top of the chain
; whichever way tokscale is invoked. Once in tokscale_t the rest of the chain
; stays there: mise and node are ordinary binaries with no transition of their
; own, and re-execing the labelled ELF from tokscale_t resolves to tokscale_t
; again.
;
; LABEL DURABILITY ACROSS UPGRADES. Neither path is stable: the command store is
; keyed by content hash and the mise tree by version, so an upgrade writes the
; binary to a directory that has never been relabelled, and a file inherits its
; parent's type. A version-agnostic filecon alone would leave the replacement
; unlabelled until the next restorecon — which only runs when the POLICY
; changes, not when tokscale does — and tokscale would silently fall back to
; unconfined_t, reinstating the exact denial this module removes. The named file
; transitions below label the replacement at creation time instead.
; ============================================================================

; --- Domain and entrypoint --------------------------------------------------
(type tokscale_t)
(type tokscale_exec_t)
(roletype unconfined_r tokscale_t)
(roletype object_r tokscale_exec_t)

; Join the base module's two attributes: dotfiles_agent_domain carries the
; unconfined privilege set (including unconfined_domain_type, which is what
; grants read access to the other protected types), and dotfiles_agent_exec
; carries file_type/exec_type plus the execute-and-transition allow.
(typeattributeset dotfiles_agent_domain (tokscale_t))
(typeattributeset dotfiles_agent_exec (tokscale_exec_t))

(typetransition unconfined_domain_type tokscale_exec_t process tokscale_t)
(allow tokscale_t tokscale_exec_t (file (entrypoint read getattr execute open map)))

; --- The exception itself ---------------------------------------------------
; tokscale writes Antigravity's tree and nothing else's. It declares no rule for
; claude_config_t or protected_agent_config_t, so those remain read-only to it
; through the base module's grant to unconfined_domain_type. No execute or
; relabel permission: a metering tool neither runs nor retypes what it reads.
(allow tokscale_t gemini_config_t (file (create read write getattr setattr unlink rename open append lock map ioctl link watch watch_reads)))
(allow tokscale_t gemini_config_t (dir (create read write getattr setattr unlink rename open search add_name remove_name reparent rmdir lock ioctl watch watch_reads)))
(allow tokscale_t gemini_config_t (lnk_file (create read getattr setattr unlink rename)))

; --- Label durability across upgrades ---------------------------------------
; Only chezmoi_t creates these, and only under the two home types that hold the
; command store (~/.local/lib) and the mise install root (~/.local/share), so
; the transition cannot capture an arbitrary file that merely shares the name.
(typetransition chezmoi_t gconf_home_t file "tokscale" tokscale_exec_t)
(typetransition chezmoi_t data_home_t file "tokscale" tokscale_exec_t)

; --- File Context Specifications (filecon) ----------------------------------
; The command store keys its directory by content hash and mise by version, so
; both specs match any generation rather than the one installed today.
(filecon "HOME_DIR/\.local/lib/commands/store/tokscale/[^/]+/tokscale" file (unconfined_u object_r tokscale_exec_t ((s0)(s0))))
(filecon "HOME_DIR/\.local/bin/tokscale" file (unconfined_u object_r tokscale_exec_t ((s0)(s0))))
(filecon "HOME_DIR/\.local/share/mise/installs/npm-tokscale/.*/tokscale" file (unconfined_u object_r tokscale_exec_t ((s0)(s0))))
