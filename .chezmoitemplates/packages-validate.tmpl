{{- /* Package authority v2: schema, gate, source trust, architecture and ownership validation. */ -}}
{{- if not (hasKey . "ctx") -}}{{- fail "packages-validate.tmpl: missing ctx" -}}{{- end -}}
{{- $ctx := .ctx -}}
{{- $packages := $ctx.packages -}}
{{- if ne ($packages.schemaVersion | toString) "2" -}}{{- fail "packages.yaml: packages.schemaVersion must be 2" -}}{{- end -}}
{{- if not (hasKey $packages "authority") -}}{{- fail "packages.yaml: packages.authority is required" -}}{{- end -}}
{{- $authority := $packages.authority -}}
{{- $authorityKeys := list "supportedArchitectures" "releaseGates" "sources" "capabilities" -}}
{{- range $key := keys $authority -}}{{- if not (has $key $authorityKeys) -}}{{- fail (printf "packages.yaml: unknown authority field %q" $key) -}}{{- end -}}{{- end -}}
{{- range $required := $authorityKeys -}}{{- if not (hasKey $authority $required) -}}{{- fail (printf "packages.yaml: authority.%s is required" $required) -}}{{- end -}}{{- end -}}
{{- $expectedArchitectures := dict "fedora" (list "amd64" "arm64") "macos" (list "arm64") -}}
{{- range $platform := list "fedora" "macos" -}}
{{-   if not (hasKey $authority.supportedArchitectures $platform) -}}{{- fail (printf "packages.yaml: supportedArchitectures.%s is required" $platform) -}}{{- end -}}
{{-   $declared := index $authority.supportedArchitectures $platform -}}
{{-   range $arch := index $expectedArchitectures $platform -}}{{- if not (has $arch $declared) -}}{{- fail (printf "packages.yaml: supportedArchitectures.%s is missing %s" $platform $arch) -}}{{- end -}}{{- end -}}
{{-   range $arch := $declared -}}{{- if not (has $arch (index $expectedArchitectures $platform)) -}}{{- fail (printf "packages.yaml: unsupported architecture %s.%s" $platform $arch) -}}{{- end -}}{{- end -}}
{{- end -}}
{{- $canonicalOrigins := dict "fedora" "https://mirrors.fedoraproject.org/metalink" "onePassword" "https://downloads.1password.com/linux/rpm/stable/$basearch" "vscodium" "https://paulcarroty.gitlab.io/vscodium-deb-rpm-repo/rpms/" "googleChrome" "https://dl.google.com/linux/chrome/rpm/stable/x86_64" "cider" "https://repo.cider.sh/rpm/RPMS" "microsoftEdge" "https://packages.microsoft.com/yumrepos/edge" "flathub" "https://dl.flathub.org/repo/flathub.flatpakrepo" "homebrewCore" "https://github.com/Homebrew/homebrew-core.git" "homebrewCask" "https://github.com/Homebrew/homebrew-cask.git" -}}
{{- $sources := dict -}}
{{- range $source := $authority.sources -}}
{{-   range $required := list "name" "backend" "origin" "trusted" -}}{{- if not (hasKey $source $required) -}}{{- fail (printf "packages.yaml: source is missing %s" $required) -}}{{- end -}}{{- end -}}
{{-   range $key := keys $source -}}{{- if not (has $key (list "name" "backend" "sourceType" "origin" "trusted")) -}}{{- fail (printf "packages.yaml: source %v has unsafe/unknown field %q" $source.name $key) -}}{{- end -}}{{- end -}}
{{-   if not (regexMatch "^[A-Za-z][A-Za-z0-9]*$" $source.name) -}}{{- fail (printf "packages.yaml: unsafe source name %q" $source.name) -}}{{- end -}}
{{-   if hasKey $sources $source.name -}}{{- fail (printf "packages.yaml: duplicate source %q" $source.name) -}}{{- end -}}
{{-   if not (has $source.backend (list "dnf" "flatpak" "homebrew")) -}}{{- fail (printf "packages.yaml: source %s has unsupported backend %q" $source.name $source.backend) -}}{{- end -}}
{{-   if not (hasKey $canonicalOrigins $source.name) -}}{{- fail (printf "packages.yaml: undeclared third-party source %q" $source.name) -}}{{- end -}}
{{-   if ne $source.origin (index $canonicalOrigins $source.name) -}}{{- fail (printf "packages.yaml: canonical origin mismatch for %s: got %q" $source.name $source.origin) -}}{{- end -}}
{{-   if not $source.trusted -}}{{- fail (printf "packages.yaml: source %s is not trusted" $source.name) -}}{{- end -}}
{{-   if not (regexMatch "^https://[^[:space:];|&]+$" $source.origin) -}}{{- fail (printf "packages.yaml: source %s has unsafe origin %q" $source.name $source.origin) -}}{{- end -}}
{{-   $_ := set $sources $source.name $source -}}
{{- end -}}
{{- $capabilities := dict -}}{{- $owners := dict -}}{{- $gates := list -}}{{- $g0Unresolved := 0 -}}
{{- range $capability := $authority.capabilities -}}
{{-   range $key := keys $capability -}}{{- if not (has $key (list "id" "sentinel" "bootstrap" "gateClosing" "legacyGroup" "gate" "integrity" "fedora" "macos")) -}}{{- fail (printf "packages.yaml: capability %v has unsafe/unknown field %q" $capability.id $key) -}}{{- end -}}{{- end -}}
{{-   if or (not (hasKey $capability "id")) (not (regexMatch "^[A-Za-z][A-Za-z0-9]*$" $capability.id)) -}}{{- fail "packages.yaml: every capability requires a safe camelCase id" -}}{{- end -}}
{{-   if hasKey $capabilities $capability.id -}}{{- fail (printf "packages.yaml: duplicate capability %q" $capability.id) -}}{{- end -}}{{- $_ := set $capabilities $capability.id true -}}
{{-   if and (hasKey $capability "sentinel") (not (regexMatch "^[A-Za-z0-9][A-Za-z0-9._+-]*$" $capability.sentinel)) -}}{{- fail (printf "packages.yaml: capability %s has unsafe PATH sentinel %q" $capability.id $capability.sentinel) -}}{{- end -}}
{{-   if hasKey $capability "gate" -}}{{- $gates = append $gates $capability.gate -}}{{- if or (not (hasKey $capability "legacyGroup")) (not (hasKey $packages.linux.fedora.gates $capability.legacyGroup)) -}}{{- fail (printf "packages.yaml: capability %s has unknown legacy gate group" $capability.id) -}}{{- end -}}{{- if ne $capability.gate (index $packages.linux.fedora.gates $capability.legacyGroup) -}}{{- fail (printf "packages.yaml: capability %s gate mismatch" $capability.id) -}}{{- end -}}{{- else if hasKey $capability "legacyGroup" -}}{{- fail (printf "packages.yaml: capability %s has legacyGroup without gate" $capability.id) -}}{{- end -}}
{{-   range $platform := list "fedora" "macos" -}}
{{-     if not (hasKey $capability $platform) -}}{{- fail (printf "packages.yaml: capability %s is missing %s disposition" $capability.id $platform) -}}{{- end -}}
{{-     $delivery := index $capability $platform -}}
{{-     range $key := keys $delivery -}}{{- if not (has $key (list "disposition" "owner" "identifier" "source" "kind" "scope" "elevation" "greedy" "version" "emulation" "architectures" "reason" "integrity" "manual")) -}}{{- fail (printf "packages.yaml: capability %s.%s has unsafe/unknown field %q" $capability.id $platform $key) -}}{{- end -}}{{- end -}}
{{-     if not (hasKey $delivery "disposition") -}}{{- fail (printf "packages.yaml: capability %s.%s is missing disposition" $capability.id $platform) -}}{{- end -}}
{{-     if not (has $delivery.disposition (list "managed" "manual" "notApplicable" "unresolved")) -}}{{- fail (printf "packages.yaml: capability %s.%s has unsupported disposition %q" $capability.id $platform $delivery.disposition) -}}{{- end -}}
{{-     if not (hasKey $delivery "architectures") -}}{{- fail (printf "packages.yaml: capability %s.%s is missing architectures" $capability.id $platform) -}}{{- end -}}
{{-     $expected := index $expectedArchitectures $platform -}}
{{-     range $arch := $expected -}}
{{-       if not (hasKey $delivery.architectures $arch) -}}{{- fail (printf "packages.yaml: capability %s.%s is missing architecture %s" $capability.id $platform $arch) -}}{{- end -}}
{{-       $state := index $delivery.architectures $arch -}}
{{-       if not (has $state (list "native" "emulated" "manual" "notApplicable" "unresolved")) -}}{{- fail (printf "packages.yaml: capability %s.%s.%s has unsupported architecture state %q" $capability.id $platform $arch $state) -}}{{- end -}}
{{-       if eq $state "emulated" -}}{{- fail "packages.yaml: emulation is no longer supported (Windows dropped)" -}}{{- end -}}
{{-       if and (hasKey $capability "bootstrap") $capability.bootstrap (ne $state "native") (ne $state "emulated") -}}{{- fail (printf "packages.yaml: bootstrap capability %s unavailable on %s.%s" $capability.id $platform $arch) -}}{{- end -}}
{{-       if and (hasKey $capability "gateClosing") (eq $capability.gateClosing "g0") (eq $state "unresolved") -}}{{- $g0Unresolved = add1 $g0Unresolved -}}{{- end -}}
{{-     end -}}
{{-     range $arch := keys $delivery.architectures -}}{{- if not (has $arch $expected) -}}{{- fail (printf "packages.yaml: capability %s.%s declares unsupported architecture %s" $capability.id $platform $arch) -}}{{- end -}}{{- end -}}
{{-     if eq $delivery.disposition "managed" -}}
{{-       range $required := list "owner" "identifier" -}}{{- if not (hasKey $delivery $required) -}}{{- fail (printf "packages.yaml: managed capability %s.%s is missing %s" $capability.id $platform $required) -}}{{- end -}}{{- end -}}
{{-       if not (regexMatch "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$" $delivery.identifier) -}}{{- fail (printf "packages.yaml: capability %s.%s has unsupported identifier %q" $capability.id $platform $delivery.identifier) -}}{{- end -}}
{{-       $ownerKey := printf "%s:%s:%s" $platform $delivery.owner (lower $delivery.identifier) -}}{{- if hasKey $owners $ownerKey -}}{{- fail (printf "packages.yaml: duplicate owner/source %s" $ownerKey) -}}{{- end -}}{{- $_ := set $owners $ownerKey $capability.id -}}
{{-       if eq $platform "macos" -}}
{{-         if not (has $delivery.owner (list "homebrew" "external" "releaseLock" "mise")) -}}{{- fail (printf "packages.yaml: unsupported macOS owner %q" $delivery.owner) -}}{{- end -}}
{{-         if eq $delivery.owner "homebrew" -}}{{- range $required := list "kind" "source" "elevation" "greedy" -}}{{- if not (hasKey $delivery $required) -}}{{- fail (printf "packages.yaml: Homebrew capability %s is missing %s" $capability.id $required) -}}{{- end -}}{{- end -}}{{- if not (has $delivery.kind (list "tap" "formula" "cask")) -}}{{- fail (printf "packages.yaml: Homebrew capability %s has unsupported kind" $capability.id) -}}{{- end -}}{{- if or (not (hasKey $sources $delivery.source)) (ne (index $sources $delivery.source).backend "homebrew") -}}{{- fail (printf "packages.yaml: Homebrew capability %s uses an untrusted tap" $capability.id) -}}{{- end -}}{{- if not (has $delivery.elevation (list "none" "sudo" "appManagement")) -}}{{- fail (printf "packages.yaml: Homebrew capability %s has unsafe elevation" $capability.id) -}}{{- end -}}{{- end -}}
{{-       else -}}{{- if not (has $delivery.owner (list "dnf" "flatpak" "dotnet" "directRpm" "external" "releaseLock" "mise")) -}}{{- fail (printf "packages.yaml: unsupported Fedora owner %q" $delivery.owner) -}}{{- end -}}{{- if has $delivery.owner (list "dnf" "flatpak") -}}{{- if or (not (hasKey $delivery "source")) (not (hasKey $sources $delivery.source)) -}}{{- fail (printf "packages.yaml: Fedora capability %s has missing source" $capability.id) -}}{{- end -}}{{- end -}}{{- end -}}
{{-       if has $delivery.owner (list "external" "releaseLock") -}}{{- if or (not (hasKey $capability "integrity")) (ne $capability.integrity "checksum") -}}{{- fail (printf "packages.yaml: direct distribution %s omits checksum integrity" $capability.id) -}}{{- end -}}{{- end -}}
{{-       if eq $delivery.owner "directRpm" -}}{{- if or (not (hasKey $delivery "integrity")) (ne $delivery.integrity "signature") -}}{{- fail (printf "packages.yaml: direct RPM %s omits signature integrity" $capability.id) -}}{{- end -}}{{- end -}}
{{-     else -}}{{- if not (hasKey $delivery "reason") -}}{{- fail (printf "packages.yaml: capability %s.%s disposition %s requires reason" $capability.id $platform $delivery.disposition) -}}{{- end -}}{{- end -}}
{{-   end -}}
{{- end -}}
{{- includeTemplate "facts-validate.tmpl" (dict "ctx" $ctx "source" ".chezmoidata/packages.yaml (authority.capabilities[].gate)" "gates" $gates) -}}
{{- $g0 := $authority.releaseGates.g0 -}}{{- if not (has $g0 (list "open" "closed")) -}}{{- fail "packages.yaml: releaseGates.g0 must be open or closed" -}}{{- end -}}{{- if and (eq $g0 "open") (gt $g0Unresolved 0) -}}{{- fail "packages.yaml: G0 is open while gate-closing architectures remain unresolved" -}}{{- end -}}{{- if and (eq $g0 "closed") (eq $g0Unresolved 0) -}}{{- fail "packages.yaml: G0 is closed but no gate-closing architecture remains unresolved" -}}{{- end -}}
