{{- /* Validate and resolve the shared compound-engineering archive authority.

       The repo interleaves several tag trains (marketplace-*, cursor-marketplace-*,
       cli-*), so the release lock filters for compound-engineering-* at refresh.
       Every consumer validates the neutral marketplace row before reading that
       resolved tag. The row is platform-neutral even though its `os` list gates
       only the generic Claude/Codex installer.

       The extracted archive path is
       ~/.local/share/compound-engineering/v<semver>/ on every OS:
         - .chezmoiexternals/ai-agents.toml emits one archive external.
         - the 00-tools scripts prune versions and install overlays on POSIX.
         - install-agent-plugins registers the path with Claude and Codex.
         - both omp updater variants register the same path with omp.
    */ -}}
{{- $name := "compound-engineering-plugin" -}}
{{- if not (hasKey .agents.marketplaces $name) -}}
{{-   fail (printf "compound-engineering: authority %q is missing from agents.marketplaces" $name) -}}
{{- end -}}
{{- $authority := index .agents.marketplaces $name -}}
{{- range $field := (list "kind" "source" "externalPath" "versionSource") -}}
{{-   if not (hasKey $authority $field) -}}
{{-     fail (printf "compound-engineering: authority %q is missing %q" $name $field) -}}
{{-   end -}}
{{- end -}}
{{- if ne (printf "%v" (index $authority "kind")) "localArchive" -}}
{{-   fail (printf "compound-engineering: authority %q must use kind localArchive" $name) -}}
{{- end -}}
{{- $source := printf "%v" (index $authority "source") -}}
{{- if not (regexMatch "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" $source) -}}
{{-   fail (printf "compound-engineering: authority %q has unsafe source %q" $name $source) -}}
{{- end -}}
{{- $path := printf "%v" (index $authority "externalPath") -}}
{{- if or (not (regexMatch "^[A-Za-z0-9_./-]+$" $path)) (hasPrefix "/" $path) (regexMatch "(^|/)\\.\\.(/|$)" $path) -}}
{{-   fail (printf "compound-engineering: authority %q has unsafe externalPath %q" $name $path) -}}
{{- end -}}
{{- if ne (printf "%v" (index $authority "versionSource")) "compoundEngineeringRelease" -}}
{{-   fail (printf "compound-engineering: authority %q has unsupported versionSource %q" $name (index $authority "versionSource")) -}}
{{- end -}}
{{- includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "compound-engineering") -}}
