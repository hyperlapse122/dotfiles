{{- /* PowerShell host facts generated from the same registry as facts-sh.tmpl. */ -}}
{{- $facts := includeTemplate "facts.tmpl" . | fromYaml -}}
{{- $registry := .factRegistry -}}
{{- $lines := list -}}
{{- range $name := (keys $facts | sortAlpha) -}}
{{-   if not (hasKey $registry $name) -}}{{- fail (printf "facts-ps1.tmpl: undeclared fact %q" $name) -}}{{- end -}}
{{-   $spec := index $registry $name -}}
{{-   $value := index $facts $name -}}
{{-   if eq $spec.type "bool" -}}
{{-     if not (kindIs "bool" $value) -}}{{- fail (printf "facts-ps1.tmpl: fact %q must be bool" $name) -}}{{- end -}}
{{-     $lines = append $lines (printf "    '%s' = $%s" $name (ternary "true" "false" $value)) -}}
{{-   else if eq $spec.type "string" -}}
{{-     $text := printf "%v" $value -}}
{{-     if not (regexMatch "^[A-Za-z0-9._-]*$" $text) -}}{{- fail (printf "facts-ps1.tmpl: unsafe string fact %q" $name) -}}{{- end -}}
{{-     $lines = append $lines (printf "    '%s' = '%s'" $name $text) -}}
{{-   else -}}{{- fail (printf "facts-ps1.tmpl: unsupported fact type %q" $spec.type) -}}{{- end -}}
{{- end -}}
# Host facts. Probed once by the chezmoi hook; this partial performs no probes.
$Script:HostFacts = @{
{{ join "\n" $lines }}
}

function Test-FactGate {
    param([AllowEmptyString()][string] $Expression)
    if (-not $Expression) { return $true }
    $negate = $Expression.StartsWith('!')
    if ($negate) { $Expression = $Expression.Substring(1) }
    $parts = $Expression.Split('.', 2)
    $name = $parts[0]
    if (-not $Script:HostFacts.ContainsKey($name)) {
        throw "Test-FactGate: unknown fact '$name'"
    }
    $actual = $Script:HostFacts[$name]
    $matched = if ($parts.Count -eq 2) { [string]$actual -eq $parts[1] } else { [bool]$actual }
    if ($negate) { return -not $matched }
    return $matched
}
