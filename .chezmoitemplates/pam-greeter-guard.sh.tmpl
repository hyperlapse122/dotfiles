{{- /*
pam-greeter-guard.sh.tmpl — the predicate that keeps the login greeter
password-only, shared by every Fedora authselect factor installer.

An authselect feature writes a module into system-auth, and every service that
includes that stack gains the factor. The greeter is the one service that MUST
NOT: it authenticates through password-auth, and the feature does not touch that
stack -- but nothing here ASSUMES so. greeter_would_gain_module resolves the
greeter's own stack through its include chain, against the profile as authselect
WOULD render it with the requested features, and answers whether the named
module reaches it. It fails closed on both unknowns: a display manager
greeter_service() does not recognize, and a stack that could not be resolved at
all, both answer "yes, withhold".

Emits shell FUNCTIONS only; the caller decides what to do with the verdict and
owns the skip declaration. The functions read FACT_DISPLAY_MANAGER (facts-sh.tmpl)
and the SUDO array (sudo-elevation-guard.sh.tmpl), so include both first.

  greeter_would_gain_module <module-regex> <profile> [feature...]
      module-regex  an ERE matched against the auth lines, e.g. 'pam_fprintd\.so'
      profile       an authselect profile id, or '' for the selected one
      feature...    the feature set to render the profile with

  {{ includeTemplate "pam-greeter-guard.sh.tmpl" . }}
  if greeter_would_gain_module 'pam_fprintd\.so' '' "${FEATURES[@]}"; then …

Verification is .ci/test-fingerprint-greeter-guard.sh, which extracts these
functions from the rendered fingerprint installer and drives them against
synthetic PAM trees and a stubbed authselect.
*/ -}}
# The first readable PAM file for a service. /etc/pam.d wins over the vendor copy,
# which is the order PAM itself uses.
pam_service_file() {
  local service="$1" file
  for file in "/etc/pam.d/${service}" "/usr/lib/pam.d/${service}"; do
    [[ -r "$file" ]] && { printf '%s' "$file"; return 0; }
  done
  return 1
}

# Resolve a PAM service through its include/substack chain and report whether any
# auth line in it names the module. Reading only the greeter's own service file
# would pass on exactly the hosts this exists to protect: a greeter names no
# factor module directly, it reaches one through the stack it substacks.
pam_chain_has_module() {
  local service="$1" module="$2" depth="${3:-0}" file kind target found=1
  (( depth > 4 )) && return 1
  file="$(pam_service_file "$service")" || return 1
  if grep -qE "^[[:space:]]*auth[[:space:]].*${module}" "$file" 2>/dev/null; then
    return 0
  fi
  while read -r _ kind target _; do
    case "$kind" in
      include|substack)
        if pam_chain_has_module "$target" "$module" "$((depth + 1))"; then
          found=0
          break
        fi
        ;;
    esac
  done < <(grep -E '^[[:space:]]*auth[[:space:]]' "$file" 2>/dev/null || true)
  return "$found"
}

# The authselect-managed stacks a service pulls in through its auth phase. These
# are the files `authselect test` actually renders -- a greeter's own service file
# is shipped by its package and authselect never touches it, so asking for a
# section named after the greeter would search for something that is never there.
pam_auth_includes() {
  local service="$1" file kind target
  # A generator, not a guard: a service with no readable file emits nothing and
  # the caller sees an empty list. Structured as an `if` rather than an early
  # `return 0` because a bare conditional success exit is indistinguishable from
  # an undeclared skip to the declaration checker.
  if file="$(pam_service_file "$service")"; then
    while read -r _ kind target _; do
      case "$kind" in
        include|substack) printf '%s\n' "$target" ;;
      esac
    done < <(grep -E '^[[:space:]]*auth[[:space:]]' "$file" 2>/dev/null || true)
  fi
}

# The greeters this repository is prepared to keep password-only, and the service
# each authenticates through. A display manager absent from this list is not
# assumed safe -- it withholds the feature.
greeter_service() {
  case "${FACT_DISPLAY_MANAGER:-}" in
    plasmalogin) printf 'plasmalogin' ;;
    sddm)        printf 'sddm' ;;
    gdm)         printf 'gdm-password' ;;
    *)           return 1 ;;
  esac
}

# Answers "would rendering PROFILE with these features put MODULE in the greeter's
# authentication stack?". Single terminal return: a conditional `return 0` here
# reads as an undeclared skip to the declaration checker, and this is a predicate,
# not a skip -- the skip is the call site.
#
# `authselect test PROFILE [FEATURE...]` renders the profile it WOULD apply
# without applying it, which is what lets the decision be made before the factor
# can land. The profile id is POSITIONAL and features are bare names; there is no
# --enable-feature= flag on `test`. Section headers are `File /etc/pam.d/<name>:`
# and are localized, so the call is pinned to LC_ALL=C.
greeter_would_gain_module() {
  local module="$1" profile="$2"
  shift 2
  # `rendered` is initialised, not merely declared: `local rendered` leaves it
  # UNSET, and under `set -u` the `[[ -n "$rendered" ]]` test below aborts the
  # whole installer on exactly the path the fallback was written for -- an
  # authselect that cannot be asked.
  local service rendered='' stack verdict=1
  # An unrecognized display manager is NOT assumed safe: there is no known greeter
  # service to check, so the answer stays yes and the feature is withheld.
  if ! service="$(greeter_service)"; then
    return 0
  fi

  # Both reads run UNPRIVILEGED. authselect.conf and the profile trees are
  # world-readable, and a `sudo` here is worse than unnecessary: on a host whose
  # sudo stack already carries pam_fprintd, sudo prints the fingerprint prompt
  # and its timeout notice on the same stream, so the captured "profile" was the
  # first word of a localized PAM message and the select failed on it.
  if [[ -z "$profile" ]]; then
    profile="$(authselect current --raw 2>/dev/null | awk 'NR==1 {print $1}')" || profile=''
  fi
  if [[ -n "$profile" ]]; then
    rendered="$(LC_ALL=C authselect test "$profile" "$@" 2>/dev/null)" || rendered=''
  fi

  # The greeter's own file is package-shipped and authselect never renders it, so
  # what matters is the authselect-managed stacks it pulls in.
  #
  # `examined` is the difference between "checked, and the greeter is clean" and
  # "could not check". Only the first may enable the factor: this predicate
  # guards the repository's password-only greeter guarantee, so an unanswerable
  # question resolves the same way an unrecognized display manager does, by
  # withholding.
  # awk's three exit codes are the three distinct answers, so they are captured
  # into a variable rather than read from $? at a distance:
  #   0  the stack rendered AND carries the module   -> withhold
  #   1  the stack rendered and is clean             -> a real answer
  #   2  authselect rendered no section by that name -> no answer
  local examined=0 rc
  if [[ -n "$rendered" ]]; then
    while read -r stack; do
      [[ -n "$stack" ]] || continue
      rc=0
      # The module regex reaches awk through the environment, not -v: gawk
      # processes escape sequences in a -v value and warns on the `\.` every
      # module name carries.
      printf '%s\n' "$rendered" | PAM_MODULE_RE="$module" awk -v svc="$stack" '
          $0 == "File /etc/pam.d/" svc ":" { inblk = 1; found_block = 1; next }
          /^File / { inblk = 0 }
          inblk && /^auth/ && $0 ~ ENVIRON["PAM_MODULE_RE"] { found = 1 }
          END { if (!found_block) exit 2; exit found ? 0 : 1 }
        ' || rc=$?
      if [[ "$rc" -eq 0 ]]; then
        verdict=0
        examined=1
        break
      elif [[ "$rc" -eq 1 ]]; then
        examined=1
      fi
    done < <(pam_auth_includes "$service")
  fi

  # Fall back to the live chain whenever the rendered profile could not answer --
  # authselect unavailable, the greeter's PAM file unresolvable, or none of its
  # includes present as a rendered section. It cannot see a factor that has not
  # landed yet, so it is the weaker check and stays the fallback.
  if [[ "$verdict" -ne 0 && "$examined" -eq 0 ]]; then
    if pam_chain_has_module "$service" "$module"; then
      verdict=0
    elif ! pam_service_file "$service" >/dev/null; then
      # Nothing could be resolved at all. Withhold.
      verdict=0
    fi
  fi
  return "$verdict"
}
