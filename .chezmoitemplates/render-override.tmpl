{{- /*
render-override.tmpl — resolve a boolean `renderOverrides.<key>`, or fall back.

Input (dict):
  ctx       required; root chezmoi context
  key       required; the renderOverrides key to read
  fallback  required; the bool to use when the key is absent

Emits the literal "true" or "false".

WHY OVERRIDES EXIST AT ALL. Some facts are probed by a subprocess or a stat --
`op vault list` for opAvailable, /run/.containerenv for container -- which
`--override-data` cannot otherwise reach. CI has to drive BOTH values of those
facts against ONE tree: a render on a host cannot forge a container, and a render
inside a container cannot escape one. musl-probe.tmpl opened this seam for
muslLinux; this partial is the shared spelling for the facts that followed.

The string forms are accepted because --override-data is often assembled by shell
interpolation, where a bare `true` easily arrives quoted.
*/ -}}
{{- if not (kindIs "map" .) -}}
{{-   fail (printf "render-override.tmpl: expected a dict, got %s" (kindOf .)) -}}
{{- end -}}
{{- range $required := list "ctx" "key" "fallback" -}}
{{-   if not (hasKey $ $required) -}}
{{-     fail (printf "render-override.tmpl: %s is required" $required) -}}
{{-   end -}}
{{- end -}}
{{- if not (kindIs "bool" .fallback) -}}
{{-   fail (printf "render-override.tmpl: fallback must be a bool, got %s" (kindOf .fallback)) -}}
{{- end -}}
{{- $value := .fallback -}}
{{- if hasKey .ctx "renderOverrides" -}}
{{-   if hasKey .ctx.renderOverrides .key -}}
{{-     $override := index .ctx.renderOverrides .key -}}
{{-     if kindIs "bool" $override -}}
{{-       $value = $override -}}
{{-     else -}}
{{-       $value = has (lower (toString $override)) (list "true" "1" "yes") -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $value -}}
