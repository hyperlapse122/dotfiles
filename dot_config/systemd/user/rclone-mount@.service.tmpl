[Unit]
Description=rclone cloud mount for %i
Documentation=man:rclone(1)
After=network-online.target
Wants=network-online.target
PartOf=graphical-session.target
ConditionPathExists=%h/.config/rclone/rclone.conf

[Service]
Type=notify
CacheDirectory=rclone
CacheDirectoryMode=0700
ExecStartPre=-/usr/bin/fusermount3 -u -z %h/Cloud/%i
ExecStartPre=/usr/bin/mkdir -p %h/Cloud/%i
ExecStart=/usr/bin/rclone mount %i: %h/Cloud/%i --vfs-cache-mode full --vfs-cache-max-size {{ .cloud.rclone.vfsCacheMaxSize }} --vfs-cache-max-age {{ .cloud.rclone.vfsCacheMaxAge }} --dir-cache-time {{ .cloud.rclone.dirCacheTime }} --timeout {{ .cloud.rclone.timeout }}
ExecStop=-/usr/bin/fusermount3 -u -z %h/Cloud/%i
ExecStopPost=-/usr/bin/fusermount3 -u -z %h/Cloud/%i
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
