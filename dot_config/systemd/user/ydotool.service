[Unit]
Description=Active-seat ydotoold wrapper (keyboard/pointer input automation)
# ydotoold only has an active seat to reach /dev/uinput inside a graphical
# session, and its socket belongs under the same per-user runtime directory
# %t that a live session provides — hence the graphical-session binding:
# PartOf so a session teardown stops this unit with it, WantedBy so the next
# graphical login starts it. This unit is never enabled with `--now` and is
# never started during a chezmoi apply; see
# .chezmoiscripts/30-linux/run_after_config-ydotool.sh.tmpl.
PartOf=graphical-session.target

[Service]
Type=simple
# The active-seat wrapper owns /usr/bin/ydotoold, %t/.ydotool_socket, and the
# 250ms /dev/uinput permission poll (KTD7) — this unit does not invoke
# ydotoold directly.
ExecStart=%h/.local/libexec/ydotoold-active-seat
Restart=on-failure
RestartSec=2

# Hardening restricted to what still applies inside an UNPRIVILEGED per-user
# manager, which has no mount namespace unless PrivateUsers=true is also set
# (it is not, here). PrivateTmp=, ProtectSystem=, and ProtectHome= would
# silently no-op without one, and any device policy that hides /dev/uinput
# would break the one device this unit exists to reach — so none of those,
# and no PrivateDevices=, are set.
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=graphical-session.target
