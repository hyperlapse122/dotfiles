{{- $cpa := .cliProxyApi -}}
# CPA-Manager-Plus — admin panel + request/usage statistics (SQLite) for the
# CLIProxyAPI management API.
[Unit]
Description=CPA-Manager-Plus admin panel and usage statistics
# CPAMP talks to CPA's management API continuously, so it must stop first on
# every shutdown path (including the system-sleep hook); systemd reverses the
# start order on stop.
After=cli-proxy-api.service

[Container]
ContainerName=cpa-manager-plus
Image={{ includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "cpa-manager-plus" "field" "imageRef") }}
Network=cli-proxy-api.network
PublishPort=127.0.0.1:{{ $cpa.ports.panel }}:{{ $cpa.ports.panel }}
# Exclusive cpamp/ subdirectory of the shared data root (SQLite, data key,
# seeded credential files); :Z because no other container mounts it.
Volume=%h/{{ $cpa.dataRoot }}/cpamp:/data:Z
Environment=HTTP_ADDR=0.0.0.0:{{ $cpa.ports.panel }}
Environment=CPA_UPSTREAM_URL=http://cli-proxy-api:{{ $cpa.ports.proxy }}
# Credentials are seeded by the 90-services provisioner into the data root as
# 0600 files — never rendered into this unit.
Environment=CPA_MANAGEMENT_KEY_FILE=/data/secrets/management-key
Environment=CPA_MANAGER_ADMIN_KEY_FILE=/data/secrets/admin-key
Environment=USAGE_DB_PATH=/data/usage.sqlite
Environment=CPA_MANAGER_DATA_KEY_PATH=/data/data.key
TimeoutStopSec=15

[Service]
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
