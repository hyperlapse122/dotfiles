{{- $cpa := .cliProxyApi -}}
# CLIProxyAPI — localhost proxy rotating across enrolled Claude subscriptions.
# Image ref is pinned by tag+digest through the release lock; the 90-services
# provisioner pulls and restarts when this rendered unit changes.
[Unit]
Description=CLIProxyAPI localhost subscription rotation proxy

[Container]
ContainerName=cli-proxy-api
Image={{ includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "cli-proxy-api" "field" "imageRef") }}
Network=cli-proxy-api.network
# Proxy API + management endpoint, localhost-only.
PublishPort=127.0.0.1:{{ $cpa.ports.proxy }}:{{ $cpa.ports.proxy }}
# OAuth login callback listeners (upstream docker-compose set), localhost-only.
{{- range $cpa.ports.oauthCallbacks }}
PublishPort=127.0.0.1:{{ . }}:{{ . }}
{{- end }}
# Exclusive subdirectories of the shared data root; :Z (not :z) because no
# other container ever mounts them. Container root maps to the host user
# (rootless default), so written files stay host-owned.
Volume=%h/{{ $cpa.dataRoot }}/config:/CLIProxyAPI/config:Z
Volume=%h/{{ $cpa.dataRoot }}/auth:/CLIProxyAPI/auth:Z
# Quadlet Exec replaces the image CMD wholesale, so the full command.
Exec=./CLIProxyAPI --config /CLIProxyAPI/config/config.yaml

[Service]
# Short, deliberate stop window: SIGKILL exposure is token files and in-flight
# stats writes, never committed state. (Quadlet .container has no TimeoutStopSec
# key in [Container]; the service-level key governs the stop timeout.)
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
