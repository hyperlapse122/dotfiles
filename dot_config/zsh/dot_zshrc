# Make the chezmoi-managed completion directory loadable. This MUST stay above
# the prezto init below: prezto's `completion` module is what calls `compinit`,
# and compinit only scans $fpath as it stands at that moment. It lives here
# rather than in .zprofile because fpath is a shell array, not an exported
# variable — .zprofile is skipped for a nested interactive shell (SHLVL > 1,
# the common tmux and subshell case), which would silently lose the entry.
# Prepended so a repo-managed completion wins over a system one of the same
# name; the (N) qualifier drops the entry when the directory is absent.
fpath=($HOME/.local/share/zsh/site-functions(N) $fpath)

if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# External generators emit `compdef` registrations. Prezto's completion module
# normally initializes it above, but deliberately returns before `compinit` in
# TERM=dumb shells. In that case loading a generator invokes zsh's
# command-not-found handler; Fedora's PackageKit fallback is a bash program,
# which produces misleading `bash: compdef: command not found` errors. Gate on
# the actual prerequisite, not TERM, so a deliberately disabled/failed Prezto
# completion module is safe too. Dumb shells have no interactive completion
# UI, so skipping the generators loses no usable behavior.
if (( $+functions[compdef] )); then
  source <(kubectl completion zsh)
  source <(minikube completion zsh)
  source <(helm completion zsh)
fi

# Run chezmoi with a GitHub token when one is cheap to get: renders no longer
# call the GitHub API (the release lock pins every tool), but apply-time
# downloads still benefit from lifting the anonymous rate limit. Token
# resolution: `gh auth token` first — the auth-github preflight logs `gh` in
# with the same PAT, so it's usually available, instant, and prompt-free (no
# 1Password biometric popup) — then fall back to 1Password (`op read`) when
# `gh` is missing, not logged in, or returns empty. If both fail, warn and run
# chezmoi without a token instead of blocking.
chezmoi() {
  if [[ -n "${GITHUB_TOKEN-}" || -n "${GITHUB_ACCESS_TOKEN-}" || -n "${CHEZMOI_GITHUB_ACCESS_TOKEN-}" ]]; then
    command chezmoi "$@"
    return
  fi
  local token
  if command -v gh >/dev/null 2>&1 && token="$(gh auth token 2>/dev/null)" && [[ -n "$token" ]]; then
    GITHUB_TOKEN="$token" command chezmoi "$@"
    return
  fi
  if command -v op >/dev/null 2>&1 && token="$(op read 'op://Private/GitHub/PAT' 2>/dev/null)" && [[ -n "$token" ]]; then
    GITHUB_TOKEN="$token" command chezmoi "$@"
    return
  fi
  print -u2 'chezmoi: no GitHub token from gh or op; running unauthenticated (GitHub API rate limits may apply)'
  command chezmoi "$@"
}
