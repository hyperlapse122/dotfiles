# Figma MCP user proxy configuration.
# Routes HTTP/HTTPS traffic to the local figma-proxy daemon, which MITMs mcp.figma.com:443
# and passes through all other traffic.
HTTP_PROXY=http://127.0.0.1:8888
HTTPS_PROXY=http://127.0.0.1:8888
NO_PROXY=localhost,127.0.0.1

# Trust the local Root CA generated by figma-proxy
NODE_EXTRA_CA_CERTS={{ .chezmoi.homeDir }}/.local/share/figma-proxy/ca.crt
SSL_CERT_FILE={{ .chezmoi.homeDir }}/.local/share/figma-proxy/ca.crt
