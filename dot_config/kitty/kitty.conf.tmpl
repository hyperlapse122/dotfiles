{{- /* kitty terminal — deploys on every target; kitty itself installs only on
   Linux desktops. A .tmpl for ONE reason: the two font lines below. The family
   and size come from .chezmoidata/fonts.yaml (`fonts.families.mono`,
   `fonts.sizes.terminal`) — the same source the KDE/GNOME font scripts, the
   fcitx5 classicui config, and the VSCodium settings read — so changing the
   mono face is a ONE-FILE edit instead of a five-file hunt. `terminal` is
   kitty's own size, deliberately separate from the shared `sizes.mono`.
   Everything else here is kitty's own settings surface and stays literal
   (this file IS the data for those). */ -}}
# ~/.config/kitty/kitty.conf — managed by chezmoi.
#
# Font family and size render from fonts.yaml — edit the yaml, not here.
# kitty inherits $SHELL (zsh, set by the repo's chsh script) so no `shell`
# directive is needed. Docs: https://sw.kovidgoyal.net/kitty/conf/

# --- window ---
# Chrome ON: KWin draws a server-side titlebar on KDE; kitty draws its own
# client-side titlebar on GNOME — one shared config covers both desktops.
# `no` is kitty's default; the line stays explicit to document the reversal
# of the prior deliberate `yes`.
hide_window_decorations no
remember_window_size  no
# 128c, not the historical 82c: the wider window is kept deliberately now that
# the tab bar sits on the top edge again, where the bar costs one row and no
# columns, so the full width is text area. `initial_window_width` in cells
# accounts for margins and padding but NEVER for the tab bar.
initial_window_width  128c
initial_window_height 24c

# --- tab bar ---
# Top edge, not kitty's default `bottom`: matches browser/editor tab conventions.
# The vertical `left` edge (kitty >= 0.48) was tried and reverted — it did not
# render stably enough in daily use.
tab_bar_edge top
# Upstream default is 2, which hides the bar until a second tab opens. Show it
# from the first tab so opening a second one never reflows the text area.
tab_bar_min_tabs 1
# Upstream default is `fade`; powerline renders a continuous styled bar. kitty
# draws the separators itself, and the managed mono face is a Nerd Font, so the
# glyphs are covered on every managed host.
tab_bar_style powerline
tab_powerline_style slanted
# Index prefix makes `goto_tab N` discoverable; kitty still auto-prepends
# {bell_symbol}/{activity_symbol} since they are absent from the template.
tab_title_template "{index}: {title}"
# Upstream default, written explicitly: closing a tab returns to the
# last-used tab instead of its neighbor.
tab_switch_strategy previous

# --- key bindings ---
# Tab move deliberately stays on the upstream `ctrl+shift+,`/`ctrl+shift+.`
# (move_tab_backward/forward); `ctrl+shift+page_up`/`ctrl+shift+page_down`
# are NOT bound here because upstream maps them to scroll_page_up/down.
# `ctrl+page_up`/`ctrl+page_down` are unmapped upstream.
map ctrl+page_up previous_tab
map ctrl+page_down next_tab
# New tab inherits the cwd via shell integration (enabled by default);
# without integration it falls back to the home directory, not an error.
map ctrl+shift+t new_tab_with_cwd
# Preserves the upstream home-directory behavior the remap above replaced.
# `ctrl+shift+alt+n` is unmapped upstream; `ctrl+shift+alt+t` is NOT used
# because upstream maps it to `set_tab_title` (rename-tab prompt).
map ctrl+shift+alt+n new_tab

# --- font ---
font_family {{ .fonts.families.mono }}
font_size {{ .fonts.sizes.terminal }}

# --- input / clipboard ---
copy_on_select        clipboard
# Plural since kitty 0.48 renamed the key; the singular spelling is now an
# unknown key that kitty warns about on every start. Values are unchanged.
strip_trailing_spaces smart

# --- scrolling ---
scrollback_lines 10000

# --- bell ---
enable_audio_bell no

# --- cursor ---
cursor_shape            beam
cursor_blink_interval   0

# --- misc ---
update_check_interval 0
