Host *
  IdentityAgent //./pipe/OpenSSH-ssh-agent
  ForwardAgent no
  StrictHostKeyChecking yes
  UpdateHostKeys yes
  UserKnownHostsFile ~/.ssh/known_hosts

# Linux development uses an operator-prepared Fedora VM. The VM host key must
# already be pinned in known_hosts; this repository never accepts or rotates it.
Host fedora-vm
  ForwardAgent no
  StrictHostKeyChecking yes
