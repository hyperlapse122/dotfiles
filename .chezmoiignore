# Root-owned system config installed to /etc by
# .chezmoiscripts/30-linux/run_onchange_after_install-system-10-files.sh.tmpl
# (manifest: .chezmoidata/system.yaml), never linked into $HOME.
./system

{{- $f := includeTemplate "facts.tmpl" . | fromYaml }}

# macOS-only
{{- if ne .chezmoi.os "darwin" }}
./Library
{{- end }}

# Windows-only
{{- if ne .chezmoi.os "windows" }}
./AppData
{{- end }}

# Read-only disk-encryption status tools are per-OS (U8): the FileVault query
# deploys only to macOS and the BitLocker query only to Windows. Linux keeps its
# existing LUKS/TPM2 path and receives neither. Enablement stays a manual
# operator step — these tools only query.
{{- if ne .chezmoi.os "darwin" }}
.local/bin/encryption-status
{{- end }}
{{- if ne .chezmoi.os "windows" }}
.local/bin/encryption-status.ps1
{{- end }}

# Native ~/.local/bin helpers deploy only where their runtime exists. Keep the
# gate in this root file: chezmoi reads only the source-root .chezmoiignore.
{{- if eq .chezmoi.os "windows" }}
.local/bin/*
!.local/bin/*.ps1
{{- else }}
.local/bin/*.ps1
{{- end }}
{{- if ne .chezmoi.os "linux" }}
.local/bin/host-facts
.local/bin/import-wifi-1password
.local/bin/setup-luks-tpm2-unlock.sh
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
.local/bin/import-wifi-1password-macos.sh
{{- end }}

# VSCodium user state deploys to the NATIVE per-OS location: the XDG path on
# Linux (dot_config/VSCodium), %APPDATA%\VSCodium on Windows and
# ~/Library/Application Support/VSCodium on macOS — both covered by the
# AppData/Library gates above. The XDG path is therefore Linux-only: keep it
# off Windows/macOS targets. The PowerShell extension reconciler is
# Windows-only (the POSIX half in 30-linux renders for Linux AND macOS) and
# mirrors the haptic ps1 pattern below: its own template guard is defense in
# depth, this ignore keeps it out of non-Windows target state.
{{- if ne .chezmoi.os "linux" }}
.config/VSCodium
{{- end }}
{{- if ne .chezmoi.os "windows" }}
.chezmoiscripts/30-windows/*.ps1
{{- end }}

# The Windows daemon provisioner is source-only on POSIX hosts. Its own
# template guard is defense in depth; the ignore keeps it out of target state.
{{- if ne .chezmoi.os "windows" }}
.chezmoiscripts/60-build/*mxm4-haptic.ps1
{{- end }}

# The haptic systemd units are Linux-only. macOS uses launchd and Windows uses
# Task Scheduler, so neither host may receive inert systemd targets.
{{- if ne .chezmoi.os "linux" }}
.config/systemd/user/mxm4-haptic*.service
{{- end }}


# kitty is provisioned from the upstream bundle by
# .chezmoiscripts/00-tools/run_onchange_before_kitty.sh (the distro package no
# longer installs it — see the kitty note in .chezmoidata/packages.yaml). Both
# the provisioner and the launcher entry it points at only make sense on a Linux
# host with a graphical session: a headless or non-KDE/GNOME host has no use for
# a GPU terminal and no menu to show it in. The managed kitty.conf itself is NOT
# gated here — it deploys everywhere and is inert without kitty.
# The opt-in WezTerm candidate launcher rides the same gate: a headless or
# non-desktop host has no menu for it either. wezterm.lua is likewise NOT gated
# — it deploys everywhere and is inert unless wezterm is launched.
{{- if or (ne .chezmoi.os "linux") (not (or (eq $f.desktop "kde") (eq $f.desktop "gnome"))) }}
.chezmoiscripts/00-tools/*kitty.sh
.local/share/applications/kitty.desktop
.local/share/applications/wezterm.desktop
{{- end }}

# ydotool (KTD2, KTD5, KTD7): a managed graphical-session user unit, its
# active-seat /dev/uinput wrapper, and the reconciler script that
# enables/reloads/restarts it. All three make sense only on a supported
# Fedora KDE/GNOME desktop that actually reaches
# graphical-session.target — never on a headless server, a non-Linux host,
# an unsupported distro/desktop, or a container (no graphical session, no
# seat to grant /dev/uinput). Gate all three together so an ineligible
# target never ends up with an orphaned unit, wrapper, or reconciler.
{{- if not (and (eq .chezmoi.os "linux") (eq $f.distro "fedora") (or (eq $f.desktop "kde") (eq $f.desktop "gnome")) (not $f.headless) (not $f.container)) }}
.config/systemd/user/ydotool.service
.local/libexec/ydotoold-active-seat
.chezmoiscripts/30-linux/*config-ydotool.sh
{{- end }}

# Vendored source dirs: crates/ + packages/ monorepos are built/used in place,
# never linked into $HOME (mirrors ./system above).
./crates
./packages

# The mxm4-haptic Claude Code / Codex plugins pulse the cross-platform
# mxm4-hapticd daemon (Linux hidraw, macOS IOKit, Windows native HID), so the
# deployed trees ship on every desktop OS. The POSIX hook wrapper covers
# Linux/macOS; the Windows hooks render PowerShell counterparts. Containers
# still skip the trees below (no MX Master 4 inside a container).


# Advisor improvement plans (repo-meta docs); never linked into $HOME.
./plans

# internal documentations
./docs

# Containerized / CI environments: Podman creates /run/.containerenv, Docker
# creates /.dockerenv (neither exists on a bare-metal host or VM). Inside a
# container, deploy the CLI dotfiles only and skip all host provisioning:
# package installs, /etc system config, GPG/GitHub/Tailscale auth, fonts,
# KDE/GNOME settings, pro-audio realtime provisioning, and the MX Master haptic build.
#
# distrobox and toolbox are the OPT-OUT: both bind-mount the host $HOME and both
# create /run/.toolboxenv (distrobox touches it for toolbx compatibility), so an
# apply inside one writes to the real host $HOME and must behave like the host —
# provision fully. Skip only a "real" container: a Podman/Docker marker present
# WITHOUT /run/.toolboxenv.
#
# That whole predicate is the `container` fact — declared in .chezmoidata/facts.yaml
# and resolved once in .chezmoitemplates/facts.tmpl, which is also what the guard
# partials and the installers read. The markers are no longer stat'd here: one
# machine, one answer.
{{- if $f.container }}
.chezmoiscripts/30-linux/*.sh
.chezmoiscripts/20-linux-fedora/*.sh
.chezmoiscripts/50-linux-kde/*.sh
.chezmoiscripts/50-linux-gnome/*.sh
.chezmoiscripts/10-auth/*.sh
.chezmoiscripts/80-keys/*.sh
.chezmoiscripts/60-build/*mxm4-haptic.sh
.chezmoiscripts/60-build/*mxm4-haptic.ps1
.config/systemd/user/mxm4-haptic*.service
Library/LaunchAgents/dev.h82.mxm4-hapticd.plist
.local/share/omp-plugins
.omp/agent/extensions/mxm4-haptic.ts
# No graphical session in a container, so the kitty bundle has nothing to draw
# on. 00-tools is not wildcarded here (unlike the distro/desktop dirs above),
# so this provisioner needs its own line. The opt-in WezTerm candidate
# launcher has nothing to launch here either.
.chezmoiscripts/00-tools/*kitty.sh
.local/share/applications/kitty.desktop
.local/share/applications/wezterm.desktop
# No MX Master 4 in a container, and the haptic build is skipped just above, so
# the Claude/Codex haptic plugins have nothing to pulse — skip the deployed
# plugin trees. The generic 70-agents/install-agent-plugins.sh script is
# deliberately KEPT (like the dotagents skills install beside it): it still
# registers compound-engineering (marketplace container: keep), while the
# mxm4-haptic rows are filtered out at RENDER time because their marketplaces
# are container: skip — so there is no whole-script skip to make here (the
# merged basename intentionally does not match the former *claude-plugins.sh
# glob).
.local/share/claude-plugins
.local/share/codex-plugins
# The ~/src garden is a host concept: the 80-keys GPG key import is skipped
# above so the encrypted project registry cannot be decrypted here, and the
# 90-src reconcile script (grow/bootstrap/aoe) would have nothing to provision
# and would hard-fail on the then-absent registry — skip both.
.chezmoiscripts/90-src/*.sh
.config/garden/garden.yaml
{{- end }}
