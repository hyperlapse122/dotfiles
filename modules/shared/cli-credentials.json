{
  "github_token": { "group": "git-hosting" },
  "gitlab_token": { "group": "git-hosting" },
  "jpi_token": { "group": "git-hosting" },
  "docker_token": {
    "group": "docker-registry",
    "nixosOption": "enableDockerToken",
    "darwin": false,
    "optional": true
  },
  "tokscale_token": { "group": "provider-services", "nixosOption": "enableTokscaleToken" },
  "synthetic_api_key": { "group": "provider-services", "nixosOption": "enableSyntheticApiKey" },
  "exa_api_key": { "group": "provider-services", "nixosOption": "enableExaApiKey" },
  "openrouter_api_key": { "group": "provider-services", "nixosOption": "enableOpenRouterApiKey" },
  "opencode_go_api_key": { "group": "provider-services", "nixosOption": "enableOpencodeGoApiKey" },
  "anthropic_api_key": { "group": "provider-services", "nixosOption": "enableAnthropicApiKey" }
}
