### Vendored monorepo build artifacts (crates/ + packages/) ###
# Rust and JS build artifacts
target/
dist/
dist
node_modules/
# The two `dist` patterns above are unscoped, so they also swallow
# firmware/*/dist/ — which is the one build output this repo tracks on purpose
# (KTD7: the built .bin is committed through Git LFS). Re-include the directory
# so git descends into it; without this the LFS filter never sees the file.
!firmware/*/dist/
# packages/ Bun workspace (workspace root, node-modules layout).
# Scoped to packages/ so the rest of the dotfiles repo is unaffected. The
# single workspace-root packages/bun.lock is intentionally TRACKED (lockfile
# convention, like the Rust Cargo.lock); per-member dist/ build output is not.
packages/node_modules/
packages/*/node_modules/
packages/*/dist/
.turbo/
packages/.turbo/
packages/*/.turbo/

### Python bytecode ###
# firmware/nuphy-gem80-hostrgb/ carries this repo's only Python; its tests
# leave __pycache__ beside the source.
__pycache__/

### codegraph ###
.codegraph

### claude ###
.claude

### agents ###
# dotagents auto-generates project state directly under .agents/; that stays
# untracked. No repo-scoped project skill is tracked there today. If one returns,
# add `!.agents/skills/` back rather than collapsing this to a bare `.agents`,
# which would make every descendant unreachable to a negation.
.agents/*


### Compound Engineering ###
docs/plans/.*.md
.compound-engineering/*.local.yaml
# Exception: the CE local config for this project carries no secrets (feedback
# source ids, sweep tunables), so it is tracked so every checkout shares it.
!.compound-engineering/config.local.yaml

# Auto-generated by dotagents — do not commit these files.
agents.lock
.agents/.gitignore

# NuPhy Gem80 Firmware
# Exclude the directory's contents, not the directory itself: git does not
# descend into an excluded directory, so the negations below would never apply.
firmware/nuphy-gem80-hostrgb/dist/*
!firmware/nuphy-gem80-hostrgb/dist/nuphy_gem80_ansi_hostrgb.bin
!firmware/nuphy-gem80-hostrgb/dist/build-info.json
# The hardware verification log is the only evidence R6-R10 were observed.
!firmware/nuphy-gem80-hostrgb/dist/verification-log.md
