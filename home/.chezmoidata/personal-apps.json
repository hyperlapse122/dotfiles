{
  "personalApps": {
    "ghq": {
      "command": "ghq",
      "repository": "x-motemen/ghq",
      "targets": {
        "darwin-amd64": {
          "asset": "ghq_darwin_amd64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq",
          "stripComponents": 1
        },
        "darwin-arm64": {
          "asset": "ghq_darwin_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq",
          "stripComponents": 1
        },
        "linux-amd64": {
          "asset": "ghq_linux_amd64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq",
          "stripComponents": 1
        },
        "linux-arm64": {
          "asset": "ghq_linux_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq",
          "stripComponents": 1
        },
        "windows-amd64": {
          "asset": "ghq_windows_amd64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq.exe",
          "stripComponents": 1
        },
        "windows-arm64": {
          "asset": "ghq_windows_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq.exe",
          "stripComponents": 1
        }
      }
    },
    "gh": {
      "command": "gh",
      "repository": "cli/cli",
      "targets": {
        "darwin-arm64": {
          "asset": "gh_{version}_macOS_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "gh_{version}_macOS_arm64/bin/gh"
        },
        "linux-amd64": {
          "asset": "gh_{version}_linux_amd64.tar.gz",
          "kind": "archive-file",
          "format": "tar.gz",
          "path": "gh_{version}_linux_amd64/bin/gh"
        },
        "linux-arm64": {
          "asset": "gh_{version}_linux_arm64.tar.gz",
          "kind": "archive-file",
          "format": "tar.gz",
          "path": "gh_{version}_linux_arm64/bin/gh"
        },
        "windows-amd64": {
          "asset": "gh_{version}_windows_amd64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "bin/gh.exe"
        },
        "windows-arm64": {
          "asset": "gh_{version}_windows_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "bin/gh.exe"
        }
      }
    },
    "omp": {
      "command": "omp",
      "repository": "can1357/oh-my-pi",
      "targets": {
        "darwin-arm64": {"asset": "omp-darwin-arm64", "kind": "file"},
        "linux-amd64": {"asset": "omp-linux-x64", "kind": "file"},
        "linux-arm64": {"asset": "omp-linux-arm64", "kind": "file"},
        "windows-amd64": {"asset": "omp-windows-x64.exe", "kind": "file"},
        "windows-arm64": {"asset": "omp-windows-arm64.exe", "kind": "file"}
      }
    }
  }
}
