{
  "personalApps": {
    "bun": {
      "command": "bun",
      "repository": "oven-sh/bun",
      "targets": {
        "darwin-arm64": {"asset": "bun-darwin-aarch64.zip", "kind": "archive-file", "format": "zip", "path": "bun-darwin-aarch64/bun"},
        "linux-amd64": {"asset": "bun-linux-x64.zip", "kind": "archive-file", "format": "zip", "path": "bun-linux-x64/bun"},
        "linux-arm64": {"asset": "bun-linux-aarch64.zip", "kind": "archive-file", "format": "zip", "path": "bun-linux-aarch64/bun"},
        "windows-amd64": {"asset": "bun-windows-x64.zip", "kind": "archive-file", "format": "zip", "path": "bun-windows-x64/bun.exe"},
        "windows-arm64": {"asset": "bun-windows-aarch64.zip", "kind": "archive-file", "format": "zip", "path": "bun-windows-aarch64/bun.exe"}
      }
    },
    "claude": {
      "command": "claude",
      "source": "claude",
      "repository": "anthropics/claude-code",
      "targets": {
        "darwin-arm64": {
          "platform": "darwin-arm64",
          "asset": "claude",
          "kind": "file"
        },
        "linux-amd64": {
          "platform": "linux-x64",
          "asset": "claude",
          "kind": "file"
        },
        "linux-arm64": {
          "platform": "linux-arm64",
          "asset": "claude",
          "kind": "file"
        },
        "windows-amd64": {
          "platform": "win32-x64",
          "asset": "claude.exe",
          "kind": "file"
        },
        "windows-arm64": {
          "platform": "win32-arm64",
          "asset": "claude.exe",
          "kind": "file"
        }
      }
    },
    "codex": {
      "command": "codex",
      "repository": "openai/codex",
      "targets": {
        "darwin-arm64": {"asset": "codex-package-aarch64-apple-darwin.tar.gz", "kind": "archive-file", "format": "tar.gz", "path": "bin/codex"},
        "linux-amd64": {"asset": "codex-package-x86_64-unknown-linux-musl.tar.gz", "kind": "archive-file", "format": "tar.gz", "path": "bin/codex"},
        "linux-arm64": {"asset": "codex-package-aarch64-unknown-linux-musl.tar.gz", "kind": "archive-file", "format": "tar.gz", "path": "bin/codex"},
        "windows-amd64": {"asset": "codex-package-x86_64-pc-windows-msvc.tar.gz", "kind": "archive-file", "format": "tar.gz", "path": "bin/codex.exe"},
        "windows-arm64": {"asset": "codex-package-aarch64-pc-windows-msvc.tar.gz", "kind": "archive-file", "format": "tar.gz", "path": "bin/codex.exe"}
      }
    },
    "antigravity": {
      "command": "agy",
      "source": "antigravity",
      "installDirectory": ".local/share/dotfiles/antigravity/bin",
      "targets": {
        "darwin-arm64": {
          "asset": "darwin-arm/cli_mac_arm64.tar.gz",
          "kind": "archive-file",
          "format": "tar.gz",
          "path": "antigravity"
        },
        "linux-amd64": {
          "asset": "linux-x64/cli_linux_x64.tar.gz",
          "kind": "archive-file",
          "format": "tar.gz",
          "path": "antigravity"
        },
        "linux-arm64": {
          "asset": "linux-arm/cli_linux_arm64.tar.gz",
          "kind": "archive-file",
          "format": "tar.gz",
          "path": "antigravity"
        },
        "windows-amd64": {"asset": "windows-x64/cli_windows_x64.exe", "kind": "file"},
        "windows-arm64": {"asset": "windows-arm/cli_windows_arm64.exe", "kind": "file"}
      }
    },
    "ghq": {
      "command": "ghq",
      "repository": "x-motemen/ghq",
      "targets": {
        "darwin-arm64": {
          "asset": "ghq_darwin_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq",
          "stripComponents": 1
        },
        "linux-amd64": {
          "asset": "ghq_linux_amd64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq",
          "stripComponents": 1
        },
        "linux-arm64": {
          "asset": "ghq_linux_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq",
          "stripComponents": 1
        },
        "windows-amd64": {
          "asset": "ghq_windows_amd64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq.exe",
          "stripComponents": 1
        },
        "windows-arm64": {
          "asset": "ghq_windows_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "ghq.exe",
          "stripComponents": 1
        }
      }
    },
    "gh": {
      "command": "gh",
      "repository": "cli/cli",
      "targets": {
        "darwin-arm64": {
          "asset": "gh_{version}_macOS_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "gh_{version}_macOS_arm64/bin/gh"
        },
        "linux-amd64": {
          "asset": "gh_{version}_linux_amd64.tar.gz",
          "kind": "archive-file",
          "format": "tar.gz",
          "path": "gh_{version}_linux_amd64/bin/gh"
        },
        "linux-arm64": {
          "asset": "gh_{version}_linux_arm64.tar.gz",
          "kind": "archive-file",
          "format": "tar.gz",
          "path": "gh_{version}_linux_arm64/bin/gh"
        },
        "windows-amd64": {
          "asset": "gh_{version}_windows_amd64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "bin/gh.exe"
        },
        "windows-arm64": {
          "asset": "gh_{version}_windows_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "bin/gh.exe"
        }
      }
    },
    "glab": {
      "command": "glab",
      "source": "gitlab",
      "repository": "gitlab-org/cli",
      "targets": {
        "darwin-arm64": {
          "asset": "glab_{version}_darwin_arm64.tar.gz",
          "kind": "archive-file",
          "format": "tar.gz",
          "path": "bin/glab"
        },
        "linux-amd64": {
          "asset": "glab_{version}_linux_amd64.tar.gz",
          "kind": "archive-file",
          "format": "tar.gz",
          "path": "bin/glab"
        },
        "linux-arm64": {
          "asset": "glab_{version}_linux_arm64.tar.gz",
          "kind": "archive-file",
          "format": "tar.gz",
          "path": "bin/glab"
        },
        "windows-amd64": {
          "asset": "glab_{version}_windows_amd64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "bin/glab.exe"
        },
        "windows-arm64": {
          "asset": "glab_{version}_windows_arm64.zip",
          "kind": "archive-file",
          "format": "zip",
          "path": "bin/glab.exe"
        }
      }
    },
    "docker-credential-wincred": {
      "command": "docker-credential-wincred",
      "repository": "docker/docker-credential-helpers",
      "targets": {
        "windows-amd64": {
          "asset": "docker-credential-wincred-v{version}.windows-amd64.exe",
          "kind": "file"
        },
        "windows-arm64": {
          "asset": "docker-credential-wincred-v{version}.windows-arm64.exe",
          "kind": "file"
        }
      }
    },
    "docker-credential-osxkeychain": {
      "command": "docker-credential-osxkeychain",
      "repository": "docker/docker-credential-helpers",
      "targets": {
        "darwin-arm64": {
          "asset": "docker-credential-osxkeychain-v{version}.darwin-arm64",
          "kind": "file"
        }
      }
    },
    "docker-credential-secretservice": {
      "command": "docker-credential-secretservice",
      "repository": "docker/docker-credential-helpers",
      "targets": {
        "linux-amd64": {
          "asset": "docker-credential-secretservice-v{version}.linux-amd64",
          "kind": "file"
        },
        "linux-arm64": {
          "asset": "docker-credential-secretservice-v{version}.linux-arm64",
          "kind": "file"
        }
      }
    },
    "pi": {
      "command": "pi",
      "repository": "earendil-works/pi",
      "installDirectory": ".local/bin/pi-native",
      "targets": {
        "darwin-arm64": {
          "asset": "pi-darwin-arm64.tar.gz",
          "kind": "archive",
          "format": "tar.gz",
          "stripComponents": 1
        },
        "linux-amd64": {
          "asset": "pi-linux-x64.tar.gz",
          "kind": "archive",
          "format": "tar.gz",
          "stripComponents": 1
        },
        "linux-arm64": {
          "asset": "pi-linux-arm64.tar.gz",
          "kind": "archive",
          "format": "tar.gz",
          "stripComponents": 1
        },
        "windows-amd64": {
          "asset": "pi-windows-x64.zip",
          "kind": "archive",
          "format": "zip",
          "stripComponents": 0
        },
        "windows-arm64": {
          "asset": "pi-windows-arm64.zip",
          "kind": "archive",
          "format": "zip",
          "stripComponents": 0
        }
      }
    },
    "grok": {
      "command": "grok",
      "source": "grok",
      "targets": {
        "darwin-arm64": {
          "platform": "macos-aarch64",
          "asset": "grok-{version}-macos-aarch64",
          "kind": "file"
        },
        "linux-amd64": {
          "platform": "linux-x86_64",
          "asset": "grok-{version}-linux-x86_64",
          "kind": "file"
        },
        "linux-arm64": {
          "platform": "linux-aarch64",
          "asset": "grok-{version}-linux-aarch64",
          "kind": "file"
        },
        "windows-amd64": {
          "platform": "windows-x86_64",
          "asset": "grok-{version}-windows-x86_64.exe",
          "kind": "file"
        },
        "windows-arm64": {
          "platform": "windows-aarch64",
          "asset": "grok-{version}-windows-aarch64.exe",
          "kind": "file"
        }
      }
    },
    "node": {
      "command": "node",
      "source": "node",
      "installDirectory": ".local/share/dotfiles/node",
      "targets": {
        "darwin-arm64": {
          "asset": "node-v{version}-darwin-arm64.tar.gz",
          "kind": "archive",
          "format": "tar.gz",
          "stripComponents": 1
        },
        "linux-amd64": {
          "asset": "node-v{version}-linux-x64.tar.gz",
          "kind": "archive",
          "format": "tar.gz",
          "stripComponents": 1
        },
        "linux-arm64": {
          "asset": "node-v{version}-linux-arm64.tar.gz",
          "kind": "archive",
          "format": "tar.gz",
          "stripComponents": 1
        },
        "windows-amd64": {
          "asset": "node-v{version}-win-x64.zip",
          "kind": "archive",
          "format": "zip",
          "stripComponents": 1
        },
        "windows-arm64": {
          "asset": "node-v{version}-win-arm64.zip",
          "kind": "archive",
          "format": "zip",
          "stripComponents": 1
        }
      }
    }
  }
}
