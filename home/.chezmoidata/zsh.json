{
  "zsh": {
    "repository": "sorin-ionescu/prezto",
    "ref": "master",
    "targets": ["linux-amd64", "linux-arm64", "darwin-arm64"],
    "completions": {
      "codex": {"args": ["completion", "zsh"]},
      "omp": {"args": ["completions", "zsh"]},
      "gh": {"args": ["completion", "-s", "zsh"]},
      "glab": {"args": ["completion", "-s", "zsh"]},
      "ghq": {"source": "misc/zsh/_ghq"},
      "mise": {"args": ["completion", "zsh"]},
      "usage": {"args": ["--completions", "zsh"]}
    },
    "submodules": [
      "modules/autosuggestions/external",
      "modules/completion/external",
      "modules/history-substring-search/external",
      "modules/syntax-highlighting/external",
      "modules/prompt/external/powerline",
      "modules/prompt/external/agnoster",
      "modules/prompt/external/pure",
      "modules/prompt/external/async",
      "modules/prompt/external/powerlevel10k"
    ]
  }
}
