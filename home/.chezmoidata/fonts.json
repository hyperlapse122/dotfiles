{
  "fonts": {
    "jetendard": {
      "repository": "kuskhan/jetendard",
      "assetPattern": "Jetendard-TTF\\.zip",
      "format": "zip",
      "selections": [{"pattern": "ttf/Jetendard-*.ttf", "minimum": 16}]
    },
    "jetbrains-mono": {
      "repository": "JetBrains/JetBrainsMono",
      "assetPattern": "JetBrainsMono-{version}\\.zip",
      "format": "zip",
      "selections": [{"pattern": "fonts/ttf/*.ttf", "minimum": 32}]
    },
    "pretendard": {
      "repository": "orioncactus/pretendard",
      "assetPattern": "Pretendard-{version}\\.zip",
      "format": "zip",
      "selections": [
        {"pattern": "public/static/alternative/Pretendard-*.ttf", "minimum": 9},
        {"pattern": "public/variable/PretendardVariable.ttf", "minimum": 1}
      ]
    },
    "pretendard-jp": {
      "repository": "orioncactus/pretendard",
      "assetPattern": "PretendardJP-{version}\\.zip",
      "format": "zip",
      "selections": [
        {"pattern": "public/static/alternative/PretendardJP-*.ttf", "minimum": 9},
        {"pattern": "public/variable/PretendardJPVariable.ttf", "minimum": 1}
      ]
    },
    "pretendard-std": {
      "repository": "orioncactus/pretendard",
      "assetPattern": "PretendardStd-{version}\\.zip",
      "format": "zip",
      "selections": [
        {"pattern": "public/static/alternative/PretendardStd-*.ttf", "minimum": 9},
        {"pattern": "public/variable/PretendardStdVariable.ttf", "minimum": 1}
      ]
    },
    "pretendard-gov": {
      "repository": "orioncactus/pretendard",
      "assetPattern": "PretendardGOV-{version}\\.zip",
      "format": "zip",
      "selections": [
        {"pattern": "public/static/alternative/PretendardGOV-*.ttf", "minimum": 9},
        {"pattern": "public/variable/PretendardGOVVariable.ttf", "minimum": 1}
      ]
    },
    "d2coding": {
      "repository": "naver/d2-coding-font",
      "assetPattern": "D2Coding-Ver{version}-[0-9]{8}\\.zip",
      "format": "zip",
      "selections": [
        {"pattern": "D2Coding/*.ttf", "minimum": 2},
        {"pattern": "D2CodingLigature/*.ttf", "minimum": 2}
      ]
    },
    "jetbrains-mono-nerd": {
      "repository": "ryanoasis/nerd-fonts",
      "assetPattern": "JetBrainsMono\\.tar\\.xz",
      "format": "tar.xz",
      "selections": [
        {"pattern": "*NerdFont-*.ttf", "minimum": 32},
        {"pattern": "*NerdFontMono-*.ttf", "minimum": 32},
        {"pattern": "*NerdFontPropo-*.ttf", "minimum": 32}
      ]
    },
    "d2coding-nerd": {
      "repository": "ryanoasis/nerd-fonts",
      "assetPattern": "D2Coding\\.tar\\.xz",
      "format": "tar.xz",
      "selections": [
        {"pattern": "*NerdFont-*.ttf", "minimum": 2},
        {"pattern": "*NerdFontMono-*.ttf", "minimum": 2},
        {"pattern": "*NerdFontPropo-*.ttf", "minimum": 2}
      ]
    }
  }
}
