{{- $gpg := includeTemplate "gpg-settings" . | fromJson -}}
[user]
    name = {{ .git.name | quote }}
    email = {{ .git.email | quote }}
    signingkey = {{ .git.signingKey | quote }}
[commit]
    gpgsign = true
[gpg]
    format = openpgp
    program = {{ $gpg.program | replace "\\" "/" | quote }}
[init]
    defaultBranch = main
[ghq]
    root = ~/src
{{ if eq .chezmoi.os "windows" }}
[http]
    sslBackend = schannel
    schannelUseSSLCAInfo = false
{{ end }}
