{{- $gpg := includeTemplate "gpg-settings" . | fromJson -}}
{{- $ghName := "gh" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $ghName = "gh.exe" -}}{{- end -}}
{{- $ghPath := joinPath .chezmoi.destDir ".local" "bin" $ghName | replace "\\" "/" -}}
{{- $ghShell := printf "'%s'" ($ghPath | replace "'" "'\"'\"'") -}}
{{- $ghHelper := printf "!%s auth git-credential" $ghShell -}}
[include]
    path = {{ joinPath .chezmoi.destDir ".local" "share" "dotfiles" "gitlab.gitconfig" | replace "\\" "/" | quote }}
[user]
    name = {{ .git.name | quote }}
    email = {{ .git.email | quote }}
    signingkey = {{ .git.signingKey | quote }}
[commit]
    gpgsign = true
[gpg]
    format = openpgp
    program = {{ $gpg.program | replace "\\" "/" | quote }}
[core]
    autocrlf = input
[init]
    defaultBranch = main
[ghq]
    root = ~/src
[credential "https://github.com"]
    helper =
    helper = {{ $ghHelper | quote }}
[credential "https://gist.github.com"]
    helper =
    helper = {{ $ghHelper | quote }}
{{ if eq .chezmoi.os "windows" }}
[http]
    sslBackend = schannel
    schannelUseSSLCAInfo = false
{{ end }}
