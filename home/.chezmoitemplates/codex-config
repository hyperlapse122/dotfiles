{{- $settings := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{- $settings = .chezmoi.stdin | fromToml -}}
{{- end -}}
{{- $ce := index .harnessPlugins "compound-engineering" -}}
{{- $id := printf "%s@%s" $ce.codex.plugin $ce.codex.marketplace -}}
{{- range $table, $key := dict "marketplaces" $ce.codex.marketplace "plugins" $id -}}
{{- $entries := dict -}}
{{- if hasKey $settings $table -}}
{{- $entries = get $settings $table -}}
{{- if not (kindIs "map" $entries) -}}
{{- fail (printf "Invalid Codex config.toml: %s must be a table" $table) -}}
{{- end -}}
{{- end -}}
{{- $entry := dict -}}
{{- if hasKey $entries $key -}}
{{- $entry = get $entries $key -}}
{{- if not (kindIs "map" $entry) -}}
{{- fail (printf "Invalid Codex config.toml: %s.%s must be a table" $table $key) -}}
{{- end -}}
{{- end -}}
{{- if eq $table "plugins" -}}
{{- $entry = $entry | setValueAtPath "enabled" true -}}
{{- else -}}
{{- $source := joinPath $.chezmoi.destDir ".local" "share" "dotfiles" "harness-plugins" "compound-engineering" | replace "\\" "/" -}}
{{- $entry = omit $entry "ref" "sparse_paths" "last_revision" | setValueAtPath "source_type" "local" | setValueAtPath "source" $source -}}
{{- end -}}
{{- $entries = $entries | setValueAtPath $key $entry -}}
{{- $settings = $settings | setValueAtPath $table $entries -}}
{{- end -}}
{{- /* Account-synced plugins have no entry, so _default turns them off. Existing entries stay on only from
      configured, bundled, or personal (home-directory) marketplaces. */ -}}
{{- $plugins := get $settings "plugins" -}}
{{- $localMarketplaces := concat (keys (get $settings "marketplaces")) (list "openai-bundled" "openai-primary-runtime") -}}
{{- /* Codex reads the first of these manifests under the home directory as the personal marketplace. */ -}}
{{- $personalFound := false -}}
{{- range $relative := list ".agents/plugins/marketplace.json" ".agents/plugins/api_marketplace.json" ".claude-plugin/marketplace.json" ".cursor-plugin/marketplace.json" -}}
{{- $manifestPath := joinPath $.chezmoi.destDir $relative -}}
{{- if and (not $personalFound) (stat $manifestPath) -}}
{{- $personalFound = true -}}
{{- $manifest := include $manifestPath | fromJson -}}
{{- if and (kindIs "map" $manifest) (kindIs "string" (get $manifest "name")) (get $manifest "name") -}}
{{- $localMarketplaces = append $localMarketplaces (get $manifest "name") -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- if not (hasKey $plugins "_default") -}}
{{- $_ := set $plugins "_default" (dict) -}}
{{- end -}}
{{- range $plugin, $entry := $plugins -}}
{{- if not (kindIs "map" $entry) -}}
{{- fail (printf "Invalid Codex config.toml: plugins.%s must be a table" $plugin) -}}
{{- end -}}
{{- if or (eq $plugin "_default") (not (has (regexReplaceAll "^.*@" $plugin "") $localMarketplaces)) -}}
{{- $_ := set $entry "enabled" false -}}
{{- else if not (hasKey $entry "enabled") -}}
{{- $_ := set $entry "enabled" true -}}
{{- end -}}
{{- end -}}
{{- $features := dict -}}
{{- if hasKey $settings "features" -}}
{{- $features = get $settings "features" -}}
{{- if not (kindIs "map" $features) -}}
{{- fail "Invalid Codex config.toml: features must be a table" -}}
{{- end -}}
{{- end -}}
{{- $_ := set $features "apps" false -}}
{{- $_ := set $settings "features" $features -}}
{{- $settings | setValueAtPath "check_for_update_on_startup" false | toToml -}}
