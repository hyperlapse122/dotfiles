{{- $os := .chezmoi.os -}}
{{- $arch := .chezmoi.arch -}}
{{- $ubuntu := and (eq $os "linux") (eq (get (get .chezmoi "osRelease" | default dict) "id") "ubuntu") -}}
{{- $workstation := false -}}
{{- if and $ubuntu (eq $arch "amd64") (stat (joinPath .chezmoi.workingTree "scripts" "linux-apps.py")) -}}
{{- $host := output "mise" "--cd" .chezmoi.workingTree "exec" "python" "--" "python" (joinPath .chezmoi.workingTree "scripts" "linux-apps.py") "--inspect" | fromJson -}}
{{- $workstation = $host.supported -}}
{{- end -}}
{{- $supported := or (and (eq $os "windows") (has $arch (list "amd64" "arm64"))) (and (eq $os "darwin") (eq $arch "arm64")) $workstation -}}
{{- dict "supported" $supported "ubuntu" $ubuntu "stagedDeb" (joinPath .chezmoi.destDir ".cache" "t3-code" "t3code.deb") | toJson -}}
