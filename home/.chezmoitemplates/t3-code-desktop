{{- $os := .chezmoi.os -}}
{{- $arch := .chezmoi.arch -}}
{{- $fedora := and (eq $os "linux") (eq (get (get .chezmoi "osRelease" | default dict) "id") "fedora") -}}
{{- $workstation := false -}}
{{- if and $fedora (eq $arch "amd64") (stat (joinPath .chezmoi.workingTree "scripts" "linux-apps.py")) -}}
{{- $host := output "mise" "--cd" .chezmoi.workingTree "exec" "python" "--" "python" (joinPath .chezmoi.workingTree "scripts" "linux-apps.py") "--inspect" | fromJson -}}
{{- $workstation = $host.supported -}}
{{- end -}}
{{- $supported := or (and (eq $os "windows") (has $arch (list "amd64" "arm64"))) (and (eq $os "darwin") (eq $arch "arm64")) $workstation -}}
{{- dict "supported" $supported "fedora" $fedora "stagedAppImage" (joinPath .chezmoi.destDir ".cache" "t3-code" "t3code.AppImage") "installDirectory" (joinPath .chezmoi.destDir ".local" "share" "dotfiles" "t3-code") | toJson -}}
