if ($env:OS -eq 'Windows_NT') {
    & {
        $managed = @()
        foreach ($tool in @(
            @{ Root = $env:DOTNET_ROOT; Bin = ''; Command = 'dotnet.exe' },
            @{ Root = $env:CARGO_HOME; Bin = 'bin'; Command = 'cargo.exe' },
            @{ Root = $env:VCPKG_ROOT; Bin = ''; Command = 'vcpkg.exe' }
        )) {
            if (-not $tool.Root) { continue }
            $directory = $tool.Root
            if ($tool.Bin) { $directory = Join-Path $directory $tool.Bin }
            if (Test-Path -LiteralPath (Join-Path $directory $tool.Command) -PathType Leaf) {
                $managed += (Get-Item -LiteralPath $directory).FullName.TrimEnd('\', '/')
            }
        }
        if ($managed.Count) {
            $remaining = @($env:PATH -split ';' | Where-Object {
                $managed -notcontains $_.Trim().Trim('"').TrimEnd('\', '/')
            })
            $env:PATH = (@($managed | Select-Object -Unique) + $remaining) -join ';'
        }
    }
}
if ($IsMacOS) {
    & {
        $state = Join-Path $HOME '.local/share/dotfiles/build'
        foreach ($name in @('DOTNET_ROOT', 'CARGO_HOME', 'RUSTUP_HOME', 'VCPKG_ROOT')) {
            $file = Join-Path $state $name
            if (Test-Path -LiteralPath $file -PathType Leaf) {
                [Environment]::SetEnvironmentVariable($name, [IO.File]::ReadAllText($file).TrimEnd("`r", "`n"), 'Process')
            }
        }
        foreach ($directory in @((Join-Path $HOME '.local/bin'), (Join-Path $state 'bin'), $env:VCPKG_ROOT, $(if ($env:CARGO_HOME) { Join-Path $env:CARGO_HOME 'bin' }), $env:DOTNET_ROOT)) {
            if ($directory -and (Test-Path -LiteralPath $directory -PathType Container) -and $directory -notin ($env:PATH -split ':')) {
                $env:PATH = "$directory`:$env:PATH"
            }
        }
    }
}
(&mise activate pwsh) | Out-String | Invoke-Expression
& {
    $completionFile = Join-Path $HOME '.local/share/dotfiles/completions/dotfiles-pinentry.ps1'
    if ($PSVersionTable.PSVersion.Major -ge 7 -and (Test-Path -LiteralPath $completionFile -PathType Leaf)) {
        . $completionFile
    }
}
