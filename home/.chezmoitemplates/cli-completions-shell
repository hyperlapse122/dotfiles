{{- $existing := .chezmoi.stdin -}}
{{- $begin := "# >>> dotfiles CLI completions >>>" -}}
{{- $end := "# <<< dotfiles CLI completions <<<" -}}
{{- $markers := regexFindAll "# (?:>>>|<<<) dotfiles CLI completions" $existing -1 -}}
{{- $owned := "(?ms)^# >>> dotfiles CLI completions >>>\\r?\\n.*?^# <<< dotfiles CLI completions <<<(?:\\r?\\n|$)" -}}
{{- if $markers -}}
{{- if or (ne (len $markers) 2) (ne (len (regexFindAll $owned $existing -1)) 1) -}}
{{- fail "malformed CLI completion block; repair its delimiters before applying" -}}
{{- end -}}
{{- $existing = $existing | replaceAllRegex $owned "" -}}
{{- end -}}
{{ $begin }}
{{ if eq .shell "bash" -}}
if [[ $- == *i* ]] && (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 2) )); then
    if { ! declare -F _init_completion >/dev/null 2>&1 || (( ${BASH_COMPLETION_VERSINFO[0]:-0} < 2 || (${BASH_COMPLETION_VERSINFO[0]:-0} == 2 && ${BASH_COMPLETION_VERSINFO[1]:-0} < 11) )); } && [[ -f "$HOME/.local/share/dotfiles/bash-completion/bash_completion" ]]; then
        . "$HOME/.local/share/dotfiles/bash-completion/bash_completion"
    fi
    # Load the pinned legacy API directly when upstream startup discovery cannot quote its path.
    if ! declare -F _init_completion >/dev/null 2>&1 && declare -F _comp_initialize >/dev/null 2>&1 && [[ -f "$HOME/.local/share/dotfiles/bash-completion/startup-core/000_bash_completion_compat.bash" ]]; then
        . "$HOME/.local/share/dotfiles/bash-completion/startup-core/000_bash_completion_compat.bash"
    fi
    if declare -F _init_completion >/dev/null 2>&1 && [[ -f "$HOME/.local/share/dotfiles/completions/dotfiles-pinentry.bash" ]]; then
        . "$HOME/.local/share/dotfiles/completions/dotfiles-pinentry.bash"
    fi
fi
{{ else if eq .shell "zsh" -}}
if [[ -o interactive && -f "$HOME/.local/share/dotfiles/completions/dotfiles-pinentry.zsh" ]]; then
    if (( ! $+functions[compdef] )); then
        autoload -Uz compinit
        compinit -i
    fi
    source "$HOME/.local/share/dotfiles/completions/dotfiles-pinentry.zsh"
fi
{{ end -}}
{{ $end }}
{{ $existing -}}
