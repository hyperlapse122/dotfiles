{{- $check := `{{- $r := .chezmoi.stdin | fromJson -}}{{- if not (kindIs "map" $r) -}}{{- fail "Claude plugin command returned invalid JSON" -}}{{- end -}}{{- if eq (get $r "outcome") "ok" -}}ok{{- else if and (eq (get $r "outcome") "failed") (eq (get $r "command") "enable") (eq (get $r "failureCode") "already_in_goal_state") (eq (get $r "alreadyInGoalState") true) -}}already-enabled{{- else -}}{{- fail (printf "Claude plugin command failed: %v" (get $r "message")) -}}{{- end -}}` -}}
#!/bin/sh
set -eu

HOME='{{ .chezmoi.destDir | replace "'" "'\\''" }}'
CLAUDE_CONFIG_DIR="$HOME/.claude"
export HOME CLAUDE_CONFIG_DIR
claude="$HOME/.local/bin/claude"
chezmoi='{{ .chezmoi.executable | replace "'" "'\\''" }}'
checker='{{ $check }}'

invoke_claude_plugin() {
    status=0
    output=$("$claude" "$@" --json 2>/dev/null) || status=$?
    result=$(printf '%s\n' "$output" | tail -n 1 | "$chezmoi" --config /dev/null --source "$HOME" --destination "$HOME" execute-template --with-stdin "$checker")
    if [ "$status" -eq 0 ] && [ "$result" = ok ]; then return; fi
    if [ "$status" -eq 1 ] && [ "$result" = already-enabled ]; then return; fi
    printf 'Claude plugin command failed (exit %s)\n' "$status" >&2
    return 1
}
{{ range $name, $plugin := .harnessPlugins -}}
{{ if hasKey $plugin "claude" -}}
invoke_claude_plugin plugin marketplace add '{{ joinPath $.chezmoi.destDir ".local" "share" "dotfiles" "harness-plugins" $name | replace "'" "'\\''" }}' --scope user
invoke_claude_plugin plugin install '{{ printf "%s@%s" $plugin.claude.plugin $plugin.claude.marketplace | replace "'" "'\\''" }}' --scope user
invoke_claude_plugin plugin enable '{{ printf "%s@%s" $plugin.claude.plugin $plugin.claude.marketplace | replace "'" "'\\''" }}' --scope user
{{ end -}}
{{ end -}}
