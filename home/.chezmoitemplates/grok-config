{{- $settings := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{- $settings = .chezmoi.stdin | fromToml -}}
{{- end -}}
{{- range $key := list "cli" "compat" -}}
{{- if and (hasKey $settings $key) (not (kindIs "map" (get $settings $key))) -}}
{{- fail (printf "Invalid Grok config.toml: %s must be a table" $key) -}}
{{- end -}}
{{- end -}}
{{- $cli := get $settings "cli" | default dict -}}
{{- $cli = $cli | setValueAtPath "auto_update" false -}}
{{- $compat := get $settings "compat" | default dict -}}
{{- range $vendor := list "claude" "cursor" -}}
{{- $entry := dict -}}
{{- if hasKey $compat $vendor -}}{{- $entry = get $compat $vendor -}}{{- end -}}
{{- if not (kindIs "map" $entry) -}}
{{- fail (printf "Invalid Grok config.toml: compat.%s must be a table" $vendor) -}}
{{- end -}}
{{- $entry = $entry | setValueAtPath "agents" false | setValueAtPath "rules" false | setValueAtPath "skills" false -}}
{{- $compat = $compat | setValueAtPath $vendor $entry -}}
{{- end -}}
{{- $settings | setValueAtPath "cli" $cli | setValueAtPath "compat" $compat | toToml -}}
