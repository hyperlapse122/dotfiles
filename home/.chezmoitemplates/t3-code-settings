{{- $settings := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{- $settings = .chezmoi.stdin | fromJson -}}
{{- if not (kindIs "map" $settings) -}}
{{- fail "Invalid T3 Code settings.json: expected a settings object; refusing to replace existing settings" -}}
{{- end -}}
{{- end -}}
{{- $providers := dict -}}
{{- if hasKey $settings "providerInstances" -}}
{{- $providers = get $settings "providerInstances" -}}
{{- if not (kindIs "map" $providers) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances must be an object" -}}
{{- end -}}
{{- end -}}
{{- /* The native Google ACP driver owns the antigravity ID. Remove only our old CLI adapter. */ -}}
{{- if hasKey $providers "antigravity" -}}
{{- $native := get $providers "antigravity" -}}
{{- if not (kindIs "map" $native) -}}{{- fail "Invalid T3 Code settings.json: providerInstances.antigravity must be an object" -}}{{- end -}}
{{- if and (hasKey $native "config") (not (kindIs "map" $native.config)) -}}{{- fail "Invalid T3 Code settings.json: providerInstances.antigravity.config must be an object" -}}{{- end -}}
{{- if eq (get $native "driver") "acpRegistry" -}}
{{- $legacyPath := joinPath .chezmoi.destDir ".local/share/dotfiles/antigravity-acp/bin/antigravity-acp" | replace "\\" "/" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $legacyPath = printf "%s.exe" $legacyPath -}}{{- end -}}
{{- if ne (get (get $native "config" | default dict) "commandPath") $legacyPath -}}
{{- fail "The antigravity ID contains a custom ACP Registry provider; move it to another ID before applying" -}}
{{- end -}}
{{- $providers = omit $providers "antigravity" -}}
{{- end -}}
{{- end -}}
{{- /* Retire the omp integration while leaving its executable and user state unmanaged. */ -}}
{{- $providers = omit $providers "omp" -}}
{{- $codex := dict -}}
{{- if hasKey $providers "codex" -}}
{{- $codex = get $providers "codex" -}}
{{- if not (kindIs "map" $codex) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances.codex must be an object" -}}
{{- end -}}
{{- end -}}
{{- $codexConfig := dict -}}
{{- if hasKey $codex "config" -}}
{{- $codexConfig = get $codex "config" -}}
{{- if not (kindIs "map" $codexConfig) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances.codex.config must be an object" -}}
{{- end -}}
{{- end -}}
{{- $codexExecutable := "codex" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $codexExecutable = "codex.exe" -}}{{- end -}}
{{- $codexCommand := joinPath .chezmoi.destDir ".local" "bin" $codexExecutable | replace "\\" "/" -}}
{{- $codexConfig = $codexConfig | setValueAtPath "enabled" true | setValueAtPath "setupMode" "existing" | setValueAtPath "binaryPath" $codexCommand -}}
{{- $codex = $codex | setValueAtPath "driver" "codex" | setValueAtPath "enabled" true | setValueAtPath "config" $codexConfig -}}
{{- $providers = $providers | setValueAtPath "codex" $codex -}}
{{- $claude := dict -}}
{{- if hasKey $providers "claudeAgent" -}}
{{- $claude = get $providers "claudeAgent" -}}
{{- if not (kindIs "map" $claude) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances.claudeAgent must be an object" -}}
{{- end -}}
{{- end -}}
{{- $claudeConfig := dict -}}
{{- if hasKey $claude "config" -}}
{{- $claudeConfig = get $claude "config" -}}
{{- if not (kindIs "map" $claudeConfig) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances.claudeAgent.config must be an object" -}}
{{- end -}}
{{- end -}}
{{- $claudeExecutable := "claude" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $claudeExecutable = "claude.exe" -}}{{- end -}}
{{- $claudeCommand := joinPath .chezmoi.destDir ".local" "bin" $claudeExecutable | replace "\\" "/" -}}
{{- $claudeHome := joinPath .chezmoi.destDir ".claude" | replace "\\" "/" -}}
{{- if and (kindIs "string" (get $claudeConfig "homePath")) (eq (get $claudeConfig "homePath") $claudeHome) -}}
{{- $claudeConfig = omit $claudeConfig "homePath" -}}
{{- end -}}
{{- $claudeConfig = $claudeConfig | setValueAtPath "enabled" true | setValueAtPath "binaryPath" $claudeCommand | setValueAtPath "idleCompaction" "beforeCacheExpires" -}}
{{- $claude = $claude | setValueAtPath "driver" "claudeAgent" | setValueAtPath "enabled" true | setValueAtPath "config" $claudeConfig -}}
{{- $providers = $providers | setValueAtPath "claudeAgent" $claude -}}
{{- $piApp := get (get . "personalApps" | default dict) "pi" | default dict -}}
{{- if hasKey (get $piApp "targets" | default dict) (printf "%s-%s" .chezmoi.os .chezmoi.arch) -}}
{{- $pi := dict -}}
{{- if hasKey $providers "pi" -}}{{- $pi = get $providers "pi" -}}{{- end -}}
{{- if not (kindIs "map" $pi) -}}{{- fail "Invalid T3 Code settings.json: pi must be an object" -}}{{- end -}}
{{- $piConfig := dict -}}
{{- if hasKey $pi "config" -}}{{- $piConfig = get $pi "config" -}}{{- end -}}
{{- if not (kindIs "map" $piConfig) -}}{{- fail "Invalid T3 Code settings.json: pi.config must be an object" -}}{{- end -}}
{{- $piExecutable := "pi" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $piExecutable = "pi.exe" -}}{{- end -}}
{{- $piCommand := joinPath .chezmoi.destDir ".local" "bin" "pi-native" $piExecutable | replace "\\" "/" -}}
{{- $piConfig = $piConfig | setValueAtPath "enabled" true | setValueAtPath "binaryPath" $piCommand -}}
{{- $pi = $pi | setValueAtPath "driver" "pi" | setValueAtPath "enabled" true | setValueAtPath "config" $piConfig -}}
{{- $providers = $providers | setValueAtPath "pi" $pi -}}
{{- end -}}
{{- $grokApp := get (get . "personalApps" | default dict) "grok" | default dict -}}
{{- if hasKey (get $grokApp "targets" | default dict) (printf "%s-%s" .chezmoi.os .chezmoi.arch) -}}
{{- $grok := dict -}}
{{- if hasKey $providers "grok" -}}{{- $grok = get $providers "grok" -}}{{- end -}}
{{- if not (kindIs "map" $grok) -}}{{- fail "Invalid T3 Code settings.json: grok must be an object" -}}{{- end -}}
{{- $grokConfig := dict -}}
{{- if hasKey $grok "config" -}}{{- $grokConfig = get $grok "config" -}}{{- end -}}
{{- if not (kindIs "map" $grokConfig) -}}{{- fail "Invalid T3 Code settings.json: grok.config must be an object" -}}{{- end -}}
{{- $grokExecutable := "grok" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $grokExecutable = "grok.exe" -}}{{- end -}}
{{- $grokCommand := joinPath .chezmoi.destDir ".local" "bin" $grokExecutable | replace "\\" "/" -}}
{{- $grokConfig = $grokConfig | setValueAtPath "enabled" true | setValueAtPath "binaryPath" $grokCommand -}}
{{- $environment := list -}}
{{- if hasKey $grok "environment" -}}
{{- if not (kindIs "slice" $grok.environment) -}}{{- fail "Invalid T3 Code settings.json: grok.environment must be an array" -}}{{- end -}}
{{- range $variable := $grok.environment -}}
{{- if not (and (kindIs "map" $variable) (kindIs "string" (get $variable "name"))) -}}
{{- fail "Invalid T3 Code settings.json: grok.environment entries require string names" -}}
{{- end -}}
{{- $name := $variable.name -}}
{{- if eq $.chezmoi.os "windows" -}}{{- $name = upper $name -}}{{- end -}}
{{- if not (has $name (list "GROK_DISABLE_AUTOUPDATER" "GROK_SUBAGENTS")) -}}{{- $environment = append $environment $variable -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- $environment = append $environment (dict "name" "GROK_DISABLE_AUTOUPDATER" "value" "1" "sensitive" false) -}}
{{- $environment = append $environment (dict "name" "GROK_SUBAGENTS" "value" "0" "sensitive" false) -}}
{{- $grok = $grok | setValueAtPath "driver" "grok" | setValueAtPath "enabled" true | setValueAtPath "config" $grokConfig | setValueAtPath "environment" $environment -}}
{{- $providers = $providers | setValueAtPath "grok" $grok -}}
{{- end -}}
{{- $settings = $settings | setValueAtPath "providerInstances" $providers -}}
{{- includeTemplate "t3-code-preferences" (dict "settings" $settings "desired" .t3CodePreferences.server "file" "settings.json") -}}
