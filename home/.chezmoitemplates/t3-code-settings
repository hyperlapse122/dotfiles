{{- $settings := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{- $settings = .chezmoi.stdin | fromJson -}}
{{- if not (kindIs "map" $settings) -}}
{{- fail "Invalid T3 Code settings.json: expected a settings object; refusing to replace existing settings" -}}
{{- end -}}
{{- end -}}
{{- $providers := dict -}}
{{- if hasKey $settings "providerInstances" -}}
{{- $providers = get $settings "providerInstances" -}}
{{- if not (kindIs "map" $providers) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances must be an object" -}}
{{- end -}}
{{- end -}}
{{- $provider := dict -}}
{{- if hasKey $providers "omp" -}}
{{- $provider = get $providers "omp" -}}
{{- if not (kindIs "map" $provider) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances.omp must be an object" -}}
{{- end -}}
{{- end -}}
{{- $config := dict -}}
{{- if hasKey $provider "config" -}}
{{- $config = get $provider "config" -}}
{{- if not (kindIs "map" $config) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances.omp.config must be an object" -}}
{{- end -}}
{{- end -}}
{{- $executable := "omp" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $executable = "omp.exe" -}}{{- end -}}
{{- $command := joinPath .chezmoi.destDir ".local" "bin" $executable | replace "\\" "/" -}}
{{- $config = $config | setValueAtPath "enabled" true | setValueAtPath "source" "local" | setValueAtPath "commandPath" $command | setValueAtPath "commandArgs" (list "acp") -}}
{{- $provider = $provider | setValueAtPath "driver" "acpRegistry" | setValueAtPath "enabled" true | setValueAtPath "config" $config -}}
{{- if not (hasKey $provider "displayName") -}}
{{- $provider = $provider | setValueAtPath "displayName" "oh-my-pi" -}}
{{- end -}}
{{- if not (hasKey $provider "accentColor") -}}
{{- $provider = $provider | setValueAtPath "accentColor" "#f84fcc" -}}
{{- end -}}
{{- $providers = $providers | setValueAtPath "omp" $provider -}}
{{- $codex := dict -}}
{{- if hasKey $providers "codex" -}}
{{- $codex = get $providers "codex" -}}
{{- if not (kindIs "map" $codex) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances.codex must be an object" -}}
{{- end -}}
{{- end -}}
{{- $codexConfig := dict -}}
{{- if hasKey $codex "config" -}}
{{- $codexConfig = get $codex "config" -}}
{{- if not (kindIs "map" $codexConfig) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances.codex.config must be an object" -}}
{{- end -}}
{{- end -}}
{{- $codexExecutable := "codex" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $codexExecutable = "codex.exe" -}}{{- end -}}
{{- $codexCommand := joinPath .chezmoi.destDir ".local" "bin" $codexExecutable | replace "\\" "/" -}}
{{- $codexConfig = $codexConfig | setValueAtPath "enabled" true | setValueAtPath "setupMode" "existing" | setValueAtPath "binaryPath" $codexCommand -}}
{{- $codex = $codex | setValueAtPath "driver" "codex" | setValueAtPath "enabled" true | setValueAtPath "config" $codexConfig -}}
{{- $providers = $providers | setValueAtPath "codex" $codex -}}
{{- $claude := dict -}}
{{- if hasKey $providers "claudeAgent" -}}
{{- $claude = get $providers "claudeAgent" -}}
{{- if not (kindIs "map" $claude) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances.claudeAgent must be an object" -}}
{{- end -}}
{{- end -}}
{{- $claudeConfig := dict -}}
{{- if hasKey $claude "config" -}}
{{- $claudeConfig = get $claude "config" -}}
{{- if not (kindIs "map" $claudeConfig) -}}
{{- fail "Invalid T3 Code settings.json: providerInstances.claudeAgent.config must be an object" -}}
{{- end -}}
{{- end -}}
{{- $claudeExecutable := "claude" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $claudeExecutable = "claude.exe" -}}{{- end -}}
{{- $claudeCommand := joinPath .chezmoi.destDir ".local" "bin" $claudeExecutable | replace "\\" "/" -}}
{{- $claudeHome := joinPath .chezmoi.destDir ".claude" | replace "\\" "/" -}}
{{- if and (kindIs "string" (get $claudeConfig "homePath")) (eq (get $claudeConfig "homePath") $claudeHome) -}}
{{- $claudeConfig = omit $claudeConfig "homePath" -}}
{{- end -}}
{{- $claudeConfig = $claudeConfig | setValueAtPath "enabled" true | setValueAtPath "binaryPath" $claudeCommand -}}
{{- $claude = $claude | setValueAtPath "driver" "claudeAgent" | setValueAtPath "enabled" true | setValueAtPath "config" $claudeConfig -}}
{{- $providers = $providers | setValueAtPath "claudeAgent" $claude -}}
{{- $settings = $settings | setValueAtPath "providerInstances" $providers -}}
{{- includeTemplate "t3-code-preferences" (dict "settings" $settings "desired" .t3CodePreferences.server "file" "settings.json") -}}
