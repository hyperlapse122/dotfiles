{{- $defaults := index .gpgPlatforms .chezmoi.os -}}
{{- $name := "dotfiles-pinentry" -}}
{{- if eq .chezmoi.os "windows" }}{{ $name = printf "%s.exe" $name }}{{ end -}}
{{- dict "program" (get . "gpgProgram" | default $defaults.program) "pinentry" (joinPath .chezmoi.homeDir ".local" "bin" $name) "fallback" (get . "pinentryProgram" | default $defaults.pinentry) | toJson -}}
