{{- $existing := .chezmoi.stdin -}}
{{- $begin := "# >>> dotfiles native system CA >>>" -}}
{{- $end := "# <<< dotfiles native system CA <<<" -}}
{{- $markers := regexFindAll "# (?:>>>|<<<) dotfiles native system CA" $existing -1 -}}
{{- $owned := "(?ms)^# >>> dotfiles native system CA >>>\\r?\\n.*?^# <<< dotfiles native system CA <<<(?:\\r?\\n|$)" -}}
{{- if $markers -}}
{{- if or (ne (len $markers) 2) (ne (len (regexFindAll $owned $existing -1)) 1) -}}
{{- fail "malformed native system CA block; repair its delimiters before applying" -}}
{{- end -}}
{{- $existing = $existing | replaceAllRegex $owned "" -}}
{{- end -}}
{{- printf "%s\nexport NODE_USE_SYSTEM_CA=1\n%s\n%s" $begin $end $existing -}}
