{{- $settings := dict -}}
{{- if .chezmoi.stdin | trim -}}
{{- $settings = .chezmoi.stdin | fromJson -}}
{{- if not (kindIs "map" $settings) -}}{{- fail "Invalid Claude settings.json: expected an object" -}}{{- end -}}
{{- end -}}
{{- range $key := list "env" "enabledPlugins" "extraKnownMarketplaces" -}}
{{- if and (hasKey $settings $key) (not (kindIs "map" (get $settings $key))) -}}
{{- fail (printf "Invalid Claude settings.json: %s must be an object" $key) -}}
{{- end -}}
{{- end -}}
{{- $ce := index .harnessPlugins "compound-engineering" -}}
{{- $marketplaces := get $settings "extraKnownMarketplaces" | default dict -}}
{{- $marketplace := dict -}}
{{- if hasKey $marketplaces $ce.claude.marketplace -}}
{{- $marketplace = get $marketplaces $ce.claude.marketplace -}}
{{- end -}}
{{- if not (kindIs "map" $marketplace) -}}{{- fail "Invalid Claude CE marketplace: expected an object" -}}{{- end -}}
{{- $path := joinPath .chezmoi.destDir ".local" "share" "dotfiles" "harness-plugins" "compound-engineering" | replace "\\" "/" -}}
{{- $marketplace = $marketplace | setValueAtPath "source" (dict "source" "directory" "path" $path) | setValueAtPath "autoUpdate" false -}}
{{- $marketplaces = $marketplaces | setValueAtPath $ce.claude.marketplace $marketplace -}}
{{- $plugins := get $settings "enabledPlugins" | default dict -}}
{{- $plugins = $plugins | setValueAtPath (printf "%s@%s" $ce.claude.plugin $ce.claude.marketplace) true -}}
{{- $env := get $settings "env" | default dict -}}
{{- $env = $env | setValueAtPath "DISABLE_AUTOUPDATER" "1" -}}
{{- $env = $env | setValueAtPath "CLAUDE_CODE_USE_POWERSHELL_TOOL" "1" -}}
{{- $settings | setValueAtPath "language" "korean" | setValueAtPath "autoMemoryEnabled" false | setValueAtPath "syncClaudeAiSkills" false | setValueAtPath "syncClaudeAiPlugins" false | setValueAtPath "disableClaudeAiConnectors" true | setValueAtPath "env" $env | setValueAtPath "enabledPlugins" $plugins | setValueAtPath "extraKnownMarketplaces" $marketplaces | toPrettyJson -}}
