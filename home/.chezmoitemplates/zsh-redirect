{{- $existing := .chezmoi.stdin -}}
{{- $owned := "(?ms)^# >>> dotfiles zsh discovery >>>\\r?\\n.*?^# <<< dotfiles zsh discovery <<<(?:\\r?\\n|$)" -}}
{{- $markers := regexFindAll "# (?:>>>|<<<) dotfiles zsh discovery" $existing -1 -}}
{{- if and $markers (or (ne (len $markers) 2) (ne (len (regexFindAll $owned $existing -1)) 1)) -}}
{{- fail "malformed zsh discovery block; repair its delimiters before applying" -}}
{{- end -}}
{{- $existing = $existing | replaceAllRegex $owned "" -}}
{{- printf "%s" $existing -}}
{{ if and $existing (not (hasSuffix "\n" $existing)) }}
{{ end -}}
# >>> dotfiles zsh discovery >>>
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
[[ ! -r "$ZDOTDIR/.zshenv" || "$ZDOTDIR/.zshenv" -ef "$HOME/.zshenv" ]] || source "$ZDOTDIR/.zshenv"
# <<< dotfiles zsh discovery <<<
