{{- $manifest := includeTemplate "external-assets-manifest" . | fromToml -}}
{{- range $path := keys $manifest | sortAlpha -}}
{{- if ne $path ".local" -}}
{{- $entry := index $manifest $path -}}
{{- $kind := "file" -}}
{{- if eq $entry.type "archive" -}}{{- $kind = "directory" -}}{{- end -}}
{{ printf "%s\t%s\t%t\n" $path $kind (get $entry "exact" | default false) }}
{{- end -}}
{{- end -}}
{{- if hasKey $manifest ".local" -}}
{{- $suffix := "" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $suffix = ".exe" -}}{{- end -}}
{{- range $name := list "codex" "codex-code-mode-host" "codex-exec-server" -}}
{{ printf ".local/bin/%s%s\tfile\tfalse\n" $name $suffix }}
{{- end -}}
{{ printf ".local/codex-package.json\tfile\tfalse\n" }}
{{- range $name := list "codex-path" "codex-resources" -}}
{{ printf ".local/%s\tdirectory\ttrue\n" $name }}
{{- end -}}
{{- end -}}
