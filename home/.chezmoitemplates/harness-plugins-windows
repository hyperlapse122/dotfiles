{{- $marketplaces := includeTemplate "harness-plugin-marketplaces" . | fromJson -}}
$ErrorActionPreference = 'Stop'
$env:HOME = '{{ .chezmoi.destDir | replace "'" "''" }}'
$env:USERPROFILE = $env:HOME
$omp = Join-Path $env:HOME '.local/bin/omp.exe'

# Windows Search opens files omp has just copied into its plugin cache, and omp renames
# that staging copy without retrying, so the install fails with EPERM. Entries created
# under a directory excluded from indexing inherit the exclusion.
$pluginCache = New-Item -ItemType Directory -Force -Path (Join-Path $env:HOME '.omp/plugins/cache/plugins')
$pluginCache.Attributes = $pluginCache.Attributes -bor [IO.FileAttributes]::NotContentIndexed

function Invoke-Omp {
    & $omp @args
    if ($LASTEXITCODE -ne 0) {
        throw "omp exited with code $LASTEXITCODE"
    }
}
{{ range $entry := $marketplaces }}
{{ if $entry.remove -}}
Invoke-Omp 'plugin' 'marketplace' 'remove' '{{ $entry.remove | replace "'" "''" }}'
{{ end -}}
{{ if $entry.add -}}
Invoke-Omp 'plugin' 'marketplace' 'add' '{{ $entry.source | replace "'" "''" }}'
{{ end -}}
Invoke-Omp 'plugin' 'marketplace' 'update' '{{ $entry.marketplace | replace "'" "''" }}'
Invoke-Omp 'plugin' 'install' '--scope' 'user' '--force' '{{ $entry.plugin | replace "'" "''" }}'
Invoke-Omp 'plugin' 'enable' '--scope' 'user' '{{ $entry.plugin | replace "'" "''" }}'
{{ end -}}
