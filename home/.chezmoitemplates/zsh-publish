replace_block() {
    file=$1
    label=$2
    body=$3
    mkdir -p "$(dirname "$file")"
    temporary=$(mktemp "$file.XXXXXX")
    if [ -e "$file" ]; then
        if ! awk -v begin="# >>> dotfiles $label >>>" -v end="# <<< dotfiles $label <<<" '
            $0 == begin { if (seen++ || active) exit 1; active=1; next }
            $0 == end { if (!active) exit 1; active=0; next }
            !active { print }
            END { if (active) exit 1 }
        ' "$file" > "$temporary"; then
            rm -f "$temporary"
            printf 'Malformed dotfiles %s block in %s\n' "$label" "$file" >&2
            exit 1
        fi
    fi
    printf '# >>> dotfiles %s >>>\n%s\n# <<< dotfiles %s <<<\n' "$label" "$body" "$label" >> "$temporary"
    if [ -f "$file" ] && cmp -s "$temporary" "$file"; then
        rm -f "$temporary"
    else
        mv -f "$temporary" "$file"
    fi
}

publish_link() {
    target=$1
    link=$2
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
        return
    fi
    if [ -e "$link" ] && [ ! -L "$link" ]; then
        printf 'Cannot replace unmanaged zsh path: %s\n' "$link" >&2
        exit 1
    fi
    ln -sfn "$target" "$link"
}
