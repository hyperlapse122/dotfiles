{{- $target := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
{{- $claude := get .personalApps "claude" | default dict -}}
{{- $codex := get .personalApps "codex" | default dict -}}
{{- $antigravity := get .personalApps "antigravity" | default dict -}}
{{- $pi := get .personalApps "pi" | default dict -}}
{{- $grok := get .personalApps "grok" | default dict -}}
{{- if or (hasKey (get $grok "targets" | default dict) $target) (hasKey (get $pi "targets" | default dict) $target) (hasKey (get $codex "targets" | default dict) $target) (hasKey (get $antigravity "targets" | default dict) $target) (hasKey (get $claude "targets" | default dict) $target) -}}
{{- range $name, $plugin := .harnessPlugins -}}
{{- $pin := index $.harnessPluginLocks $name | default dict -}}
{{- if not (regexMatch "^[0-9a-f]{40}$" (get $pin "commit")) -}}
{{- fail (printf "Missing full harness plugin commit pin for %s" $name) -}}
{{- end }}
[{{ printf ".local/share/dotfiles/harness-plugins/%s" $name | quote }}]
type = "archive"
refreshPeriod = "0"
url = {{ printf "https://github.com/%s/archive/%s.tar.gz" $plugin.repository $pin.commit | quote }}
stripComponents = 1
exact = true
exclude = {{ get $plugin "archiveExclude" | default list | toJson }}
{{ end -}}
{{- end -}}
