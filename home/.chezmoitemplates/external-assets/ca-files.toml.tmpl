{{- if and (has .chezmoi.os (list "darwin" "linux")) (stat (joinPath .chezmoi.sourceDir ".secrets" "ca-certificates.json.asc")) -}}
[".local/share/dotfiles/ca/public-roots.pem"]
type = "archive-file"
refreshPeriod = "0"
url = {{ printf "%s#sha256=%s" .caFilesPublicRoots.url .caFilesPublicRoots.sha256 | quote }}
format = "zip"
path = "certifi/cacert.pem"
checksum.sha256 = {{ .caFilesPublicRoots.sha256 | quote }}
{{ end -}}
