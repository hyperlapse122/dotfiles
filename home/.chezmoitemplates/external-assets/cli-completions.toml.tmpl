{{- if ne .chezmoi.os "windows" -}}
{{- $pin := .cliCompletionAssets.bashCompletion -}}
{{- /* Use the tag archive: the release tar contains hardlinked test fixtures,
      which chezmoi rejects before include filtering. Runtime files are identical. */ -}}
[".local/share/dotfiles/bash-completion"]
type = "archive"
url = {{ printf "%s#sha256=%s" $pin.url $pin.sha256 | quote }}
checksum.sha256 = {{ $pin.sha256 | quote }}
refreshPeriod = "0"
format = "tar.gz"
stripComponents = 1
include = ["bash-completion-2.18.0/bash_completion", "bash-completion-2.18.0/startup-core", "bash-completion-2.18.0/startup-core/000_bash_completion_compat.bash", "bash-completion-2.18.0/COPYING"]
exact = true
{{- end }}
