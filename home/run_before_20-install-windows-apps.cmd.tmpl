{{ if eq .chezmoi.os "windows" -}}
@echo off
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ^
 "$ErrorActionPreference = 'Stop';" ^
 "$winget = @(Get-Command winget -CommandType Application -ErrorAction SilentlyContinue)[0];" ^
 "if (-not $winget) { throw 'WinGet is unavailable. Install or update Windows App Installer, then rerun chezmoi apply.' };" ^
 "$packages = @({{ range $index, $package := .windows.apps }}{{ if $index }}, {{ end }}'{{ $package | replace "'" "''" }}'{{ end }});" ^
 "foreach ($package in $packages) {" ^
 "Write-Host ('Ensuring {0} is installed with WinGet; approve installation prompts when requested.' -f $package);" ^
 "& $winget.Source install --id $package --exact --source winget --no-upgrade;" ^
 "$result = [long]$LASTEXITCODE -band 0xFFFFFFFFL;" ^
 "if ($result -ne 0 -and $result -ne 0x8A150061L) { throw ('Install {0} failed (exit 0x{1:X8}).' -f $package, $result) };" ^
 "}; exit 0"
exit /b %errorlevel%
{{ end -}}
