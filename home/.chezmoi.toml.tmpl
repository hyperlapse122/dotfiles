{{- $config := dict -}}
{{- if stat .chezmoi.configFile -}}
{{- $config = include .chezmoi.configFile | fromToml -}}
{{- end -}}
{{- $gpgData := include (joinPath .chezmoi.sourceDir ".chezmoidata" "gpg.yaml") | fromYaml -}}
{{- $gpg := includeTemplate "gpg-settings" (merge (dict) . $gpgData) | fromJson -}}
{{- $config = $config
    | setValueAtPath "encryption" "gpg"
    | setValueAtPath "gpg.command" $gpg.program
    | setValueAtPath "gpg.recipient" $gpgData.gpgRecipient
    | setValueAtPath "gpg.recipients" (list)
    | setValueAtPath "gpg.symmetric" false
    | setValueAtPath "gpg.args" (list "--no-options" "--no-auto-check-trustdb")
-}}
{{- if eq .chezmoi.os "windows" -}}
{{- /* Interpreter entries replace defaults; use the system runtime even when init runs inside mise. */ -}}
{{- $config = $config
    | setValueAtPath "interpreters.ps1.command" (joinPath (env "SystemRoot") "System32" "WindowsPowerShell" "v1.0" "powershell.exe")
    | setValueAtPath "interpreters.ps1.args" (list "-NoLogo" "-NoProfile" "-NonInteractive" "-ExecutionPolicy" "Bypass" "-File")
-}}
{{- $previous := dig "hooks" "apply" "pre" (dict) $config -}}
{{- $saved := dig "data" "dotfilesWindowsApplyPre" (dict) $config -}}
{{- $invocation := dict -}}
{{- if and $saved (deepEqual $previous (get $saved "generated")) -}}
{{- $previous = get $saved "original" -}}
{{- end -}}
{{- if $previous -}}
{{- if and (get $previous "command") (get $previous "script") -}}
{{- fail "The existing apply.pre hook has both command and script; resolve it before initializing." -}}
{{- end -}}
{{- $command := get $previous "command" | default "" -}}
{{- $args := get $previous "args" | default list -}}
{{- if get $previous "script" -}}
{{- $script := get $previous "script" -}}
{{- $extension := trimPrefix "." (ext $script) | lower -}}
{{- $interpreter := get .chezmoi.config.interpreters $extension | default dict -}}
{{- if get $interpreter "command" -}}
{{- $command = get $interpreter "command" -}}
{{- $args = concat (get $interpreter "args" | default list) (list $script) $args -}}
{{- else -}}
{{- $command = $script -}}
{{- end -}}
{{- end -}}
{{- $invocation = dict "command" $command "args" $args -}}
{{- end -}}
{{- $hook := dict "command" $config.interpreters.ps1.command "args" (concat $config.interpreters.ps1.args (list (joinPath .chezmoi.workingTree "scripts" "windows-apply-pre.ps1") "-Payload" ($invocation | toJson | b64enc))) -}}
{{- $config = $config
    | setValueAtPath "hooks.apply.pre" $hook
    | setValueAtPath "data.dotfilesWindowsApplyPre" (dict "original" $previous "generated" $hook)
-}}
{{- end -}}
{{- $config | setValueAtPath "sourceDir" .chezmoi.workingTree | setValueAtPath "workingTree" .chezmoi.workingTree | toToml -}}
