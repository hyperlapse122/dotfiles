{{- $target := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
{{- range $name, $app := .personalApps -}}
{{- if hasKey $app.targets $target -}}
{{- $lock := index $.personalAppLocks $name | default dict -}}
{{- $pin := index (get $lock "targets" | default dict) $target | default dict -}}
{{- if or (not (get $pin "url")) (not (get $pin "sha256")) (not (get $pin "kind")) -}}
{{- fail (printf "Missing personal application pin for %s on %s" $name $target) -}}
{{- end -}}
{{- if eq $pin.kind "archive-file" -}}
{{- if or (not (get $pin "format")) (not (get $pin "path")) -}}
{{- fail (printf "Missing personal application archive pin for %s on %s" $name $target) -}}
{{- end -}}
{{- end -}}
{{- $suffix := "" -}}
{{- if eq $.chezmoi.os "windows" -}}{{- $suffix = ".exe" -}}{{- end }}
[{{ printf ".local/bin/%s%s" $app.command $suffix | quote }}]
type = {{ $pin.kind | quote }}
url = {{ printf "%s#sha256=%s" $pin.url $pin.sha256 | quote }}
executable = true
checksum.sha256 = {{ $pin.sha256 | quote }}
{{ if eq $pin.kind "archive-file" -}}
format = {{ $pin.format | quote }}
path = {{ $pin.path | quote }}
{{ if hasKey $pin "stripComponents" -}}
stripComponents = {{ $pin.stripComponents }}
{{ end -}}
{{ end -}}
{{ end -}}
{{- end -}}
