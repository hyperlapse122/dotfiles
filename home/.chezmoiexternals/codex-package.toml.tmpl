{{- $target := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
{{- $codex := get .personalApps "codex" | default dict -}}
{{- if hasKey (get $codex "targets" | default dict) $target -}}
{{- $pin := index .personalAppLocks.codex.targets $target -}}
{{- $url := printf "%s#sha256=%s" $pin.url $pin.sha256 -}}
{{- $suffix := "" -}}
{{- if eq .chezmoi.os "windows" -}}{{- $suffix = ".exe" -}}{{- end -}}
{{- range $name := list "codex-code-mode-host" "codex-exec-server" }}
[{{ printf ".local/bin/%s%s" $name $suffix | quote }}]
type = "archive-file"
url = {{ $url | quote }}
checksum.sha256 = {{ $pin.sha256 | quote }}
format = "tar.gz"
path = {{ printf "bin/%s%s" $name $suffix | quote }}
executable = true
{{ end }}
[".local/codex-package.json"]
type = "archive-file"
url = {{ $url | quote }}
checksum.sha256 = {{ $pin.sha256 | quote }}
format = "tar.gz"
path = "codex-package.json"
{{ range $directory := list "codex-path" "codex-resources" }}
[{{ printf ".local/%s" $directory | quote }}]
type = "archive"
url = {{ $url | quote }}
checksum.sha256 = {{ $pin.sha256 | quote }}
format = "tar.gz"
stripComponents = 1
include = [{{ printf "%s/**" $directory | quote }}]
exact = true
{{ end -}}
{{- end -}}
