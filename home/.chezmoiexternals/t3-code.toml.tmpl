{{- $desktop := includeTemplate "t3-code-desktop" . | fromJson -}}
{{- if and $desktop.supported $desktop.ubuntu (not $desktop.installed) -}}
{{- $release := get . "t3CodeRelease" | default dict -}}
{{- if not $release -}}
{{- $release = output "mise" "--cd" .chezmoi.workingTree "exec" "python" "--" "python" (joinPath .chezmoi.workingTree "scripts" "t3-code-release.py") | fromJson -}}
{{- end -}}
{{- $version := get $release "tag_name" | toString | trimPrefix "v" -}}
{{- $name := printf "T3-Code-%s-%s.deb" $version .chezmoi.arch -}}
{{- $asset := dict -}}
{{- range get $release "assets" -}}
{{- if eq (get . "name" | toString) $name -}}
{{- $asset = . -}}
{{- end -}}
{{- end -}}
{{- if not $asset -}}
{{- fail (printf "T3 Code release has no Ubuntu %s desktop package (%s)" .chezmoi.arch $name) -}}
{{- end -}}
{{- $digest := get $asset "digest" | default "" | toString -}}
{{- if not (regexMatch "^sha256:[0-9a-fA-F]{64}$" $digest) -}}
{{- fail (printf "T3 Code desktop package %s has no valid SHA-256 release metadata" $name) -}}
{{- end -}}
{{- $sha256 := trimPrefix "sha256:" $digest -}}
[".cache/t3-code/t3code.deb"]
type = "file"
url = {{ printf "%s#sha256=%s" (get $asset "browser_download_url" | toString) $sha256 | quote }}
checksum.sha256 = {{ $sha256 | quote }}
{{ end -}}
