{{ if ne .chezmoi.os "darwin" }}
Library
{{ end }}
{{ if not (stat (joinPath .chezmoi.destDir ".bash_profile")) }}
.bash_profile
{{ end }}
{{ if not (stat (joinPath .chezmoi.destDir ".bash_login")) }}
.bash_login
{{ end }}
{{ $target := printf "%s-%s" .chezmoi.os .chezmoi.arch }}
{{ $apps := get . "personalApps" | default dict }}
{{ $omp := get $apps "omp" | default dict }}
{{ $targets := get $omp "targets" | default dict }}
{{ if not (hasKey $targets $target) }}
.omp
{{ else }}
{{ $agent := joinPath .chezmoi.destDir ".omp" "agent" }}
{{ if or (stat (joinPath $agent "config.yml")) (not (stat (joinPath $agent "config.yaml"))) }}
.omp/agent/config.yaml
{{ else }}
.omp/agent/config.yml
{{ end }}
{{ end }}
{{ $codex := get $apps "codex" | default dict }}
{{ if not (hasKey (get $codex "targets" | default dict) $target) }}
.codex
{{ end }}
{{ $release := get .chezmoi "osRelease" | default dict }}
{{ $t3Windows := and (eq .chezmoi.os "windows") (has .chezmoi.arch (list "amd64" "arm64")) }}
{{ $t3Posix := or (and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64")) (and (eq .chezmoi.os "linux") (eq (get $release "id") "ubuntu") (has .chezmoi.arch (list "amd64" "arm64"))) }}
{{ if not (or $t3Windows $t3Posix) }}
.t3
{{ end }}
{{ if not $t3Windows }}
.local/bin/t3.ps1
{{ end }}
{{ if not $t3Posix }}
.local/bin/t3
{{ end }}
{{ $claude := get $apps "claude" | default dict }}
{{ if not (hasKey (get $claude "targets" | default dict) $target) }}
.claude
{{ end }}
{{ $antigravity := get $apps "antigravity" | default dict }}
{{ $antigravityTargets := get $antigravity "targets" | default dict }}
{{ $antigravitySupported := hasKey $antigravityTargets $target }}
{{ if not $antigravitySupported }}
.gemini
{{ end }}
{{ if or (not $antigravitySupported) (ne .chezmoi.os "windows") }}
.local/bin/agy.ps1
.local/bin/antigravity-acp.ps1
{{ end }}
{{ if or (not $antigravitySupported) (eq .chezmoi.os "windows") }}
.local/bin/agy
.local/bin/antigravity-acp
{{ end }}
