{{ if eq .chezmoi.os "windows" -}}
{{- $gpg := includeTemplate "gpg-settings" . | fromJson -}}
@echo off
rem GnuPG prints Windows paths using the system ANSI code page.
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ^
 "$ErrorActionPreference = 'Stop';" ^
 "[Console]::OutputEncoding = [Text.Encoding]::Default; $OutputEncoding = [Console]::OutputEncoding;" ^
 "$gpgconf = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{{ printf "%s/gpgconf.exe" (dir ($gpg.program | replace "\\" "/")) | b64enc }}'));" ^
 "$expected = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{{ includeTemplate "gpg-home" . | b64enc }}'));" ^
 "$parents = @($expected, (Split-Path -Parent $expected), (Split-Path -Parent (Split-Path -Parent $expected)));" ^
 "foreach ($path in $parents) { $item = Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue;" ^
 "if ($null -ne $item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw ('Refusing to replace linked GPG directory {0}.' -f $path) } };" ^
 "$actual = & $gpgconf --list-dirs homedir;" ^
 "if ($LASTEXITCODE -ne 0) { throw ('Cannot determine the GPG home (exit {0}).' -f $LASTEXITCODE) };" ^
 "$actual = [IO.Path]::GetFullPath(($actual -join [Environment]::NewLine).Trim()).TrimEnd('\', '/');" ^
 "$expected = [IO.Path]::GetFullPath($expected).TrimEnd('\', '/');" ^
 "if (-not [string]::Equals($actual, $expected, [StringComparison]::OrdinalIgnoreCase)) {" ^
 "throw ('GPG uses {0}, but these dotfiles manage {1}. Reconcile the GPG home before applying.' -f $actual, $expected) }"
exit /b %errorlevel%
{{ end -}}
