#!/usr/bin/env bash
#
# agent-trust-reconcile: Forwarding wrapper to settings-reconcile trust.
# Asserts project trust across Claude Code and OpenAI Codex.
#
set -euo pipefail

reconciler="${RECONCILER:-}"
if [[ -z "$reconciler" || ! -x "$reconciler" ]]; then
  if [[ -x "$HOME/.local/bin/settings-reconcile" ]]; then
    reconciler="$HOME/.local/bin/settings-reconcile"
  elif command -v settings-reconcile >/dev/null 2>&1; then
    reconciler="$(command -v settings-reconcile)"
  fi
fi

if [[ -z "$reconciler" || ! -x "$reconciler" ]]; then
  echo "agent-trust-reconcile: error: settings-reconcile binary not found or not executable" >&2
  exit 127
fi

exec "$reconciler" trust "$@"
