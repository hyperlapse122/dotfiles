{{- $target := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
{{- $app := get .personalApps "antigravity" | default dict -}}
{{- if and (hasKey (get $app "targets" | default dict) $target) (ne .chezmoi.os "windows") -}}
#!/bin/sh
export AGY_CLI_DISABLE_AUTO_UPDATE=true
exec '{{ joinPath .chezmoi.destDir ".local" "share" "dotfiles" "antigravity" "bin" "agy" | replace "'" "'\\''" }}' "$@"
{{ end -}}
