{{- $target := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
{{- $app := get .personalApps "bun" | default dict -}}
{{- if and (hasKey (get $app "targets" | default dict) $target) (eq .chezmoi.os "windows") -}}
{{ "\ufeff" -}}
$ErrorActionPreference = 'Stop'
# Explicit native quoting preserves empty arguments in Windows PowerShell 5.1 too.
$arguments = @('x') + $args | ForEach-Object {
    '"' + (($_ -replace '(\\*)"', '$1$1\"') -replace '(\\+)$', '$1$1') + '"'
}
$process = Start-Process -FilePath (Join-Path $PSScriptRoot 'bun.exe') -ArgumentList $arguments -WorkingDirectory $PWD.ProviderPath -NoNewWindow -Wait -PassThru
exit $process.ExitCode
{{ end -}}
