{{- $target := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
{{- $app := get .personalApps "antigravity-acp" | default dict -}}
{{- if and (hasKey (get $app "targets" | default dict) $target) (eq .chezmoi.os "windows") -}}
@echo off
setlocal EnableExtensions DisableDelayedExpansion
set "AGY_CLI_DISABLE_AUTO_UPDATE=true"
for %%I in ("%~dp0..\share\dotfiles\antigravity\bin\agy.exe") do set "AGY_BIN=%%~fI"
set "AGY_SKIP_DOWNLOAD=1"
for %%I in ("%~dp0..\share\dotfiles\antigravity-acp\bin\antigravity-acp.exe") do set "agy_acp_bin=%%~fI"
"%agy_acp_bin%" %*
exit /b %ERRORLEVEL%
{{ end -}}
