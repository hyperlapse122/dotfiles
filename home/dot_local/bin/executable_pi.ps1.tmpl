{{ "\ufeff" -}}
$ErrorActionPreference = 'Stop'
$binary = '{{ joinPath .chezmoi.destDir ".local" "bin" "pi-native" "pi.exe" | replace "'" "''" }}'
if ($args.Count -eq 1 -and $args[0] -in @('--version', '--help')) {
    & $binary @args
    exit $LASTEXITCODE
}
$policy = '{{ joinPath .chezmoi.destDir ".pi" "agent" "dotfiles-policy.ts" | replace "'" "''" }}'
$catalog = '{{ joinPath .chezmoi.destDir ".pi" "agent" "dotfiles-model-lock.json" | replace "'" "''" }}'
if (!(Test-Path -LiteralPath $policy -PathType Leaf) -or !(Test-Path -LiteralPath $catalog -PathType Leaf)) {
    throw 'Apply the managed Pi policy and model lock first.'
}
& $binary --extension $policy @args
exit $LASTEXITCODE
