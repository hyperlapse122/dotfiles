{{- $target := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
{{- $app := get .personalApps "antigravity" | default dict -}}
{{- if and (hasKey (get $app "targets" | default dict) $target) (eq .chezmoi.os "windows") -}}
{{ "\ufeff" -}}
$ErrorActionPreference = 'Stop'
$previous = @{}
foreach ($name in @('AGY_CLI_DISABLE_AUTO_UPDATE')) {
    $previous[$name] = [Environment]::GetEnvironmentVariable($name, 'Process')
}
try {
    $env:AGY_CLI_DISABLE_AUTO_UPDATE = 'true'
    & (Join-Path $PSScriptRoot '../share/dotfiles/antigravity/bin/agy.exe') @args
    exit $LASTEXITCODE
} finally {
    foreach ($name in $previous.Keys) {
        [Environment]::SetEnvironmentVariable($name, $previous[$name], 'Process')
    }
}
{{ end -}}
