{{- $desktop := includeTemplate "t3-code-desktop" . | fromJson -}}
{{- if and $desktop.supported (eq .chezmoi.os "windows") -}}
{{ "\ufeff" -}}
$ErrorActionPreference = 'Stop'
$previous = @{}
foreach ($name in @('T3CODE_CLI_PATH', 'T3CODE_HOME', 'ELECTRON_RUN_AS_NODE', 'T3CODE_DESKTOP_CLI_LAUNCHER')) {
    $previous[$name] = [Environment]::GetEnvironmentVariable($name, 'Process')
}
try {
    $env:T3CODE_CLI_PATH = $PSCommandPath
    if (-not $env:T3CODE_HOME) {
        $env:T3CODE_HOME = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../../.t3'))
    }
    $env:ELECTRON_RUN_AS_NODE = '1'
    $env:T3CODE_DESKTOP_CLI_LAUNCHER = '1'
    foreach ($root in @($env:LOCALAPPDATA, $env:ProgramW6432, $env:ProgramFiles, ${env:ProgramFiles(x86)})) {
        if (-not $root) { continue }
        $relative = if ($root -eq $env:LOCALAPPDATA) { 'Programs/t3code/T3 Code (Beta).exe' } else { 't3code/T3 Code (Beta).exe' }
        $app = Join-Path $root $relative
        if (Test-Path -LiteralPath $app -PathType Leaf) {
            $entry = Join-Path (Split-Path $app) 'resources/server.asar/apps/server/dist/bin.mjs'
            # Electron is a GUI executable; explicitly wait and quote its native argv.
            $arguments = @($entry) + $args | ForEach-Object {
                '"' + (($_ -replace '(\\*)"', '$1$1\"') -replace '(\\+)$', '$1$1') + '"'
            }
            $process = Start-Process -FilePath $app -ArgumentList $arguments -NoNewWindow -Wait -PassThru
            exit $process.ExitCode
        }
    }
    [Console]::Error.WriteLine('T3 Code desktop is missing. Run chezmoi apply to install it, then retry t3.')
    exit 127
} finally {
    foreach ($name in $previous.Keys) {
        [Environment]::SetEnvironmentVariable($name, $previous[$name], 'Process')
    }
}
{{ end -}}
