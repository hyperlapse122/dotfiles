{{ if eq .chezmoi.os "windows" -}}
@echo off
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ^
 "$ErrorActionPreference = 'Stop';" ^
 "$body = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{{ includeTemplate "powershell-mise-profile-install" . | b64enc }}'));" ^
 "& ([scriptblock]::Create($body));" ^
 "$checkout = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{{ .chezmoi.workingTree | b64enc }}'));" ^
 "$command = '& ([scriptblock]::Create([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String(''{{ includeTemplate "powershell-mise-profile-install" . | b64enc }}''))))';" ^
 "& mise --cd $checkout exec -- pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $command;" ^
 "exit $LASTEXITCODE"
exit /b %errorlevel%
{{ end -}}
