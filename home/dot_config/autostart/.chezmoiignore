# kleopatra is the KDE/GnuPG certificate manager; only autostart it on the KDE
# targets. The desktop is the `desktop` fact (.chezmoidata/facts.yaml, resolved in
# .chezmoitemplates/facts.tmpl): `gnome` means gnome-shell on PATH WITHOUT
# plasmashell (KDE wins when both are present), and with neither desktop
# (headless, container, CI) the fact is `none` — the KDE variant — so it keeps
# deploying.
{{ $f := includeTemplate "facts.tmpl" . | fromYaml -}}
{{ if and (eq .chezmoi.os "linux") (eq $f.desktop "gnome") -}}
kleopatra.desktop
{{ end }}

# Discord and Telegram are Flatpak apps, so their autostart entries are dead
# configuration wherever the app is never installed: a non-Linux target, or a host
# with features.flatpaks off. That is the same flag the root .chezmoiignore gates
# .chezmoiscripts/30-components/40-flatpaks.sh on, read through the same
# `(default dict .features)` form so both gate sites stay greppable as one idiom.
# That form does not make the lookup fail-safe: chezmoi renders with
# missingkey=error, so a features.yaml missing the key aborts the apply here
# instead of silently changing what deploys — same as every other feature flag.
{{ if or (ne .chezmoi.os "linux") (not (default dict .features).flatpaks) -}}
discord.desktop
telegram.desktop
{{ end }}
