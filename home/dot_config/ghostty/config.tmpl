{{- /* Ghostty terminal — deploys on every target; Ghostty installs on
   Linux and macOS desktop environments. A .tmpl for ONE reason: the two font
   lines below. The family and size come from .chezmoidata/fonts.yaml
   (`fonts.families.mono`, `fonts.sizes.terminal`) — the single font source
   shared with the KDE/GNOME font scripts, fcitx5 classicui config, and
   VSCodium settings — so changing the mono face is a ONE-FILE edit instead
   of a multi-file hunt. `terminal` is the dedicated terminal font size,
   deliberately separate from the shared `sizes.mono`.
   Everything else here is Ghostty's own settings surface and stays literal. */ -}}
# ~/.config/ghostty/config — managed by chezmoi.
#
# Font family and size render from fonts.yaml — edit the yaml, not here.
# Docs: https://ghostty.org/docs/config

# --- font ---
font-family = {{ .fonts.families.mono }}
font-size = {{ .fonts.sizes.terminal }}

# --- theme ---
theme = catppuccin-mocha

# --- window geometry, padding & decoration ---
window-width = 128
window-height = 24
window-decoration = auto
window-inherit-working-directory = true
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true
window-padding-color = extend

# --- visual styling ---
background-opacity = 0.95
background-blur = true

# --- cursor ---
cursor-style = block
cursor-style-blink = true

# --- input & clipboard ---
copy-on-select = clipboard

# --- keybindings (tabs & splits) ---
keybind = ctrl+shift+t=new_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+s=new_split:down
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:top
keybind = alt+down=goto_split:bottom
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits

# --- quick terminal (dropdown / scratchpad) ---
quick-terminal-position = top
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# --- url & link handling ---
link-url = true

# --- terminal behavior & scrollback ---
scrollback-limit = 50000
bell-features = no-audio,no-system,no-attention,no-title,no-border
confirm-close-surface = true
