set -eu
exec mise --cd '{{ .chezmoi.workingTree | replace "'" "'\"'\"'" }}' exec -- python '{{ joinPath .chezmoi.workingTree "scripts" "ca-files.py" | replace "'" "'\"'\"'" }}' apply --source '{{ .chezmoi.workingTree | replace "'" "'\"'\"'" }}' --config '{{ .chezmoi.configFile | replace "'" "'\"'\"'" }}' --destination '{{ .chezmoi.destDir | replace "'" "'\"'\"'" }}'
{{ end -}}
