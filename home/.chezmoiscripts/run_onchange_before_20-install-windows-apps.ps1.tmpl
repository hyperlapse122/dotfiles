{{ if eq .chezmoi.os "windows" -}}
{{ "\ufeff" -}}
# data windows.apps sha256: {{ .windows.apps | toJson | sha256sum }}
$ErrorActionPreference = 'Stop'
$winget = @(Get-Command winget -CommandType Application -ErrorAction SilentlyContinue)[0]
if (-not $winget) {
    throw 'WinGet is unavailable. Install or update Windows App Installer, then rerun chezmoi apply.'
}
$packages = @({{ range $index, $package := .windows.apps }}{{ if $index }}, {{ end }}'{{ $package | replace "'" "''" }}'{{ end }})
foreach ($package in $packages) {
    Write-Host ('Ensuring {0} is installed with WinGet; approve installation prompts when requested.' -f $package)
    $installArgs = @('install', '--id', $package, '--exact', '--source', 'winget', '--no-upgrade')
    & $winget.Source @installArgs
    $result = [long]$LASTEXITCODE -band 0xFFFFFFFFL
    if ($result -ne 0 -and $result -ne 0x8A150061L) {
        throw ('Install {0} failed (exit 0x{1:X8}).' -f $package, $result)
    }
}
{{ end -}}
