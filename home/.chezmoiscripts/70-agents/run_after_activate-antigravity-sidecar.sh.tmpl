{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env bash
set -euo pipefail

# Retry after a missing user session and repair a stopped service on each apply.
binary="$HOME/.local/bin/antigravity-sidecar"
[[ -x "$binary" ]] || { echo "antigravity-sidecar: missing executable $binary" >&2; exit 1; }
state_dir="$HOME/.local/state/dotfiles-antigravity-sidecar"
[[ ! -L "$state_dir" ]] || { echo "antigravity-sidecar: state directory is a symlink" >&2; exit 1; }
mkdir -p "$state_dir"
chmod 0700 "$state_dir"
state="$state_dir/service-revision"
[[ ! -L "$state" ]] || { echo "antigravity-sidecar: revision file is a symlink" >&2; exit 1; }
{{ if eq .chezmoi.os "linux" -}}
{{ $bus := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "user-manager-bus-present") -}}
{{ includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list (dict "name" "user-manager-bus-present" "value" $bus))) }}
unit="$HOME/.config/systemd/user/antigravity-sidecar.service"
{{ includeTemplate "user-manager-deadline-guard.sh.tmpl" (dict "ctx" . "name" "antigravity-sidecar" "includeReload" true) }}
if ! timeout -k "$user_manager_term_grace_secs" "$user_manager_deadline_secs" systemctl --user show-environment >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "activate-antigravity-sidecar" "site" "no-user-manager-bus" "direction" "transient-blocking" "probe" "user-manager-bus-present" "reason" "the user manager bus is unavailable; sidecar activation will retry on the next apply") | trim | indent 2 }}
fi
{{ else -}}
unit="$HOME/Library/LaunchAgents/app.dotfiles.antigravity-sidecar.plist"
{{ end -}}
revision=$(cksum "$binary" "$unit")
previous=''
[[ ! -f "$state" ]] || previous=$(cat "$state")
{{ if eq .chezmoi.os "linux" -}}
if [[ "$revision" != "$previous" ]]; then
  timeout -k "$user_manager_term_grace_secs" "$user_manager_reload_deadline_secs" systemctl --user daemon-reload
  timeout -k "$user_manager_term_grace_secs" "$user_manager_reload_deadline_secs" systemctl --user restart antigravity-sidecar.service
else
  timeout -k "$user_manager_term_grace_secs" "$user_manager_reload_deadline_secs" systemctl --user start antigravity-sidecar.service
fi
{{ else -}}
domain="gui/$(id -u)"
service="$domain/app.dotfiles.antigravity-sidecar"
if launchctl print "$service" >/dev/null 2>&1; then
  if [[ "$revision" != "$previous" ]]; then
    launchctl bootout "$service"
    launchctl bootstrap "$domain" "$unit"
  else
    launchctl kickstart "$service"
  fi
else
  launchctl bootstrap "$domain" "$unit"
fi
{{ end -}}
temporary=$(mktemp "$state.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
printf '%s\n' "$revision" >"$temporary"
mv -f -- "$temporary" "$state"
{{ end -}}
