{{- $isFedora := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
{{- $isUbuntu := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") -}}
{{- if or $isFedora $isUbuntu -}}
#!/usr/bin/env bash
#
# Steady-state convergence for the GPG stack and paper-backup ceremony tools
# declared in .chezmoidata/gpg.yaml. Deliberately `run_after_`, not
# `run_onchange_`: an onchange script re-runs only when its own rendered
# content hash changes, never when a package is later removed by hand, so it
# cannot restore anything on the next apply. This runs unconditionally, every
# apply, and installs only what is missing.
set -euo pipefail

{{ includeTemplate "facts-sh.tmpl" . }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-gpg-packages") }}
{{ includeTemplate "sudo-elevation-guard.sh.tmpl" (dict "ctx" . "name" "install-gpg-packages.sh") -}}

gpg_packages=(
{{ if $isFedora -}}
{{   range .gpg.packages.fedora.core }}  {{ . | quote }}
{{   end -}}
{{   range .gpg.packages.fedora.paperBackup }}  {{ . | quote }}
{{   end -}}
{{ else if $isUbuntu -}}
{{   range .gpg.packages.debian.core }}  {{ . | quote }}
{{   end -}}
{{   range .gpg.packages.debian.paperBackup }}  {{ . | quote }}
{{   end -}}
{{ end -}}
)

case "${FACT_DESKTOP:-none}" in
  kde) gpg_packages+=({{ .gpg.packages.desktopPinentry.kde | quote }}) ;;
  gnome) gpg_packages+=({{ .gpg.packages.desktopPinentry.gnome | quote }}) ;;
  *) ;;
esac

{{ if $isFedora -}}
# A declared name is a capability, not necessarily a package name. `dnf install
# <name>` is satisfied by whichever installed package provides <name>, so the
# inspection that decides what to install asks the same question.
missing=()
if ! rpm -q --whatprovides "${gpg_packages[@]}" >/dev/null 2>&1; then
  for pkg in "${gpg_packages[@]}"; do
    rpm -q --whatprovides "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
  done
fi

if [[ "${#missing[@]}" -gt 0 ]]; then
  "${SUDO[@]}" dnf install -y "${missing[@]}"
fi
{{ else if $isUbuntu -}}
is_apt_installed() {
  local status
  status="$(dpkg-query -f '${db:Status-Status}' -W "$1" 2>/dev/null)" || status=''
  [[ "$status" == installed ]]
}

missing=()
for pkg in "${gpg_packages[@]}"; do
  is_apt_installed "$pkg" || missing+=("$pkg")
done

if [[ "${#missing[@]}" -gt 0 ]]; then
  "${SUDO[@]}" apt-get update -qq || true
  "${SUDO[@]}" apt-get install -y "${missing[@]}"
fi
{{ end -}}
{{ end -}}
