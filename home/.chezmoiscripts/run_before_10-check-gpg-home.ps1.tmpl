{{ if eq .chezmoi.os "windows" -}}
{{- $gpg := includeTemplate "gpg-settings" . | fromJson -}}
{{ "\ufeff" -}}
# file gpg-settings sha256: {{ include ".chezmoitemplates/gpg-settings" | sha256sum }}
# file gpg-home sha256: {{ include ".chezmoitemplates/gpg-home" | sha256sum }}
# data gpg.program sha256: {{ dict "program" $gpg.program | toJson | sha256sum }}
$ErrorActionPreference = 'Stop'
# Native GnuPG paths are UTF-8; ANSI getenv can already corrupt GNUPGHOME upstream.
[Console]::OutputEncoding = [Text.Encoding]::UTF8
$OutputEncoding = [Console]::OutputEncoding
$gpgconf = '{{ printf "%s/gpgconf.exe" (dir ($gpg.program | replace "\\" "/")) | replace "'" "''" }}'
$expected = '{{ includeTemplate "gpg-home" . | replace "'" "''" }}'
$parents = @($expected, (Split-Path -Parent $expected), (Split-Path -Parent (Split-Path -Parent $expected)))
foreach ($path in $parents) {
    $item = Get-Item -LiteralPath $path -Force -ErrorAction SilentlyContinue
    if ($null -ne $item -and ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
        throw ('Refusing to replace linked GPG directory {0}.' -f $path)
    }
}
$actual = & $gpgconf --list-dirs homedir
if ($LASTEXITCODE -ne 0) {
    throw ('Cannot determine the GPG home (exit {0}).' -f $LASTEXITCODE)
}
$actual = [IO.Path]::GetFullPath(($actual -join [Environment]::NewLine).Trim()).TrimEnd('\', '/')
$expected = [IO.Path]::GetFullPath($expected).TrimEnd('\', '/')
$sameHome = [string]::Equals($actual, $expected, [StringComparison]::OrdinalIgnoreCase)
if (-not $sameHome -and (Test-Path -LiteralPath $actual -PathType Container) -and
    (Test-Path -LiteralPath $expected -PathType Container)) {
    if (-not ('DotfilesGpgDirectoryIdentity' -as [type])) {
        Add-Type -TypeDefinition @'
using System;
using System.ComponentModel;
using System.Runtime.InteropServices;
using Microsoft.Win32.SafeHandles;
public static class DotfilesGpgDirectoryIdentity {
    [StructLayout(LayoutKind.Sequential)]
    private struct Identity {
        public ulong Volume, Low, High;
    }
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, ExactSpelling = true, SetLastError = true)]
    private static extern SafeFileHandle CreateFileW(
        string path, uint access, uint share, IntPtr security,
        uint disposition, uint flags, IntPtr template);
    [DllImport("kernel32.dll", ExactSpelling = true, SetLastError = true)]
    private static extern bool GetFileInformationByHandleEx(
        SafeFileHandle handle, int informationClass, out Identity info, uint size);
    public static bool Same(string left, string right) {
        // OPEN_EXISTING, shared read/write/delete, FILE_FLAG_BACKUP_SEMANTICS.
        using (var a = CreateFileW(left, 0, 7, IntPtr.Zero, 3, 0x02000000, IntPtr.Zero)) {
            if (a.IsInvalid) throw new Win32Exception(Marshal.GetLastWin32Error());
            using (var b = CreateFileW(right, 0, 7, IntPtr.Zero, 3, 0x02000000, IntPtr.Zero)) {
                if (b.IsInvalid) throw new Win32Exception(Marshal.GetLastWin32Error());
                Identity x, y;
                // FileIdInfo (18) returns a 24-byte volume serial and 128-bit file ID.
                if (!GetFileInformationByHandleEx(a, 18, out x, 24))
                    throw new Win32Exception(Marshal.GetLastWin32Error());
                if (!GetFileInformationByHandleEx(b, 18, out y, 24))
                    throw new Win32Exception(Marshal.GetLastWin32Error());
                return x.Volume == y.Volume && x.Low == y.Low && x.High == y.High;
            }
        }
    }
}
'@
    }
    $sameHome = [DotfilesGpgDirectoryIdentity]::Same($actual, $expected)
}
if (-not $sameHome) {
    throw ('GPG uses {0}, but these dotfiles manage {1}. Reconcile the GPG home before applying.' -f $actual, $expected)
}
{{ end -}}
