{{- $desktop := includeTemplate "t3-code-desktop" . | fromJson -}}
{{- if and $desktop.supported (ne .chezmoi.os "windows") -}}
#!/bin/sh
# file t3-code-desktop sha256: {{ include ".chezmoitemplates/t3-code-desktop" | sha256sum }}
set -eu
{{ if eq .chezmoi.os "darwin" -}}
home='{{ .chezmoi.destDir | replace "'" "'\\''" }}'
for bundle in "$home/Applications/T3 Code (Beta).app" '/Applications/T3 Code (Beta).app'; do
    if [ -x "$bundle/Contents/MacOS/T3 Code (Beta)" ]; then
        exit 0
    fi
done
brew=/opt/homebrew/bin/brew
if [ ! -x "$brew" ]; then
    echo 'T3 Code installation requires native Apple Silicon Homebrew at /opt/homebrew. Install Homebrew, then run chezmoi apply again.' >&2
    exit 1
fi
# A registered cask may use a custom appdir; never upgrade an existing installation.
if "$brew" list --cask t3-code >/dev/null 2>&1; then
    exit 0
fi
"$brew" install --yes --cask t3-code
{{ else -}}
if [ -x '/opt/T3 Code (Beta)/t3code' ]; then
    exit 0
fi
if [ "$(dpkg-query -W -f='${Status}' t3code 2>/dev/null || true)" = 'install ok installed' ]; then
    exit 0
fi
if ! command -v apt-get >/dev/null 2>&1 || ! command -v dpkg-query >/dev/null 2>&1; then
    echo 'T3 Code installation requires Ubuntu apt and Debian package tooling.' >&2
    exit 1
fi
package='{{ $desktop.stagedDeb | replace "'" "'\\''" }}'
if [ ! -f "$package" ]; then
    echo 'T3 Code desktop package is not staged. Run chezmoi apply again to fetch the declared external.' >&2
    exit 1
fi
sudo apt-get install -- "$package"
{{ end -}}
{{ end -}}
