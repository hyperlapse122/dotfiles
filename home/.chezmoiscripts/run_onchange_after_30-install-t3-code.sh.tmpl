{{- $desktop := includeTemplate "t3-code-desktop" . | fromJson -}}
{{- if and $desktop.supported (ne .chezmoi.os "windows") -}}
#!/bin/sh
# file t3-code-desktop sha256: {{ include ".chezmoitemplates/t3-code-desktop" | sha256sum }}
set -eu
{{ if eq .chezmoi.os "darwin" -}}
home='{{ .chezmoi.destDir | replace "'" "'\\''" }}'
for bundle in "$home/Applications/T3 Code (Beta).app" '/Applications/T3 Code (Beta).app'; do
    if [ -x "$bundle/Contents/MacOS/T3 Code (Beta)" ]; then
        exit 0
    fi
done
brew=/opt/homebrew/bin/brew
if [ ! -x "$brew" ]; then
    echo 'T3 Code installation requires native Apple Silicon Homebrew at /opt/homebrew. Install Homebrew, then run chezmoi apply again.' >&2
    exit 1
fi
# A registered cask may use a custom appdir; never upgrade an existing installation.
if "$brew" list --cask t3-code >/dev/null 2>&1; then
    exit 0
fi
"$brew" install --yes --cask t3-code
{{ else -}}
install='{{ $desktop.installDirectory | replace "'" "'\\''" }}'
if [ -x "$install/t3code" ]; then
    exit 0
fi
appimage='{{ $desktop.stagedAppImage | replace "'" "'\\''" }}'
if [ ! -f "$appimage" ]; then
    echo 'T3 Code AppImage is not staged. Run chezmoi apply again to fetch the declared external.' >&2
    exit 1
fi
# The AppImage runtime extracts itself into squashfs-root in the working directory, without FUSE.
mkdir -p "$(dirname "$install")"
work=$(mktemp -d "$install.XXXXXX")
trap 'rm -rf "$work"' EXIT
(cd "$work" && "$appimage" --appimage-extract >/dev/null)
rm -rf "$install"
mv "$work/squashfs-root" "$install"
if [ ! -x "$install/t3code" ]; then
    echo "T3 Code AppImage did not extract a t3code binary into $install." >&2
    exit 1
fi
applications='{{ joinPath .chezmoi.destDir ".local" "share" "applications" | replace "'" "'\\''" }}'
mkdir -p "$applications"
launch="\"$install/t3code\" %U"
shipped=
for candidate in "$install"/*.desktop; do
    if [ -f "$candidate" ]; then
        shipped=$candidate
        break
    fi
done
if [ -n "$shipped" ]; then
    # The shipped entry launches AppRun and names a theme icon; neither resolves outside the AppImage.
    icon=$(sed -n 's/^Icon=//p' "$shipped" | head -n 1)
    if [ -f "$install/$icon.png" ]; then
        icon="$install/$icon.png"
    fi
    T3_LAUNCH="$launch" T3_ICON="$icon" awk '
        /^Exec=/ { print "Exec=" ENVIRON["T3_LAUNCH"]; next }
        /^Icon=/ { print "Icon=" ENVIRON["T3_ICON"]; next }
        { print }
    ' "$shipped" >"$applications/t3code.desktop"
else
    cat >"$applications/t3code.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=T3 Code (Beta)
Exec=$launch
Terminal=false
EOF
fi
{{ end -}}
{{ end -}}
