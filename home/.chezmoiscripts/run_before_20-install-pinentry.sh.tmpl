{{ if ne .chezmoi.os "windows" -}}
{{- $gpg := includeTemplate "gpg-settings" . | fromJson -}}
#!/bin/sh
set -eu
source='{{ .chezmoi.workingTree | replace "'" "'\\''" }}'
target='{{ $gpg.pinentry | replace "'" "'\\''" }}'
mise --cd "$source" run pinentry:build
binary="$source/target/release/dotfiles-pinentry"
mkdir -p "$(dirname "$target")"
if ! cmp -s "$binary" "$target"; then
    install -m 755 "$binary" "$target"
fi
chmod 755 "$target"
{{ end -}}
