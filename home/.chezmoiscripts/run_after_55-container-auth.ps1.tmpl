{{ if and (eq .chezmoi.os "windows") (stat (joinPath .chezmoi.sourceDir ".secrets" "container-auth.json.asc")) -}}
$ErrorActionPreference = 'Stop'
& mise --cd '{{ .chezmoi.workingTree | replace "'" "''" }}' exec -- python '{{ joinPath .chezmoi.workingTree "scripts" "container-auth.py" | replace "'" "''" }}' apply --source '{{ .chezmoi.workingTree | replace "'" "''" }}' --config '{{ .chezmoi.configFile | replace "'" "''" }}' --destination '{{ .chezmoi.destDir | replace "'" "''" }}'
exit $LASTEXITCODE
{{ end -}}
