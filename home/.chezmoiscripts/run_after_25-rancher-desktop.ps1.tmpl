{{ if eq .chezmoi.os "windows" -}}
{{ "\ufeff" -}}
$ErrorActionPreference = 'Stop'

function Find-RancherTool([string]$Name) {
    $command = @(Get-Command $Name -CommandType Application -ErrorAction SilentlyContinue)[0]
    if ($command) { return $command.Source }

    $installRoots = @()
    if ($env:ProgramFiles) { $installRoots += Join-Path $env:ProgramFiles 'Rancher Desktop' }
    if ($env:LOCALAPPDATA) { $installRoots += Join-Path $env:LOCALAPPDATA 'Programs\Rancher Desktop' }
    foreach ($root in $installRoots) {
        $bin = Join-Path $root 'resources\resources\win32\bin'
        foreach ($extension in @('.exe', '.cmd')) {
            $candidate = Join-Path $bin ($Name + $extension)
            if (Test-Path -LiteralPath $candidate -PathType Leaf) { return $candidate }
        }
    }
    throw ('Rancher Desktop bundled {0} was not found in PATH or its installation directories. Install or repair Rancher Desktop, then rerun chezmoi apply.' -f $Name)
}

$rdctl = Find-RancherTool 'rdctl'
$kubectl = $null
foreach ($extension in @('.exe', '.cmd')) {
    $candidate = Join-Path (Split-Path -Parent $rdctl) ('kubectl' + $extension)
    if (Test-Path -LiteralPath $candidate -PathType Leaf) { $kubectl = $candidate; break }
}
if (-not $kubectl) { throw 'Rancher Desktop bundled kubectl was not found beside rdctl. Repair the Rancher Desktop installation and rerun chezmoi apply.' }
$deadline = (Get-Date).AddSeconds(300)
$startup = Start-Process -FilePath $rdctl -ArgumentList @('start', '--kubernetes.enabled=true', '--no-modal-dialogs') -NoNewWindow -PassThru
try {
    $null = $startup.Handle
    $milliseconds = [Math]::Max(0, [Math]::Floor(($deadline - (Get-Date)).TotalMilliseconds))
    if (-not $startup.WaitForExit([int]$milliseconds)) {
        $startup.Kill()
        throw 'Rancher Desktop startup timed out within 300 seconds. Check Rancher Desktop diagnostics and rerun chezmoi apply.'
    }
    if ($startup.ExitCode -ne 0) {
        throw ('Rancher Desktop startup failed (exit {0}). Check Rancher Desktop diagnostics, then rerun chezmoi apply.' -f $startup.ExitCode)
    }
} finally {
    $startup.Dispose()
}

$diagnostic = 'No Kubernetes readiness response was received.'
while (($remaining = ($deadline - (Get-Date)).TotalSeconds) -gt 0) {
    $requestTimeout = [Math]::Min(5, [Math]::Floor($remaining))
    if ($requestTimeout -lt 1) { break }
    # Windows PowerShell represents native stderr as error records. Capture them
    # as readiness diagnostics instead of terminating before the deadline.
    $ErrorActionPreference = 'Continue'
    $response = & $kubectl --context rancher-desktop "--request-timeout=$($requestTimeout)s" get nodes -o json 2>&1
    $result = $LASTEXITCODE
    $ErrorActionPreference = 'Stop'
    if ($result -eq 0) {
        try {
            $nodes = ($response -join "`n") | ConvertFrom-Json
            $readyNodes = @($nodes.items | Where-Object {
                @($_.status.conditions | Where-Object { $_.type -eq 'Ready' -and $_.status -eq 'True' }).Count -gt 0
            })
            if ($readyNodes.Count -gt 0) {
                Write-Host 'Rancher Desktop Kubernetes is ready (context: rancher-desktop).'
                return
            }
            $diagnostic = 'The API is reachable, but no Ready node was reported.'
        } catch {
            $diagnostic = 'Could not read Kubernetes node data: ' + $_.Exception.Message
        }
    } else {
        $diagnostic = 'kubectl exited {0}: {1}' -f $result, ($response -join "`n")
    }
    $remaining = ($deadline - (Get-Date)).TotalSeconds
    $sleepSeconds = [Math]::Min(5, [Math]::Floor($remaining))
    if ($sleepSeconds -lt 1) { break }
    Start-Sleep -Seconds $sleepSeconds
}
throw ('Rancher Desktop Kubernetes was not ready within 300 seconds (context: rancher-desktop). Check Rancher Desktop diagnostics and rerun chezmoi apply. Last check: {0}' -f $diagnostic)
{{ end -}}
