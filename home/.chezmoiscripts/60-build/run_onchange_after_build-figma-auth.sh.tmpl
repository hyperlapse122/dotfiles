{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ $repoRoot := includeTemplate "repo-root.tmpl" $sourceDir -}}
{{ $bunVersion := includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "bun") -}}
#!/usr/bin/env bash
set -euo pipefail
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/sbin:"*) ;;
  *) PATH="$HOME/.local/sbin:$PATH" ;;
esac
export PATH

{{ includeTemplate "fingerprint.tmpl" (dict "sourceDir" $repoRoot
      "globs" (list "mise.toml" "packages/package.json" "packages/bun.lock" "packages/bunfig.toml" "packages/vite.config.ts" "packages/figma-auth/package.json" "packages/figma-auth/tsconfig.json" "packages/figma-auth/vite.config.ts" "packages/figma-auth/src/**")
      "values" (list (dict "name" "bun-version" "value" $bunVersion))) }}

{{ includeTemplate "repo-root.sh.tmpl" | trim }}
SRC="$repo_root"
export DOTFILES_BUN_VERSION="{{ $bunVersion }}"
DIST="$SRC/packages/figma-auth/dist/figma-auth"
STAGING_DIR="$HOME/.local/share/chezmoi-commands/incomplete/figma-auth"
TARGET="$STAGING_DIR/figma-auth"

MISE_BIN="mise"
if ! command -v "$MISE_BIN" >/dev/null 2>&1; then
  if [[ -x "$HOME/.local/bin/mise" ]]; then
    MISE_BIN="$HOME/.local/bin/mise"
  elif [[ -x "$HOME/.local/share/chezmoi-commands/incomplete/mise/mise" ]]; then
    MISE_BIN="$HOME/.local/share/chezmoi-commands/incomplete/mise/mise"
  else
    echo "build-figma-auth: mise is not installed; figma-auth build cannot run" >&2
    exit 1
  fi
fi

{{ includeTemplate "bun-resolve.sh.tmpl" | trim }}
if [[ -z "$BUN_BIN" ]]; then
  printf '%s\n' 'build-figma-auth: bun is not installed; figma-auth build cannot run' >&2
  exit 1
fi

if ! "$MISE_BIN" -C "$SRC/packages" exec -- vp install --frozen-lockfile; then
  printf '%s\n' 'build-figma-auth: dependency installation failed; fix the package lock or registry access, then re-apply.' >&2
  exit 1
fi
if ! "$MISE_BIN" -C "$SRC/packages/figma-auth" exec -- vp run build; then
  printf '%s\n' 'build-figma-auth: build failed; fix the figma-auth build error, then re-apply.' >&2
  exit 1
fi
if [[ ! -f "$DIST" || ! -x "$DIST" ]]; then
  printf '%s\n' 'build-figma-auth: build completed without an executable dist artifact; inspect the build output, then re-apply.' >&2
  exit 1
fi

ancestor="$STAGING_DIR"
while [[ "$ancestor" != "$HOME" && "$ancestor" != / ]]; do
  if [[ -L "$ancestor" ]]; then
    printf 'build-figma-auth: staging path is a symlink: %s\n' "$ancestor" >&2
    exit 1
  fi
  ancestor=${ancestor%/*}
done
mkdir -p "$STAGING_DIR"
temporary=""
cleanup() {
  if [[ -n "$temporary" ]]; then rm -f -- "$temporary"; fi
}
on_hup() { trap - HUP INT TERM; cleanup; exit 129; }
on_int() { trap - HUP INT TERM; cleanup; exit 130; }
on_term() { trap - HUP INT TERM; cleanup; exit 143; }
trap cleanup EXIT
trap on_hup HUP
trap on_int INT
trap on_term TERM

if [[ -L "$TARGET" || ( -e "$TARGET" && ! -f "$TARGET" ) ]]; then
  echo "build-figma-auth: the figma-auth install target is not a regular file; existing target is preserved" >&2
  exit 1
fi

temporary="$(mktemp "$STAGING_DIR/.figma-auth.XXXXXX")"
chmod 0600 "$temporary"
cp -- "$DIST" "$temporary"
chmod 0755 "$temporary"
mv -f -- "$temporary" "$TARGET"
temporary=""
if [[ ! -f "$TARGET" || -L "$TARGET" || ! -x "$TARGET" ]]; then
  echo "build-figma-auth: the promoted figma-auth target is not a regular executable" >&2
  exit 1
fi
printf '%s\n' 'build-figma-auth: staged figma-auth'
{{ end -}}
