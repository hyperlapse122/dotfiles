{{ if and (ne .chezmoi.os "windows") (stat (joinPath .chezmoi.sourceDir ".secrets" "ssh-identities.json.asc")) -}}
#!/bin/sh
set -eu
exec mise --cd '{{ .chezmoi.workingTree | replace "'" "'\"'\"'" }}' exec -- python '{{ joinPath .chezmoi.workingTree "scripts" "ssh-identities.py" | replace "'" "'\"'\"'" }}' apply --source '{{ .chezmoi.workingTree | replace "'" "'\"'\"'" }}' --config '{{ .chezmoi.configFile | replace "'" "'\"'\"'" }}' --destination '{{ .chezmoi.destDir | replace "'" "'\"'\"'" }}'
{{ end -}}
