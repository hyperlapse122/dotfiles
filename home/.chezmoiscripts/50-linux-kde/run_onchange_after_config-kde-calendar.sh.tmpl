{{ if eq .chezmoi.os "linux" -}}
{{ $kconfigPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "kwriteconfig6-present") -}}
{{ $mariadbPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "mariadb-present") -}}
{{ $akonadiSocketPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "akonadi-socket-present") -}}
#!/usr/bin/env bash
#
# Enables calendar popup features in the Digital Clock:
#   a) enabledCalendarPlugins = kde.calendar.plugins on each digitalclock
#   b) selectedRegions        = kde.calendar.holidayRegions in
#                                plasma_calendar_holiday_regions
#   c) calendars              = all local Akonadi calendar collection IDs in
#                                plasmashellrc [PIMEventsPlugin]
#
# The (a) and (b) values are DATA, not script: .chezmoidata/kde.yaml
# `kde.calendar` is the single source of truth (see its header) — edit the yaml,
# not this file. The applet-discovery loop, the plugin id it matches on, and the
# Akonadi query stay here: they are structure, and (c)'s collection IDs are
# per-host database rows that can only be discovered at runtime.
#
# Sub-step (c) is discovered at runtime by querying Akonadi's local MariaDB.
# Missing mariadb, an absent socket, and an empty collection set are DECLARED
# classified outcomes; a failed query on a reachable socket is a hard error,
# because the calendars key would silently stay unconfigured.
#
# Capability fingerprints pair each transient-blocking declaration below with
# the cached precondition it names. Comment-only; never executed.
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list
      (dict "name" "kwriteconfig6-present" "value" $kconfigPresent)
      (dict "name" "mariadb-present" "value" $mariadbPresent)
      (dict "name" "akonadi-socket-present" "value" $akonadiSocketPresent))) }}
set -euo pipefail

{{ includeTemplate "kde-guard.sh.tmpl" (dict "ctx" . "name" "config-kde-calendar.sh") -}}

# KConfig stores both keys as a comma-separated list, so the yaml sequences are
# rendered joined — the list shape lives in the data, the delimiter here.
PLUGINS="{{ join "," .kde.calendar.plugins }}"
HOLIDAY_REGIONS="{{ join "," .kde.calendar.holidayRegions }}"

configure_calendar() {
  printf 'config-kde-calendar.sh: enabling %s, regions %s, all PIM calendars...\n' \
    "$PLUGINS" "$HOLIDAY_REGIONS"

  if ! command -v kwriteconfig6 >/dev/null 2>&1 || ! command -v kreadconfig6 >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-calendar" "site" "kconfig-tools-absent" "direction" "transient-blocking" "probe" "kwriteconfig6-present" "reason" "KConfig tools are not installed; calendar configuration is deferred") | trim | indent 4 }}
  fi

  configure_digitalclock_plugin() {
    local applet_file="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
    if [[ ! -f "$applet_file" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-calendar" "site" "appletsrc-absent" "direction" "harmless" "reason" "the Plasma applet configuration is not present") | trim | indent 6 }}
    fi

    local count=0
    local containment applet plugin
    while IFS=':' read -r containment applet; do
      plugin="$(kreadconfig6 --file "$applet_file" \
        --group Containments --group "$containment" \
        --group Applets --group "$applet" \
        --key plugin)"
      [[ "$plugin" == "org.kde.plasma.digitalclock" ]] || continue
      kwriteconfig6 --file "$applet_file" \
        --group Containments --group "$containment" \
        --group Applets --group "$applet" \
        --group Configuration --group Appearance \
        --key enabledCalendarPlugins "$PLUGINS"
      printf '  set [Containments/%s/Applets/%s] (%s) enabledCalendarPlugins = %s\n' \
        "$containment" "$applet" "$plugin" "$PLUGINS"
      count=$((count + 1))
    done < <(grep -oE '^\[Containments\]\[[0-9]+\]\[Applets\]\[[0-9]+\]$' "$applet_file" \
              | sed -E 's/^\[Containments\]\[([0-9]+)\]\[Applets\]\[([0-9]+)\]$/\1:\2/')

    if [[ "$count" -eq 0 ]]; then
      (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "config-kde-calendar" "site" "no-digitalclock-applet" "reason" "no Digital Clock applet is configured") | trim | indent 8 }}
      )
    else
      printf '  (a) configured %d digitalclock applet(s).\n' "$count"
    fi
  }
  configure_digitalclock_plugin

  kwriteconfig6 --file plasma_calendar_holiday_regions \
    --group General \
    --key selectedRegions "$HOLIDAY_REGIONS"
  printf '  (b) set [General] selectedRegions = %s in plasma_calendar_holiday_regions\n' \
    "$HOLIDAY_REGIONS"

  if ! command -v mariadb >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-calendar" "site" "mariadb-absent" "direction" "transient-blocking" "probe" "mariadb-present" "reason" "mariadb is not installed; calendar collection configuration is deferred") | trim | indent 4 }}
  fi

  local akonadi_rc="$HOME/.config/akonadi/akonadiserverrc"
  local socket=""
  if [[ -f "$akonadi_rc" ]]; then
    socket="$(grep -E '^Options=' "$akonadi_rc" \
      | sed -nE 's/.*UNIX_SOCKET=([^"]+).*/\1/p' | head -n1)"
  fi
  [[ -n "$socket" ]] || socket="/run/user/$(id -u)/akonadi/mysql.socket"

  if [[ ! -S "$socket" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-calendar" "site" "akonadi-socket-absent" "direction" "transient-blocking" "probe" "akonadi-socket-present" "reason" "the Akonadi socket is unavailable; calendar collection configuration is deferred") | trim | indent 4 }}
  fi

  local ids
  if ! ids="$(mariadb --socket="$socket" -u root akonadi \
      -B --skip-column-names --silent \
      -e "SELECT DISTINCT c.id
            FROM CollectionTable c
            JOIN CollectionMimeTypeRelation cmr ON cmr.Collection_id = c.id
            JOIN MimeTypeTable m ON m.id = cmr.MimeType_id
           WHERE m.name IN ('text/calendar',
                            'application/x-vnd.akonadi.calendar.event',
                            'application/x-vnd.akonadi.calendar.todo',
                            'application/x-vnd.akonadi.calendar.journal')
           ORDER BY c.id;" 2>/dev/null)"; then
    printf 'config-kde-calendar: failed to query the Akonadi MariaDB on %s; verify the Akonadi service, then re-apply.\n' "$socket" >&2
    return 1
  fi

  local csv
  csv="$(printf '%s\n' "$ids" | awk 'NF' | paste -sd, -)"

  if [[ -z "$csv" ]]; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "config-kde-calendar" "site" "no-calendar-collections" "reason" "no Akonadi calendar collections are configured") | trim | indent 6 }}
    )
    return 0
  fi

  kwriteconfig6 --file plasmashellrc \
    --group PIMEventsPlugin \
    --key calendars "$csv"
  printf '  (c) set [PIMEventsPlugin] calendars = %s in plasmashellrc\n' "$csv"
}

configure_calendar
{{ end -}}
