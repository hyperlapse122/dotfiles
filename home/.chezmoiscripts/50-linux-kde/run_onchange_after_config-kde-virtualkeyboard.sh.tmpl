{{ if eq .chezmoi.os "linux" -}}
{{ $kconfigPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "kwriteconfig6-present") -}}
{{ $fcitxPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "fcitx5-present") -}}
#!/usr/bin/env bash
#
# Selects the KWin virtual keyboard / input-method launcher:
#   [Wayland] InputMethod = kde.virtualKeyboard.desktopFile
# (the Fcitx 5 Wayland Launcher — fcitx5 is the KDE targets' input method).
#
# The .desktop file is DATA, not script: .chezmoidata/kde.yaml
# `kde.virtualKeyboard` is the single source of truth (see its header) — edit the
# yaml, not this file. The file-existence PRECONDITION below stays here; it is
# why this script is not collapsible into the settings manifest.
#
# Uses kwriteconfig6 --type path so KConfig writes the canonical
# InputMethod[$e]=... form. Skips cleanly when the desktop file isn't installed.
#
# Capability fingerprints pair each transient-blocking declaration below with
# the cached precondition it names. Comment-only; never executed.
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list
      (dict "name" "kwriteconfig6-present" "value" $kconfigPresent)
      (dict "name" "fcitx5-present" "value" $fcitxPresent))) }}
set -euo pipefail

{{ includeTemplate "kde-guard.sh.tmpl" (dict "ctx" . "name" "config-kde-virtualkeyboard.sh") -}}

VIRTUAL_KEYBOARD_DESKTOP_FILE={{ .kde.virtualKeyboard.desktopFile | quote }}

configure_virtualkeyboard() {
  printf 'config-kde-virtualkeyboard.sh: selecting %s...\n' \
    "$VIRTUAL_KEYBOARD_DESKTOP_FILE"

  if ! command -v kwriteconfig6 >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-virtualkeyboard" "site" "kwriteconfig6-absent" "direction" "transient-blocking" "probe" "kwriteconfig6-present" "reason" "kwriteconfig6 is not installed; virtual keyboard configuration is deferred") | trim | indent 4 }}
  fi

  if [[ ! -f "$VIRTUAL_KEYBOARD_DESKTOP_FILE" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-virtualkeyboard" "site" "fcitx5-desktop-absent" "direction" "transient-blocking" "probe" "fcitx5-present" "reason" "the fcitx5 desktop file is not installed; virtual keyboard configuration is deferred") | trim | indent 4 }}
  fi

  kwriteconfig6 --file kwinrc \
    --group Wayland \
    --key InputMethod \
    --type path \
    "$VIRTUAL_KEYBOARD_DESKTOP_FILE"
  printf '  set [Wayland] InputMethod = %s\n' "$VIRTUAL_KEYBOARD_DESKTOP_FILE"
}

configure_virtualkeyboard
{{ end -}}
