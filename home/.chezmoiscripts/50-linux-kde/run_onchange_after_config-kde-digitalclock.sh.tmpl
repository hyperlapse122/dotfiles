{{ if eq .chezmoi.os "linux" -}}
{{ $kconfigPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "kwriteconfig6-present") -}}
#!/usr/bin/env bash
#
# Sets the Digital Clock date format to kde.digitalClock.dateFormat on every
# panel-level org.kde.plasma.digitalclock applet.
#
# The format is DATA, not script: .chezmoidata/kde.yaml `kde.digitalClock` is the
# single source of truth (see its header) — edit the yaml, not this file. The
# applet-discovery loop and the plugin id it matches on are structure and stay.
#
# CAVEAT: ~/.config/plasma-org.kde.plasma.desktop-appletsrc is owned by a
# running plasmashell. Edits are safest before plasmashell first starts or
# after restarting it; otherwise the live process may overwrite the change.
# The write is idempotent so re-running is safe.
#
# Cached capability fingerprint for the transient-blocking KConfig precondition.
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list (dict "name" "kwriteconfig6-present" "value" $kconfigPresent))) }}
set -euo pipefail

{{ includeTemplate "kde-guard.sh.tmpl" (dict "ctx" . "name" "config-kde-digitalclock.sh") -}}

DATE_FORMAT="{{ .kde.digitalClock.dateFormat }}"

configure_digitalclock() {
  printf 'config-kde-digitalclock.sh: setting date format to %s...\n' "$DATE_FORMAT"

  if ! command -v kwriteconfig6 >/dev/null 2>&1 || ! command -v kreadconfig6 >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-digitalclock" "site" "kconfig-tools-absent" "direction" "transient-blocking" "probe" "kwriteconfig6-present" "reason" "KConfig tools are not installed; Digital Clock configuration is deferred") | trim | indent 4 }}
  fi

  local file="$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc"
  if [[ ! -f "$file" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-digitalclock" "site" "appletsrc-absent" "direction" "harmless" "reason" "the Plasma applet configuration is not present") | trim | indent 4 }}
  fi

  local count=0
  local containment applet plugin
  while IFS=':' read -r containment applet; do
    plugin="$(kreadconfig6 --file "$file" \
      --group Containments --group "$containment" \
      --group Applets --group "$applet" \
      --key plugin)"
    [[ "$plugin" == "org.kde.plasma.digitalclock" ]] || continue
    kwriteconfig6 --file "$file" \
      --group Containments --group "$containment" \
      --group Applets --group "$applet" \
      --group Configuration --group Appearance \
      --key dateFormat "$DATE_FORMAT"
    printf '  set [Containments/%s/Applets/%s] (%s) dateFormat = %s\n' \
      "$containment" "$applet" "$plugin" "$DATE_FORMAT"
    count=$((count + 1))
  done < <(grep -oE '^\[Containments\]\[[0-9]+\]\[Applets\]\[[0-9]+\]$' "$file" \
            | sed -E 's/^\[Containments\]\[([0-9]+)\]\[Applets\]\[([0-9]+)\]$/\1:\2/')

  if [[ "$count" -eq 0 ]]; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "config-kde-digitalclock" "site" "no-digitalclock-applet" "reason" "no Digital Clock applet is configured") | trim | indent 6 }}
    )
    return 0
  fi

  printf '  configured %d digitalclock applet(s).\n' "$count"
}

configure_digitalclock
{{ end -}}
