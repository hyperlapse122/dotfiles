{{- $target := printf "%s-%s" .chezmoi.os .chezmoi.arch -}}
{{- if and (eq .chezmoi.os "windows") (hasKey .personalApps.omp.targets $target) -}}
{{- $inputs := includeTemplate "harness-plugin-script-inputs" . -}}
{{ "\ufeff" -}}
# file harness-plugin-script-inputs sha256: {{ include ".chezmoitemplates/harness-plugin-script-inputs" | sha256sum }}
# file harness-plugin-marketplaces sha256: {{ include ".chezmoitemplates/harness-plugin-marketplaces" | sha256sum }}
# file harness-plugins-windows sha256: {{ include ".chezmoitemplates/harness-plugins-windows" | sha256sum }}
# data harness.action sha256: {{ $inputs | fromJson | toJson | sha256sum }}
$ErrorActionPreference = 'Stop'
# Render runtime decisions only after the action is scheduled. An isolated state
# file avoids reopening the parent chezmoi process's locked database.
$state = [IO.Path]::GetTempFileName()
$dataFile = "$state.json"
$scriptFile = "$state.ps1"
try {
    # Files avoid Windows PowerShell 5.1's legacy native JSON quoting and stdout decoding.
    [IO.File]::WriteAllText($dataFile, '{{ $inputs | replace "'" "''" }}', (New-Object Text.UTF8Encoding($false)))
    '{{`{{ includeTemplate "harness-plugins-windows" . }}`}}' | & '{{ .chezmoi.executable | replace "'" "''" }}' --config NUL --config-format toml --source '{{ .chezmoi.sourceDir | replace "'" "''" }}' --destination '{{ .chezmoi.destDir | replace "'" "''" }}' --persistent-state $state --override-data-file $dataFile --output $scriptFile execute-template
    if ($LASTEXITCODE -ne 0) {
        throw "Unable to render omp reconciliation: chezmoi exited with code $LASTEXITCODE"
    }
    & ([scriptblock]::Create([IO.File]::ReadAllText($scriptFile)))
} finally {
    foreach ($path in @($state, $dataFile, $scriptFile)) {
        if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Force }
    }
}
{{ end -}}
