{{- if and (eq .chezmoi.os "windows") (has .chezmoi.arch (list "amd64" "arm64")) -}}
{{ "\ufeff" -}}
$ErrorActionPreference = 'Stop'
$root = Join-Path '{{ .chezmoi.destDir | replace "'" "''" }}' '.local/share/dotfiles'
& '{{ joinPath .chezmoi.workingTree "scripts" "install-fonts.ps1" | replace "'" "''" }}' `
    -AssetRoot (Join-Path $root 'font-assets') `
    -IndexPath (Join-Path $root 'font-index.tsv') `
    -FontDirectory (Join-Path $env:LOCALAPPDATA 'Microsoft/Windows/Fonts') `
    -StatePath (Join-Path $root 'installed-fonts.json')
{{ end -}}
