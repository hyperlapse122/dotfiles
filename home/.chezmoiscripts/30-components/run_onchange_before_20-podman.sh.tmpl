{{- $isFedora := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
{{- $isUbuntu := and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "pop")) -}}
{{- if or $isFedora $isUbuntu -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "facts-sh.tmpl" . }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-podman") }}
{{ includeTemplate "sudo-elevation-guard.sh.tmpl" (dict "ctx" . "name" "install-podman.sh") -}}

{{ if $isFedora -}}
DNF=("${SUDO[@]}" dnf)

podman_packages=(
  buildah
  containers-common
  fuse-overlayfs
  kubernetes-client
  passt
  podman
  podman-compose
  podman-docker
  slirp4netns
)

# A declared name is a capability, not necessarily a package name:
# kubernetes1.36-client provides kubernetes-client. `dnf install <name>` is
# satisfied by whichever installed package provides <name>, so the
# re-inspection that decides convergence asks the same question.
rpm_installed() {
  rpm -q --whatprovides "$1" >/dev/null 2>&1
}

missing_podman_packages=()
compute_missing_podman_packages() {
  missing_podman_packages=()
  local pkg
  for pkg in "${podman_packages[@]}"; do
    rpm_installed "${pkg}" || missing_podman_packages+=("${pkg}")
  done
}

report_podman_missing() {
  printf 'install-podman-fedora: dnf left these declared packages uninstalled: %s\n' "${missing_podman_packages[*]}" >&2
  printf '  sudo dnf install -y %s\n' "${missing_podman_packages[*]}" >&2
  return 0
}

clear_podman_skip_record() {
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "clear_record" "script" "install-podman-fedora" "site" "podman-packages-not-installed") | trim | indent 2 }}
}

install_podman_packages() {
  compute_missing_podman_packages

  if [[ "${#missing_podman_packages[@]}" -gt 0 ]]; then
    # Exit status is discarded because the post-attempt re-inspection is the verdict.
    if ! "${DNF[@]}" install -y "${missing_podman_packages[@]}"; then :; fi
    compute_missing_podman_packages
  fi

  if [[ "${#missing_podman_packages[@]}" -gt 0 ]] && report_podman_missing; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-podman-fedora" "site" "podman-packages-not-installed" "direction" "operator-blocking" "reason" "dnf left declared podman packages uninstalled; the missing set and the by-hand install command were printed above") | trim | indent 4 }}
  fi
  clear_podman_skip_record
}

configure_user_namespaces() {
  local target_user
  target_user="${SUDO_USER:-$USER}"

  if getent group docker >/dev/null 2>&1; then
    "${SUDO[@]}" gpasswd -d "${target_user}" docker 2>/dev/null || true
  fi

  grep -q "^${target_user}:" /etc/subgid 2>/dev/null || "${SUDO[@]}" usermod --add-subgids 100000-165535 "${target_user}" 2>/dev/null || true
  grep -q "^${target_user}:" /etc/subuid 2>/dev/null || "${SUDO[@]}" usermod --add-subuids 100000-165535 "${target_user}" 2>/dev/null || true
}

install_podman_packages
configure_user_namespaces

{{ else if $isUbuntu -}}
apt_installed() {
  local status
  status="$(dpkg-query -f '${db:Status-Status}' -W "$1" 2>/dev/null)" || return 1
  [[ "$status" == installed ]]
}

install_apt() {
  local pkg=$1
  if ! apt_installed "$pkg"; then
    if ! "${SUDO[@]}" apt-get install -y "$pkg"; then
      printf 'install-podman-ubuntu: apt-get install failed for %s\n' "$pkg" >&2
    fi
  fi
}

podman_packages=(
  buildah
  fuse-overlayfs
  podman
  podman-docker
  slirp4netns
  uidmap
)

missing_podman_packages=()
compute_missing_podman_packages() {
  missing_podman_packages=()
  local pkg
  for pkg in "${podman_packages[@]}"; do
    apt_installed "$pkg" || missing_podman_packages+=("$pkg")
  done
}

report_podman_missing() {
  printf 'install-podman-ubuntu: apt-get left these declared packages uninstalled: %s\n' "${missing_podman_packages[*]}" >&2
  printf '  sudo apt-get install -y %s\n' "${missing_podman_packages[*]}" >&2
  return 0
}

clear_podman_skip_record() {
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "clear_record" "script" "install-podman-ubuntu" "site" "podman-packages-not-installed") | trim | indent 2 }}
}

install_podman_packages() {
  "${SUDO[@]}" apt-get update -qq || true
  local pkg
  for pkg in "${podman_packages[@]}"; do
    install_apt "$pkg"
  done

  compute_missing_podman_packages

  if [[ "${#missing_podman_packages[@]}" -gt 0 ]] && report_podman_missing; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-podman-ubuntu" "site" "podman-packages-not-installed" "direction" "operator-blocking" "reason" "apt-get left declared podman packages uninstalled; the missing set and the by-hand install command were printed above") | trim | indent 4 }}
  fi
  clear_podman_skip_record
}

install_podman_packages

target_user="${SUDO_USER:-$USER}"
grep -q "^${target_user}:" /etc/subgid 2>/dev/null || "${SUDO[@]}" usermod --add-subgids 100000-165535 "${target_user}" 2>/dev/null || true
grep -q "^${target_user}:" /etc/subuid 2>/dev/null || "${SUDO[@]}" usermod --add-subuids 100000-165535 "${target_user}" 2>/dev/null || true
{{ end -}}

{{ end -}}
