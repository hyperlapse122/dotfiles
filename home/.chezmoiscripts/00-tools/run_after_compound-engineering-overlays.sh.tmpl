
{{- $ctx := . -}}
{{- $ceAuthority := index .agents.marketplaces "compound-engineering-plugin" -}}
{{- if not (hasKey $ceAuthority "pristinePath") -}}
{{-   fail "compound-engineering-overlays: the compound-engineering-plugin authority declares no pristinePath" -}}
{{- end -}}
{{- $pristineSegment := includeTemplate "local-archive-ref.tmpl" (dict "ctx" $ctx "marketplace" "compound-engineering-plugin" "field" "segment") -}}
{{- $base := include "dot_local/share/compound-engineering-overlays/base.json" | fromJson -}}
{{- if not (regexMatch "^compound-engineering-v[0-9]+\\.[0-9]+\\.[0-9]+$" (printf "%v" $base.version)) -}}
{{-   fail (printf "compound-engineering-overlays: base.json version %v is not a compound-engineering-v<semver> tag" $base.version) -}}
{{- end -}}
{{- $keys := keys $base.paths | sortAlpha -}}
{{- range $key := $keys -}}
{{-   $entry := index $base.paths $key -}}
{{-   if or (not (regexMatch "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$" $key)) (regexMatch "(^|/)(\\.|\\.\\.|\\.git)(/|$)" $key) -}}
{{-     fail (printf "compound-engineering-overlays: base.json key %q is not a safe relative path" $key) -}}
{{-   end -}}
{{-   if not (regexMatch "^0(644|755)$" (printf "%v" $entry.mode)) -}}
{{-     fail (printf "compound-engineering-overlays: base.json mode for %q must be 0644 or 0755" $key) -}}
{{-   end -}}
{{-   if not (regexMatch "^[0-9a-f]{64}$" (printf "%v" $entry.postimage.sha256)) -}}
{{-     fail (printf "compound-engineering-overlays: base.json post-image sha256 for %q is malformed" $key) -}}
{{-   end -}}
{{-   if not (kindIs "string" $entry.preimage) -}}
{{-     if not (and (regexMatch "^[0-9a-f]{64}$" (printf "%v" $entry.preimage.sha256)) (regexMatch "^0(644|755)$" (printf "%v" $entry.preimage.mode))) -}}
{{-       fail (printf "compound-engineering-overlays: base.json pre-image for %q is malformed" $key) -}}
{{-     end -}}
{{-   else if ne $entry.preimage "absent" -}}
{{-     fail (printf "compound-engineering-overlays: base.json pre-image for %q must be absent or an object" $key) -}}
{{-   end -}}
{{- end -}}

#!/usr/bin/env bash
#
# Installs the locally customized compound-engineering files into every pinned
# compound-engineering version directory.
#
# Each customization is a patch against one upstream file. The overlay directory
# holds patches/<path>.patch. base.json, embedded below at render time, records
# the release tag, the upstream pre-image of each path (sha256 and mode, or
# `absent` for a file the patch creates), and its post-image (sha256 and mode).
# Both archive externals exclude every patched path, so chezmoi never owns them.
# A separate include-only external keeps the unpatched upstream files in the
# pristine directory, which nothing else writes.
#
# Every apply:
#   - A destination that holds the recorded post-image is skipped. When only its
#     mode differs, the recorded mode is set in place.
#   - Every other post-image is computed before any is installed. The verified
#     pre-image is copied into a private scratch git repository, patched, given
#     the recorded mode, and checked against the recorded sha256. The script never
#     patches a destination in place. It installs each result into every copy.
#   - Installing is one transaction. First a read-only pass refuses, with exit 1,
#     any directory component that is not a plain directory, before anything
#     changes. Then the script stages every new file beside its destination, sets
#     each old entry aside, and moves the new files into place. When a step fails,
#     it puts every path back as it was, removes its temp files, and degrades as
#     below. When it cannot put a path back, it warns and exits 2.
#   - Any failure (a tag that differs from the directory, a pre-image that
#     differs from its record, no git, a patch that does not apply, a post-image
#     that differs from its record, an install step) degrades every path in every
#     copy together. Each pristine file that matches its recorded pre-image is
#     installed unmodified, as one transaction of its own. Every other target
#     stays unchanged, including a path whose pre-image is absent but that
#     upstream now ships. Each path gets a warning, and the script exits 0. It
#     never installs unverified patched content and never mixes patched and
#     unpatched results.
#   - Without a sha256 tool nothing can be verified: one warning, no change, exit 0.
#
# The script does no network I/O. The ce-sweep persona and its added source
# depend on each other, so a partial patched set would break ce-sweep.
#
# OWNERSHIP: the patched paths are ours, while the directory chain above them is
# archive-owned. Because the tree is additive, another process can replace a
# leaf with a symlink into an unrelated checkout. Following it would overwrite
# a foreign tracked file. Reclaim the leaves we own; refuse, rather than delete,
# a directory component that is not a plain directory. A version directory that
# is itself a symlink gets the same treatment as a foreign leaf and is skipped.
#
# run_after_ (not run_onchange_): that drift is LIVE state in a third-party-
# writable tree, so it must be re-asserted after every file phase — a
# fingerprinted onchange run records a clean skip and never repairs it. A
# converged apply costs a stat and a digest per file.

set -euo pipefail

# Every localArchive copy of the compound-engineering archive, not just one:
# omp gets its own copy with the root plugin.json excluded, and it needs the
# same customizations. The overlay directory and the pristine tree are shared —
# they are keyed off the first authority's paths — because both copies hold one
# version of one upstream.
OVERLAYS="$HOME/{{ $ceAuthority.externalPath }}-overlays"
PATCH_DIR="$OVERLAYS/patches"
PRISTINE_DIR="$HOME/{{ $ceAuthority.pristinePath }}/{{ $pristineSegment }}"
TARGET_DIRS=(
{{- range $mName, $mAuthority := .agents.marketplaces }}
{{-   if and (eq (printf "%v" (index $mAuthority "kind")) "localArchive") (eq (printf "%v" (index $mAuthority "source")) "EveryInc/compound-engineering-plugin") }}
  "$HOME/{{ $mAuthority.externalPath }}/{{ includeTemplate "local-archive-ref.tmpl" (dict "ctx" $ctx "marketplace" $mName "field" "segment") }}"
{{-   end }}
{{- end }}
)

# One state table, parallel arrays indexed by patched path, generated from base.json.
BASE_TAG={{ $base.version | quote }}
PATCH_KEYS=(
{{- range $key := $keys }}
  {{ $key | quote }}
{{- end }}
)
PRE_SHA=(
{{- range $key := $keys }}
{{-   $pre := (index $base.paths $key).preimage }}
  {{ if kindIs "string" $pre }}"absent"{{ else }}{{ $pre.sha256 | quote }}{{ end }}
{{- end }}
)
PRE_MODE=(
{{- range $key := $keys }}
{{-   $pre := (index $base.paths $key).preimage }}
  {{ if kindIs "string" $pre }}"-"{{ else }}{{ $pre.mode | quote }}{{ end }}
{{- end }}
)
POST_SHA=(
{{- range $key := $keys }}
  {{ (index $base.paths $key).postimage.sha256 | quote }}
{{- end }}
)
POST_MODE=(
{{- range $key := $keys }}
  {{ (index $base.paths $key).mode | quote }}
{{- end }}
)
BASE_SEGMENT="v${BASE_TAG#compound-engineering-v}"
KEY_COUNT="${#PATCH_KEYS[@]}"

SCRATCH=''
TX_OPEN=0
cleanup() {
  if [ "$TX_OPEN" -eq 1 ]; then
    rollback_jobs || warn "could not undo every change; the tree may hold a mix of patched and unpatched files"
  fi
  if [ -n "$SCRATCH" ]; then
    rm -rf -- "$SCRATCH"
  fi
}
trap cleanup EXIT

warn() {   # <message> -> one prefixed line on stderr
  printf 'compound-engineering-overlays: %s\n' "$*" >&2
}

# The overlay source must exist after the file phase. Match the prune script's defensive skip.
if [ ! -d "$OVERLAYS" ]; then
  exit 0
fi

COPIES=()
for ((T = 0; T < ${#TARGET_DIRS[@]}; T++)); do
  if [ -L "${TARGET_DIRS[T]}" ]; then
    warn "${TARGET_DIRS[T]} is a symlink; skipping it"
  elif [ -d "${TARGET_DIRS[T]}" ]; then
    COPIES+=("${TARGET_DIRS[T]}")
  fi
done
COPY_COUNT="${#COPIES[@]}"
if [ "$COPY_COUNT" -eq 0 ]; then
  exit 0
fi

# Portable SHA-256 (roster validOS includes darwin, which ships no sha256sum):
# prefer sha256sum, fall back to shasum -a 256. A read failure on an existing
# file reaches the callers as an empty, non-matching digest rather than aborting
# under `set -euo pipefail`.
if command -v sha256sum >/dev/null 2>&1; then
  SHA256_CMD=(sha256sum --)
elif command -v shasum >/dev/null 2>&1; then
  SHA256_CMD=(shasum -a 256 --)
else
  warn "no sha256 tool; leaving every target unchanged"
  exit 0
fi
sha256_of() {   # <path> -> prints hex digest on stdout; empty output, nonzero status if unreadable
  "${SHA256_CMD[@]}" "$1" 2>/dev/null | cut -d' ' -f1
}

perm_of() {   # <path> -> prints the permission bits in octal
  stat -c '%a' -- "$1" 2>/dev/null || stat -f '%Lp' -- "$1" 2>/dev/null
}

# Owner-execute bit through stat: access(2) reports EACCES for X_OK on a noexec
# mount, which would misread every file as 0644. The bit is what the recorded
# 0644 and 0755 mean, so a umask that narrowed the group bits changes nothing.
mode_of() {   # <path> -> prints 0755 when the owner execute bit is set, else 0644
  local perm
  perm="$(perm_of "$1")" || return 1
  if [ $((8#$perm & 8#100)) -ne 0 ]; then
    printf '0755'
  else
    printf '0644'
  fi
}

is_plain_file() {   # <path> -> true for a regular file that is not a symlink
  [ -f "$1" ] && [ ! -L "$1" ]
}

check_directory_chain() {   # <base-dir> <relative-file-path> -> read-only; warns and returns 1 for a component that is a symlink or not a directory
  local base="$1" relative="$2" node component
  IFS=/ read -r -a COMPONENTS <<<"$(dirname -- "$relative")"
  node="$base"
  for component in "${COMPONENTS[@]}"; do
    node="$node/$component"
    if [ -L "$node" ] || { [ -e "$node" ] && [ ! -d "$node" ]; }; then
      warn "$node is not a plain directory; remove it and re-apply"
      return 1
    fi
  done
}

make_directory_chain() {   # <base-dir> <relative-file-path> -> mkdir the missing components, recording each one in CREATED_DIRS
  local base="$1" relative="$2" node component
  IFS=/ read -r -a COMPONENTS <<<"$(dirname -- "$relative")"
  node="$base"
  for component in "${COMPONENTS[@]}"; do
    node="$node/$component"
    if [ ! -d "$node" ]; then
      mkdir -- "$node" || return 1
      CREATED_DIRS+=("$node")
    fi
  done
}

# One job per destination change: install (a new file at base/relative) or chmod
# (only the mode differs). Every job records what it changed, so a failure can
# put the tree back as it was. An old entry is kept beside its destination as
# <destination>.chezmoi-<pid>.bak, and a new file is staged as
# <destination>.chezmoi-<pid>.tmp on the same filesystem. Bash 3.2 has no empty
# "${array[@]}" under set -u, so every loop runs over an index.
JOB_KIND=()
JOB_BASE=()
JOB_REL=()
JOB_ARG=()
JOB_DONE=()
JOB_ASIDE=()
JOB_COMMITTED=()
JOB_OLDPERM=()
JOB_NOTE=()
CREATED_DIRS=()

reset_jobs() {   # -> empties the job list
  JOB_KIND=()
  JOB_BASE=()
  JOB_REL=()
  JOB_ARG=()
  JOB_DONE=()
  JOB_ASIDE=()
  JOB_COMMITTED=()
  JOB_OLDPERM=()
  JOB_NOTE=()
  CREATED_DIRS=()
}

add_job() {   # <install|chmod> <base-dir> <relative-path> <file to install, or mode> <warning after the commit>
  local j="${#JOB_KIND[@]}"
  JOB_KIND[j]="$1"
  JOB_BASE[j]="$2"
  JOB_REL[j]="$3"
  JOB_ARG[j]="$4"
  JOB_DONE[j]="$5"
  JOB_ASIDE[j]=none
  JOB_COMMITTED[j]=0
  JOB_OLDPERM[j]=''
  JOB_NOTE[j]=''
}

stage_job() {   # <index> -> makes the missing directories and copies the new file beside its destination
  local j="$1" dest
  dest="${JOB_BASE[j]}/${JOB_REL[j]}"
  make_directory_chain "${JOB_BASE[j]}" "${JOB_REL[j]}" || {
    warn "could not create the directories for $dest"
    return 1
  }
  rm -rf -- "$dest.chezmoi-$$.tmp" "$dest.chezmoi-$$.bak" || return 1
  cp -p -- "${JOB_ARG[j]}" "$dest.chezmoi-$$.tmp" || {
    warn "could not stage $dest"
    return 1
  }
}

commit_job() {   # <index> -> keeps the old entry, then moves the staged file into place (or sets the mode)
  local j="$1" dest temp backup
  dest="${JOB_BASE[j]}/${JOB_REL[j]}"
  temp="$dest.chezmoi-$$.tmp"
  backup="$dest.chezmoi-$$.bak"
  if [ "${JOB_KIND[j]}" = chmod ]; then
    JOB_OLDPERM[j]="$(perm_of "$dest")" || return 1
    chmod "${JOB_ARG[j]}" "$dest" || return 1
    JOB_COMMITTED[j]=1
    return 0
  fi
  if [ -L "$dest" ]; then
    JOB_NOTE[j]="replaced foreign symlink $dest -> $(readlink -- "$dest")"
    mv -- "$dest" "$backup" || return 1
    JOB_ASIDE[j]=move
  elif [ -e "$dest" ] && [ ! -f "$dest" ]; then
    JOB_NOTE[j]="replaced non-file entry $dest"
    mv -- "$dest" "$backup" || return 1
    JOB_ASIDE[j]=move
  elif [ -f "$dest" ]; then
    JOB_ASIDE[j]=copy
    cp -p -- "$dest" "$backup" || return 1
  fi
  mv -f -- "$temp" "$dest" || {
    warn "could not install $dest"
    return 1
  }
  JOB_COMMITTED[j]=1
}

rollback_job() {   # <index> -> puts one destination back as it was; returns 1 when a step fails
  local j="$1" dest rc=0
  dest="${JOB_BASE[j]}/${JOB_REL[j]}"
  if [ "${JOB_KIND[j]}" = chmod ]; then
    if [ "${JOB_COMMITTED[j]}" -eq 1 ]; then
      chmod "${JOB_OLDPERM[j]}" "$dest" || rc=1
    fi
  else
    rm -f -- "$dest.chezmoi-$$.tmp" || rc=1
    case "${JOB_ASIDE[j]}" in
      copy)
        if [ "${JOB_COMMITTED[j]}" -eq 1 ]; then
          mv -f -- "$dest.chezmoi-$$.bak" "$dest" || rc=1
        else
          rm -f -- "$dest.chezmoi-$$.bak" || rc=1
        fi
        ;;
      move)
        if [ "${JOB_COMMITTED[j]}" -eq 1 ]; then
          rm -f -- "$dest" || rc=1
        fi
        mv -- "$dest.chezmoi-$$.bak" "$dest" || rc=1
        ;;
      *)
        if [ "${JOB_COMMITTED[j]}" -eq 1 ]; then
          rm -f -- "$dest" || rc=1
        fi
        ;;
    esac
  fi
  if [ "$rc" -ne 0 ]; then
    warn "could not restore $dest"
  fi
  return "$rc"
}

rollback_jobs() {   # -> undoes every job in reverse order, then removes the directories the jobs made
  local j rc=0
  for ((j = ${#JOB_KIND[@]} - 1; j >= 0; j--)); do
    rollback_job "$j" || rc=1
  done
  for ((j = ${#CREATED_DIRS[@]} - 1; j >= 0; j--)); do
    rmdir -- "${CREATED_DIRS[j]}" 2>/dev/null || true
  done
  return "$rc"
}

perform_jobs() {   # -> stages every new file, then commits every job in order; returns 1 at the first failing step
  local j count="${#JOB_KIND[@]}"
  for ((j = 0; j < count; j++)); do
    if [ "${JOB_KIND[j]}" = install ]; then
      stage_job "$j" || return 1
    fi
  done
  for ((j = 0; j < count; j++)); do
    commit_job "$j" || return 1
  done
}

finish_jobs() {   # -> drops the kept old entries and prints each job's warnings
  local j dest
  for ((j = 0; j < ${#JOB_KIND[@]}; j++)); do
    dest="${JOB_BASE[j]}/${JOB_REL[j]}"
    if [ "${JOB_ASIDE[j]}" != none ]; then
      rm -rf -- "$dest.chezmoi-$$.bak" || warn "could not remove $dest.chezmoi-$$.bak"
    fi
    if [ -n "${JOB_NOTE[j]}" ]; then
      warn "${JOB_NOTE[j]}"
    fi
    if [ -n "${JOB_DONE[j]}" ]; then
      warn "${JOB_DONE[j]}"
    fi
  done
}

run_jobs() {   # -> 0 when every job committed; 1 after every change was undone; exits 1 for a foreign directory component and 2 when a change cannot be undone
  local j
  for ((j = 0; j < ${#JOB_KIND[@]}; j++)); do
    if [ "${JOB_KIND[j]}" = install ] && ! check_directory_chain "${JOB_BASE[j]}" "${JOB_REL[j]}"; then
      exit 1
    fi
  done
  TX_OPEN=1
  if ! perform_jobs; then
    if ! rollback_jobs; then
      TX_OPEN=0
      warn "could not undo every change; the tree may hold a mix of patched and unpatched files"
      exit 2
    fi
    TX_OPEN=0
    return 1
  fi
  TX_OPEN=0
  finish_jobs
}

# The `git apply` settings match ceo_git in .ci/lib/ce-overlay.sh: no user or
# system configuration, no enclosing repository, and no whitespace or line-ending
# rewrite. ceo_git adds diff and commit settings that this script does not use.
git_isolated() {   # <git arguments> -> runs git inside the scratch boundary
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY \
    -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_COMMON_DIR -u GIT_NAMESPACE \
    HOME="$SCRATCH/git-home" XDG_CONFIG_HOME="$SCRATCH/git-home" \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_CONFIG_NOSYSTEM=1 \
    GIT_ATTR_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 LC_ALL=C \
    git -c core.autocrlf=false -c core.safecrlf=false -c core.filemode=true \
    -c core.symlinks=true -c core.hooksPath=/dev/null -c core.quotepath=off \
    -c init.defaultBranch=main -c apply.whitespace=nowarn "$@" </dev/null
}

DEGRADE_REASON=''
note_failure() {   # <reason> -> keeps the first reason
  if [ -z "$DEGRADE_REASON" ]; then
    DEGRADE_REASON="$1"
  fi
}

# Per path: verified (a pristine file matches its recorded pre-image), upstream
# (the pre-image is absent but upstream now ships the file, so no pre-image
# verifies it and its target stays unchanged), none (absent, and absent
# upstream), or unusable.
PRISTINE_STATE=()
PRISTINE_CHECKED=0
verify_pristine() {   # -> fills PRISTINE_STATE; every failing path warns and sets DEGRADE_REASON
  local k key file
  PRISTINE_CHECKED=1
  for ((k = 0; k < KEY_COUNT; k++)); do
    key="${PATCH_KEYS[k]}"
    file="$PRISTINE_DIR/$key"
    PRISTINE_STATE[k]=unusable
    if [ "${PRE_SHA[k]}" = absent ]; then
      if is_plain_file "$file"; then
        PRISTINE_STATE[k]=upstream
        warn "$key: upstream now ships this file, but its pre-image is recorded as absent"
        note_failure "upstream now ships $key"
      elif [ -e "$file" ] || [ -L "$file" ]; then
        warn "$key: $file is not a regular file"
        note_failure "the pristine entry for $key is not a regular file"
      else
        PRISTINE_STATE[k]=none
      fi
    elif ! is_plain_file "$file"; then
      warn "$key: the pristine file $file is missing"
      note_failure "the pristine file for $key is missing"
    elif [ "$(sha256_of "$file")" != "${PRE_SHA[k]}" ]; then
      warn "$key: the pristine file $file differs from the recorded pre-image sha256"
      note_failure "the pristine file for $key differs from its recorded pre-image"
    elif [ "$(mode_of "$file")" != "${PRE_MODE[k]}" ]; then
      warn "$key: the pristine file $file differs from the recorded pre-image mode"
      note_failure "the pristine file for $key differs from its recorded pre-image"
    else
      PRISTINE_STATE[k]=verified
    fi
  done
}

# Post-images land in $SCRATCH/work/<path>.
compute_post_images() {   # -> patches every verified pre-image; every failing path warns and sets DEGRADE_REASON
  local k key patch work="$SCRATCH/work"
  if ! git_isolated --version >/dev/null 2>&1; then
    warn "git is not available; the patches cannot be applied"
    note_failure "git is not available"
    return 0
  fi
  git_isolated init -q -- "$work" >/dev/null 2>&1 || {
    warn "git could not create its scratch repository"
    note_failure "git could not create its scratch repository"
    return 0
  }
  for ((k = 0; k < KEY_COUNT; k++)); do
    key="${PATCH_KEYS[k]}"
    patch="$PATCH_DIR/$key.patch"
    mkdir -p -- "$work/$(dirname -- "$key")"
    if [ "${PRE_SHA[k]}" != absent ]; then
      cp -p -- "$PRISTINE_DIR/$key" "$work/$key"
    fi
    if ! is_plain_file "$patch"; then
      warn "$key: the patch $patch is missing"
      note_failure "the patch for $key is missing"
    elif ! git_isolated -C "$work" apply -- "$patch" >/dev/null 2>"$SCRATCH/apply.err"; then
      warn "$key: the patch does not apply: $(head -c 300 "$SCRATCH/apply.err" | tr '\n' ' ')"
      note_failure "the patch for $key does not apply"
    elif ! is_plain_file "$work/$key"; then
      warn "$key: the patch left no regular file"
      note_failure "the patch for $key left no regular file"
    else
      chmod "${POST_MODE[k]}" "$work/$key"
      if [ "$(sha256_of "$work/$key")" != "${POST_SHA[k]}" ]; then
        warn "$key: the patched file differs from the recorded post-image sha256"
        note_failure "the post-image for $key differs from its record"
      fi
    fi
  done
}

stage_pristine_files() {   # -> copies every verified pristine file, with its mode, into $SCRATCH/pristine; returns 1 when a copy fails
  local k key staged
  for ((k = 0; k < KEY_COUNT; k++)); do
    if [ "${PRISTINE_STATE[k]}" = verified ]; then
      key="${PATCH_KEYS[k]}"
      staged="$SCRATCH/pristine/$key"
      mkdir -p -- "$SCRATCH/pristine/$(dirname -- "$key")" || return 1
      cp -- "$PRISTINE_DIR/$key" "$staged" || return 1
      chmod "$(mode_of "$PRISTINE_DIR/$key")" "$staged" || return 1
    fi
  done
}

degrade_all() {   # -> installs verified pristine files as one transaction, leaves every other target unchanged, warns per path
  local c k j key dest staged
  if ! stage_pristine_files; then
    DEGRADE_REASON="$DEGRADE_REASON; the pristine files could not be staged"
    for ((k = 0; k < KEY_COUNT; k++)); do
      PRISTINE_STATE[k]=unusable
    done
  fi
  reset_jobs
  for ((c = 0; c < COPY_COUNT; c++)); do
    for ((k = 0; k < KEY_COUNT; k++)); do
      key="${PATCH_KEYS[k]}"
      dest="${COPIES[c]}/$key"
      staged="$SCRATCH/pristine/$key"
      if [ "${PRISTINE_STATE[k]}" != verified ]; then
        warn "$dest: left unchanged ($DEGRADE_REASON)"
      elif is_plain_file "$dest" && cmp -s -- "$staged" "$dest" && [ "$(mode_of "$dest")" = "$(mode_of "$staged")" ]; then
        warn "$dest: holds the unmodified upstream file ($DEGRADE_REASON)"
      else
        add_job install "${COPIES[c]}" "$key" "$staged" "$dest: installed the unmodified upstream file ($DEGRADE_REASON)"
      fi
    done
  done
  if ! run_jobs; then
    for ((j = 0; j < ${#JOB_KIND[@]}; j++)); do
      warn "${JOB_BASE[j]}/${JOB_REL[j]}: left unchanged ($DEGRADE_REASON; installing the unmodified files failed)"
    done
  fi
}

# Plan: 0 converged, 1 mode differs, 2 needs its post-image.
ACTIONS=()
NEEDS_POST_IMAGE=0
for ((C = 0; C < COPY_COUNT; C++)); do
  if [ "${COPIES[C]##*/}" != "$BASE_SEGMENT" ]; then
    warn "${COPIES[C]} is ${COPIES[C]##*/}, but base.json records $BASE_TAG"
    note_failure "${COPIES[C]} is ${COPIES[C]##*/}, but base.json records $BASE_TAG"
  fi
done
if [ -z "$DEGRADE_REASON" ]; then
  for ((C = 0; C < COPY_COUNT; C++)); do
    for ((K = 0; K < KEY_COUNT; K++)); do
      DESTINATION="${COPIES[C]}/${PATCH_KEYS[K]}"
      ACTIONS[C * KEY_COUNT + K]=2
      if is_plain_file "$DESTINATION" && [ "$(sha256_of "$DESTINATION")" = "${POST_SHA[K]}" ]; then
        if [ "$(mode_of "$DESTINATION")" = "${POST_MODE[K]}" ]; then
          ACTIONS[C * KEY_COUNT + K]=0
        else
          ACTIONS[C * KEY_COUNT + K]=1
        fi
      fi
      if [ "${ACTIONS[C * KEY_COUNT + K]}" -eq 2 ]; then
        NEEDS_POST_IMAGE=1
      fi
    done
  done
fi

if [ -z "$DEGRADE_REASON" ] && [ "$NEEDS_POST_IMAGE" -eq 1 ]; then
  SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/compound-engineering-overlays.XXXXXX")"
  mkdir -p -- "$SCRATCH/git-home"
  verify_pristine
  if [ -z "$DEGRADE_REASON" ]; then
    compute_post_images
  fi
fi

if [ -z "$DEGRADE_REASON" ]; then
  reset_jobs
  for ((C = 0; C < COPY_COUNT; C++)); do
    for ((K = 0; K < KEY_COUNT; K++)); do
      case "${ACTIONS[C * KEY_COUNT + K]}" in
        1)
          add_job chmod "${COPIES[C]}" "${PATCH_KEYS[K]}" "${POST_MODE[K]}" ''
          ;;
        2)
          add_job install "${COPIES[C]}" "${PATCH_KEYS[K]}" "$SCRATCH/work/${PATCH_KEYS[K]}" ''
          ;;
      esac
    done
  done
  if ! run_jobs; then
    warn "an install step failed and every change was undone"
    note_failure "an install step failed"
  fi
fi

if [ -n "$DEGRADE_REASON" ]; then
  if [ -z "$SCRATCH" ]; then
    SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/compound-engineering-overlays.XXXXXX")"
  fi
  if [ "$PRISTINE_CHECKED" -eq 0 ]; then
    verify_pristine
  fi
  degrade_all
  exit 0
fi
