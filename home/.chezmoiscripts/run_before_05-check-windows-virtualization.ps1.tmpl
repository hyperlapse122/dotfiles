{{ if eq .chezmoi.os "windows" -}}
{{ "\ufeff" -}}
#requires -Version 5.1
$ErrorActionPreference = 'Stop'

try {
    $wsl = @(Get-Command wsl.exe -CommandType Application -ErrorAction Stop)[0]
    if (-not $wsl.Source) { throw 'The WSL executable could not be resolved.' }
} catch {
    throw ('WSL2 prerequisite check failed: WSL is unavailable. Install current WSL manually using https://learn.microsoft.com/windows/wsl/install and complete any requested restart before applying again. Details: {0}' -f $_.Exception.Message)
}

# Exit codes are invariant; status text is localized and can mention a missing distro.
foreach ($option in @('--version', '--status')) {
    $global:LASTEXITCODE = $null
    try {
        $ErrorActionPreference = 'Continue'
        & $wsl.Source $option *> $null
        $exitCode = $global:LASTEXITCODE
    } finally {
        $ErrorActionPreference = 'Stop'
    }
    if ($null -eq $exitCode -or $exitCode -ne 0) {
        throw ('WSL2 prerequisite check failed: wsl.exe {0} failed (exit {1}). Manually install or update WSL, complete any requested restart, and rerun apply. Run wsl.exe {0} directly for diagnostics.' -f $option, $exitCode)
    }
}

$requiredFeatures = [ordered]@{
    VirtualMachinePlatform = 'Virtual Machine Platform (required by WSL2)'
    HypervisorPlatform = 'Windows Hypervisor Platform'
}
foreach ($feature in $requiredFeatures.GetEnumerator()) {
    try {
        $state = @(Get-CimInstance -ClassName Win32_OptionalFeature -Filter "Name = '$($feature.Key)'" -ErrorAction Stop)
    } catch {
        throw ('Cannot verify {0} ({1}) through Windows CIM. Check query permissions and feature state manually before applying again. Details: {2}' -f $feature.Value, $feature.Key, $_.Exception.Message)
    }
    if ($state.Count -ne 1 -or $state[0].InstallState -ne 1) {
        throw ('{0} ({1}) is not confirmed enabled. Enable it manually in Windows Features, complete any requested restart, and rerun apply.' -f $feature.Value, $feature.Key)
    }
}

Write-Host 'WSL2 prerequisite queries succeeded; Virtual Machine Platform and Windows Hypervisor Platform are enabled. Podman and Kubernetes setup remains manual.'
{{ end -}}
