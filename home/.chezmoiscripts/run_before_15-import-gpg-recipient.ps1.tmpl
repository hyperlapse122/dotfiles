{{ if eq .chezmoi.os "windows" -}}
{{- $gpg := includeTemplate "gpg-settings" . | fromJson -}}
{{ "\ufeff" -}}
$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = [Text.Encoding]::UTF8
$OutputEncoding = [Console]::OutputEncoding
$gpg = '{{ $gpg.program | replace "'" "''" }}'
$recipient = '{{ .gpgRecipient | replace "'" "''" }}'
$scratch = Join-Path ([IO.Path]::GetTempPath()) ('dotfiles-gpg-' + [Guid]::NewGuid().ToString('N'))
[IO.Directory]::CreateDirectory($scratch) | Out-Null
try {
    $keyFile = Join-Path $scratch 'recipient.asc'
    $publicKey = @'
{{ .gpgRecipientPublicKey }}
'@
    [IO.File]::WriteAllText($keyFile, $publicKey, [Text.UTF8Encoding]::new($false))
    function Get-PrimaryFingerprint($lines) {
        $primary = $false
        $count = 0
        $fingerprint = ''
        foreach ($line in $lines) {
            $fields = $line.Split(':')
            if ($fields[0] -eq 'sec') { throw 'Public GPG recipient artifact contains a private key.' }
            if ($fields[0] -eq 'pub') { $primary = $true; $count++; continue }
            if ($primary -and $fields[0] -eq 'fpr') { $fingerprint = $fields[9]; $primary = $false }
        }
        if ($count -ne 1 -or -not $fingerprint) { return '' }
        return $fingerprint
    }
    # Inspection can create keyring files, so use a disposable home first.
    $inspection = & $gpg --no-options --batch --no-autostart --no-auto-check-trustdb `
        --homedir $scratch --with-colons --import-options show-only --import $keyFile
    if ($LASTEXITCODE -ne 0 -or (Get-PrimaryFingerprint $inspection) -cne $recipient) {
        throw 'Public GPG recipient fingerprint does not match the configured recipient.'
    }
    # Windows PowerShell treats redirected native stderr as a PowerShell error.
    # A missing recipient is expected here; preserve its native exit code.
    $savedErrorActionPreference = $ErrorActionPreference
    try {
        $ErrorActionPreference = 'Continue'
        $existing = & $gpg --no-options --batch --no-autostart --no-auto-check-trustdb `
            --with-colons --list-keys $recipient 2>$null
        $listExit = $LASTEXITCODE
    } finally {
        $ErrorActionPreference = $savedErrorActionPreference
    }
    if ($listExit -eq 0 -and (Get-PrimaryFingerprint $existing) -ceq $recipient) { return }
    & $gpg --no-options --batch --no-autostart --no-auto-check-trustdb --import $keyFile
    if ($LASTEXITCODE -ne 0) { throw 'Public GPG recipient import failed.' }
    $imported = & $gpg --no-options --batch --no-autostart --no-auto-check-trustdb `
        --with-colons --list-keys $recipient
    if ($LASTEXITCODE -ne 0 -or (Get-PrimaryFingerprint $imported) -cne $recipient) {
        throw 'Imported GPG recipient fingerprint verification failed.'
    }
} finally {
    Remove-Item -LiteralPath $scratch -Recurse -Force
}
{{ end -}}
