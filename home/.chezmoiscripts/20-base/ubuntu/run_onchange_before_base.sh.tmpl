{{ if and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "pop")) -}}
#!/usr/bin/env bash

set -euo pipefail

# Base Ubuntu/Debian system provisioning: core development tools,
# shell utilities, and essential networking tools.

{{ includeTemplate "facts-sh.tmpl" . }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-base-ubuntu") }}

SUDO=()
if [[ "${EUID}" -ne 0 ]]; then
  if ! command -v sudo >/dev/null 2>&1; then
    printf 'install-base-ubuntu.sh: requires root or sudo for package installation.\n' >&2
    exit 1
  fi
  SUDO=(sudo)
fi

install_apt() {
  local pkg=$1
  local status=''
  status="$(dpkg-query -f '${db:Status-Status}' -W "$pkg" 2>/dev/null)" || status=''
  if [[ "$status" != installed ]]; then
    "${SUDO[@]}" apt-get install -y "$pkg"
  fi
}

base_packages=(
  build-essential
  ca-certificates
  curl
  file
  git
  jq
  lsb-release
  ripgrep
  tmux
  wget
  zsh
)

# Named generically, unlike the other converted installers' missing_<set>
# arrays: the frozen base-packages-already-present matrix row's predicate
# already reads "${#missing[@]}", so renaming it would move that row too.
missing=()
compute_missing() {
  missing=()
  local pkg status
  for pkg in "${base_packages[@]}"; do
    status="$(dpkg-query -f '${db:Status-Status}' -W "$pkg" 2>/dev/null)" || status=''
    if [[ "$status" != installed ]]; then
      missing+=("${pkg}")
    fi
  done
}

report_base_missing() {
  printf 'install-base-ubuntu.sh: apt-get left these declared base packages uninstalled: %s\n' "${missing[*]}" >&2
  printf '  sudo apt-get install -y %s\n' "${missing[*]}" >&2
  return 0
}

clear_base_skip_record() {
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "clear_record" "script" "install-base-ubuntu" "site" "base-packages-not-installed") | trim | indent 2 }}
}

install_base_packages() {
  compute_missing
  # The early return below is the converged path, and it never reaches the
  # retirement at the end of this function. A host an earlier apply blocked
  # converges there and nowhere else, so retire its record before taking it.
  [[ "${#missing[@]}" -gt 0 ]] || clear_base_skip_record
  if [[ "${#missing[@]}" -eq 0 ]]; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "done_here" "script" "install-base-ubuntu" "site" "base-packages-already-present" "reason" "all declared base packages are already installed") | trim | indent 6 }}
    )
    return 0
  fi

  printf 'install-base-ubuntu.sh: %d of %d base packages missing; updating apt cache and installing.\n' \
    "${#missing[@]}" "${#base_packages[@]}"

  "${SUDO[@]}" apt-get update -qq || true
  # Exit status is discarded because the post-attempt re-inspection is the verdict.
  if ! "${SUDO[@]}" apt-get install -y "${missing[@]}"; then :; fi
  compute_missing

  if [[ "${#missing[@]}" -gt 0 ]] && report_base_missing; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-base-ubuntu" "site" "base-packages-not-installed" "direction" "operator-blocking" "reason" "apt-get left declared base packages uninstalled; the missing set and the by-hand install command were printed above") | trim | indent 4 }}
  fi
  clear_base_skip_record
}

install_base_packages

{{ end -}}
