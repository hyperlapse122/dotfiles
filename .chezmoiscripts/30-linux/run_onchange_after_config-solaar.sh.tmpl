{{ if eq .chezmoi.os "linux" -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ $solaarPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "solaar-present") -}}
{{ $pythonYamlPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "python3-yaml-present") -}}
#!/usr/bin/env bash
#
# Apply per-device Solaar settings to ~/.config/solaar/config.yaml that
# CANNOT be expressed via the symlinked rules.yaml. Currently:
#
#   1. divert-keys: route specific reprogrammable buttons through Solaar's
#      rule engine (HID++ notifications) instead of the device firmware
#      default (which sends a stock mouse button).
#   2. thumb-scroll-mode: divert the thumb wheel (MX Master 4 + MX Master 3S)
#      so THUMB WHEEL notifications reach the rules.yaml horizontal-scroll
#      rule.
#   3. scroll/feel ergonomics (smart-shift, scroll-ratchet-torque,
#      hires-smooth-resolution): tuned values enforced declaratively so
#      every machine the mouse pairs with feels identical. Pointer DPI is
#      deliberately NOT managed here — left to the firmware/user default.
#
# The settings themselves are DATA, not script: .chezmoidata/solaar.yaml is
# the single source of truth (device model IDs, setting paths/values, and the
# per-setting reference documentation). Edit the yaml, not the TARGETS array
# below — the data renders into this script, so a yaml edit re-triggers this
# run_onchange_ script automatically.
#
# Haptic intensity (`haptic-level`) is intentionally NOT enforced here —
# leave that to the user's Solaar GUI preference. The mxm4-haptic helper
# writes raw HID++ haptic-play with no ack wait, so intermittent
# perceptibility at low intensity (a Bolt-wireless ack-variance artefact
# of Solaar's own `Set` write path) is no longer a concern.
#
# Why not symlink config.yaml itself: the file embeds per-physical-device
# state (_serial, _unitId, _battery, _absent feature list) alongside the
# settings we want to manage. Tracking it verbatim would couple the repo
# to one mouse unit, break on hardware replacement, and produce noisy
# diffs every time Solaar updates battery readings.
#
# Why not `solaar config <setting> <value>`: Solaar 1.1.19 hits
#   TypeError: Unable to marshal str as an array
# inside Gio.Application.run when persisting the change. The runtime
# device state flips (so the rule fires once or the pulse plays once);
# the on-disk config does not. GUI path persists correctly but isn't
# automatable.
#
# This script edits the file directly with PyYAML and only restarts
# Solaar if it actually changed something. PyYAML is a Solaar rpm
# requirement, so importing yaml via /usr/bin/python3 (NOT bare
# `python3`, which mise may shadow) is guaranteed wherever Solaar is.
#
# Soft-skips when:
#   - solaar not installed (nothing to configure)
#   - ~/.config/solaar/config.yaml absent (no devices paired yet)
#   - target device not present in config.yaml (paired on another host only)
#   - PyYAML unreachable via /usr/bin/python3 (defensive; Solaar rpm pulls it)
#
# Config edit is idempotent: re-running on an already-correct config writes
# nothing and touches no backup. The Solaar restart in section 4, however, now
# fires on every run (when the service is active), so a rules-only change —
# an edit to rules.yaml.tmpl or to the solaar.rules tunables in solaar.yaml,
# either of which re-runs this script via the fingerprint below — is still
# picked up even when divert-keys was already correct.
#
# Rules and capability fingerprints — comment-only; never executed. The
# capability tokens pair each transient-blocking declaration below with the
# cached precondition it names.
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir
      "globs" (list "dot_config/solaar/rules.yaml.tmpl" ".chezmoidata/solaar.yaml")
      "values" (list
        (dict "name" "solaar-present" "value" $solaarPresent)
        (dict "name" "python3-yaml-present" "value" $pythonYamlPresent))) }}
set -euo pipefail

CONFIG="${HOME}/.config/solaar/config.yaml"
PYTHON=/usr/bin/python3
SOLAAR_SERVICE=app-solaar@autostart.service

# Per-device targets rendered from .chezmoidata/solaar.yaml — EDIT THE DATA,
# not this array (the setting reference lives in the yaml header too). One
# entry per setting: "<model_id>:<setting_path>:<value>:<label>"
#   model_id     : 12-hex from `solaar show` -> Model ID line.
#   setting_path : either a scalar setting name (e.g. `smart-shift`) or
#                  a nested-dict path (e.g. `divert-keys.416`). The inline
#                  python splits on the first dot: no dot means scalar, dot
#                  means the second part is an int key into the named dict.
#   value        : int, or the literal token `true`/`false` for boolean
#                  settings — parsed to a real Python bool so it round-trips
#                  as a YAML boolean (Solaar stores e.g.
#                  `hires-smooth-resolution: false`, not 0). Go-template
#                  renders the yaml's native ints/bools as exactly these
#                  tokens.
#   label        : free-form, only for log output ("<device name> / <label>").
TARGETS=(
{{- range $dev := .solaar.devices }}
{{- range $s := $dev.settings }}
  "{{ $dev.modelId }}:{{ $s.path }}:{{ $s.value }}:{{ $dev.name }} / {{ $s.label }}"
{{- end }}
{{- end }}
)

# 0. Solaar is installed by this repository, so absence is a DECLARED
# transient-blocking precondition paired with the cached fingerprint above.
if ! command -v solaar >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-solaar" "site" "solaar-absent" "direction" "transient-blocking" "probe" "solaar-present" "reason" "solaar is not installed; device configuration is deferred") | trim | indent 2 }}
fi

# 1. A config never generated by Solaar cannot be configured by this script:
# DECLARED harmless because pairing a device is an intentional data boundary.
if [[ ! -f "$CONFIG" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-solaar" "site" "config-not-generated" "direction" "harmless" "reason" "the Solaar config file has not been generated by a paired device") | trim | indent 2 }}
fi

# 2. PyYAML via system Python is a repository-installed precondition, so its
# absence is DECLARED transient-blocking and paired with the cached token above.
if ! "$PYTHON" -c "import yaml" 2>/dev/null; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-solaar" "site" "pyyaml-absent" "direction" "transient-blocking" "probe" "python3-yaml-present" "reason" "PyYAML is unavailable from system Python; device configuration is deferred") | trim | indent 2 }}
fi

# 3. Apply targets via inline Python: load, mutate, atomic write, log.
RESULT=$("$PYTHON" - "$CONFIG" "${TARGETS[@]}" <<'PYEOF'
import os
import shutil
import sys

import yaml

config_path = sys.argv[1]
targets = []
for spec in sys.argv[2:]:
    parts = spec.split(":", 3)
    if len(parts) < 4:
        sys.stderr.write(
            f"config-solaar: malformed target {spec!r}; "
            f"need model:setting_path:value:label\n"
        )
        continue
    model_id, setting_path, value_str, label = parts
    if value_str in ("true", "false"):
        # Boolean settings (hires-smooth-resolution, thumb-scroll-mode)
        # must land as real bools so PyYAML serializes them back as the
        # YAML booleans Solaar wrote (`false`, not `0`).
        value = value_str == "true"
    else:
        try:
            value = int(value_str)
        except ValueError:
            sys.stderr.write(
                f"config-solaar: value {value_str!r} in {spec!r} is neither "
                f"an int nor true/false; skipping\n"
            )
            continue
    if "." in setting_path:
        setting_name, key_str = setting_path.split(".", 1)
        try:
            key = int(key_str)
        except ValueError:
            sys.stderr.write(
                f"config-solaar: non-int dict key {key_str!r} in {spec!r}; skipping\n"
            )
            continue
    else:
        setting_name = setting_path
        key = None
    targets.append((model_id, setting_name, key, value, label))

with open(config_path) as f:
    doc = yaml.safe_load(f)

# Solaar's config.yaml is a single document whose top level is a list:
# the first element is the Solaar version string, the rest are per-device
# dicts. Bail out cleanly if Solaar changes the schema rather than risk
# corrupting it.
if not isinstance(doc, list):
    print("UNCHANGED:UNEXPECTED_SCHEMA: top-level not a list")
    sys.exit(0)

changed_labels = []
skipped_labels = []
for model_id, setting_name, key, value, label in targets:
    device = next(
        (entry for entry in doc
         if isinstance(entry, dict) and entry.get("_modelId") == model_id),
        None,
    )
    if device is None:
        skipped_labels.append(f"{label} (model {model_id} not in config)")
        continue
    if key is None:
        # Scalar setting (e.g. haptic-level).
        if device.get(setting_name) == value:
            continue
        device[setting_name] = value
    else:
        # Nested-dict setting (e.g. divert-keys.416).
        existing = device.get(setting_name)
        if existing is None:
            existing = {}
        if not isinstance(existing, dict):
            skipped_labels.append(
                f"{label} ({setting_name} not a dict in config)"
            )
            continue
        if existing.get(key) == value:
            continue
        existing[key] = value
        device[setting_name] = existing
    changed_labels.append(label)

if not changed_labels:
    if skipped_labels:
        print("UNCHANGED:SKIPPED:" + "; ".join(skipped_labels))
    else:
        print("UNCHANGED")
    sys.exit(0)

# Atomic write: backup the previous config, write to temp, rename in place.
shutil.copy2(config_path, config_path + ".bak")
tmp = config_path + ".new"
with open(tmp, "w") as f:
    yaml.safe_dump(doc, f, default_flow_style=None, sort_keys=False,
                   allow_unicode=True)
os.replace(tmp, config_path)

msg = "CHANGED:" + "; ".join(changed_labels)
if skipped_labels:
    msg += " | SKIPPED:" + "; ".join(skipped_labels)
print(msg)
PYEOF
)

echo "config-solaar: $RESULT"

# 4. Restart Solaar so it reloads its rules + diversion state. This fires on
# every run after a changed source fingerprint, even when $RESULT is unchanged.
# An inactive user service is a DECLARED harmless step completion: new state
# loads at the next user-session start, so do not start it outside a session.
restart_solaar() {
  if systemctl --user is-active --quiet "$SOLAAR_SERVICE" 2>/dev/null; then
    systemctl --user restart "$SOLAAR_SERVICE"
    echo "config-solaar: restarted $SOLAAR_SERVICE (config result: $RESULT)"
  else
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-solaar" "site" "service-not-running" "direction" "harmless" "reason" "the Solaar user service is not running; new state loads at next start") | trim | indent 4 }}
  fi
}
restart_solaar

exit 0
{{ end -}}