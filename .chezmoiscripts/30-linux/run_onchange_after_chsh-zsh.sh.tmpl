{{ if eq .chezmoi.os "linux" -}}
{{ $sudoUsable := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "sudo-usable") -}}
{{ $zshPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "zsh-present") -}}
{{ $chshPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "chsh-present") -}}
{{ $sqlite3Present := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "sqlite3-present") -}}
{{ $facts := includeTemplate "facts.tmpl" . | fromYaml -}}
{{ $distro := $facts.distro -}}
#!/usr/bin/env bash
#
# Set the invoking user's login shell to zsh. The login shell lives in the
# /etc/passwd field, which chezmoi (a $HOME manager) cannot own, so this ships
# as a `run_onchange_after_` script — the chezmoi equivalent of a post-install
# shell step.
#
# Idempotent: the current login shell is read from /etc/passwd (via getent)
# first. If it is already a zsh, the script prints a notice and exits 0 WITHOUT
# touching sudo — so the steady-state re-run (this file re-runs whenever its
# rendered content changes) is a silent no-op that never prompts for a password.
#
# Soft-skips (exit 0, never aborts `chezmoi apply`) when:
#   - zsh is not installed (nothing to switch to; install zsh, then re-run)
#   - chsh is not available (Fedora ships it in util-linux-user)
#   - not root, stdin is not a TTY, and sudo has no cached credentials — a
#     non-interactive apply (CI, an agent, a piped run) can't answer a sudo
#     prompt. That skip is DECLARED transient-blocking on the cached
#     `sudo-usable` capability (see the fingerprint block below), so chezmoi
#     still records the run as successful, but the token flipping to available
#     changes this script's content and chezmoi re-runs it on its own.
#
# sudo: rewriting the /etc/passwd shell field needs root. The script body runs
# as the user (so $USER is the real invoking user), and only the privileged
# `chsh`/`tee` calls are prefixed with sudo; when already root (e.g. a chroot
# bootstrap) sudo is dropped.
#
# /etc/shells: a login shell should be registered there (getusershell()-based
# tooling and display managers consult it). The zsh rpm registers it already;
# on a host where it is missing we append the resolved path (guarded,
# idempotent) so the registry stays correct.
#
# Single-platform (Linux only) by design — gated on `.chezmoi.os == "linux"`.
# macOS already defaults to zsh and Windows has no /etc/passwd login shell, so
# there is nothing equivalent to do on either; no .ps1 counterpart per the
# script-parity exception in ../AGENTS.md.

# Capability fingerprints pair each transient-blocking declaration below with
# the cached precondition it names. Comment-only; never executed.
{{- $fingerprintValues := list
      (dict "name" "sudo-usable" "value" $sudoUsable)
      (dict "name" "zsh-present" "value" $zshPresent)
      (dict "name" "chsh-present" "value" $chshPresent) -}}
{{- if eq $distro "ubuntu" -}}
{{-   $fingerprintValues = append $fingerprintValues (dict "name" "sqlite3-present" "value" $sqlite3Present) -}}
{{- end -}}
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" $fingerprintValues) }}
set -euo pipefail

# 1. Nothing to switch to if zsh isn't installed: DECLARED transient-blocking,
# paired with the cached zsh-present fingerprint above.
if ! command -v zsh >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "chsh-zsh" "site" "zsh-absent" "direction" "transient-blocking" "probe" "zsh-present" "reason" "zsh is not installed; login-shell change is deferred") | trim | indent 2 }}
fi
zsh_bin="$(command -v zsh)"

# 2. Already a zsh login shell? This is a DECLARED done_here completion. Match
# on basename so /bin/zsh vs /usr/bin/zsh does not cause needless churn.
current_shell="$(getent passwd "$USER" 2>/dev/null | awk -F: '{ print $7 }')" || true
if [[ "${current_shell##*/}" == "zsh" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "done_here" "script" "chsh-zsh" "site" "already-zsh-login-shell" "reason" "the login shell is already zsh") | trim | indent 2 }}
fi

# 3. chsh is what actually rewrites the /etc/passwd shell field. Its absence is
# a DECLARED transient-blocking precondition because Fedora installs it later.
if ! command -v chsh >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "chsh-zsh" "site" "chsh-absent" "direction" "transient-blocking" "probe" "chsh-present" "reason" "chsh is not installed; login-shell change is deferred") | trim | indent 2 }}
fi

# 4. Privilege: prefix privileged calls with sudo unless we are already root.
{{ includeTemplate "sudo-skip-guard.sh.tmpl" "chsh-zsh" -}}

{{ if eq $distro "ubuntu" -}}
# 4b. authd-managed account? An authd/Entra account has no /etc/passwd row, so
# chsh cannot rewrite its shell. The whole branch is gated at TEMPLATE compile
# time on distro.ubuntu, so a Fedora render never gains this control flow.
#
# `@` in the username is the agreed provisional discriminator. A real
# authd-membership probe is deliberately out of scope.
if [[ "$USER" == *@* ]]; then
  authd_db=/var/lib/authd/authd.sqlite3

  # `authctl user set-shell` is the supported interface, but it landed upstream
  # after release tag v0.6.4, so most installed authd builds do not have it.
  # Probing the SUBCOMMAND rather than the binary is the whole point: `command -v
  # authctl` succeeds on an older build, which would then abort under `set -e`
  # instead of reaching the documented fallback below. This is a branch selector,
  # not a skip precondition, so it stays a runtime probe with no cached capability.
  if authctl user set-shell --help >/dev/null 2>&1; then
    printf 'chsh-zsh: setting authd login shell for %s to %s via authctl\n' "$USER" "$zsh_bin"
    "${SUDO[@]}" authctl user set-shell "$USER" "$zsh_bin" || true
  else
    if ! command -v sqlite3 >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "chsh-zsh" "site" "authd-sqlite3-absent" "direction" "transient-blocking" "probe" "sqlite3-present" "reason" "neither authctl user set-shell nor sqlite3 is available; the authd login-shell change is deferred") | trim | indent 6 }}
    fi

    # Writing the vendor's database directly is NOT a supported interface, so
    # every assumption is asserted before the write and any failure is a
    # diagnostic rather than an abort: schema, column, version row, user row.
    if [[ ! -r "$authd_db" ]]; then
      printf 'chsh-zsh: %s is not readable; leaving the authd login shell unchanged.\n' "$authd_db" >&2
    elif ! "${SUDO[@]}" sqlite3 "$authd_db" 'SELECT shell FROM users LIMIT 0;' >/dev/null 2>&1; then
      printf 'chsh-zsh: authd schema has no users.shell column; leaving the authd login shell unchanged.\n' >&2
    elif ! "${SUDO[@]}" sqlite3 "$authd_db" 'SELECT version FROM schema_version LIMIT 1;' >/dev/null 2>&1; then
      printf 'chsh-zsh: authd schema_version is unreadable; leaving the authd login shell unchanged.\n' >&2
    elif [[ "$("${SUDO[@]}" sqlite3 "$authd_db" "SELECT count(*) FROM users WHERE name = '${USER//\'/\'\'}';" 2>/dev/null)" != 1 ]]; then
      printf 'chsh-zsh: authd has no users row for %s; leaving the authd login shell unchanged.\n' "$USER" >&2
    else
      printf 'chsh-zsh: setting authd login shell for %s to %s\n' "$USER" "$zsh_bin"
      "${SUDO[@]}" sqlite3 "$authd_db" \
        "UPDATE users SET shell = '${zsh_bin//\'/\'\'}' WHERE name = '${USER//\'/\'\'}';" || true
    fi
  fi

  # authd re-reads the database per query and its NSS module opens a fresh client
  # per lookup, so a write is visible immediately: no daemon restart, which on a
  # shared host would interrupt authentication for everyone.
  confirmed="$(getent passwd "$USER" 2>/dev/null | awk -F: '{ print $7 }')" || true
  if [[ "${confirmed##*/}" == "zsh" ]]; then
    printf 'chsh-zsh: done. Log out and back in for the new login shell to take effect.\n'
  else
    printf 'chsh-zsh: authd still reports %s for %s; retrying on the next apply.\n' "${confirmed:-<unset>}" "$USER" >&2
  fi
  exit 0
fi
{{ end -}}
# 5. chsh only accepts a shell listed in /etc/shells for non-root callers, and
#    a login shell belongs there regardless. Register the resolved zsh path if
#    the package did not already (idempotent: append only when missing).
if [[ -f /etc/shells ]] && ! grep -qxF "$zsh_bin" /etc/shells; then
  printf 'chsh-zsh: registering %s in /etc/shells\n' "$zsh_bin"
  printf '%s\n' "$zsh_bin" | "${SUDO[@]}" tee -a /etc/shells >/dev/null
fi

# 6. Switch the login shell.
printf 'chsh-zsh: setting login shell for %s to %s\n' "$USER" "$zsh_bin"
"${SUDO[@]}" chsh -s "$zsh_bin" "$USER"

printf 'chsh-zsh: done. Log out and back in for the new login shell to take effect.\n'
{{ end -}}