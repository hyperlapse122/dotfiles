{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
{{-   $luksPassphrase := "" -}}
{{-   if and (hasKey . "luksPassphraseCipher") (ne .luksPassphraseCipher "") -}}
{{-     $secretsKey := includeTemplate "config-secrets-key.tmpl" . -}}
{{-     if ne $secretsKey "" }}{{ $luksPassphrase = decryptAES $secretsKey .luksPassphraseCipher }}{{ end -}}
{{-   end -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ $sudoUsable := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "sudo-usable") -}}
#!/usr/bin/env bash
#
# Wrapper that enrolls Fedora LUKS devices for TPM2 auto-unlock on
# `chezmoi apply`, by driving the deployed
# ~/.local/bin/setup-luks-tpm2-unlock.sh non-interactively.
#
# PASSPHRASE from the chezmoi config: `chezmoi init` prompts once for the
# existing LUKS passphrase and stores it AES-ENCRYPTED (luksPassphraseCipher in
# ~/.config/chezmoi/chezmoi.toml — see .chezmoi.toml.tmpl) with the
# user-keyring key from .chezmoitemplates/config-secrets-key.tmpl. This wrapper
# decrypts it at render time and hands it to the enrollment tool through the
# SETUP_LUKS_TPM2_PASSPHRASE environment variable (the tool reads it from env
# ONLY, never argv, and clears it immediately). A blank prompt (or an
# unreachable/locked keyring at render time, which leaves the key empty) takes
# the skip path below — e.g. once the disk is already enrolled. Enrollment is
# also idempotent: a device that already carries a systemd-tpm2 token is
# skipped even when a passphrase is given.
#
# onchange trigger: the fingerprint block below embeds a sha256 of the deployed
# enrollment tool (executable_setup-luks-tpm2-unlock.sh.tmpl and its inlined
# .setup-luks-tpm2-unlock_dracut.sh backend), so chezmoi re-runs this wrapper
# whenever the enrollment logic changes. The prompted LUKS passphrase is NOT part
# of the fingerprint — only the tool's source is hashed; note that a stored
# passphrase does decrypt into this script's body (base64), which itself
# changes the onchange hash, so the first apply after init stores one does
# fire enrollment (and an apply where the keyring is temporarily unreachable
# renders the skip branch instead — a harmless hash flip that re-fires the
# idempotent enrollment on the next reachable apply). Blank passphrase, a
# not-yet-deployed tool, an absent TPM, no LUKS device, or missing sudo is
# classified explicitly below. The cached sudo fingerprint makes its
# transient-blocking skip recover automatically when sudo becomes usable;
# permanent hardware and data opt-outs remain final.
# SECURITY NOTES (inherent to the chezmoi-prompt approach, chosen deliberately):
#   * promptString does NOT mask input, so the passphrase is echoed on screen as
#     you type it during an interactive `chezmoi init`.
#   * At rest the config carries only the AES ciphertext; the key never leaves
#     the user keyring. But when a passphrase decrypts, it is rendered
#     (base64-wrapped only for shell safety, NOT secrecy) into this script's
#     transient run-script file, which chezmoi writes mode-0700 and deletes
#     after execution. Avoid `chezmoi apply --verbose` / `--dry-run` with a real
#     passphrase stored, as those print rendered script contents.
#   * Non-interactive inits (CI, agents, piped) get promptString's empty
#     default, so no ciphertext is stored and applies take the skip path below —
#     no passphrase is ever rendered.
set -euo pipefail
export LC_ALL=C

# Enrollment tool and capability fingerprints — comment-only; never executed.
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir
      "globs" (list "dot_local/share/chezmoi/command-sources/executable_setup-luks-tpm2-unlock.sh.tmpl" "dot_local/share/chezmoi/command-sources/.setup-luks-tpm2-unlock_dracut.sh")
      "values" (list (dict "name" "sudo-usable" "value" $sudoUsable))) }}
{{ if $luksPassphrase -}}
tool="${HOME}/.local/bin/setup-luks-tpm2-unlock.sh"

# Every unmet precondition is declared through skip.sh.tmpl.
if [[ ! -x "$tool" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "luks-tpm2" "site" "tool-not-deployed" "direction" "harmless" "reason" "the TPM2 enrollment tool is not deployed in the user bin directory") | trim | indent 2 }}
fi

# TPM2 present? (kernel device node — backend-neutral)
if [[ ! -e /sys/class/tpm/tpm0 && ! -e /dev/tpmrm0 ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "luks-tpm2" "site" "no-tpm2-device" "reason" "this host has no TPM2 device") | trim | indent 2 }}
fi

# Any crypto_LUKS block device to enroll?
if ! lsblk -rno FSTYPE 2>/dev/null | grep -qx 'crypto_LUKS'; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "luks-tpm2" "site" "no-luks-devices" "reason" "this host has no LUKS devices to enroll") | trim | indent 2 }}
fi

# Enrollment needs root. A non-empty passphrase only ever comes from an
# interactive promptString, so a terminal is present and the tool can prompt for
# sudo itself — we only need sudo to exist here.
if [[ "$EUID" -ne 0 ]] && ! command -v sudo >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "luks-tpm2" "site" "sudo-unavailable" "direction" "transient-blocking" "probe" "sudo-usable" "reason" "not root and sudo is unavailable; TPM2 enrollment is deferred") | trim | indent 2 }}
fi

# Hand the prompted passphrase to the tool via env (never argv). base64 keeps any
# shell-special characters in the passphrase from breaking the assignment; the
# tool reads $SETUP_LUKS_TPM2_PASSPHRASE, clears it, and enrolls every
# not-yet-enrolled LUKS device for TPM2 unlock.
SETUP_LUKS_TPM2_PASSPHRASE="$(printf '%s' {{ $luksPassphrase | b64enc | quote }} | base64 -d)" "$tool"
{{ else -}}
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "luks-tpm2" "site" "no-stored-passphrase" "direction" "harmless" "reason" "no stored LUKS passphrase is available for TPM2 enrollment") }}
{{ end -}}
{{ end -}}
