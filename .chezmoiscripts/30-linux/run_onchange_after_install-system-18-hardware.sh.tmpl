{{ if eq .chezmoi.os "linux" -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
#!/usr/bin/env bash
set -euo pipefail

{{ includeTemplate "headless-guard.sh.tmpl" (dict "ctx" . "name" "install-system-hardware") }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-system-hardware") }}
{{ includeTemplate "sudo-elevation-guard.sh.tmpl" (dict "ctx" . "name" "install-system-hardware") }}
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "system/linux/etc/modprobe.d/thinkpad_acpi.conf" "system/linux/etc/modules-load.d/thinkpad_acpi.conf")) }}
SRC_ROOT="{{ $sourceDir }}/system/linux"

os_id="$(. /etc/os-release 2>/dev/null && printf '%s' "${ID:-}")" || os_id=""

override_patterns=()
override_modes=()
override_gates=()
{{ range .system.linux.hardware.overrides -}}
override_patterns+=({{ .path | quote }})
override_modes+=({{ get . "mode" | default "644" | quote }})
override_gates+=({{ get . "gate" | default "" | quote }})
{{ end }}
{{- $gates := list -}}
{{- range .system.linux.hardware.overrides -}}
{{-   $gate := get . "gate" | default "" -}}
{{-   if ne $gate "" -}}
{{-     $gates = append $gates $gate -}}
{{-   end -}}
{{- end -}}
{{- includeTemplate "facts-validate.tmpl" (dict "ctx" . "source" ".chezmoidata/system.yaml (hardware.overrides)" "gates" $gates) -}}

{{ includeTemplate "facts-gate.sh.tmpl" . }}
gate_ok() {
  fact_gate "$1"
}

hw_files=("$SRC_ROOT"/etc/modprobe.d/thinkpad_acpi.conf "$SRC_ROOT"/etc/modules-load.d/thinkpad_acpi.conf)
for src in "${hw_files[@]}"; do
  [[ -f "$src" ]] || continue
  rel="${src#"$SRC_ROOT"/}"
  dst="/$rel"
  mode=644
  gate=
  for i in "${!override_patterns[@]}"; do
    # shellcheck disable=SC2254 # manifest entries are deliberate glob patterns
    case "$rel" in
      ${override_patterns[$i]})
        mode="${override_modes[$i]}"
        gate="${override_gates[$i]}"
        break
        ;;
    esac
  done

  if ! gate_ok "$gate"; then
    printf '  -- %s (skipped: gate %s failed)\n' "$dst" "$gate"
    continue
  fi

  printf '  -> %s (mode %s)\n' "$dst" "$mode"
  "${SUDO[@]}" install -D -m "$mode" "$src" "$dst"
done

if [[ "$FACT_THINKPAD" == 1 ]]; then
  printf '  -> modprobe thinkpad_acpi\n'
  "${SUDO[@]}" modprobe thinkpad_acpi
else
  (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "install-system-hardware" "site" "thinkpad-absent" "reason" "this host is not a ThinkPad") | trim | indent 4 }}
  )
fi

if [[ "$FACT_UX534" == 1 ]]; then
  # Take the ScreenPad's power state away from systemd. The panel boots powered
  # and i915 enumerates it as HDMI-A-1; what kills it is this unit restoring the
  # brightness it saved at the previous shutdown, ~3s in. Masking stops both
  # halves — the restore that disconnects the panel and the save that recorded
  # the value. See .chezmoidata/ux534.yaml for the full mechanism.
  printf '  -> masking systemd-backlight@backlight:asus_screenpad.service\n'
  # FATAL on failure, deliberately. This mask IS the fix, and masking is just a
  # symlink to /dev/null -- it does not require the unit to exist, so a failure
  # here is a real one. Swallowing it would be worse than noisy: chezmoi records
  # a script that exits 0 as a converged run and will not retry it until the
  # rendered content changes, so a warning-and-continue would leave the panel
  # broken with a permanent false success against it.
  if ! "${SUDO[@]}" systemctl mask systemd-backlight@backlight:asus_screenpad.service; then
    printf '  !! could not mask the ScreenPad backlight unit; the panel will keep disconnecting at boot\n' >&2
    exit 1
  fi

  # And nothing writes the panel's brightness. See .chezmoidata/ux534.yaml for
  # why: the saved value systemd restored was 40, not 0, so a NON-ZERO write is
  # what dropped the panel. Until that is understood, the repository adds no
  # write of its own to that attribute -- masking removes systemd's, and that is
  # the whole intervention.

  # Kernel arguments. Read-compare-then-write so a converged host makes no
  # grubby call at all, mirroring the resume= handling in
  # install-system-swap-hibernate. See .chezmoidata/ux534.yaml for why the
  # presence of a video= argument is not evidence that it took effect.
  if command -v grubby >/dev/null 2>&1; then
    ux534_wanted_args=({{ range .ux534.kernelArgs }}{{ . | quote }} {{ end }})
    ux534_stale_args=({{ range .ux534.removedKernelArgs }}{{ . | quote }} {{ end }})
    ux534_current_args="$(grubby --info=DEFAULT 2>/dev/null | grep -E '^args=' || true)"

    ux534_add=()
    for arg in "${ux534_wanted_args[@]}"; do
      if [[ "$ux534_current_args" != *"$arg"* ]]; then
        ux534_add+=("$arg")
      fi
    done
    if [[ ${#ux534_add[@]} -gt 0 ]]; then
      printf '  -> kernel args += %s\n' "${ux534_add[*]}"
      "${SUDO[@]}" grubby --update-kernel=ALL --args="${ux534_add[*]}"
    fi

    ux534_drop=()
    for arg in "${ux534_stale_args[@]}"; do
      if [[ "$ux534_current_args" == *"$arg"* ]]; then
        ux534_drop+=("$arg")
      fi
    done
    if [[ ${#ux534_drop[@]} -gt 0 ]]; then
      printf '  -> kernel args -= %s\n' "${ux534_drop[*]}"
      "${SUDO[@]}" grubby --update-kernel=ALL --remove-args="${ux534_drop[*]}"
    fi
  else
    printf '  -- grubby absent; kernel arguments not managed on this host\n'
  fi
else
  (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "install-system-hardware" "site" "ux534-absent" "reason" "this host is not an ASUS ZenBook UX534") | trim | indent 4 }}
  )
fi

REMOVED_PATHS=()
REMOVED_DISTROS=()
{{ range .system.linux.hardware.removed -}}
REMOVED_PATHS+=({{ .path | quote }})
REMOVED_DISTROS+=({{ get . "distro" | default "" | quote }})
{{ end }}
for i in "${!REMOVED_PATHS[@]}"; do
  dst="${REMOVED_PATHS[$i]}"
  distro="${REMOVED_DISTROS[$i]}"
  [[ -z "$distro" || "$distro" == "$os_id" ]] || continue
  if [[ -e "$dst" || -L "$dst" ]]; then
    printf '  -> removing %s\n' "$dst"
    "${SUDO[@]}" rm -f "$dst"
  fi
done

{{ end -}}
