{{ if eq .chezmoi.os "linux" -}}
{{ $sudoUsable := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "sudo-usable") -}}
#!/usr/bin/env bash
#
# Network-path configuration: firewalld for Tailscale/VMware, resolv.conf →
# systemd-resolved, DNS-path service restarts, and NetworkManager drop-in
# hygiene + reload. Part 3/3 of the split install-system set (10-files →
# 20-host → 30-network); splitting keeps re-run scope tight — a tracked /etc
# file edit re-runs 10-files only, so it no longer restarts
# systemd-resolved/NetworkManager/tailscaled the way the old monolithic
# install-system-config did. Those restarts now happen only when THIS
# script's content changes (or `chezmoi apply --force`).
#
# onchange, no source-tree dependency: everything here asserts fixed
# firewalld/DNS state derived from nothing in the source tree, so the only
# fingerprint below is the sudo capability one. (The IPv4/IPv6 forwarding
# sysctl the masquerade path rides on is installed and applied by 10-files.)
#
# firewalld setup covers three things: (1) IPv4 masquerade on the default
# zone, required for the Tailscale exit-node and VMware NAT egress paths to
# source-NAT traffic out the host's primary interface (which lives in the
# default zone on Fedora Workstation); (2) binding tailscale0 to the
# `trusted` zone, per Tailscale's recommendation for firewalld hosts; and
# (3) opening UDP 41641 (WireGuard) + UDP 3478 (STUN) on the `public` zone
# so direct peer connections work behind a host firewall.
#
# Skip behaviour: both shared guards inlined below declare their early exits
# (.chezmoitemplates/skip.sh.tmpl). A headless/server install is `harmless` —
# this host is not a desktop and will not become one, so exit 0 is final. A
# sudo prompt this run cannot answer is `transient-blocking` on the cached
# `sudo-usable` capability: chezmoi records the exit-0 skip as a successful run,
# and the sudo fingerprint block below is what re-runs the script by itself once
# that token flips to available.

# sudo capability fingerprint — pairs the transient-blocking sudo declaration
# with the cached token it names. Comment-only; never executed.
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list (dict "name" "sudo-usable" "value" $sudoUsable))) }}
set -euo pipefail

{{ includeTemplate "headless-guard.sh.tmpl" (dict "ctx" . "name" "install-system-network") }}
{{ includeTemplate "sudo-skip-guard.sh.tmpl" "install-system-network" }}
# Configure firewalld for Tailscale and VMware (see header for the three
# changes and their rationale).
#
# Gate: `firewall-cmd --state` is firewalld's own liveness probe
# (https://firewalld.org/documentation/howto/get-firewalld-state.html).
# It returns 0 when the daemon is running and non-zero when firewalld is
# masked, missing, or replaced by a different backend (raw nftables,
# iptables-services). In every non-running case all firewalld steps are
# skipped — we don't program a backend that isn't there.
#
# Idempotency: every change is gated on a `--query-*` probe so we only
# mutate when something would change. A single `--reload` at the end
# applies all permanent changes to the runtime without restarting
# firewalld (https://firewalld.org/documentation/configuration/runtime-versus-permanent.html).
configure_firewalld() {
  if "${SUDO[@]}" firewall-cmd --state >/dev/null 2>&1; then
    fw_changed=0

    if "${SUDO[@]}" firewall-cmd --permanent --query-masquerade >/dev/null 2>&1; then
      printf '  -- firewalld masquerade: already enabled (default zone)\n'
    else
      printf '  -> firewalld masquerade: enabling on default zone\n'
      "${SUDO[@]}" firewall-cmd --permanent --add-masquerade >/dev/null
      fw_changed=1
    fi

    # Tailscale's own recommendation for hosts running firewalld: the trusted
    # zone accepts all traffic, which is what we want for the mesh interface.
    if "${SUDO[@]}" firewall-cmd --permanent --zone=trusted --query-interface=tailscale0 >/dev/null 2>&1; then
      printf '  -- firewalld: tailscale0 already bound to trusted zone\n'
    else
      printf '  -> firewalld: binding tailscale0 to trusted zone\n'
      "${SUDO[@]}" firewall-cmd --permanent --zone=trusted --add-interface=tailscale0 >/dev/null
      fw_changed=1
    fi

    for port in 41641/udp 3478/udp; do
      if "${SUDO[@]}" firewall-cmd --permanent --zone=public --query-port="$port" >/dev/null 2>&1; then
        printf '  -- firewalld: public/%s already open\n' "$port"
      else
        printf '  -> firewalld: opening public/%s\n' "$port"
        "${SUDO[@]}" firewall-cmd --permanent --zone=public --add-port="$port" >/dev/null
        fw_changed=1
      fi
    done

    if [[ "$fw_changed" -eq 1 ]]; then
      printf '  -> firewall-cmd --reload\n'
      "${SUDO[@]}" firewall-cmd --reload >/dev/null
    fi
  else
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-system-network" "site" "firewalld-not-running" "direction" "harmless" "reason" "firewalld is not running; firewall configuration is not applicable") | trim | indent 4 }}
  fi
}
configure_firewalld

# Reference: https://tailscale.com/docs/reference/linux-dns
# Point resolv.conf at systemd-resolved's stub, then restart each DNS-path
# service that is currently running so the switch takes effect.
"${SUDO[@]}" ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
for svc in systemd-resolved NetworkManager tailscaled; do
  if systemctl is-active --quiet "$svc" 2>/dev/null; then
    printf '  -> systemctl restart %s\n' "$svc"
    "${SUDO[@]}" systemctl restart "$svc"
  else
    printf '  -- %s reload: skipped (service not running)\n' "$svc"
  fi
done

# Remove dangling symlinks under /etc/NetworkManager/conf.d/. A drop-in
# installed by another tool as a symlink into a store/cache path becomes a
# broken link once that target is removed; NetworkManager then logs
# warnings on every reload and `ls -l` flags it red. We only delete
# symlinks whose targets are missing — regular files and live symlinks are
# left untouched, so this can't accidentally remove a drop-in placed by
# another tool.
if [[ -d /etc/NetworkManager/conf.d ]]; then
  stale=0
  for link in /etc/NetworkManager/conf.d/*; do
    [[ -L "$link" && ! -e "$link" ]] || continue
    printf '  -> removing stale symlink: %s\n' "$link"
    "${SUDO[@]}" rm -f "$link"
    stale=$((stale + 1))
  done
  if [[ "$stale" -eq 0 ]]; then
    printf '  -- NetworkManager conf.d: no stale symlinks\n'
  else
    printf '  -- NetworkManager conf.d: removed %d stale symlink(s)\n' "$stale"
  fi
fi

# Reload NetworkManager so any freshly-installed drop-ins under
# /etc/NetworkManager/conf.d/ take effect without a reboot.
# `systemctl reload` triggers NetworkManager's SIGHUP handler, which
# re-reads NetworkManager.conf and every conf.d/ drop-in without
# disrupting active connections (unlike `restart`, which would).
#
# Gate: `systemctl is-active --quiet NetworkManager` returns 0 only when
# the unit exists and is currently running, covering both "service
# present" and "service running" in a single check. Hosts without
# NetworkManager (systemd-networkd, netctl, no network stack at all)
# skip cleanly.
reload_networkmanager() {
  if systemctl is-active --quiet NetworkManager 2>/dev/null; then
    printf '  -> systemctl reload NetworkManager\n'
    "${SUDO[@]}" systemctl reload NetworkManager
  else
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-system-network" "site" "networkmanager-not-running" "direction" "harmless" "reason" "NetworkManager is not running; its configuration reload is not applicable") | trim | indent 4 }}
  fi
}
reload_networkmanager
{{ end -}}
