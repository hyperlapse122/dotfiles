{{ if eq .chezmoi.os "linux" -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
#!/usr/bin/env bash
set -euo pipefail

{{ includeTemplate "headless-guard.sh.tmpl" (dict "ctx" . "name" "install-system-udev") }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-system-udev") }}
{{ includeTemplate "sudo-elevation-guard.sh.tmpl" (dict "ctx" . "name" "install-system-udev") }}
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "system/linux/etc/udev/rules.d/**" "system/linux/etc/libinput/**")) }}
SRC_ROOT="{{ $sourceDir }}/system/linux"

override_patterns=()
override_modes=()
override_gates=()
{{ range .system.linux.udev.overrides -}}
override_patterns+=({{ .path | quote }})
override_modes+=({{ get . "mode" | default "644" | quote }})
override_gates+=({{ get . "gate" | default "" | quote }})
{{ end }}
{{- $gates := list -}}
{{- range .system.linux.udev.overrides -}}
{{-   $gate := get . "gate" | default "" -}}
{{-   if ne $gate "" -}}
{{-     $gates = append $gates $gate -}}
{{-   end -}}
{{- end -}}
{{- includeTemplate "facts-validate.tmpl" (dict "ctx" . "source" ".chezmoidata/system.yaml (udev.overrides)" "gates" $gates) -}}

{{ includeTemplate "facts-gate.sh.tmpl" . }}
gate_ok() {
  fact_gate "$1"
}

shopt -s globstar nullglob

udev_files=("$SRC_ROOT"/etc/udev/rules.d/** "$SRC_ROOT"/etc/libinput/**)
for src in "${udev_files[@]}"; do
  [[ -f "$src" ]] || continue
  rel="${src#"$SRC_ROOT"/}"
  dst="/$rel"
  mode=644
  gate=
  for i in "${!override_patterns[@]}"; do
    # shellcheck disable=SC2254 # manifest entries are deliberate glob patterns
    case "$rel" in
      ${override_patterns[$i]})
        mode="${override_modes[$i]}"
        gate="${override_gates[$i]}"
        break
        ;;
    esac
  done

  if ! gate_ok "$gate"; then
    printf '  -- %s (skipped: gate %s failed)\n' "$dst" "$gate"
    continue
  fi

  printf '  -> %s (mode %s)\n' "$dst" "$mode"
  "${SUDO[@]}" install -D -m "$mode" "$src" "$dst"
done

REMOVED_PATHS=()
{{ range .system.linux.udev.removed -}}
REMOVED_PATHS+=({{ .path | quote }})
{{ end }}
for dst in "${REMOVED_PATHS[@]}"; do
  if [[ -e "$dst" || -L "$dst" ]]; then
    printf '  -> removing %s\n' "$dst"
    "${SUDO[@]}" rm -f "$dst"
  fi
done

if [[ -d "$SRC_ROOT/etc/udev/rules.d" ]]; then
  printf '  -> udevadm control --reload\n'
  "${SUDO[@]}" udevadm control --reload
  # --reload only re-reads the rule FILES; it does not re-run them against
  # devices that were enumerated before the apply. A ceiling installed for a
  # battery that came up at boot would otherwise not take effect until the next
  # one -- and the acceptance signal for it is "after apply", not "after
  # reboot". A synthetic change event is benign on a host with no matching rule.
  printf '  -> udevadm trigger (power_supply)\n'
  "${SUDO[@]}" udevadm trigger --subsystem-match=power_supply --action=change
fi

{{ end -}}
