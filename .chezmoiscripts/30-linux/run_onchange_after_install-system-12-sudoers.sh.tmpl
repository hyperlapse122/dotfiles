{{ if eq .chezmoi.os "linux" -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
#!/usr/bin/env bash
set -euo pipefail

{{ includeTemplate "headless-guard.sh.tmpl" (dict "ctx" . "name" "install-system-sudoers") }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-system-sudoers") }}
{{ includeTemplate "sudo-elevation-guard.sh.tmpl" (dict "ctx" . "name" "install-system-sudoers") }}
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "system/linux/etc/sudoers.d/**")) }}
SRC_ROOT="{{ $sourceDir }}/system/linux"

shopt -s globstar nullglob

override_patterns=()
override_modes=()
override_gates=()
override_checks=()
{{ range .system.linux.sudoers.overrides -}}
override_patterns+=({{ .path | quote }})
override_modes+=({{ get . "mode" | default "440" | quote }})
override_gates+=({{ get . "gate" | default "" | quote }})
override_checks+=({{ get . "check" | default "" | quote }})
{{ end }}
{{- $gates := list -}}
{{- range .system.linux.sudoers.overrides -}}
{{-   $gate := get . "gate" | default "" -}}
{{-   if ne $gate "" -}}
{{-     $gates = append $gates $gate -}}
{{-   end -}}
{{- end -}}
{{- includeTemplate "facts-validate.tmpl" (dict "ctx" . "source" ".chezmoidata/system.yaml (sudoers.overrides)" "gates" $gates) -}}

for check in "${override_checks[@]}"; do
  case "$check" in
    ''|visudo) ;;
    *) printf 'install-system-sudoers: unknown check "%s"; aborting.\n' "$check" >&2; exit 1 ;;
  esac
done

{{ includeTemplate "facts-gate.sh.tmpl" . }}
gate_ok() {
  fact_gate "$1"
}

for src in "$SRC_ROOT"/etc/sudoers.d/**; do
  [[ -f "$src" ]] || continue
  rel="${src#"$SRC_ROOT"/}"
  dst="/$rel"
  mode=440
  gate=
  check=
  for i in "${!override_patterns[@]}"; do
    # shellcheck disable=SC2254 # manifest entries are deliberate glob patterns
    case "$rel" in
      ${override_patterns[$i]})
        mode="${override_modes[$i]}"
        gate="${override_gates[$i]}"
        check="${override_checks[$i]}"
        break
        ;;
    esac
  done

  if [[ "$check" == visudo ]]; then
    if ! visudo -c -f "$src" >/dev/null; then
      printf '  !! %s: visudo syntax check failed; aborting\n' "$dst" >&2
      exit 1
    fi
  fi

  if ! gate_ok "$gate"; then
    printf '  -- %s (skipped: gate %s failed)\n' "$dst" "$gate"
    continue
  fi

  printf '  -> %s (mode %s)\n' "$dst" "$mode"
  "${SUDO[@]}" install -D -m "$mode" "$src" "$dst"
done

{{ end -}}
