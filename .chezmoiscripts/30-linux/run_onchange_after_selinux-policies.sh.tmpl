{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ $facts := includeTemplate "facts.tmpl" . | fromYaml -}}
{{ if not $facts.container -}}
#!/usr/bin/env bash
#
# Installs and updates declarative SELinux policy modules from
# system/linux/selinux/**/*.cil using `sudo semodule -X 400 -i`, and
# relabels protected dotfiles in $HOME with `restorecon`.
#
# GATED: Linux + Fedora + active SELinux enforcement (sestatus).
# Non-Fedora, non-Linux, and container hosts skip harmlessly at render time.

set -euo pipefail

{{ includeTemplate "sudo-elevation-guard.sh.tmpl" (dict "ctx" . "name" "selinux-policies") }}
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "system/linux/selinux/**")) }}

if command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled && command -v semodule >/dev/null 2>&1; then
  SRC_DIR="{{ $sourceDir }}/system/linux/selinux"
  if [[ -d "$SRC_DIR" ]]; then
    shopt -s nullglob
    cil_files=("$SRC_DIR"/*.cil)
    shopt -u nullglob

    if [[ ${#cil_files[@]} -gt 0 ]]; then
      for cil in "${cil_files[@]}"; do
        module_name="$(basename "$cil" .cil)"
        printf 'selinux-policies: installing module %s...\n' "$module_name"
        "${SUDO[@]}" semodule -X 400 -i "$cil"
      done

      if command -v restorecon >/dev/null 2>&1; then
        printf 'selinux-policies: relabeling protected paths...\n'
        # Every filecon root the module declares, plus the entrypoint stores.
        # Only explicit config files, skill roots, and plugin state are relabelled.
        # Whole harness homes ($HOME/.claude, $HOME/.gemini) are deliberately NOT
        # relabelled to prevent hardlink leaks into shared caches (e.g. Bun cache).
        restorecon -RFv \
          "$HOME/.codex/config.toml" \
          "$HOME/.codex/skills" \
          "$HOME/.agents/skills" \
          "$HOME/.agents/plugins" \
          "$HOME/.claude.json"* \
          "$HOME/.mcp.json" \
          "$HOME/.claude/settings.json" \
          "$HOME/.claude/skills" \
          "$HOME/.claude/plugins/installed_plugins.json" \
          "$HOME/.claude/plugins/known_marketplaces.json" \
          "$HOME/.claude/plugins/marketplaces" \
          "$HOME/.gemini/config" \
          "$HOME/.gemini/skills" \
          "$HOME/.local/bin/chezmoi" \
          "$HOME/.local/bin/claude" \
          "$HOME/.local/bin/agy" \
          "$HOME/.local/lib/commands/store/claude" \
          "$HOME/.local/lib/commands/store/agy" \
          2>/dev/null || true

        # LEGACY LABEL RECLAIM. An earlier revision of this module claimed the
        # whole of ~/.claude and ~/.gemini, and restorecon relabels INODES, not
        # paths: the recursive walk stamped claude_config_t onto files that Bun
        # had hardlinked out of ~/.bun/install/cache, and onto every other name
        # those inodes carry in project node_modules trees (issue #338).
        #
        # Narrowing the filecon set stopped the cause but repaired no damage. A
        # label lives on the inode, and the protected types carry no attribute,
        # so no unconfined domain holds relabelfrom on them: `restorecon -RF
        # ~/.bun/install/cache` from a login shell fails with EACCES, and so
        # does `rm`. chezmoi_t is the only domain the module grants relabelfrom,
        # which makes this script the only place the repair can run.
        #
        # The sweep can only LOWER a label. It selects paths that ALREADY carry
        # a protected type and asks restorecon for the policy default, so a path
        # the module still claims is a no-op and every stale one drops back to
        # user_home_t. It never walks a cache root looking for files to protect,
        # so it cannot re-create the leak it repairs.
        if find "$HOME" -maxdepth 0 -context '*' >/dev/null 2>&1; then
          printf 'selinux-policies: reclaiming stale protected labels...\n'
          find "$HOME" -xdev \
            \( -context '*:protected_agent_config_t:*' \
            -o -context '*:claude_config_t:*' \
            -o -context '*:gemini_config_t:*' \) -print0 2>/dev/null |
            xargs -0 -r -n 200 restorecon -Fiv 2>/dev/null || true
        else
          printf 'selinux-policies: %s\n' \
            'find(1) has no -context support, so stale protected labels left by an earlier policy revision cannot be found. Reinstall findutils with SELinux support to reclaim them.'
        fi
      fi

      # SELinux fixes a process's domain at exec, and installing a module never
      # moves a process that is already running. An agent session started before
      # this ran therefore keeps unconfined_t while its files are now labelled
      # claude_config_t / gemini_config_t, and its own writes — transcripts,
      # session state — are denied with EACCES. Only a re-exec fixes it, so say
      # so: this script only runs when the policy actually changed.
      # Name the offenders rather than warning in the abstract. An operator who
      # can see the pids knows which terminal to restart; an empty list is the
      # all-clear. A process that already sits in an agent domain is fine, and so
      # is chezmoi_t, which is what runs this script.
      stale=()
      while read -r pid; do
        [[ -r "/proc/$pid/attr/current" ]] || continue
        case "$(tr -d '\0' <"/proc/$pid/attr/current")" in
        *:claude_t:* | *:agy_t:* | *:chezmoi_t:*) ;;
        *) stale+=("$pid") ;;
        esac
      done < <(pgrep -x -u "$(id -u)" 'claude|agy' 2>/dev/null || true)

      if [[ ${#stale[@]} -gt 0 ]]; then
        printf 'selinux-policies: WARNING %s\n' \
          'Restart any claude/agy process started earlier. SELinux assigns a domain at exec, so these processes stay unconfined_t while their files are now labelled claude_config_t / gemini_config_t, and their own writes are denied with EACCES until they re-exec. Closing the terminal is NOT enough for a "claude daemon run" process: it is parented to systemd and outlives the session, so kill it explicitly. The stale processes are:'
        for pid in "${stale[@]}"; do
          # ps pads lstart to a fixed width under LC_ALL=C but not under every
          # locale, so trim rather than relying on a leading space in the format.
          printf 'selinux-policies:   pid %s (%s) started %s\n' \
            "$pid" \
            "$(tr -d '\0' <"/proc/$pid/comm" 2>/dev/null || printf '?')" \
            "$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^[[:space:]]*//' || printf '?')"
        done
      else
        printf 'selinux-policies: %s\n' \
          'policy reinstalled; no claude/agy process is left in a stale domain. Restart any agent session started earlier if one appears later.'
      fi
    fi
  fi
fi
{{ end -}}
{{ end -}}
