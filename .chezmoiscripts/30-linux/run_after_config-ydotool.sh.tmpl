{{- $f := includeTemplate "facts.tmpl" . | fromYaml -}}
{{- $eligible := and (eq .chezmoi.os "linux") (eq $f.distro "fedora") (or (eq $f.desktop "kde") (eq $f.desktop "gnome")) (not $f.headless) (not $f.container) -}}
{{ if $eligible -}}
#!/usr/bin/env bash
# .chezmoiscripts/30-linux/run_after_config-ydotool.sh.tmpl
#
# KTD5: persists graphical-session enablement of ydotool.service
# (dot_config/systemd/user/ydotool.service) without depending on a live user
# bus, then reconciles an already-running instance when one is reachable.
#
# Rendered-fact gate above repeats, defensively, the same eligibility test
# that keeps this script (and the unit + wrapper it reconciles) out of the
# source tree entirely on an ineligible host — see the ydotool block in
# .chezmoiignore. Both checks encode the same predicate: Fedora Linux,
# KDE or GNOME, not headless, not a container. Belt-and-suspenders:
# an ignore-gate miss must not leave a live systemctl call reachable here.
#
# Deliberately a plain `run_after_` script, NOT `run_onchange_after_` with a
# source-fingerprint block: nothing about ITS OWN content needs to change for
# rerunning to matter. The package it depends on
# (.chezmoiscripts/20-linux-fedora/run_onchange_before_fedora.sh.tmpl) and the
# user bus it needs can each recover between applies with no change to this
# script's rendered text — a `run_onchange_` guard would then skip the very
# retry this script exists to provide. Unconditional means every eligible
# apply re-asserts enablement and, when possible, reload/restart.
#
# Soft-skips (exit 0, no service mutation) when /usr/bin/ydotoold is not
# installed — package state can lag a no-sudo apply, or the package simply
# is not there yet — so a later apply, once it lands, reconciles cleanly.
#
# NEVER passes --now: this script must not start a previously inactive unit
# during apply (KTD5/KTD2). Enablement alone makes the next graphical login
# the activation point; a restart below only ever targets a unit systemd
# already reports as active.

set -euo pipefail

readonly DAEMON=/usr/bin/ydotoold
readonly UNIT=ydotool.service

# 0. Skip cleanly when the daemon binary isn't there — no service mutation,
#    actionable message, and a normal (retryable) exit.
if [[ ! -x "$DAEMON" ]]; then
  echo "config-ydotool: $DAEMON not present; skipping (package not installed, or state has not landed yet); retries on the next apply" >&2
  exit 0
fi

# 1. Offline-capable enable — always attempted, bus or no bus. `--no-reload`
#    only wires the graphical-session.target WantedBy symlink without asking
#    the manager to notice it yet, so this succeeds even when this apply has
#    no user session bus (headless TTY apply, SSH without lingering, chroot).
#    No --now: never starts the unit here.
if systemctl --user enable --no-reload "$UNIT" >/dev/null 2>&1; then
  echo "config-ydotool: $UNIT enabled for graphical-session.target (offline-capable; starts at the next graphical login)"
else
  echo "config-ydotool: could not enable $UNIT (no user unit directory yet?); will retry on the next apply" >&2
fi

# 2. Reload + restart-if-active, ONLY when a user bus is actually reachable.
#    daemon-reload doubles as the reachability probe: it fails outright (no
#    partial effect) when there is no session bus, so the whole block
#    soft-skips there rather than half-applying.
if systemctl --user daemon-reload >/dev/null 2>&1; then
  echo "config-ydotool: user manager reloaded"
  if systemctl --user is-active --quiet "$UNIT" 2>/dev/null; then
    systemctl --user restart "$UNIT"
    echo "config-ydotool: restarted $UNIT (picked up the current unit + wrapper)"
  else
    echo "config-ydotool: $UNIT is not active; leaving it for graphical-session.target to start it"
  fi
else
  echo "config-ydotool: no user session bus reachable; enablement persisted, reload/restart deferred to the next graphical login" >&2
fi

exit 0
{{ end -}}
