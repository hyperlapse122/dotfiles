{{- $signatureConfig := printf "gnome-extension-retry-v1\nuuid=%s\negoId=%v\n" .gnome.shellExtensions.solaar.uuid .gnome.shellExtensions.solaar.egoId -}}
{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

UUID="{{ .gnome.shellExtensions.solaar.uuid }}"
EGO_PK={{ .gnome.shellExtensions.solaar.egoId }}
SIGNATURE={{ $signatureConfig | sha256sum | quote }}
{{ includeTemplate "extension-signature-stamp.sh.tmpl" (dict "name" "install-gnome-solaar-extension" "stamp" "gnome-solaar-extension") }}
{{ includeTemplate "gnome-guard.sh.tmpl" (dict "ctx" . "name" "install-gnome-solaar-extension") -}}

if stamp_matches; then
  echo "install-gnome-solaar-extension: already reconciled desired configuration; leaving extension alone"
  exit 0
fi
clear_safe_stamp || fail "cannot clear stale success signature"

command -v gnome-extensions >/dev/null 2>&1 \
  || { echo "install-gnome-solaar-extension: gnome-extensions absent; retrying on a later apply" >&2; exit 0; }
command -v curl >/dev/null 2>&1 \
  || { echo "install-gnome-solaar-extension: curl absent; retrying on a later apply" >&2; exit 0; }
[[ -x /usr/bin/python3 ]] \
  || { echo "install-gnome-solaar-extension: /usr/bin/python3 absent; retrying on a later apply" >&2; exit 0; }
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && ! -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]]; then
  echo "install-gnome-solaar-extension: no D-Bus session bus; retrying on a later apply" >&2
  exit 0
fi

shell_major="$(gnome-shell --version 2>/dev/null | grep -oE '[0-9]+' | head -n1 || true)"
if [[ ! "$shell_major" =~ ^[0-9]+$ ]]; then
  echo "install-gnome-solaar-extension: cannot determine gnome-shell version; retrying on a later apply" >&2
  exit 0
fi

freshly_installed=0
if gnome-extensions info "$UUID" >/dev/null 2>&1; then
  echo "install-gnome-solaar-extension: $UUID already installed; reconciling enabled-extensions"
else
  info_url="https://extensions.gnome.org/extension-info/?pk=${EGO_PK}&shell_version=${shell_major}"
  if ! info_json="$(curl -fsSL --max-time 30 "$info_url")"; then
    retry "extensions.gnome.org query failed (${info_url})"
  fi

  resolved="$(/usr/bin/python3 - "$info_json" "$shell_major" "$UUID" <<'PYEOF'
import json
import sys

raw, major, expected_uuid = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    info = json.loads(raw)
except ValueError:
    print("PARSE_ERROR")
    sys.exit(0)
if info.get("uuid") != expected_uuid:
    print("UUID_MISMATCH:%s" % info.get("uuid"))
    sys.exit(0)
if major not in info.get("shell_version_map", {}):
    print("NO_COMPAT")
    sys.exit(0)
print(info.get("download_url") or "PARSE_ERROR")
PYEOF
)"

  case "$resolved" in
    NO_COMPAT)
      retry "no compatible build for GNOME Shell ${shell_major}"
      ;;
    PARSE_ERROR | UUID_MISMATCH:*)
      retry "unexpected extension-info response (${resolved})"
      ;;
  esac

  download_url="$resolved"
  [[ "$download_url" == /* ]] && download_url="https://extensions.gnome.org${download_url}"
  tmpdir="$(mktemp -d)"
  trap 'rm -rf "$tmpdir"' EXIT
  zip="$tmpdir/${UUID}.shell-extension.zip"
  if ! curl -fsSL --max-time 120 -o "$zip" "$download_url"; then
    retry "download failed (${download_url})"
  fi
  if ! gnome-extensions install --force "$zip"; then
    fail "HARD ERROR: gnome-extensions install --force failed for $UUID"
  fi
  freshly_installed=1
  echo "install-gnome-solaar-extension: installed $UUID (build for GNOME Shell ${shell_major})"
fi

if current="$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null)"; then
  new_value="$(/usr/bin/python3 - "$current" "$UUID" <<'PYEOF'
import ast
import sys

raw, uuid = sys.argv[1], sys.argv[2]
value = raw.strip()
if value.startswith("@as"):
    value = value[len("@as"):].strip()
try:
    exts = ast.literal_eval(value) if value else []
except (ValueError, SyntaxError):
    print("PARSE_ERROR")
    sys.exit(0)
if not isinstance(exts, (list, tuple)):
    print("PARSE_ERROR")
    sys.exit(0)
exts = list(exts)
if uuid in exts:
    print("ALREADY_PRESENT")
    sys.exit(0)
exts.append(uuid)
print(repr(exts))
PYEOF
)" || new_value="PARSE_ERROR"

  case "$new_value" in
    ALREADY_PRESENT)
      echo "install-gnome-solaar-extension: $UUID already in enabled-extensions"
      ;;
    PARSE_ERROR)
      echo "install-gnome-solaar-extension: WARNING: unexpected enabled-extensions value (${current}); enable $UUID manually" >&2
      ;;
    *)
      if gsettings set org.gnome.shell enabled-extensions "$new_value"; then
        echo "install-gnome-solaar-extension: added $UUID to enabled-extensions"
      else
        echo "install-gnome-solaar-extension: WARNING: gsettings write failed; enable $UUID manually" >&2
      fi
      ;;
  esac
else
  echo "install-gnome-solaar-extension: WARNING: cannot read org.gnome.shell enabled-extensions (gsettings/schema/dconf unavailable); enable $UUID manually" >&2
fi

write_stamp || fail "cannot record success signature"
if ((freshly_installed)); then
  echo "install-gnome-solaar-extension: a freshly installed extension loads after the GNOME session restarts"
fi
{{ end -}}
