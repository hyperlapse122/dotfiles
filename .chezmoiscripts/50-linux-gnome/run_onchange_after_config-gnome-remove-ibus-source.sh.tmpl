{{ if eq .chezmoi.os "linux" -}}
{{ $sessionBusPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "session-bus-present") -}}
{{ $gsettingsPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "gsettings-present") -}}
{{ $pythonPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "usr-bin-python3-present") -}}
#!/usr/bin/env bash
#
# GNOME hosts. Migration for the unified
# input-method policy (fcitx5 everywhere; ibus rejected as buggy — see
# .chezmoidata/packages.yaml gnomePackages).
#
# GNOME Shell has a BUILT-IN ibus integration that owns the Wayland
# text-input protocol whenever any ('ibus', <engine>) pair is present in
# org.gnome.desktop.input-sources sources — even if the user selected an xkb
# entry as active. That routing pre-empts fcitx5's own text-input-v3 client,
# so this script strips every ('ibus', …) tuple from the list, leaving
# whatever xkb layouts the user has behind. A FRESH GNOME host defaults to
# ('xkb', <locale>) only, so this is a no-op there; the value comes from
# migrating an existing host that had ibus configured under GNOME's native
# stack.
#
# ONE-SHOT + user-respecting (same pattern as the wallpaper script and the
# extension installers): stripping is a per-user policy decision, not a
# recurring assertion. Once we have run once, we do NOT re-strip on every
# apply — a user who later re-adds an ibus engine on purpose is not fought.
#
# Live-session preconditions below are DECLARED transient-blocking and paired
# with cached capability tokens in the comment-only fingerprint block.

{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list
      (dict "name" "session-bus-present" "value" $sessionBusPresent)
      (dict "name" "gsettings-present" "value" $gsettingsPresent)
      (dict "name" "usr-bin-python3-present" "value" $pythonPresent))) }}
set -euo pipefail

STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/gnome-inputsources-strip-ibus"

{{ includeTemplate "gnome-guard.sh.tmpl" (dict "ctx" . "name" "config-gnome-remove-ibus-source") -}}

# Already stripped once -> respect the user's current source list.
if [[ -f "$STAMP" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "done_here" "script" "config-gnome-remove-ibus-source" "site" "stamp-present" "reason" "the input-source migration stamp is already present") | trim | indent 2 }}
fi

# --- Live session / tooling guards ------------------------------------------
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && ! -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-gnome-remove-ibus-source" "site" "no-session-bus" "direction" "transient-blocking" "probe" "session-bus-present" "reason" "no D-Bus session bus is available; input-source migration is deferred") | trim | indent 2 }}
fi
if ! command -v gsettings >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-gnome-remove-ibus-source" "site" "gsettings-absent" "direction" "transient-blocking" "probe" "gsettings-present" "reason" "gsettings is not installed; input-source migration is deferred") | trim | indent 2 }}
fi
# /usr/bin/python3, NOT bare python3 (mise may shadow it): GVariant text for
# a(ss) is valid Python literal syntax, so filtering the list parses with
# ast.literal_eval instead of hand-rolled string munging.
if [[ ! -x /usr/bin/python3 ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-gnome-remove-ibus-source" "site" "python3-absent" "direction" "transient-blocking" "probe" "usr-bin-python3-present" "reason" "system Python is not installed; input-source migration is deferred") | trim | indent 2 }}
fi

if ! current="$(gsettings get org.gnome.desktop.input-sources sources 2>/dev/null)"; then
  printf '%s\n' 'config-gnome-remove-ibus-source: failed to read input sources with gsettings; verify the GNOME session bus and schema, then re-apply.' >&2
  exit 1
fi

# Filter every ('ibus', <engine>) tuple out of the existing list. Output
# protocol: NO_IBUS (nothing to remove; already ibus-free), PARSE_ERROR
# (unexpected GVariant text — leave untouched), EMPTY (removing ibus would
# leave an empty source list — leave untouched so GNOME's own locale defaults
# still populate it on next login), or the new list in GVariant text form.
filtered="$(/usr/bin/python3 - "$current" <<'PYEOF'
import ast
import sys

raw = sys.argv[1].strip()
if raw.startswith("@a(ss)"):
    raw = raw[len("@a(ss)"):].strip()
try:
    sources = [tuple(item) for item in ast.literal_eval(raw)]
except (SyntaxError, ValueError):
    print("PARSE_ERROR")
    sys.exit(0)

kept = [s for s in sources if not (len(s) >= 1 and s[0] == "ibus")]
if len(kept) == len(sources):
    print("NO_IBUS")
elif not kept:
    print("EMPTY")
else:
    print(repr(kept))
PYEOF
)"

case "$filtered" in
  PARSE_ERROR)
    printf '%s\n' 'config-gnome-remove-ibus-source: input sources are not valid GVariant tuple-list text; leave them unchanged, repair the dconf value, then re-apply.' >&2
    exit 1
    ;;
  NO_IBUS)
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "done_here" "script" "config-gnome-remove-ibus-source" "site" "no-ibus-entries" "reason" "the input-source list contains no ibus entries") | trim | indent 6 }}
    )
    ;;
  EMPTY)
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-gnome-remove-ibus-source" "site" "would-empty-source-list" "direction" "harmless" "reason" "removing ibus would leave the input-source list empty") | trim | indent 4 }}
    ;;
  *)
    gsettings set org.gnome.desktop.input-sources sources "$filtered"
    echo "config-gnome-remove-ibus-source: stripped ibus entries -> ${filtered}"
    echo "config-gnome-remove-ibus-source: fcitx5 handles Korean input now (autostart entry: ~/.config/autostart/org.fcitx.Fcitx5.desktop)"
    ;;
esac

# Stamp only after the desired state is reached, so any skip path above
# retries on a later apply.
mkdir -p "$(dirname "$STAMP")"
touch "$STAMP"
exit 0
{{ end -}}
