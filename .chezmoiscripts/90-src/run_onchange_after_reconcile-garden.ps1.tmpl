{{- if eq .chezmoi.os "windows" -}}
{{- $sourceDir := .chezmoi.sourceDir -}}
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "dot_config/garden/encrypted_readonly_garden.yaml.asc")) }}
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$env:GIT_TERMINAL_PROMPT = '0'
$registry = Join-Path $HOME '.config/garden/garden.yaml'

function Assert-Command {
    param([Parameter(Mandatory = $true)][string] $Name)
    if (-not (Get-Command $Name -ErrorAction SilentlyContinue)) {
        throw "reconcile-garden: $Name not on PATH"
    }
}
function Invoke-Checked {
    param([Parameter(Mandatory = $true)][string] $FilePath, [Parameter(Mandatory = $true)][string[]] $Arguments)
    $output = & $FilePath @Arguments 2>&1
    if ($LASTEXITCODE -ne 0) {
        throw "reconcile-garden: $FilePath $($Arguments -join ' ') failed:`n$($output -join "`n")"
    }
    return $output
}

Assert-Command -Name garden
Assert-Command -Name aoe
if (-not (Test-Path -LiteralPath $registry -PathType Leaf)) {
    throw "reconcile-garden: $registry missing (chezmoi apply did not deploy it)"
}

Write-Output "reconcile-garden: garden grow '*'"
Invoke-Checked -FilePath garden -Arguments @('--config', $registry, 'grow', '*') | Out-Null

$raw = Invoke-Checked -FilePath garden -Arguments @('--config', $registry, 'ls', '--all', '--no-commands', '--no-remotes', '--no-gardens', '--no-groups', '-v')
$invalid = @()
foreach ($line in $raw) {
    $text = [string]$line
    if ($text -notmatch '^#-?\s+(.+)$') { continue }
    $fields = $Matches[1] -split '\s+'
    if ($fields.Count -lt 2 -or $fields[0] -eq '.') { continue }
    $name = $fields[0]
    $treePath = $fields[-1]
    $probe = if ($treePath -match '[\\/]\.bare$') {
        @('-C', $treePath, 'rev-parse', '--is-bare-repository')
    } else {
        @('-C', $treePath, 'rev-parse', '--is-inside-work-tree')
    }
    & git @probe *> $null
    if ($LASTEXITCODE -ne 0) { $invalid += "$name at $treePath" }
}
if ($invalid.Count -gt 0) {
    throw "reconcile-garden: grow incomplete: $($invalid -join ', ')"
}

Write-Output "reconcile-garden: garden cmd '*' setup-gitdir setup-upstream aoe-session"
Invoke-Checked -FilePath garden -Arguments @('--config', $registry, 'cmd', '*', 'setup-gitdir', 'setup-upstream', 'aoe-session') | Out-Null
Write-Output 'reconcile-garden: done'
{{- end -}}
