{{- $sourceDir := .chezmoi.sourceDir -}}
#!/usr/bin/env bash
#
# Reports how the live Orca settings differ from the declaration in
# .chezmoidata/orca.yaml. It never writes: the reconciler it calls runs in
# report mode, and the write itself belongs to orca-settings-reconcile.service
# at graphical-session start.
#
# WHY APPLY CANNOT WRITE THIS SURFACE. Orca reads orca-data.json once at startup
# and never re-reads it, and while it runs it rewrites the whole document from
# memory -- measured at roughly one write every nine seconds on an idle session.
# `chezmoi apply` normally runs from a terminal inside Orca, so a value written
# here would be both ignored and overwritten before the operator could restart.
# Reporting is the only honest thing apply can do.
#
# WHY run_after AND NOT run_onchange. Drift is created by the application and by
# the operator's own UI edits, and neither changes a chezmoi source fingerprint.
# An onchange script would stay silent for exactly the case this exists to
# surface. run_after_register-orca.sh.tmpl beside it is the same shape for the
# same reason.
#
# GATING. The container skip lives in the single gated .chezmoiignore block
# (`.chezmoiscripts/90-src/*.sh`), the same one that skips the reconciler and
# the registry. No new declaration.
#
# NEVER FAILS THE APPLY. Drift is information, not an error: an operator who
# deliberately left a setting alone should not have their apply go red for it.
#
# Dependency fingerprint -- this script runs on every apply, so the fingerprint
# below is not what triggers it. It is here so a declaration edit re-renders the
# script and the diff shows the two are coupled. Comment-only; never executed.
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list ".chezmoidata/orca.yaml")) }}
set -euo pipefail

reconcile="$HOME/.local/bin/orca-settings-reconcile"

# The command is materialized by the command manifest earlier in the same apply.
# A host that has not reached that step yet simply has nothing to report against.
if [ ! -x "$reconcile" ]; then
  echo "report-orca-settings: $reconcile is not present yet; skipped the drift report." >&2
  exit 0
fi

"$reconcile" --mode report || true
