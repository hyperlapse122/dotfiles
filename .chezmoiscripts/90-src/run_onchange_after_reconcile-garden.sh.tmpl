{{- $sourceDir := .chezmoi.sourceDir -}}
#!/usr/bin/env bash
#
# Apply-time garden provisioning + reconcile. Turns the documented manual
# bootstrap into an automatic step of `chezmoi apply`: whenever the ~/src
# project registry changes, grow every declared tree and run the custom
# bootstrap command (setup-upstream). Registering those trees with Orca is the
# job of the run_after_register-orca script beside this one, which runs on every
# apply because Orca's registry is state this repository does not fingerprint.
#
# ADDITIVE ONLY. This never removes, relocates, or unlocks a tree, clone, or
# worktree — Orca owns worktree lifecycle, and trees dropped from the manifest
# are left in place for `src-audit` to report.
#
# TWO HARD GATES. Before grow, the path-mirror gate refuses any declaration
# whose path is not the one derived from its own url — the ~/src layout rule,
# owned by the "Repository layout and garden ownership" section of the agent
# instructions. It lives here rather than in CI because the registry is
# GPG-encrypted and no runner holds the key; `.ci/test-garden-path-mirror-check.sh`
# covers the shared checker's logic against fixtures instead. After grow, the
# completeness check re-verifies every declared tree is a real work tree.
#
# GATING. Runs on Linux and macOS on a real host. The container skip lives in
# the single gated .chezmoiignore block (`.chezmoiscripts/90-src/*.sh`), the
# sanctioned mechanism that also skips .config/garden/garden.yaml.
#
# PLACEMENT (90-src). It must
# run after 10-auth's after-scripts (which configure the gh/glab git credential
# helpers the private https clones need) and after target application (the
# registry now deploys to ~/.config/garden/garden.yaml; the garden external
# materializes under ~/.local/bin). Unlike the old target, deploying
# the registry there has no ~/src side effect — `garden grow` below creates
# ~/src itself when absent, so per Risk-4 ~/src may be absent for the ENTIRE
# after-phase if an apply aborts before this script runs. Placing it LAST
# means a hard-fail here does not abort the unrelated after-phase
# provisioning that would otherwise follow (/etc, host, network, desktop,
# agent plugins, key import) — none of that depends on the garden.
#
# HARD-FAIL. A grow or bootstrap failure fails the apply (set -euo pipefail).
# But `garden grow '*'` exits 0 even when a tree fails to clone, so its exit
# code alone does NOT enforce that — the completeness check below re-verifies
# every declared tree is actually a valid clone and exits non-zero (naming the
# tree) on any missing, broken, or half-cloned tree. It never auto-repairs
# (that would mean destructive rm), so a corrupt tree exits with a manual
# cleanup hint rather than being silently accepted or repaired.
#
# NON-INTERACTIVE. GIT_TERMINAL_PROMPT=0 so an auth/reachability gap fails fast
# instead of hanging apply on a credential prompt. Credentials are injected by
# the native gh/glab helpers from 10-auth; this script passes no tokens.
#
# Dependency fingerprint — chezmoi hashes this rendered script to decide whether
# to re-run it, so embedding the sha256 of the ENCRYPTED registry SOURCE forces
# a re-run whenever the manifest changes (trees added, or a bootstrap command
# edited). gpg is non-deterministic, so any re-encrypt re-triggers even
# on identical plaintext — a harmless over-trigger, since the reconcile is
# idempotent. Hashing the ciphertext (raw source bytes) never exposes a secret.
# Comment-only; never executed.
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "dot_config/garden/encrypted_readonly_garden.yaml.asc")) }}
set -euo pipefail
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/sbin:"*) ;;
  *) PATH="$HOME/.local/sbin:$PATH" ;;
esac
export PATH


export GIT_TERMINAL_PROMPT=0
reg="$HOME/.config/garden/garden.yaml"

# Prerequisites are hard requirements: the garden external and the decrypted
# registry are both materialized during target application, before this
# after-phase script. Their absence is a real failure, not a soft skip.
command -v garden >/dev/null 2>&1 || { echo "reconcile-garden: garden not on PATH (externals not applied? see .chezmoiexternals/vcs.toml)" >&2; exit 1; }
[ -f "$reg" ] || { echo "reconcile-garden: $reg missing (chezmoi apply did not deploy it)" >&2; exit 1; }

# The shared record parser, derivation, and comparison. Inlined here so step 1
# can use it; .ci/test-garden-path-mirror-check.sh drives the same file with
# fixtures, which is the only coverage CI can give it (no GPG key, no garden).
GARDEN_PATH_MIRROR_SOURCED=1
{{ includeTemplate "garden-path-mirror-check.sh" . }}

# 1. Enumerate declared trees, their resolved paths, AND their remote urls in
#    ONE `garden ls -v` call, shared by the path-mirror gate (step 2) and the
#    completeness check (step 4). Capture garden's OWN exit status first: a hard
#    `ls` failure (crash, non-zero) must fail the apply, not pass vacuously — an
#    empty tree_info would otherwise skip both loops entirely. garden prints
#    grown-tree lines to STDERR and missing-tree lines to STDOUT, so 2>&1 merges
#    both (same reason as dot_local/share/chezmoi-command-sources/executable_src-audit);
#    "# <name> [branch] <path>" (grown) and "#- <name> <path>" (missing) both
#    carry the resolved path as the last field, and each is followed by an
#    indented "origin: <url>" line.
#
#    This call deliberately omits --no-remotes, which the completeness check
#    used to pass: that flag suppresses the remotes block, and with it every
#    url the path-mirror gate needs. The header lines it does emit are
#    unchanged, so the existing extraction below still works.
#
#    Declaration-derived, so it runs BEFORE grow: the gate in step 2 must
#    refuse a bad declaration before any directory is created. Paths do not
#    change across grow, so step 4 reuses this same capture. The `garden ls`
#    call, the root resolution and the record/header count check live in the
#    shared helper, which run_after_register-orca.sh.tmpl needs identically.
tree_records="$(garden_path_mirror_enumerate "$reg" reconcile-garden grow)" || exit 1

# 2. Path-mirror gate — the ~/src layout rule (see TWO HARD GATES above for why
#    it lives here).
# The helper's record shape is name/declared-path/url, so drop the absolute
# path column from the shared records.
if ! printf '%s\n' "$tree_records" | cut -f1,3,4 | garden_path_mirror_check; then
  echo "reconcile-garden: registry declarations violate the ~/src layout rule (see above) — failing apply before grow" >&2
  echo "reconcile-garden: the rule is owned by the \"Repository layout and garden ownership\" section of the agent instructions" >&2
  exit 1
fi

# 3. Grow every declared tree (idempotent; already-grown trees are no-ops).
echo "reconcile-garden: garden grow '*'"
garden --config "$reg" grow '*'

# 4. Completeness check — the second hard-fail gate. `garden grow '*'` exits 0
#    even when trees fail to clone, so re-verify each DECLARED tree is a valid
#    git work tree. Missing/broken/half-cloned => exit non-zero, naming the
#    tree, so a silent clone failure fails the apply.
check_tree() {
  local name="$1" tp="$2"
  if [ -z "$tp" ]; then
    echo "reconcile-garden: cannot resolve tree path for '$name'" >&2
    return 1
  fi
  if ! git -C "$tp" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "reconcile-garden: '$name' not grown/broken at $tp (fix: garden --config ~/.config/garden/garden.yaml grow $name)" >&2
    return 1
  fi
}

# tree_records was parsed in step 1 from the same `garden ls` call; paths are
# declaration-derived and do not change across grow, and the "." root is
# already dropped.
rc=0
record_sep="$(printf '\t')"
# Heredoc (not a pipe) so the loop runs in THIS shell and rc survives it.
while IFS="$record_sep" read -r name tp _rel _url; do
  [ -n "$name" ] || continue
  check_tree "$name" "$tp" || rc=1
done <<EOF
$tree_records
EOF
if [ "$rc" -ne 0 ]; then
  echo "reconcile-garden: grow incomplete (see above) — failing apply" >&2
  exit 1
fi

# 5. Bootstrap: set each tree's upstream on its default branch. Idempotent.
echo "reconcile-garden: garden cmd '*' setup-upstream"
garden --config "$reg" cmd '*' setup-upstream

echo "reconcile-garden: done"
