{{- if eq .chezmoi.os "windows" -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
if (-not (Get-Command gh -ErrorAction SilentlyContinue)) {
    throw 'auth-github: gh is unavailable; the package authority must converge it before repository access.'
}
& gh auth status '--hostname' 'github.com'
if ($LASTEXITCODE -ne 0) {
    throw 'auth-github: named human step required: run gh auth login --hostname github.com --git-protocol https, then re-run chezmoi apply.'
}
Write-Output 'auth-github: github.com vendor-native authentication is ready.'
{{- end -}}
