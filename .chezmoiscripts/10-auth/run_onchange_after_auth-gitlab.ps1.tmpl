{{- if eq .chezmoi.os "windows" -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
if (-not (Get-Command glab -ErrorAction SilentlyContinue)) {
    throw 'auth-gitlab: glab is unavailable; the locked external must converge before repository access.'
}
$status = 0
foreach ($hostName in @('git.jpi.app', 'gitlab.com')) {
    & glab auth status '--hostname' $hostName
    if ($LASTEXITCODE -ne 0) {
        Write-Error "auth-gitlab: named human step required for ${hostName}: run auth-glab and complete vendor-native OAuth, then re-run chezmoi apply." -ErrorAction Continue
        $status = 1
    }
}
if ($status -ne 0) { throw 'auth-gitlab: one or more hosts are not authenticated.' }
Write-Output 'auth-gitlab: vendor-native authentication is ready.'
{{- end -}}
