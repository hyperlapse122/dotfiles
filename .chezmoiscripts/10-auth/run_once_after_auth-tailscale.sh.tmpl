{{- $facts := includeTemplate "facts.tmpl" . | fromYaml -}}
#!/usr/bin/env bash

set -euo pipefail

{{ if $facts.jetson -}}
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "auth-tailscale" "site" "jetson-off-tailnet" "reason" "Jetson host intentionally stays off the tailnet") }}
{{ else -}}
{{ if eq .chezmoi.os "darwin" -}}
SUDO=()
# The Mac App Store / standalone Tailscale app ships its CLI inside the app
# bundle and is often not on PATH; prefer PATH, else fall back to the bundle.
if command -v tailscale >/dev/null 2>&1; then
  TAILSCALE=(tailscale)
elif [[ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
  TAILSCALE=(/Applications/Tailscale.app/Contents/MacOS/Tailscale)
else
  printf 'auth-tailscale.sh: tailscale CLI not found on PATH or in /Applications/Tailscale.app.\n' >&2
  exit 1
fi
{{ else if eq .chezmoi.os "linux" -}}
if [[ "${EUID}" -eq 0 ]]; then
  SUDO=()
elif command -v sudo >/dev/null 2>&1; then
  SUDO=(sudo)
else
  printf 'auth-tailscale.sh: requires root or sudo to run tailscale up.\n' >&2
  exit 1
fi
TAILSCALE=(tailscale)
{{ end -}}

{{ if eq .chezmoi.os "linux" -}}
"${SUDO[@]}" systemctl enable --now tailscaled.service
{{ end -}}

# Completion check: a node already authenticated to a tailnet must not consume
# the single-use auth key. This is a DECLARED done_here completion, not deferred
# work and not a bare success exit.
if "${SUDO[@]}" "${TAILSCALE[@]}" status --json 2>/dev/null \
  | grep -Eq '"BackendState"[[:space:]]*:[[:space:]]*"(Running|Starting|Stopped|NeedsMachineAuth)"'; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "done_here" "script" "auth-tailscale" "site" "already-authenticated" "reason" "already authenticated to a tailnet") | trim | indent 2 }}
fi

if ! "${SUDO[@]}" "${TAILSCALE[@]}" up --operator "$USER" --accept-routes --accept-dns --accept-risk=all --auth-key="{{ onepasswordRead "op://Private/Tailscale/Auth Key" }}"; then
  printf 'auth-tailscale.sh: `tailscale up` failed; node did not join the tailnet. Fix the auth key or connectivity, then re-run `chezmoi apply`.\n' >&2
  exit 1
fi
{{ end -}}
