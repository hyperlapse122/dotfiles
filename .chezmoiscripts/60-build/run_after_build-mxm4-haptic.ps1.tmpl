{{- $facts := includeTemplate "facts.tmpl" . | fromYaml -}}
{{- if and (eq .chezmoi.os "windows") (not $facts.container) -}}
{{- $sourceDir := .chezmoi.sourceDir -}}
{{- $pluginInputs := list "packages/package.json" "packages/bun.lock" "packages/vite.config.ts" "packages/mxm4-haptic/package.json" "packages/mxm4-haptic/tsconfig.json" "packages/mxm4-haptic/vite.config.ts" "packages/mxm4-haptic/src/**" "dot_local/share/omp-plugins/plugins/mxm4-haptic/package.json.tmpl" -}}
{{- $daemonInputs := list "crates/mxm4-haptic/Cargo.toml" "crates/mxm4-haptic/Cargo.lock" "crates/mxm4-haptic/src/lib.rs" "crates/mxm4-haptic/src/bin/mxm4-haptic.rs" "crates/mxm4-haptic/src/bin/mxm4-hapticd.rs" -}}
{{- $pluginInputsFingerprint := includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" $pluginInputs) -}}
{{- $daemonInputsFingerprint := includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" $daemonInputs) -}}
# Builds and stages the OMP plugin and Windows daemon, then reconciles one
# limited current-user Task Scheduler logon task. Every required stage is fatal.
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$SourceRoot = if ([string]::IsNullOrWhiteSpace($env:MXM4_HAPTIC_SOURCE_ROOT)) { '{{ $sourceDir }}' } else { $env:MXM4_HAPTIC_SOURCE_ROOT }
$ManagedHome = if ([string]::IsNullOrWhiteSpace($env:MXM4_HAPTIC_MANAGED_HOME)) { $HOME } else { $env:MXM4_HAPTIC_MANAGED_HOME }
$PipeName = 'mxm4-haptic'
$TaskName = if ([string]::IsNullOrWhiteSpace($env:MXM4_HAPTIC_TASK_NAME)) { '\mxm4-hapticd' } else { $env:MXM4_HAPTIC_TASK_NAME }
$PluginSource = Join-Path $SourceRoot 'packages\mxm4-haptic'
$CrateSource = Join-Path $SourceRoot 'crates\mxm4-haptic'
$PluginRoot = Join-Path $ManagedHome '.local\share\omp-plugins\plugins\mxm4-haptic'
$PluginManifest = Join-Path $PluginRoot 'package.json'
$PluginDestination = Join-Path $PluginRoot 'dist\index.js'
$DaemonDestination = Join-Path $ManagedHome '.local\bin\mxm4-hapticd.exe'
$StateRoot = Join-Path $ManagedHome '.local\state\mxm4-haptic'
$PluginStamp = Join-Path $StateRoot 'plugin.sha256'
$DaemonStamp = Join-Path $StateRoot 'daemon.sha256'
$PluginConfigFingerprint = 'settled={{ .haptic.omp.settled }};failed={{ .haptic.omp.failed }};question={{ .haptic.omp.question }}'

$PluginInputsFingerprint = @'
{{ $pluginInputsFingerprint }}
'@
$DaemonInputsFingerprint = @'
{{ $daemonInputsFingerprint }}
'@
# Raw-input fingerprints only. Build output (dist/ and target/) is deliberately
# excluded.
{{ $pluginInputsFingerprint }}
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list ".chezmoidata/haptic.yaml")) }}
{{ $daemonInputsFingerprint }}

function Fail([string]$Stage, [string]$Message) {
  throw "mxm4-haptic[$Stage]: $Message"
}

function Require-Command([string]$Name) {
  if (-not (Get-Command $Name -ErrorAction SilentlyContinue)) {
    Fail 'preflight' "required command is unavailable: $Name"
  }
}

function Invoke-Native([string]$Stage, [scriptblock]$Command) {
  & $Command
  if ($LASTEXITCODE -ne 0) {
    Fail $Stage "native command exited with code $LASTEXITCODE"
  }
}

function Get-ComponentDigest([string]$Inputs, [string]$Config) {
  $bytes = [Text.Encoding]::UTF8.GetBytes($Inputs + "`n" + $Config)
  $hash = [Security.Cryptography.SHA256]::HashData($bytes)
  return [Convert]::ToHexString($hash).ToLowerInvariant()
}

function Read-Stamp([string]$Path) {
  if (Test-Path -LiteralPath $Path -PathType Leaf) {
    return (Get-Content -LiteralPath $Path -Raw).Trim()
  }
  return ''
}

function Assert-WritableDestination([string]$Destination) {
  $ancestor = Split-Path -Parent $Destination
  while ($ancestor -and -not (Test-Path -LiteralPath $ancestor -PathType Container)) {
    $next = Split-Path -Parent $ancestor
    if ($next -eq $ancestor) { break }
    $ancestor = $next
  }
  if (-not $ancestor -or -not (Test-Path -LiteralPath $ancestor -PathType Container)) {
    Fail 'preflight' "no existing destination ancestor: $Destination"
  }
  $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
  $principals = @($identity.User.Value) + @($identity.Groups | ForEach-Object { $_.Value })
  $modify = [Security.AccessControl.FileSystemRights]::Modify
  $allowed = $false
  foreach ($rule in (Get-Acl -LiteralPath $ancestor).Access) {
    $sid = $rule.IdentityReference.Translate([Security.Principal.SecurityIdentifier]).Value
    if ($principals -notcontains $sid -or (($rule.FileSystemRights -band $modify) -eq 0)) { continue }
    if ($rule.AccessControlType -eq [Security.AccessControl.AccessControlType]::Deny) {
      Fail 'preflight' "destination ACL denies modification: $Destination"
    }
    $allowed = $true
  }
  if (-not $allowed) { Fail 'preflight' "destination ACL does not grant modification: $Destination" }
}

function Replace-Atomically([string]$Candidate, [string]$Destination) {
  $directory = Split-Path -Parent $Destination
  New-Item -ItemType Directory -Force -Path $directory | Out-Null
  $temporary = Join-Path $directory ('.' + [IO.Path]::GetFileName($Destination) + '.' + [Guid]::NewGuid().ToString('N') + '.tmp')
  try {
    Copy-Item -LiteralPath $Candidate -Destination $temporary
    Move-Item -LiteralPath $temporary -Destination $Destination -Force
  } finally {
    Remove-Item -LiteralPath $temporary -Force -ErrorAction SilentlyContinue
  }
}

function Get-RegisteredTask {
  try {
    return $taskFolder.GetTask($TaskName)
  } catch {
    return $null
  }
}

function Test-TaskRegistration($Task) {
  if ($null -eq $Task -or -not $Task.Enabled) { return $false }
  try {
    $definition = $Task.Definition
    if ($definition.Actions.Count -ne 1 -or $definition.Triggers.Count -ne 1) { return $false }
    $action = $definition.Actions.Item(1)
    $trigger = $definition.Triggers.Item(1)
    $settings = $definition.Settings
    return $action.Type -eq 0 -and
      [IO.Path]::GetFullPath($action.Path) -eq [IO.Path]::GetFullPath($DaemonDestination) -and
      [string]::IsNullOrWhiteSpace($action.Arguments) -and
      [string]::IsNullOrWhiteSpace($action.WorkingDirectory) -and
      $trigger.Type -eq 9 -and $trigger.Enabled -and $trigger.UserId -eq $currentSid -and
      $definition.Principal.UserId -eq $currentSid -and
      $definition.Principal.LogonType -eq 3 -and
      $definition.Principal.RunLevel -eq 0 -and
      $settings.Enabled -and $settings.AllowDemandStart -and
      $settings.MultipleInstances -eq 2 -and $settings.ExecutionTimeLimit -eq 'PT0S'
  } catch {
    return $false
  }
}

function Wait-TaskRunning([string]$Stage) {
  $deadline = [DateTime]::UtcNow.AddSeconds(15)
  do {
    $task = Get-RegisteredTask
    if ($null -ne $task -and $task.State -eq 4) { return $task }
    Start-Sleep -Milliseconds 200
  } while ([DateTime]::UtcNow -lt $deadline)
  $state = if ($null -eq $task) { 'absent' } else { $task.State }
  Fail $Stage "scheduled task did not reach Running (state $state)"
}

function Stop-TaskForReplacement {
  & schtasks.exe /End /TN $TaskName 2>$null
  if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne 1) {
    Fail 'task-stop' "schtasks /End exited with code $LASTEXITCODE"
  }

  $deadline = [DateTime]::UtcNow.AddSeconds(10)
  do {
    $task = Get-RegisteredTask
    $instancesReleased = $null -eq $task -or ($task.State -ne 4 -and $task.GetInstances(0).Count -eq 0)
    $executableReleased = $true
    if (Test-Path -LiteralPath $DaemonDestination -PathType Leaf) {
      try {
        $probe = [IO.File]::Open($DaemonDestination, [IO.FileMode]::Open, [IO.FileAccess]::ReadWrite, [IO.FileShare]::None)
        $probe.Dispose()
      } catch {
        $executableReleased = $false
      }
    }
    if ($instancesReleased -and $executableReleased) { return }
    Start-Sleep -Milliseconds 100
  } while ([DateTime]::UtcNow -lt $deadline)
  Fail 'task-stop' 'scheduled task process did not release the daemon executable before replacement'
}

function Assert-TaskReady {
  $task = Wait-TaskRunning 'task-state'
  $pipe = [IO.Pipes.NamedPipeClientStream]::new('.', $PipeName, [IO.Pipes.PipeDirection]::Out)
  try {
    $pipe.Connect(5000)
  } catch {
    Fail 'readiness' "owned pipe did not accept: $($_.Exception.Message)"
  } finally {
    $pipe.Dispose()
  }
  $task = Get-RegisteredTask
  if ($null -eq $task -or $task.State -ne 4) {
    $state = if ($null -eq $task) { 'absent' } else { $task.State }
    Fail 'readiness' "task stopped after pipe acceptance (state $state)"
  }
}

# Complete preflight: no script-owned path or Task Scheduler state has changed.
foreach ($command in @('vp', 'cargo', 'schtasks.exe')) { Require-Command $command }
if (-not (Test-Path -LiteralPath $PluginSource -PathType Container)) { Fail 'preflight' 'plugin source is missing' }
if (-not (Test-Path -LiteralPath $CrateSource -PathType Container)) { Fail 'preflight' 'Rust crate source is missing' }
if (-not (Test-Path -LiteralPath $ManagedHome -PathType Container)) { Fail 'preflight' 'managed home is not a directory' }
if (-not (Test-Path -LiteralPath $PluginManifest -PathType Leaf)) { Fail 'preflight' 'rendered OMP package manifest is missing' }
try {
  $manifest = Get-Content -LiteralPath $PluginManifest -Raw | ConvertFrom-Json
} catch {
  Fail 'preflight' "rendered OMP package manifest is invalid JSON: $($_.Exception.Message)"
}
if ($manifest.name -ne '@h82/omp-mxm4-haptic' -or $manifest.type -ne 'module' -or
    @($manifest.omp.extensions).Count -ne 1 -or $manifest.omp.extensions[0] -ne './dist/index.js') {
  Fail 'preflight' 'rendered OMP package manifest does not declare the canonical extension'
}
$currentIdentity = [Security.Principal.WindowsIdentity]::GetCurrent()
$currentSid = $currentIdentity.User.Value
if ([string]::IsNullOrWhiteSpace($currentSid)) { Fail 'preflight' 'current-user SID is unavailable' }
foreach ($destination in @($PluginDestination, $DaemonDestination, $PluginStamp, $DaemonStamp)) {
  Assert-WritableDestination $destination
}
try {
  $scheduler = New-Object -ComObject 'Schedule.Service'
  $scheduler.Connect()
  $taskFolder = $scheduler.GetFolder('\')
} catch {
  Fail 'preflight' "Task Scheduler current-user API is unavailable: $($_.Exception.Message)"
}

$escapedSid = [Security.SecurityElement]::Escape($currentSid)
$escapedDaemon = [Security.SecurityElement]::Escape([IO.Path]::GetFullPath($DaemonDestination))
$taskXml = @"
<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><URI>$TaskName</URI></RegistrationInfo>
  <Triggers><LogonTrigger><Enabled>true</Enabled><UserId>$escapedSid</UserId></LogonTrigger></Triggers>
  <Principals><Principal id="Author"><UserId>$escapedSid</UserId><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings><StopOnIdleEnd>false</StopOnIdleEnd><RestartOnIdle>false</RestartOnIdle></IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure><Interval>PT1M</Interval><Count>3</Count></RestartOnFailure>
  </Settings>
  <Actions Context="Author"><Exec><Command>$escapedDaemon</Command></Exec></Actions>
</Task>
"@
try { [xml]$validatedTask = $taskXml } catch { Fail 'preflight' "task XML is invalid: $($_.Exception.Message)" }
$ns = New-Object Xml.XmlNamespaceManager($validatedTask.NameTable)
$ns.AddNamespace('t', 'http://schemas.microsoft.com/windows/2004/02/mit/task')
$required = @{
  '/t:Task/t:Triggers/t:LogonTrigger/t:UserId' = $currentSid
  '/t:Task/t:Principals/t:Principal/t:LogonType' = 'InteractiveToken'
  '/t:Task/t:Principals/t:Principal/t:RunLevel' = 'LeastPrivilege'
  '/t:Task/t:Settings/t:MultipleInstancesPolicy' = 'IgnoreNew'
  '/t:Task/t:Settings/t:ExecutionTimeLimit' = 'PT0S'
  '/t:Task/t:Settings/t:DisallowStartIfOnBatteries' = 'false'
  '/t:Task/t:Settings/t:StopIfGoingOnBatteries' = 'false'
  '/t:Task/t:Settings/t:RestartOnFailure/t:Count' = '3'
}
foreach ($entry in $required.GetEnumerator()) {
  $node = $validatedTask.SelectSingleNode($entry.Key, $ns)
  if ($null -eq $node -or $node.InnerText -ne $entry.Value) { Fail 'preflight' "task XML contract failed: $($entry.Key)" }
}
if ($validatedTask.SelectSingleNode('//t:BootTrigger', $ns) -or
    $taskXml -match '(?i)<LogonType>Password</LogonType>|<RunLevel>HighestAvailable</RunLevel>|<UserId>SYSTEM</UserId>') {
  Fail 'preflight' 'task XML requests a forbidden trigger, credential, or privilege'
}

# The isolated CI fixture may request the fully preflighted deterministic XML.
# Normal fixture coverage invokes the complete transaction below.
if (-not [string]::IsNullOrWhiteSpace($env:MXM4_HAPTIC_PREFLIGHT_XML_OUT)) {
  [IO.File]::WriteAllText($env:MXM4_HAPTIC_PREFLIGHT_XML_OUT, $taskXml, [Text.Encoding]::Unicode)
  return
}
$pluginDigest = Get-ComponentDigest $PluginInputsFingerprint $PluginConfigFingerprint
$daemonDigest = Get-ComponentDigest $DaemonInputsFingerprint $taskXml
$pluginChanged = (Read-Stamp $PluginStamp) -ne $pluginDigest -or -not (Test-Path -LiteralPath $PluginDestination -PathType Leaf)
$daemonChanged = (Read-Stamp $DaemonStamp) -ne $daemonDigest -or -not (Test-Path -LiteralPath $DaemonDestination -PathType Leaf)

$stage = Join-Path $StateRoot ('stage-' + [Guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Force -Path $stage | Out-Null
try {
  $pluginCandidate = Join-Path $stage 'index.js'
  $daemonCandidate = Join-Path $stage 'mxm4-hapticd.exe'
  $taskCandidate = Join-Path $stage 'mxm4-hapticd.xml'
  [IO.File]::WriteAllText($taskCandidate, $taskXml, [Text.Encoding]::Unicode)

  if ($pluginChanged) {
    Push-Location $PluginSource
    try { Invoke-Native 'plugin-build' { & vp run 'build:omp-plugin' } } finally { Pop-Location }
    $builtPlugin = Join-Path $PluginSource 'dist\omp-plugin\index.js'
    if (-not (Test-Path -LiteralPath $builtPlugin -PathType Leaf) -or (Get-Item -LiteralPath $builtPlugin).Length -eq 0) {
      Fail 'plugin-validate' 'bundle output is missing or empty'
    }
    Copy-Item -LiteralPath $builtPlugin -Destination $pluginCandidate
    $bundleText = Get-Content -LiteralPath $pluginCandidate -Raw
    if ($bundleText -match '(?m)\bfrom\s*["''](?:\.\.?[\\/]|@h82/mxm4-haptic)') {
      Fail 'plugin-validate' 'bundle retains a workspace or relative runtime import'
    }
  }

  if ($daemonChanged) {
    $cargoTarget = Join-Path $stage 'cargo-target'
    $oldCargoTarget = $env:CARGO_TARGET_DIR
    $env:CARGO_TARGET_DIR = $cargoTarget
    Push-Location $CrateSource
    try { Invoke-Native 'daemon-build' { & cargo build --release --locked --bin mxm4-hapticd } } finally {
      Pop-Location
      $env:CARGO_TARGET_DIR = $oldCargoTarget
    }
    $builtDaemon = Join-Path $cargoTarget 'release\mxm4-hapticd.exe'
    if (-not (Test-Path -LiteralPath $builtDaemon -PathType Leaf) -or (Get-Item -LiteralPath $builtDaemon).Length -lt 2) {
      Fail 'daemon-validate' 'staged daemon is missing or empty'
    }
    $header = [IO.File]::ReadAllBytes($builtDaemon)[0..1]
    if ($header[0] -ne 0x4d -or $header[1] -ne 0x5a) { Fail 'daemon-validate' 'staged daemon is not a PE executable' }
    Copy-Item -LiteralPath $builtDaemon -Destination $daemonCandidate
  }

  if ($pluginChanged) {
    Replace-Atomically $pluginCandidate $PluginDestination
    [IO.File]::WriteAllText($PluginStamp, "$pluginDigest`n", [Text.Encoding]::ASCII)
  }

  if ($daemonChanged) {
    # Do not race executable replacement with Task Scheduler process teardown.
    Stop-TaskForReplacement
    Replace-Atomically $daemonCandidate $DaemonDestination
  }

  # This reconciliation is intentionally unconditional: source stamps decide
  # builds, while live Task Scheduler drift is repaired on every apply.
  $task = Get-RegisteredTask
  if (-not (Test-TaskRegistration $task)) {
    if ($null -ne $task -and $task.State -eq 4) { Stop-TaskForReplacement }
    Invoke-Native 'task-register' { & schtasks.exe /Create /TN $TaskName /XML $taskCandidate /F }
    $task = Get-RegisteredTask
    if (-not (Test-TaskRegistration $task)) {
      Fail 'task-register' 'registered task does not match the current-user daemon endpoint contract'
    }
  }
  if ($task.State -ne 4) {
    Invoke-Native 'task-start' { & schtasks.exe /Run /TN $TaskName }
  }
  Assert-TaskReady
  if ($daemonChanged) {
    [IO.File]::WriteAllText($DaemonStamp, "$daemonDigest`n", [Text.Encoding]::ASCII)
  }
} finally {
  Remove-Item -LiteralPath $stage -Recurse -Force -ErrorAction SilentlyContinue
}

if (-not $pluginChanged -and -not $daemonChanged) {
  Write-Host 'mxm4-haptic: components current; Windows task reconciled'
} else {
  Write-Host 'mxm4-haptic: Windows plugin and daemon components reconciled'
}
{{ end -}}
