{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ $misePresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "mise-present") -}}
#!/usr/bin/env bash
set -euo pipefail

{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir
      "globs" (list "mise.toml" "packages/package.json" "packages/bun.lock" "packages/bunfig.toml" "packages/vite.config.ts" "packages/figma-auth/package.json" "packages/figma-auth/tsconfig.json" "packages/figma-auth/vite.config.ts" "packages/figma-auth/src/**")
      "values" (list (dict "name" "mise-present" "value" $misePresent))) }}
SRC="{{ $sourceDir }}"
DIST="$SRC/packages/figma-auth/dist/figma-auth"
STAGING_DIR="$HOME/.local/share/chezmoi-commands/incomplete/figma-auth"
TARGET="$STAGING_DIR/figma-auth"

if ! command -v mise >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "build-figma-auth" "site" "mise-absent" "direction" "transient-blocking" "probe" "mise-present" "reason" "mise is not installed; figma-auth build is deferred") | trim | indent 2 }}
fi

if ! mise -C "$SRC/packages" exec -- vp install --frozen-lockfile; then
  printf '%s\n' 'build-figma-auth: dependency installation failed; fix the package lock or registry access, then re-apply.' >&2
  exit 1
fi

if ! mise -C "$SRC/packages/figma-auth" exec -- vp run build; then
  printf '%s\n' 'build-figma-auth: build failed; fix the figma-auth build error, then re-apply.' >&2
  exit 1
fi

if [[ ! -f "$DIST" || ! -x "$DIST" ]]; then
  printf '%s\n' 'build-figma-auth: build completed without an executable dist artifact; inspect the build output, then re-apply.' >&2
  exit 1
fi

mkdir -p "$STAGING_DIR"
temporary="$(mktemp "$STAGING_DIR/.figma-auth.XXXXXX")"
cleanup() {
  if [[ -n "$temporary" ]]; then
    rm -f -- "$temporary"
  fi
}
on_hup() {
  trap - HUP INT TERM
  cleanup
  exit 129
}
on_int() {
  trap - HUP INT TERM
  cleanup
  exit 130
}
on_term() {
  trap - HUP INT TERM
  cleanup
  exit 143
}
trap cleanup EXIT
trap on_hup HUP
trap on_int INT
trap on_term TERM
chmod 0600 "$temporary"
cat "$DIST" >"$temporary"
chmod 0755 "$temporary"

if [[ -L "$TARGET" || ( -e "$TARGET" && ! -f "$TARGET" ) ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "build-figma-auth" "site" "install-target-unsafe" "direction" "harmless" "reason" "the figma-auth install target is not a regular file; existing target is preserved") | trim | indent 2 }}
fi

mv -f -- "$temporary" "$TARGET"
temporary=''
if [[ ! -f "$TARGET" || -L "$TARGET" || ! -x "$TARGET" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "build-figma-auth" "site" "promoted-target-unsafe" "direction" "harmless" "reason" "the promoted figma-auth target is not a regular executable") | trim | indent 2 }}
fi
printf '%s\n' 'build-figma-auth: staged figma-auth'
{{ end -}}
