{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ $bunVersion := includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "bun") -}}
#!/usr/bin/env bash
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/sbin:"*) ;;
  *) PATH="$HOME/.local/sbin:$PATH" ;;
esac
export PATH

set -euo pipefail
{{- /* The `bun-version` value makes a lock-driven bun bump rebuild the binary.
   Fingerprint package sources and workspace configuration. */ -}}
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir
      "globs" (list "mise.toml" "packages/package.json" "packages/bun.lock" "packages/bunfig.toml" "packages/vite.config.ts" "packages/figma-proxy/package.json" "packages/figma-proxy/tsconfig.json" "packages/figma-proxy/vite.config.ts" "packages/figma-proxy/src/**")
      "values" (list (dict "name" "bun-version" "value" $bunVersion))) }}

SRC="{{ $sourceDir }}"
export DOTFILES_BUN_VERSION="{{ $bunVersion }}"
DIST="$SRC/packages/figma-proxy/dist/figma-proxy"
STAGING_DIR="$HOME/.local/share/chezmoi-commands/incomplete/figma-proxy"
TARGET="$STAGING_DIR/figma-proxy"

MISE_BIN="mise"
if ! command -v "$MISE_BIN" >/dev/null 2>&1; then
  if [[ -x "$HOME/.local/bin/mise" ]]; then
    MISE_BIN="$HOME/.local/bin/mise"
  elif [[ -x "$HOME/.local/share/chezmoi-commands/incomplete/mise/mise" ]]; then
    MISE_BIN="$HOME/.local/share/chezmoi-commands/incomplete/mise/mise"
  else
    printf '%s\n' 'build-figma-proxy: mise is not installed; the figma-proxy binary cannot be built' >&2
    exit 1
  fi
fi

{{ includeTemplate "bun-resolve.sh.tmpl" | trim }}

if [[ -z "$BUN_BIN" ]]; then
  printf '%s\n' 'build-figma-proxy: bun is not installed; the build compiles with bun' >&2
  exit 1
fi

if ! "$MISE_BIN" -C "$SRC/packages" exec -- vp install --frozen-lockfile; then
  printf '%s\n' 'build-figma-proxy: dependency installation failed; fix the package lock or registry access, then re-apply.' >&2
  exit 1
fi
if ! "$MISE_BIN" -C "$SRC/packages/figma-proxy" exec -- vp run build; then
  printf '%s\n' 'build-figma-proxy: build failed; fix the figma-proxy build error, then re-apply.' >&2
  exit 1
fi
if [[ ! -f "$DIST" || ! -x "$DIST" ]]; then
  printf '%s\n' 'build-figma-proxy: build completed without an executable dist artifact; inspect the build output, then re-apply.' >&2
  exit 1
fi

"$DIST" ca-init || true

mkdir -p "$STAGING_DIR"
temporary="$(mktemp "$STAGING_DIR/.figma-proxy.XXXXXX")"
trap 'rm -f -- "$temporary"' EXIT
chmod 0600 "$temporary"
cp -- "$DIST" "$temporary"
chmod 0755 "$temporary"
mv -f -- "$temporary" "$TARGET"
temporary=''
printf '%s\n' 'build-figma-proxy: staged figma-proxy'
{{ end -}}
