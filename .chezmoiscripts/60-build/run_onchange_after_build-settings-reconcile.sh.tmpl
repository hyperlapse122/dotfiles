{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ $misePresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "mise-present") -}}
{{ $bunVersion := includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "bun") -}}
#!/usr/bin/env bash
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/sbin:"*) ;;
  *) PATH="$HOME/.local/sbin:$PATH" ;;
esac
export PATH

set -euo pipefail
{{- /* The `bun-version` value is what makes a lock-driven bun bump rebuild: the
   compiled binary embeds a bun runtime, but no tracked file changes when the
   lock moves, so without this the staged binary would stay compiled by the
   previous bun until an unrelated source edit happened to re-trigger the
   script. Hashing the version alone rather than globbing the lock keeps an
   unrelated tool's version out of this script's fingerprint. */ -}}
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir
      "globs" (list "mise.toml" "packages/package.json" "packages/bun.lock" "packages/bunfig.toml" "packages/vite.config.ts" "packages/settings-reconcile/package.json" "packages/settings-reconcile/tsconfig.json" "packages/settings-reconcile/vite.config.ts" "packages/settings-reconcile/src/**")
      "values" (list (dict "name" "mise-present" "value" $misePresent)
                     (dict "name" "bun-version" "value" $bunVersion))) }}

SRC="{{ $sourceDir }}"
# `vp run build` caches on its declared inputs, all of which live under the
# packages/ workspace root; .chezmoidata/releases.json sits outside it and no
# `input` base reaches there. The vite task therefore fingerprints this
# variable instead, so a bun bump invalidates the vp cache as well as the
# chezmoi onchange fingerprint above.
export DOTFILES_BUN_VERSION="{{ $bunVersion }}"
DIST="$SRC/packages/settings-reconcile/dist/settings-reconcile"
STAGING_DIR="$HOME/.local/share/chezmoi-commands/incomplete/settings-reconcile"
TARGET="$STAGING_DIR/settings-reconcile"

if ! command -v mise >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "build-settings-reconcile" "site" "mise-absent" "direction" "transient-blocking" "probe" "mise-present" "reason" "mise is not installed; settings-reconcile build is deferred") | trim | indent 2 }}
fi

{{- /* The ladder runs for its PATH prepend, not to pick a toolchain: `vp run
   build` shells out to `bun build --compile`, and that subprocess resolves bun
   from PATH. Without this, a host whose only bun is the staged external builds
   under mise and still fails one level down.

   There is deliberately no bun-only branch here. The build needs `vp`, which is
   a mise tool, so bun alone cannot replace mise for this script. Making the skip
   wait on "neither mise nor bun" would also break its pruning: a
   transient-blocking record encodes ONE probe, and prune_stale_skip_records
   clears it only when that probe reads available — so a host that recovered by
   installing the other tool would carry the record forever. */}}
{{ includeTemplate "bun-resolve.sh.tmpl" | trim }}

if ! mise -C "$SRC/packages" exec -- vp install --frozen-lockfile; then
  printf '%s\n' 'build-settings-reconcile: dependency installation failed; fix the package lock or registry access, then re-apply.' >&2
  exit 1
fi
if ! mise -C "$SRC/packages/settings-reconcile" exec -- vp run build; then
  printf '%s\n' 'build-settings-reconcile: build failed; fix the settings-reconcile build error, then re-apply.' >&2
  exit 1
fi
if [[ ! -f "$DIST" || ! -x "$DIST" ]]; then
  printf '%s\n' 'build-settings-reconcile: build completed without an executable dist artifact; inspect the build output, then re-apply.' >&2
  exit 1
fi
mkdir -p "$STAGING_DIR"
temporary="$(mktemp "$STAGING_DIR/.settings-reconcile.XXXXXX")"
trap 'rm -f -- "$temporary"' EXIT
chmod 0600 "$temporary"
cp -- "$DIST" "$temporary"
chmod 0755 "$temporary"
if [[ -L "$TARGET" || ( -e "$TARGET" && ! -f "$TARGET" ) ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "build-settings-reconcile" "site" "install-target-unsafe" "direction" "harmless" "reason" "the settings-reconcile install target is not a regular file; existing target is preserved") | trim | indent 2 }}
fi
mv -f -- "$temporary" "$TARGET"
temporary=''
printf '%s\n' 'build-settings-reconcile: staged settings-reconcile'
{{ end -}}
