{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
{{ $pluginInputs := includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "packages/package.json" "packages/bun.lock" "packages/vite.config.ts" "packages/mxm4-haptic/package.json" "packages/mxm4-haptic/tsconfig.json" "packages/mxm4-haptic/vite.config.ts" "packages/mxm4-haptic/src/**" "dot_local/share/omp-plugins/dot_omp-plugin/marketplace.json" "dot_local/share/omp-plugins/plugins/mxm4-haptic/package.json.tmpl")) -}}
{{ $pluginConfig := printf "settled=%s\nfailed=%s\nquestion=%s\n" .haptic.omp.settled .haptic.omp.failed .haptic.omp.question -}}
{{ $daemonInputs := "" -}}
{{ $daemonConfig := "" -}}
{{ $notifyInputs := "" -}}
{{ $notifyConfig := "" -}}
{{ if eq .chezmoi.os "darwin" -}}
{{ $daemonInputs = includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "crates/mxm4-haptic/Cargo.toml" "crates/mxm4-haptic/Cargo.lock" "crates/mxm4-haptic/src/lib.rs" "crates/mxm4-haptic/src/bin/mxm4-haptic.rs" "crates/mxm4-haptic/src/bin/mxm4-hapticd.rs" "Library/LaunchAgents/dev.h82.mxm4-hapticd.plist")) -}}
{{ else -}}
{{ $daemonInputs = includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "crates/mxm4-haptic/Cargo.toml" "crates/mxm4-haptic/Cargo.lock" "crates/mxm4-haptic/src/lib.rs" "crates/mxm4-haptic/src/bin/mxm4-haptic.rs" "crates/mxm4-haptic/src/bin/mxm4-hapticd.rs" "dot_config/systemd/user/mxm4-hapticd.service.tmpl")) -}}
