
{{- $tag := (includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "codegraph")) -}}

#!/usr/bin/env bash
#
# onchange trigger: the latest release tag is rendered into the script body
# below, so a new upstream release changes the rendered content and re-runs
# the re-link + prune.

set -euo pipefail

INSTALL_DIR="${CODEGRAPH_INSTALL_DIR:-$HOME/.codegraph}"
BIN_DIR="${CODEGRAPH_BIN_DIR:-$HOME/.local/bin}"

dest="$INSTALL_DIR/versions/{{ $tag }}"
ln -sf "$dest/bin/codegraph" "$BIN_DIR/codegraph"
ln -sfn "$dest" "$INSTALL_DIR/current"

pruned=0
if [ -d "$INSTALL_DIR/versions" ]; then
  for d in "$INSTALL_DIR/versions"/*; do
    [ -d "$d" ] || continue
    if [ "$d" != "$dest" ]; then
      if rm -rf "$d"; then
        pruned=$((pruned + 1))
      fi
    fi
  done
fi
