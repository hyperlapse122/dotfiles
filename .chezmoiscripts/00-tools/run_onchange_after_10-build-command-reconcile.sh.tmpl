{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
#!/usr/bin/env bash
set -euo pipefail
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir
      "globs" (list "mise.toml" "packages/package.json" "packages/bun.lock" "packages/bunfig.toml" "packages/vite.config.ts" "packages/command-reconcile/package.json" "packages/command-reconcile/tsconfig.json" "packages/command-reconcile/vite.config.ts" "packages/command-reconcile/src/**")) }}

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/sbin:"*) ;;
  *) PATH="$HOME/.local/sbin:$PATH" ;;
esac
export PATH

SRC="{{ $sourceDir }}"
DIST="$SRC/packages/command-reconcile/dist/command-reconcile"
LIBEXEC_DIR="$HOME/.local/libexec"
TARGET="$LIBEXEC_DIR/command-reconcile"

MISE_BIN="mise"
if ! command -v "$MISE_BIN" >/dev/null 2>&1; then
  if [[ -x "$HOME/.local/bin/mise" ]]; then
    MISE_BIN="$HOME/.local/bin/mise"
  elif [[ -x "$HOME/.local/share/chezmoi-commands/incomplete/mise/mise" ]]; then
    MISE_BIN="$HOME/.local/share/chezmoi-commands/incomplete/mise/mise"
  fi
fi

{{ includeTemplate "bun-resolve.sh.tmpl" | trim }}

if ! command -v "$MISE_BIN" >/dev/null 2>&1 && [[ ! -x "$MISE_BIN" ]] && [[ -z "$BUN_BIN" ]]; then
  printf '%s\n' 'build-command-reconcile: neither mise nor bun is installed; command-reconcile cannot be built' >&2
  exit 1
fi
# Both branches below compile with bun: the mise branch reaches it through `vp
# run build`, whose task command is `bun build --compile`. Since bun left mise's
# tool set, mise being present no longer implies bun is, so say which tool is
# missing here rather than letting the build fail three levels down.
if [[ -z "$BUN_BIN" ]]; then
  printf '%s\n' 'build-command-reconcile: bun is not installed; the build compiles with bun through either toolchain' >&2
  exit 1
fi

if command -v "$MISE_BIN" >/dev/null 2>&1 || [[ -x "$MISE_BIN" ]]; then
  if ! "$MISE_BIN" -C "$SRC/packages" exec -- vp install --frozen-lockfile; then
    printf '%s\n' 'build-command-reconcile: dependency installation failed; fix the package lock or registry access, then re-apply.' >&2
    exit 1
  fi
  if ! "$MISE_BIN" -C "$SRC/packages/command-reconcile" exec -- vp run build; then
    printf '%s\n' 'build-command-reconcile: build failed; fix the command-reconcile build error, then re-apply.' >&2
    exit 1
  fi
elif [[ -n "$BUN_BIN" ]]; then
  if ! (cd "$SRC/packages/command-reconcile" && "$BUN_BIN" build --compile ./src/cli.ts --outfile ./dist/command-reconcile); then
    printf '%s\n' 'build-command-reconcile: bun build failed; fix the command-reconcile build error, then re-apply.' >&2
    exit 1
  fi
fi

if [[ ! -f "$DIST" || ! -x "$DIST" ]]; then
  printf '%s\n' 'build-command-reconcile: build completed without an executable dist artifact; inspect the build output, then re-apply.' >&2
  exit 1
fi

mkdir -p "$LIBEXEC_DIR"
temporary="$(mktemp "$LIBEXEC_DIR/.command-reconcile.XXXXXX")"
trap 'rm -f -- "$temporary"' EXIT
chmod 0600 "$temporary"
cp -- "$DIST" "$temporary"
chmod 0755 "$temporary"

mv -f -- "$temporary" "$TARGET"
temporary=''
printf '%s\n' 'build-command-reconcile: installed ~/.local/libexec/command-reconcile'
{{ end -}}
