{{- $ctx := . -}}
{{- $marketplaces := .agents.marketplaces -}}
{{- $prunes := list -}}
{{- range $name := keys $marketplaces | sortAlpha -}}
{{-   $authority := index $marketplaces $name -}}
{{-   if not (hasKey $authority "kind") -}}{{ fail (printf "compound-engineering prune: marketplace %q is missing kind" $name) }}{{- end -}}
{{-   if ne (printf "%v" (index $authority "kind")) "localArchive" -}}{{ continue }}{{ end -}}
{{-   $segment := includeTemplate "local-archive-ref.tmpl" (dict "ctx" $ctx "marketplace" $name "field" "segment") -}}
{{-   $prunes = append $prunes (printf "  %q" (printf "%s\t%s" (index $authority "externalPath") $segment)) -}}
{{- end -}}

#!/usr/bin/env bash
#
# Prunes older extracted versions under ~/<externalPath>/ for every
# localArchive marketplace, keeping only the segment its authority currently
# pins. Chezmoi's exact=true only cleans within one target path, so sibling
# version directories under the same parent accumulate without this.
#
# There is no ~/.local/bin symlink to repoint. Claude, Codex, and omp consume
# the fully rendered versioned marketplace path. A version bump re-registers
# the path through the surviving agent-plugin and omp updater scripts.
#
# onchange trigger: the rendered segments below ARE the trigger — a new
# upstream release or gitRef move changes this script's content and re-runs
# the prune after the file phase has extracted the new version.

set -euo pipefail

PRUNES=(
{{ join "\n" $prunes }}
)

for row in "${PRUNES[@]}"; do
  row=${row//\\t/$'\t'}
  IFS=$'\t' read -r rel_base segment <<<"$row"
  base_dir="$HOME/$rel_base"
  current="$base_dir/$segment"

  # The file phase must have extracted the current version already; if not, do
  # nothing rather than nuking the whole tree. Same defensive skip as the
  # omp plugin updater.
  [ -d "$current" ] || continue

  for d in "$base_dir"/*; do
    # lstat first: a symlink in the parent is never a prune candidate, so a
    # foreign checkout linked into the tree is left untouched. Only plain
    # directories that are not the pinned segment reach the single removal.
    [ -L "$d" ] && continue
    [ -d "$d" ] || continue
    [ "$d" = "$current" ] && continue
    rm -rf -- "$d" || true
  done
done
