{{ if eq .chezmoi.os "windows" -}}

{{- $latestReleaseId := (includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "claude")) -}}

# .chezmoiscripts/00-tools/run_onchange_after_claude.ps1.tmpl
#
# Windows counterpart to run_onchange_after_claude.sh.tmpl: links the pinned
# claude to ~/.local/bin and prunes older versions.
#
# The external lands the binary at ~/.local/share/claude/versions/<id>.exe
# (release-lock pinned, checksum-verified). POSIX publishes it with a symlink;
# Windows file symlinks require Developer Mode or elevation, so this script
# publishes a HARDLINK at ~/.local/bin/claude.exe instead — hardlinks need no
# privilege and both paths live under %USERPROFILE% (same volume). If the
# hardlink fails (exotic volume layout) it falls back to a copy with a
# diagnostic, so `claude` still resolves on PATH.
#
# Undeclared-state preservation: a pre-existing claude.exe that differs from
# the pinned binary (anything this script did not place — e.g. an npm-installed
# claude) is backed up ONCE to claude.exe.pre-chezmoi.bak before replacement,
# never silently destroyed. A matching file (re-run, same version) is left
# untouched, so a second apply converges to a no-op.
#
# onchange trigger: the latest release id is rendered into the script body
# below, so a new upstream release changes the rendered content and re-runs
# the re-link + prune (same contract as the POSIX half).

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$installDir = if ($env:CLAUDE_INSTALL_DIR) { $env:CLAUDE_INSTALL_DIR } else { Join-Path $HOME '.local\share\claude' }
$binDir = if ($env:CLAUDE_BIN_DIR) { $env:CLAUDE_BIN_DIR } else { Join-Path $HOME '.local\bin' }

$dest = Join-Path $installDir 'versions\{{ $latestReleaseId }}.exe'
$link = Join-Path $binDir 'claude.exe'

New-Item -ItemType Directory -Force -Path $binDir | Out-Null

if (-not (Test-Path -LiteralPath $dest -PathType Leaf)) {
  # The file phase must have fetched the pinned version already; if not, do
  # nothing rather than pruning the whole tree (same defensive skip as the
  # compound-engineering siblings).
  Write-Warning "claude: pinned version $dest is absent; skipping link and prune"
  exit 0
}

$publish = $true
if (Test-Path -LiteralPath $link -PathType Leaf) {
  $linkItem = Get-Item -LiteralPath $link -Force
  if ($linkItem.Attributes.HasFlag([IO.FileAttributes]::ReparsePoint)) {
    # A reparse point here is foreign (this script never creates one); remove
    # the link itself, never its target.
    $linkItem.Delete()
  } elseif ((Get-FileHash -Algorithm SHA256 -LiteralPath $link).Hash -eq (Get-FileHash -Algorithm SHA256 -LiteralPath $dest).Hash) {
    $publish = $false
  } else {
    $backup = "$link.pre-chezmoi.bak"
    if (-not (Test-Path -LiteralPath $backup)) {
      Move-Item -LiteralPath $link -Destination $backup
      Write-Warning "claude: undeclared $link preserved at $backup"
    } else {
      Remove-Item -LiteralPath $link -Force
    }
  }
}

if ($publish) {
  try {
    New-Item -ItemType HardLink -Path $link -Target $dest | Out-Null
  } catch {
    Copy-Item -LiteralPath $dest -Destination $link -Force
    Write-Warning "claude: hardlink failed ($($_.Exception.Message)); copied $dest to $link instead"
  }
}

# Prune older versions (files only, mirroring the POSIX `[ -f ]` test).
$versionsDir = Join-Path $installDir 'versions'
if (Test-Path -LiteralPath $versionsDir -PathType Container) {
  Get-ChildItem -LiteralPath $versionsDir -File -Force |
    Where-Object { $_.FullName -ne $dest } |
    ForEach-Object { Remove-Item -LiteralPath $_.FullName -Force }
}

{{ end -}}
