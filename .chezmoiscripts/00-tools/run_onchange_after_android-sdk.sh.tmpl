{{- if not (includeTemplate "facts.tmpl" . | fromYaml).container -}}
{{- $androidVersion := (includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "android")) -}}
{{- /* The emulator system image is per-ABI, and this script runs on the arm64
       and macOS legs too, so the ABI is composed from .chezmoi.arch the same
       way .chezmoiexternals composes its platform tokens. An x86_64 image on an
       arm64 host installs and then boots nothing. */ -}}
{{- $abi := "x86_64" -}}
{{- if eq .chezmoi.arch "arm64" -}}{{- $abi = "arm64-v8a" -}}{{- end -}}
#!/usr/bin/env bash
#
# Provisions the Android SDK headlessly into ~/.local/share/android-sdk using
# the Android CLI: platform-tools, build-tools, a platform, and the pieces
# Orca's mobile emulator needs — cmdline-tools (avdmanager), the emulator
# itself, and one system image — plus a default AVD.
#
# WHY THE EMULATOR SET IS NOT OPTIONAL. Orca's Android backend shells out to
# `adb`, `emulator`, and `avdmanager` and needs at least one AVD; without them
# it reports "Android SDK not found" however correct ANDROID_HOME is. A
# components-only install leaves the device list empty, which looks the same to
# the user as no SDK at all.
#
# NO SWALLOWED FAILURES. Every step is load-bearing, so none is suffixed with an
# error-swallowing operator, and the `android` CLI is a hard prerequisite rather
# than a soft skip on an executable test: a host that finished green with no SDK
# and no AVD is the silent-incompleteness this script exists to prevent.
#
# android CLI version: {{ $androidVersion }}
# system image ABI: {{ $abi }} (from .chezmoi.arch)
#
# This script re-runs when rendered content changes (e.g. when the android CLI
# version or the selected ABI updates).

set -euo pipefail

ANDROID_HOME="${ANDROID_HOME:-$HOME/.local/share/android-sdk}"
export ANDROID_HOME
export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$ANDROID_HOME}"
mkdir -p "$ANDROID_HOME"

ANDROID_BIN="$HOME/.local/bin/android"
if [ ! -x "$ANDROID_BIN" ]; then
  if command -v android >/dev/null 2>&1; then
    ANDROID_BIN="$(command -v android)"
  fi
fi
[ -x "$ANDROID_BIN" ] || {
  echo "android-sdk: the android CLI is not on PATH or at ~/.local/bin/android (externals not applied? see .chezmoiexternals/dev-tools.toml)" >&2
  exit 1
}

# Initialize the agent environment and skills.
"$ANDROID_BIN" init

# Install required SDK components idempotently.
"$ANDROID_BIN" --sdk="$ANDROID_HOME" sdk install \
  "platform-tools" \
  "build-tools/35.0.0" \
  "platforms/android-36" \
  "cmdline-tools" \
  "emulator" \
  "system-images/android-36/google_apis/{{ $abi }}"

# One AVD is what turns Orca's emulator panel from "not found" into a device
# list. Created only when there is none: this script re-runs on every render
# change, and an operator's own AVD must never be displaced.
# The probe's own exit status decides, not its stdout: `emulator list 2>/dev/null`
# makes a failing probe indistinguishable from "no AVD exists", so a broken SDK
# would skip creation and the apply would finish green with exactly the empty
# device list this script exists to prevent.
if ! avd_list="$("$ANDROID_BIN" --sdk="$ANDROID_HOME" emulator list 2>&1)"; then
  echo "android-sdk: 'emulator list' failed: $avd_list" >&2
  exit 1
fi
if [ -z "$(printf '%s' "$avd_list" | tr -d '[:space:]')" ]; then
  echo "android-sdk: creating the default medium_phone AVD"
  "$ANDROID_BIN" --sdk="$ANDROID_HOME" emulator create medium_phone
fi
{{- end -}}
