{{ if ne .chezmoi.os "windows" -}}

{{- $ctx := . -}}
{{- $cePlugin := "" -}}
{{- range .agents.opencode.plugins -}}
{{-   if and (eq .install "localArchive") (eq .versionSource "compoundEngineeringRelease") -}}
{{-     $cePlugin = . -}}
{{-   end -}}
{{- end -}}
{{- if $cePlugin -}}
{{- $ceRef := includeTemplate "compound-engineering-ref.tmpl" $ctx -}}
{{- $ceVersion := printf "v%s" (trimPrefix "compound-engineering-v" $ceRef) -}}

#!/usr/bin/env bash
# .chezmoiscripts/00-tools/run_after_compound-engineering-overlays.sh.tmpl
#
# Injects the compound-engineering-overlays tree
# (~/.local/share/compound-engineering-overlays/) onto the currently-pinned
# compound-engineering version directory (~/.local/share/compound-engineering/v<semver>/).
# ce-sweep and other skills load per-source personas from references/sources/<type>.md
# inside that versioned tree, which the release archive does not ship (e.g.
# gitlab-issues.md); without this overlay every run re-authors them and they diverge
# across devices.
#
# The compound-engineering external is ADDITIVE: .chezmoiexternals/ai-agents.toml's
# localArchive block intentionally omits `exact`, so chezmoi adds/updates archive
# files but does not remove others. An injected overlay therefore survives across
# no-change applies for overlay-only files. Archive-owned files such as
# skills/ce-sweep/SKILL.md are restored by the external on every reconciliation,
# so this run_after script reapplies its strict contract patch after every file
# phase.
#
# Generic: every file under the overlays tree is mirrored onto the CE tree at the
# matching relative path, so adding a future overlay needs no script change.
# POSIX `cp -Rp .../.` merges portably across GNU and BSD cp. Mirrors the version
# resolution in run_onchange_after_compound-engineering (the prune script); this
# script never prunes version directories and never modifies the overlays source.
#
# This remains run_after_ intentionally: the archive can overwrite an owned file
# without any source fingerprint changing, so live state must be retried on every
# apply. The exact substitutions below fail closed on upstream contract drift.

set -euo pipefail

BASE_DIR="$HOME/{{ $cePlugin.externalPath }}"
CURRENT="$BASE_DIR/{{ $ceVersion }}"
OVERLAYS="${BASE_DIR}-overlays"

# Both must exist: the file phase extracts CURRENT and deploys OVERLAYS before
# scripts run. Match the prune script's defensive skip.
if [ ! -d "$OVERLAYS" ] || [ ! -d "$CURRENT" ]; then
  exit 0
fi

# Merge the overlays tree onto the current CE version tree at matching relative
# paths. `/.` copies directory contents (including nested) into the target; -Rp is
# POSIX and preserves mode; same-named files are overwritten (overlay semantics).
cp -Rp -- "$OVERLAYS/." "$CURRENT/"

SWEEP_SKILL="$CURRENT/skills/ce-sweep/SKILL.md"
[ -f "$SWEEP_SKILL" ] || {
  echo "compound-engineering overlay: missing $SWEEP_SKILL" >&2
  exit 1
}

old_schema='The persona returns mapped items (`id`, `origin`, `author_class`, `body`, `media`, identity-scoped `existing_ack`, `existing_closeout`) or one of its degrade/skip sentences.'
new_schema='The persona returns mapped items (`id`, `origin`, `author_class`, `title`, `body`, `media`, identity-scoped `existing_ack`, `existing_closeout`, optional `sensitive`) or one of its degrade/skip sentences.'
old_upsert='Include `"sensitive": true` in the item JSON when the source'"'"'s config entry is marked sensitive — the engine drops `body`/`quote` before writing.'
new_upsert='Include `"sensitive": true` in the item JSON when either the source'"'"'s config entry is marked sensitive or the mapped item carries `sensitive: true` — the engine drops `body`/`quote` before writing. A source persona that marks an individual item sensitive must also replace its `title` with a neutral, non-sensitive summary and omit `media` because those fields are retained.'

patch_contract() {
  old=$1
  new=$2
  if grep -qF -- "$new" "$SWEEP_SKILL"; then
    return
  fi
  if ! grep -qF -- "$old" "$SWEEP_SKILL"; then
    echo "compound-engineering overlay: ce-sweep contract drifted; refusing an unsafe patch" >&2
    exit 1
  fi
  OLD="$old" NEW="$new" perl -0pi -e 's/\Q$ENV{OLD}\E/$ENV{NEW}/g' "$SWEEP_SKILL"
  grep -qF -- "$new" "$SWEEP_SKILL" || {
    echo "compound-engineering overlay: ce-sweep contract patch failed" >&2
    exit 1
  }
}

patch_contract "$old_schema" "$new_schema"
patch_contract "$old_upsert" "$new_upsert"

{{ end -}}
{{ end -}}
