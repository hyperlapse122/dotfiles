{{ if ne .chezmoi.os "windows" -}}

{{- $arch := (replace "amd64" "x86_64" (replace "arm64" "aarch64" .chezmoi.arch)) -}}

{{- $tag := (includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "codex")) -}}
{{- $release := (replace "rust-v" "" $tag) -}}
{{- $target := (replace "linux" "unknown-linux-musl" (replace "darwin" "apple-darwin" (replace "windows" "pc-windows-msvc" .chezmoi.os))) -}}

{{- $releasePath := (printf "%s-%s-%s" $release $arch $target) -}}
{{- $asset := (printf "codex-package-%s-%s.tar.zst" $arch $target) -}}

{{- $releaseDir := (joinPath (env "HOME") ".codex" "packages" "standalone" "releases") -}}
{{- $installationPath := (joinPath $releaseDir $releasePath) -}}

#!/usr/bin/env bash
# .chezmoiscripts/00-tools/run_onchange_after_codex.sh.tmpl
#
# Selects the current standalone Codex release and prunes older versions.
# Chezmoi separately owns the public ~/.local/bin/codex wrapper.
#
# onchange trigger: the latest release path is rendered into the script body
# below, so a new upstream release changes the rendered content and re-runs
# current-release selection + prune.

set -euo pipefail

dest="{{ $installationPath }}"
ln -sfn "$dest" "{{ $releaseDir }}/current"
ln -sf "$(jq -r '.entrypoint' "$dest/codex-package.json")" "$dest/codex"

# Prune older versions
pruned=0
if [ -d "{{ $releaseDir }}" ]; then
  for d in "{{ $releaseDir }}"/*; do
    # 'current' is a symlink living in this same dir — never prune it
    # (test -d follows symlinks, so it would otherwise match).
    if [ -L "$d" ] || [ ! -d "$d" ]; then
      continue
    fi
    if [ "$d" != "$dest" ]; then
      if rm -rf "$d"; then
        pruned=$((pruned + 1))
      fi
    fi
  done
fi
# if [ "$pruned" -gt 0 ]; then
#   echo "Removed    $pruned older version(s)"
# fi

{{ end -}}
