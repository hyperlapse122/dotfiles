{{ if eq .chezmoi.os "windows" -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
# .chezmoiscripts/70-agents/run_onchange_after_install-dotagents-skills.ps1.tmpl
#
# Windows counterpart to run_onchange_after_install-dotagents-skills.sh.tmpl:
# provisions user-scoped agent MCP servers with `dotagents --user install`,
# driven by the deployed ~/.agents/agents.toml (source:
# dot_agents/private_readonly_agents.toml.tmpl). The POSIX half carries the
# full onchange/fingerprint rationale; the fingerprint inputs are identical.
#
# WINDOWS LINK MECHANICS (the one behavioral delta): dotagents drops a
# `skills` link into each agent's config dir (~/.claude/skills,
# ~/.codex/skills) pointing at ~/.agents/skills. A Windows file/directory
# SYMLINK requires Developer Mode or elevation, so this script pre-creates
# those links as JUNCTIONS — junctions need no privilege — before invoking
# dotagents, which then sees its link already present and only writes MCP
# config. Junctions are validated: an existing reparse point is left to
# dotagents, while a pre-existing REAL directory is undeclared vendor state
# and is preserved untouched with a diagnostic (never merged or deleted).
# ~/.agents/skills itself must exist first (deployed dot_agents/skills
# content); without it the junction step skips with a diagnostic.
#
# Soft-skip: this script must never fail apply; missing tools and install
# errors all exit 0 after a diagnostic message, and that clean exit-0 is not
# retried until the fingerprint changes (re-run by hand or
# `chezmoi apply --force`).

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
$PSNativeCommandUseErrorActionPreference = $false

# Raw agents.toml source fingerprint — target-format and local-skill changes.
# Comment-only; never executed.
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "dot_agents/private_readonly_agents.toml.tmpl" ".chezmoitemplates/agent-mcp-servers-json.tmpl")) }}
#
# Selective unresolved DATA trigger (identical hash to the POSIX half).
{{ $dotagentsData := dict "mcp" .agents.mcp -}}
# dotagents-data-sha256: {{ $dotagentsData | toJson | sha256sum }}

if (-not (Get-Command mise -ErrorAction SilentlyContinue)) {
  Write-Warning 'install-dotagents-skills: skipped (mise not installed)'
  exit 0
}

if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
  Write-Warning 'install-dotagents-skills: skipped (git not installed)'
  exit 0
}

$skillsTarget = Join-Path $HOME '.agents\skills'
$claudeDir = Join-Path $HOME '.claude'
$codexDir = Join-Path $HOME '.codex'

# First-apply fix (same as POSIX): dotagents' ensureSkillsSymlink does NOT
# create the agent config dirs, and nothing else creates ~/.claude before
# Claude Code first runs. Pre-create them so the initial apply provisions
# fully; New-Item -Force is idempotent.
New-Item -ItemType Directory -Force -Path $claudeDir, $codexDir | Out-Null

# Pre-create the skills links as junctions (see the header). A junction whose
# target is missing still works once the target appears, but skipping with a
# diagnostic is clearer than planting a dangling link on a first bootstrap
# where the file phase could not run.
if (Test-Path -LiteralPath $skillsTarget -PathType Container) {
  foreach ($agentDir in @($claudeDir, $codexDir)) {
    $link = Join-Path $agentDir 'skills'
    if (Test-Path -LiteralPath $link) {
      $item = Get-Item -LiteralPath $link -Force
      if (-not $item.Attributes.HasFlag([IO.FileAttributes]::ReparsePoint)) {
        Write-Warning "install-dotagents-skills: preserved undeclared directory $link (not replaced with a junction)"
      }
      continue
    }
    New-Item -ItemType Junction -Path $link -Target $skillsTarget | Out-Null
  }
} else {
  Write-Warning "install-dotagents-skills: skipped skills junctions ($skillsTarget not deployed yet)"
}

# Run dotagents THROUGH mise (same reasoning as POSIX: mise's npm/bun backend
# owns the CLI and puts a mise-managed runtime on PATH for the duration of the
# run, with --no-config --no-env --no-hooks keeping it independent of any mise
# config in the working directory).
$installOutput = (& mise --no-config --no-env --no-hooks exec -y bun -- bunx '@sentry/dotagents' --user install 2>&1 | Out-String)
if ($LASTEXITCODE -ne 0) {
  $reason = ($installOutput -split "`n") -join '; '
  Write-Warning "install-dotagents-skills: skipped (install failed: $reason)"
  exit 0
}
{{ end -}}
