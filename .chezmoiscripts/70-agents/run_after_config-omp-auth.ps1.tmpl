{{ if eq .chezmoi.os "windows" -}}
{{- $env := .agents.omp.auth.env -}}
{{- $required := list "ZAI_API_KEY" "EXA_API_KEY" "OPENROUTER_API_KEY" "OPENCODE_API_KEY" -}}
{{- if not (kindIs "slice" $env) -}}{{- fail (printf "config-omp-auth: agents.omp.auth.env must be a list, got %s" (kindOf $env)) -}}{{- end -}}
{{- $names := list -}}
{{- $values := list -}}
{{- range $index, $entry := $env -}}
{{-   $where := printf "agents.omp.auth.env[%d]" $index -}}
{{-   if not (kindIs "map" $entry) -}}{{- fail (printf "config-omp-auth: %s must be a map, got %s" $where (kindOf $entry)) -}}{{- end -}}
{{-   if not (hasKey $entry "variable") -}}{{- fail (printf "config-omp-auth: %s is missing the `variable` field" $where) -}}{{- end -}}
{{-   if not (kindIs "string" $entry.variable) -}}{{- fail (printf "config-omp-auth: %s field `variable` must be a string, got %s" $where (kindOf $entry.variable)) -}}{{- end -}}
{{-   if not (has $entry.variable $required) -}}{{- fail (printf "config-omp-auth: %s declares unsupported variable %q; the closed set is %s" $where $entry.variable (join ", " $required)) -}}{{- end -}}
{{-   if has $entry.variable $names -}}{{- fail (printf "config-omp-auth: %s duplicates variable %q" $where $entry.variable) -}}{{- end -}}
{{-   if not (hasKey $entry "key") -}}{{- fail (printf "config-omp-auth: %s is missing the `key` field" $where) -}}{{- end -}}
{{-   $resolved := includeTemplate "resolve-op-refs-json.tmpl" (dict "value" $entry.key "ctx" $) | fromJson -}}
{{-   if not (kindIs "string" $resolved) -}}{{- fail (printf "config-omp-auth: %s field `key` must resolve to a string" $where) -}}{{- end -}}
{{-   if eq $resolved "" -}}{{- fail (printf "config-omp-auth: %s resolved to an empty value" $where) -}}{{- end -}}
{{-   $names = append $names $entry.variable -}}
{{-   $values = append $values ($resolved | b64enc) -}}
{{- end -}}
{{- range $want := $required -}}
{{-   if not (has $want $names) -}}{{- fail (printf "config-omp-auth: agents.omp.auth.env must declare %s" $want) -}}{{- end -}}
{{- end -}}
# This script retries on every apply because its rendered secrets are not a safe
# onchange fingerprint input.
# Reconciles omp's managed environment credentials in its live-written dotenv
# file. The declared set is closed (see .chezmoidata/agents.yaml), so this script
# can never be steered into writing an arbitrary variable. Unrelated valid dotenv
# entries remain byte-identical. No backup is created.
$ErrorActionPreference = 'Stop'

$auth = if ($env:OMP_AGENT_ENV) {
  $env:OMP_AGENT_ENV
} else {
  Join-Path $HOME '.omp/agent/.env'
}
$authDir = Split-Path -Parent $auth
$managedNames = @({{ range $names }}{{ . | quote }}, {{ end }}$null) | Where-Object { $null -ne $_ }
$managedValuesB64 = @({{ range $values }}{{ . | quote }}, {{ end }}$null) | Where-Object { $null -ne $_ }

if (Test-Path -LiteralPath $auth) {
  $item = Get-Item -Force -LiteralPath $auth
  if ($item.LinkType -or -not ($item -is [IO.FileInfo])) {
    throw "config-omp-auth: unsafe target: $auth"
  }
}

[IO.Directory]::CreateDirectory($authDir) | Out-Null
$dirItem = Get-Item -Force -LiteralPath $authDir
if ($dirItem.LinkType -or -not ($dirItem -is [IO.DirectoryInfo])) {
  throw "config-omp-auth: unsafe auth directory: $authDir"
}

$lines = if (Test-Path -LiteralPath $auth) {
  [IO.File]::ReadAllLines($auth)
} else {
  @()
}
$preserved = [Collections.Generic.List[string]]::new()
foreach ($line in $lines) {
  if ($line -match '^\s*$' -or $line -match '^\s*#') {
    $preserved.Add($line)
    continue
  }
  if ($line -match '^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=') {
    if ($managedNames -notcontains $Matches[1]) {
      $preserved.Add($line)
    }
    continue
  }
  throw "config-omp-auth: refusing malformed dotenv line in $auth"
}

for ($index = 0; $index -lt $managedNames.Count; $index++) {
  $managedValue = [Text.Encoding]::UTF8.GetString(
    [Convert]::FromBase64String($managedValuesB64[$index])
  )
  $escaped = $managedValue.Replace('\', '\\').Replace('"', '\"').Replace("`r", '\r').Replace("`n", '\n')
  $preserved.Add("$($managedNames[$index])=`"$escaped`"")
}
$contents = [string]::Join([Environment]::NewLine, $preserved) + [Environment]::NewLine
$temporary = Join-Path $authDir ('.env.' + [Guid]::NewGuid().ToString('N') + '.tmp')
try {
  $encoding = [Text.UTF8Encoding]::new($false)
  $stream = [IO.File]::Open($temporary, [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
  try {
    $writer = [IO.StreamWriter]::new($stream, $encoding)
    try {
      $writer.Write($contents)
      $writer.Flush()
      $stream.Flush($true)
    } finally {
      $writer.Dispose()
    }
  } finally {
    $stream.Dispose()
  }
  Move-Item -Force -LiteralPath $temporary -Destination $auth
} finally {
  Remove-Item -Force -ErrorAction SilentlyContinue -LiteralPath $temporary
}
Write-Host "config-omp-auth: reconciled $($managedNames -join ' ') in $auth"
{{ end -}}
