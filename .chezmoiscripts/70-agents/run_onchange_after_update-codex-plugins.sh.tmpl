{{- $ctx := . -}}
{{- $sourceDir := .chezmoi.sourceDir -}}
{{- /* The dotfiles-codex-plugin tree, the everyone payload body, and the hook
       declaration partial are dependencies, not just targets: Codex serves the
       COPY under ~/.codex/plugins/cache/<marketplace>/<plugin>/<version>, so an
       edit only reaches a session if this script re-runs and re-adds. Two of
       those three sit outside the tree glob — the payload body because the hook
       binary embeds it from .chezmoitemplates, and the declaration because
       hooks/hooks.json.tmpl is a one-line includeTemplate wrapper whose own
       source never changes. Both are listed for that reason. The plugin's
       version is derived from the same inputs so the re-add resolves a new cache
       directory; both halves are required. */ -}}
{{- $fingerprintInputs := list ".chezmoidata/agents.yaml" ".chezmoidata/releases.json" "dot_local/share/dotfiles-codex-plugin/**" ".chezmoitemplates/orchestration-everyone.tmpl" ".chezmoitemplates/codex-hook-declaration.tmpl" -}}
{{- $personal := includeTemplate "codex-personal-marketplace.tmpl" (dict "ctx" . "caller" "update-codex-plugins") -}}
{{- $rows := includeTemplate "agent-plugin-rows.tmpl" (dict "ctx" $ctx "harness" "codex" "field" "plugins") -}}
{{- $removedRows := includeTemplate "agent-plugin-rows.tmpl" (dict "ctx" $ctx "harness" "codex" "field" "pluginsRemoved") -}}
#!/usr/bin/env bash
# Reconciles every eligible agents.codex.plugins row into Codex.
#
# Codex discovers the chezmoi-owned personal marketplace at
# ~/.agents/plugins/marketplace.json without registration. Each entry points at
# ./<registry key>, a symlink beside the manifest whose target is the pinned
# archive, so a version bump moves the symlink and this script only has to
# (re)assert the install. Codex records the installed set in ~/.codex/config.toml.
#
# The whole eligible set is a render-time constant, so an empty set renders a
# notice and no loop at all rather than a runtime branch over an empty array.
set -euo pipefail

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/sbin:"*) ;;
  *) PATH="$HOME/.local/sbin:$PATH" ;;
esac
export PATH
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" $fingerprintInputs) }}
{{- if and (eq $rows "") (eq $removedRows "") }}
printf 'update-codex-plugins: %s\n' 'no eligible plugins or removals are declared for this host'
{{- else }}
PERSONAL_MARKETPLACE={{ $personal | quote }}
MARKETPLACE_ROOT="$HOME/.agents/plugins"
{{- if ne $rows "" }}

PLUGINS=(
{{ $rows }}
)
{{- end }}
{{- if ne $removedRows "" }}
PLUGINS_REMOVED=(
{{ $removedRows }}
)
{{- end }}

die() { printf 'update-codex-plugins: %s\n' "$*" >&2; exit 1; }

[[ -n ${HOME:-} && -d $HOME ]] || die 'preflight: HOME is not a directory'
command -v codex >/dev/null 2>&1 || die 'preflight: codex is not on PATH'
[[ -f $MARKETPLACE_ROOT/marketplace.json ]] ||
  die "preflight: personal marketplace manifest is missing: $MARKETPLACE_ROOT/marketplace.json"

{{- if ne $removedRows "" }}

# Removals run first and stay best-effort: removing a plugin that is already
# gone is the converged state this loop wants.
for row in "${PLUGINS_REMOVED[@]}"; do
  row=${row//\\t/$'\t'}
  IFS=$'\t' read -r name market <<<"$row"
  codex plugin remove "${name}@${PERSONAL_MARKETPLACE}" >/dev/null 2>&1 || true
done
{{- end }}
{{- if ne $rows "" }}

# Preflight every row before the first mutation: a half-applied set would leave
# Codex pointing at a marketplace entry it cannot read.
for row in "${PLUGINS[@]}"; do
  row=${row//\\t/$'\t'}
  IFS=$'\t' read -r name market kind source <<<"$row"
  [[ -d $source ]] || die "preflight: $kind marketplace $market is missing: $source"
  [[ -f $source/.codex-plugin/plugin.json ]] ||
    die "preflight: $kind marketplace $market has no Codex plugin manifest: $source/.codex-plugin/plugin.json"
  link="$MARKETPLACE_ROOT/$market"
  [[ -L $link ]] || die "preflight: personal marketplace entry is not a symlink: $link"
  [[ $(readlink "$link") == "$source" ]] ||
    die "preflight: personal marketplace entry $link does not point at $source"
done

for row in "${PLUGINS[@]}"; do
  row=${row//\\t/$'\t'}
  IFS=$'\t' read -r name market kind source <<<"$row"
  id="${name}@${PERSONAL_MARKETPLACE}"
  # `codex plugin add` is idempotent: re-adding an installed plugin succeeds.
  if ! add_output=$(codex plugin add "$id" 2>&1); then
    printf '%s\n' "$add_output" >&2
    die "plugin add failed for $id"
  fi
done
{{- end }}

{{- end }}
