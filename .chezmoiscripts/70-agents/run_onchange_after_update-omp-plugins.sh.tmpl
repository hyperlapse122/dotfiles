{{- $ctx := . -}}
{{- $os := .chezmoi.os -}}
{{- $home := .chezmoi.homeDir -}}
{{- $sourceDir := .chezmoi.sourceDir -}}
{{- $fingerprintInputs := list ".chezmoidata/agents.yaml" ".chezmoidata/releases.json" "dot_local/share/omp-plugins/dot_omp-plugin/marketplace.json.tmpl" -}}
{{- $ompVersion := trimPrefix "v" (includeTemplate "release-lock-ref.tmpl" (dict "ctx" $ctx "tool" "omp")) -}}
{{- $facts := includeTemplate "facts.tmpl" . | fromYaml -}}
{{- $marketplaces := .agents.marketplaces -}}
{{- $plugins := .agents.omp.plugins -}}
{{- $nameRe := "^[a-z0-9]([a-z0-9.-]{0,62}[a-z0-9])?$" -}}
{{- $validOS := .agents.validOS -}}
{{- $validKinds := list "localDir" "localArchive" -}}
{{- $validContainers := list "skip" "keep" -}}
{{- $validJetsons := list "skip" "keep" -}}
{{- $rows := list -}}
{{- $seen := dict -}}
{{- $survivingMarketplaces := dict -}}
{{- range $i, $plugin := $plugins -}}
{{-   $where := printf "agents.omp.plugins[%d]" $i -}}
{{-   if not (has (len $plugin) (list 2)) -}}{{ fail (printf "update-omp-plugins: %s must contain exactly {name, marketplace}" $where) }}{{- end -}}
{{-   if not (and (hasKey $plugin "name") (hasKey $plugin "marketplace")) -}}{{ fail (printf "update-omp-plugins: %s must contain exactly {name, marketplace}" $where) }}{{- end -}}
{{-   $name := printf "%v" (index $plugin "name") -}}
{{-   $market := printf "%v" (index $plugin "marketplace") -}}
{{-   if not (regexMatch $nameRe $name) -}}{{ fail (printf "update-omp-plugins: %s has invalid plugin name %q" $where $name) }}{{- end -}}
{{-   if not (regexMatch $nameRe $market) -}}{{ fail (printf "update-omp-plugins: %s has invalid marketplace name %q" $where $market) }}{{- end -}}
{{-   $id := printf "%s@%s" $name $market -}}
{{-   if hasKey $seen $id -}}{{ fail (printf "update-omp-plugins: duplicate OMP plugin %q" $id) }}{{- end -}}
{{-   $_ := set $seen $id true -}}
{{-   if not (hasKey $marketplaces $market) -}}{{ fail (printf "update-omp-plugins: %s references undefined marketplace %q" $where $market) }}{{- end -}}
{{-   $authority := index $marketplaces $market -}}
{{-   if not (hasKey $authority "kind") -}}{{ fail (printf "update-omp-plugins: marketplace %q is missing kind" $market) }}{{- end -}}
{{-   $kind := printf "%v" (index $authority "kind") -}}
{{-   if not (has $kind $validKinds) -}}{{ fail (printf "update-omp-plugins: marketplace %q has unsupported kind %q" $market $kind) }}{{- end -}}
{{-   if not (hasKey $authority "container") -}}{{ fail (printf "update-omp-plugins: marketplace %q is missing container" $market) }}{{- end -}}
{{-   $container := printf "%v" (index $authority "container") -}}
{{-   if not (has $container $validContainers) -}}{{ fail (printf "update-omp-plugins: marketplace %q has invalid container value %q" $market $container) }}{{- end -}}
{{-   $jetson := "keep" -}}
{{-   if hasKey $authority "jetson" -}}
{{-     $jetson = printf "%v" (index $authority "jetson") -}}
{{-     if not (has $jetson $validJetsons) -}}{{ fail (printf "update-omp-plugins: marketplace %q has invalid jetson value %q" $market $jetson) }}{{- end -}}
{{-   end -}}
{{-   if not (hasKey $authority "os") -}}{{ fail (printf "update-omp-plugins: marketplace %q is missing os" $market) }}{{- end -}}
{{-   $marketOS := list -}}
{{-   range $value := index $authority "os" -}}
{{-     $value = printf "%v" $value -}}
{{-     if not (has $value $validOS) -}}{{ fail (printf "update-omp-plugins: marketplace %q has invalid os %q" $market $value) }}{{- end -}}
{{-     $marketOS = append $marketOS $value -}}
{{-   end -}}
{{-   $source := "" -}}
{{-   if eq $kind "localDir" -}}
{{-     if not (hasKey $authority "path") -}}{{ fail (printf "update-omp-plugins: localDir marketplace %q is missing path" $market) }}{{- end -}}
{{-     $rel := printf "%v" (index $authority "path") -}}
{{-     if or (not (regexMatch "^[A-Za-z0-9_./-]+$" $rel)) (hasPrefix "/" $rel) (contains ".." $rel) -}}{{ fail (printf "update-omp-plugins: marketplace %q has unsafe relative path %q" $market $rel) }}{{- end -}}
{{-     $source = printf "%s/%s" $home $rel -}}
{{-   else -}}
{{-     $segment := includeTemplate "local-archive-ref.tmpl" (dict "ctx" $ctx "marketplace" $market "field" "segment") -}}
{{-     $rel := printf "%v" (index $authority "externalPath") -}}
{{-     $source = printf "%s/%s/%s" $home $rel $segment -}}
{{-   end -}}
{{-   $requiredExtensions := list -}}
{{-   $requiredSkills := list -}}
{{-   if hasKey $authority "requiredPaths" -}}
{{-     $requiredPaths := index $authority "requiredPaths" -}}
{{-     if not (kindIs "map" $requiredPaths) -}}{{ fail (printf "update-omp-plugins: marketplace %q requiredPaths must be a map, got %s" $market (kindOf $requiredPaths)) }}{{- end -}}
{{-     range $entryType, $paths := $requiredPaths -}}
{{-       if not (has $entryType (list "extensions" "skills")) -}}{{ fail (printf "update-omp-plugins: marketplace %q has unsupported requiredPaths type %q" $market $entryType) }}{{- end -}}
{{-       if not (kindIs "slice" $paths) -}}{{ fail (printf "update-omp-plugins: marketplace %q requiredPaths.%s must be a list, got %s" $market $entryType (kindOf $paths)) }}{{- end -}}
{{-       range $path := $paths -}}
{{-         if not (kindIs "string" $path) -}}{{ fail (printf "update-omp-plugins: marketplace %q requiredPaths.%s entries must be strings, got %s" $market $entryType (kindOf $path)) }}{{- end -}}
{{-         if or (not (regexMatch "^[A-Za-z0-9_./-]+$" $path)) (hasPrefix "/" $path) (contains ".." $path) -}}{{ fail (printf "update-omp-plugins: marketplace %q has unsafe requiredPaths.%s path %q" $market $entryType $path) }}{{- end -}}
{{-         if eq $entryType "extensions" -}}{{ $requiredExtensions = append $requiredExtensions $path }}{{- else -}}{{ $requiredSkills = append $requiredSkills $path }}{{- end -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   if or (contains "\t" $source) (contains "\n" $source) -}}{{ fail (printf "update-omp-plugins: %s resolves to unsafe path %q" $where $source) }}{{- end -}}
{{-   if and (has $os $marketOS) (not (and $facts.container (eq $container "skip"))) (not (and $facts.jetson (eq $jetson "skip"))) -}}
{{-     $rows = append $rows (printf "  %q" (printf "%s\t%s\t%s\t%s\t%s\t%s" $name $market $kind $source (join " " $requiredExtensions) (join " " $requiredSkills))) -}}
{{-     $_ := set $survivingMarketplaces $market true -}}
{{-   end -}}
{{- end -}}
{{- $pluginsRemoved := .agents.omp.pluginsRemoved -}}
{{- $removedRows := list -}}
{{- $removedSeen := dict -}}
{{- $removedMarketplaceRows := list -}}
{{- $removedMarketplaceSeen := dict -}}
{{- range $i, $plugin := $pluginsRemoved -}}
{{-   $where := printf "agents.omp.pluginsRemoved[%d]" $i -}}
{{-   if not (has (len $plugin) (list 2)) -}}{{ fail (printf "update-omp-plugins: %s must contain exactly {name, marketplace}" $where) }}{{- end -}}
{{-   if not (and (hasKey $plugin "name") (hasKey $plugin "marketplace")) -}}{{ fail (printf "update-omp-plugins: %s must contain exactly {name, marketplace}" $where) }}{{- end -}}
{{-   $name := printf "%v" (index $plugin "name") -}}
{{-   $market := printf "%v" (index $plugin "marketplace") -}}
{{-   if not (regexMatch $nameRe $name) -}}{{ fail (printf "update-omp-plugins: %s has invalid plugin name %q" $where $name) }}{{- end -}}
{{-   if not (regexMatch $nameRe $market) -}}{{ fail (printf "update-omp-plugins: %s has invalid marketplace name %q" $where $market) }}{{- end -}}
{{-   $id := printf "%s@%s" $name $market -}}
{{-   if hasKey $removedSeen $id -}}{{ fail (printf "update-omp-plugins: duplicate removed OMP plugin %q" $id) }}{{- end -}}
{{-   $_ := set $removedSeen $id true -}}
{{-   $removedRows = append $removedRows (printf "  %q" (printf "%s\t%s" $name $market)) -}}
{{-   if and (not (hasKey $marketplaces $market)) (not (hasKey $removedMarketplaceSeen $market)) -}}
{{-     $_ := set $removedMarketplaceSeen $market true -}}
{{-     $removedMarketplaceRows = append $removedMarketplaceRows (printf "  %q" $market) -}}
{{-   end -}}
{{- end -}}
#!/usr/bin/env bash
# Reconciles every eligible agents.omp.plugins row; haptic replacement is proof-gated.
set -euo pipefail

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/sbin:"*) ;;
  *) PATH="$HOME/.local/sbin:$PATH" ;;
esac
export PATH

if ! command -v bun >/dev/null 2>&1 && command -v mise >/dev/null 2>&1; then
  bun() { mise exec -- bun "$@"; }
fi
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" $fingerprintInputs) }}

readonly EXPECTED_OMP_VERSION='{{ $ompVersion }}'
PLUGINS=(
{{ join "\n" $rows }}
)
PLUGINS_REMOVED=(
{{ join "\n" $removedRows }}
)
MARKETPLACES_REMOVED=(
{{ join "\n" $removedMarketplaceRows }}
)

die() { printf 'update-omp-plugins: %s\n' "$*" >&2; exit 1; }

[[ -n ${HOME:-} && -d $HOME && -w $HOME ]] || die 'preflight: HOME is not writable'
command -v omp >/dev/null 2>&1 || die 'preflight: omp is not on PATH'
command -v bun >/dev/null 2>&1 || die 'preflight: bun loader/hash tool is not on PATH'
omp_version=$(omp --version 2>/dev/null) || die 'preflight: omp --version failed'
expected_omp_version_re=${EXPECTED_OMP_VERSION//./\\.}
[[ $omp_version =~ (^|[^[:digit:]])${expected_omp_version_re}([^[:digit:]-]|$) ]] ||
  die "preflight: expected omp ${EXPECTED_OMP_VERSION}, got ${omp_version}"
for parent in "$HOME/.omp" "$HOME/.omp/plugins" "$HOME/.omp/agent/extensions"; do
  if [[ -e $parent ]]; then
    [[ -d $parent && -w $parent ]] || die "preflight: user path is not writable: $parent"
  else
    ancestor=$parent
    while [[ ! -e $ancestor ]]; do ancestor=${ancestor%/*}; done
    [[ -d $ancestor && -w $ancestor ]] || die "preflight: cannot create user path below $ancestor"
  fi
done
if [[ ${#PLUGINS[@]} -eq 0 && ${#PLUGINS_REMOVED[@]} -eq 0 ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "update-omp-plugins" "site" "no-plugins-or-removals" "reason" "no eligible plugins or removals are declared") | trim | indent 2 }}
fi

mkdir -p "$HOME/.omp/agent/extensions" "$HOME/.omp/plugins" || die 'preflight: failed to create OMP user paths'

for row in "${PLUGINS_REMOVED[@]}"; do
  row=${row//\\t/$'\t'}
  IFS=$'\t' read -r name market <<<"$row"
  id="${name}@${market}"
  omp plugin uninstall --scope user "$id" >/dev/null 2>&1 || true
done
if [[ ${#MARKETPLACES_REMOVED[@]} -gt 0 ]]; then
  for market in "${MARKETPLACES_REMOVED[@]}"; do
    omp plugin marketplace remove "$market" >/dev/null 2>&1 || true
  done
fi

if [[ ${#PLUGINS[@]} -eq 0 ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "update-omp-plugins" "site" "no-eligible-plugins" "reason" "no eligible plugins remain after removals") | trim | indent 2 }}
fi

helper_root="${XDG_RUNTIME_DIR:-"$HOME/.cache"}/omp-haptic-reconcile"
mkdir -p -- "$helper_root" || die 'preflight: cannot create loader helper root'
chmod 0700 -- "$helper_root" || die 'preflight: cannot secure loader helper root'
helper=$(mktemp "$helper_root/validate.XXXXXX.ts") || die 'preflight: cannot create loader helper'
cat >"$helper" <<'BUN'
{{ includeTemplate "omp-plugin-reconcile-helper.ts.tmpl" . }}
BUN

for row in "${PLUGINS[@]}"; do
  row=${row//\\t/$'\t'}
  IFS=$'\t' read -r name market kind source required_extensions required_skills <<<"$row"
  if [[ $kind == localDir ]]; then
    [[ -f $source/.omp-plugin/marketplace.json ]] || die "preflight: marketplace manifest is missing: $source"
  else
    [[ -f $source/.claude-plugin/marketplace.json ]] || die "preflight: pinned marketplace is missing: $source"
    bun "$helper" marketplace "$source" "$market" "$name" >/dev/null ||
      die "preflight: marketplace manifest drift: $source"
  fi
  if [[ -n $required_extensions || -n $required_skills ]]; then
    for rel in $required_extensions $required_skills; do
      [[ -e $source/$rel ]] || die "preflight: required path is missing: $source/$rel"
    done
    bun "$helper" manifest "$source" "$required_extensions" "$required_skills" >/dev/null ||
      die "preflight: pi manifest drift: $source"
  fi
done

mkdir -p "$HOME/.omp/agent/extensions" "$HOME/.omp/plugins" || die 'preflight: failed to create OMP user paths'
for row in "${PLUGINS[@]}"; do
  row=${row//\\t/$'\t'}
  IFS=$'\t' read -r name market kind source _rest <<<"$row"
  id="${name}@${market}"
  omp plugin marketplace remove "$market" >/dev/null 2>&1 || true
  omp plugin marketplace add "$source" || die "marketplace add failed for $market"
  omp plugin install --scope user --force "$id" || die "plugin install failed for $id"
  omp plugin enable --scope user "$id" || die "plugin enable failed for $id"
done
