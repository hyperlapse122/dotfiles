{{ if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
{{- $ctx := . -}}
{{- $name := "compound-engineering-plugin" -}}
{{- $ceRef := includeTemplate "compound-engineering-ref.tmpl" $ctx -}}
{{- $ceAuthority := index .agents.marketplaces $name -}}
{{- $ceVersion := printf "v%s" (trimPrefix "compound-engineering-v" $ceRef) -}}
#!/usr/bin/env bash
# Reconciles omp's compound-engineering plugin from the neutral pinned archive.
set -euo pipefail

SOURCE="$HOME/{{ $ceAuthority.externalPath }}/{{ $ceVersion }}"
if ! command -v omp >/dev/null 2>&1; then
  printf '%s\n' 'update-omp-plugins: skipped (omp not on PATH)' >&2
  exit 0
fi
if [[ ! -f "$SOURCE/.claude-plugin/marketplace.json" ]]; then
  printf 'update-omp-plugins: pinned marketplace is missing: %s\n' "$SOURCE" >&2
  exit 1
fi

omp plugin marketplace add "$SOURCE"
omp plugin install --scope user 'compound-engineering@compound-engineering-plugin'
printf 'update-omp-plugins: reconciled compound-engineering from %s\n' "$SOURCE"
{{ end -}}
