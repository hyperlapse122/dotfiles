{{- $ctx := . -}}
{{- $name := "i-have-adhd" -}}
{{- $authority := index .agents.marketplaces $name -}}
{{- $segment := includeTemplate "local-archive-ref.tmpl" (dict "ctx" $ctx "marketplace" $name "field" "segment") -}}

#!/usr/bin/env bash
#
# Applies the managed omp-compatibility patch to the pinned i-have-adhd
# extension loader after every apply's file phase.
#
# Why: pinned omp v17.2.12 lacks sessionManager.buildContextEntries, so the
# upstream loader throws on every session start. The patch rewrites the single
# call site to a feature-detect form that prefers the native API once omp
# ships it and falls back to getBranch() until then (a bounded post-compaction
# re-injection gap, accepted). skills/ content is never touched: the ruleset
# stays byte-verbatim upstream.
#
# run_after_ (not run_onchange_): chezmoi converges the exact = true external
# from the cached archive on every apply, restoring the pristine loader
# underneath an unchanged lock, so the patch must be re-asserted after every
# file phase — the compound-engineering overlays provisioner is the same
# pattern. A no-op on an already-patched file costs one byte compare.
#
# Fail-closed three-way check on the call site: patched form present -> no-op;
# exact upstream form present -> substitute; anything else -> the pinned tree
# drifted from what this patch was written against, so fail and name the drift
# rather than guess.

set -euo pipefail

TREE="$HOME/{{ $authority.externalPath }}/{{ $segment }}"
TARGET="$TREE/extensions/i-have-adhd.ts"

# Nothing to patch until the file phase has extracted the tree; a tree that
# should exist but does not is the updater preflight's fail-closed job.
if [ ! -d "$TREE" ]; then
  exit 0
fi

UPSTREAM='for (const entry of ctx.sessionManager.buildContextEntries()) {'
PATCHED='for (const entry of (ctx.sessionManager.buildContextEntries?.() ?? ctx.sessionManager.getBranch())) {'

patched_count=0
upstream_count=0
if [ -f "$TARGET" ]; then
  patched_count=$(grep -cF -- "$PATCHED" "$TARGET" || true)
  upstream_count=$(grep -cF -- "$UPSTREAM" "$TARGET" || true)
fi

if [ "$patched_count" -eq 1 ] && [ "$upstream_count" -eq 0 ]; then
  exit 0
fi

if [ "$patched_count" -ne 0 ] || [ "$upstream_count" -ne 1 ]; then
  printf 'i-have-adhd patch: %s drifted (patched=%s upstream=%s); refresh the managed patch\n' \
    "$TARGET" "$patched_count" "$upstream_count" >&2
  exit 1
fi

TEMP="$TARGET.chezmoi-$$.tmp"
trap 'rm -f -- "$TEMP"' EXIT
cp -p -- "$TARGET" "$TEMP"
awk -v old="$UPSTREAM" -v new="$PATCHED" '
  { if ((i = index($0, old)) > 0) { $0 = substr($0, 1, i - 1) new substr($0, i + length(old)) } print }
' "$TARGET" > "$TEMP"
mv -f -- "$TEMP" "$TARGET"
