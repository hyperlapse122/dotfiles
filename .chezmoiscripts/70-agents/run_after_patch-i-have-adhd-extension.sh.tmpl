{{- $ctx := . -}}
{{- $name := "i-have-adhd" -}}
{{- $authority := index .agents.marketplaces $name -}}
{{- $segment := includeTemplate "local-archive-ref.tmpl" (dict "ctx" $ctx "marketplace" $name "field" "segment") -}}

#!/usr/bin/env bash
# OMP v17.2.12 has no buildContextEntries API.
# When available, the patched loader uses that API.
# Otherwise, it reads the model context rebuilt after compaction.
# It does not use durable branch history. Skill content stays upstream.
#
# The exact = true archive restores the pristine loader on every apply.
# This run_after_ script re-asserts the patch after the file phase.
#
# The script compares the complete function and fails closed.
# The patched form exits successfully. The exact upstream form is replaced.
# Every other form is actionable drift.

set -euo pipefail

TREE="$HOME/{{ $authority.externalPath }}/{{ $segment }}"
TARGET="$TREE/extensions/i-have-adhd.ts"

# The updater preflight owns a missing archive tree after the file phase.
if [ ! -d "$TREE" ]; then
  exit 0
fi

UPSTREAM=$(cat <<'EOF'
function rulesAreInContext(ctx: ExtensionContext): boolean {
  let active = false;

  for (const entry of ctx.sessionManager.buildContextEntries()) {
    if (entry.type !== "custom_message") continue;

    if (entry.customType === RULES_MESSAGE_TYPE) {
      active = true;
    } else if (entry.customType === DISABLED_MESSAGE_TYPE) {
      active = false;
    }
  }

  return active;
}
EOF
)
PATCHED=$(cat <<'EOF'
function rulesAreInContext(ctx: ExtensionContext): boolean {
  let active = false;
  const contextEntries =
    ctx.sessionManager.buildContextEntries?.() ??
    ctx.sessionManager.buildSessionContext().messages;

  for (const entry of contextEntries) {
    if (
      !("customType" in entry) ||
      ("type" in entry && entry.type !== "custom_message") ||
      ("role" in entry && entry.role !== "custom")
    ) {
      continue;
    }

    if (entry.customType === RULES_MESSAGE_TYPE) {
      active = true;
    } else if (entry.customType === DISABLED_MESSAGE_TYPE) {
      active = false;
    }
  }

  return active;
}
EOF
)
TEMP="$TARGET.chezmoi-$$.tmp"
trap 'rm -f -- "$TEMP"' EXIT

extract_rules_function() {
  awk '
    $0 == "function rulesAreInContext(ctx: ExtensionContext): boolean {" {
      extracting = 1
    }

    extracting {
      print
      depth += gsub(/\{/, "&") - gsub(/\}/, "&")
      if (depth == 0) exit
    }
  ' "$1"
}

if [ ! -f "$TARGET" ]; then
  printf 'i-have-adhd patch: %s is missing from the extracted tree\n' "$TARGET" >&2
  exit 1
fi

current=$(extract_rules_function "$TARGET")
if [ "$current" = "$PATCHED" ]; then
  exit 0
fi

if [ "$current" != "$UPSTREAM" ]; then
  printf 'i-have-adhd patch: %s drifted; refresh the managed patch\n' "$TARGET" >&2
  exit 1
fi

cp -p -- "$TARGET" "$TEMP"
awk -v replacement="$PATCHED" '
  !replaced && $0 == "function rulesAreInContext(ctx: ExtensionContext): boolean {" {
    replaced = 1
    replacing = 1
    print replacement
  }

  replacing {
    depth += gsub(/\{/, "&") - gsub(/\}/, "&")
    if (depth == 0) replacing = 0
    next
  }

  { print }

' "$TARGET" >"$TEMP"
mv -f -- "$TEMP" "$TARGET"
