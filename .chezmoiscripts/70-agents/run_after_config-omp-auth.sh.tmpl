{{- $env := .agents.omp.auth.env -}}
{{- $allowed := list "OPENROUTER_API_KEY" "EXA_API_KEY" -}}
{{- if not (kindIs "slice" $env) -}}{{- fail (printf "config-omp-auth: agents.omp.auth.env must be a list, got %s" (kindOf $env)) -}}{{- end -}}
{{- $names := list -}}
{{- $values := list -}}
{{- range $index, $entry := $env -}}
{{-   $where := printf "agents.omp.auth.env[%d]" $index -}}
{{-   if not (kindIs "map" $entry) -}}{{- fail (printf "config-omp-auth: %s must be a map, got %s" $where (kindOf $entry)) -}}{{- end -}}
{{-   if not (hasKey $entry "variable") -}}{{- fail (printf "config-omp-auth: %s is missing the `variable` field" $where) -}}{{- end -}}
{{-   if not (kindIs "string" $entry.variable) -}}{{- fail (printf "config-omp-auth: %s field `variable` must be a string, got %s" $where (kindOf $entry.variable)) -}}{{- end -}}
{{-   if not (has $entry.variable $allowed) -}}{{- fail (printf "config-omp-auth: %s declares unsupported variable %q; the closed set is %s" $where $entry.variable (join ", " $allowed)) -}}{{- end -}}
{{-   if has $entry.variable $names -}}{{- fail (printf "config-omp-auth: %s duplicates variable %q" $where $entry.variable) -}}{{- end -}}
{{-   if not (hasKey $entry "key") -}}{{- fail (printf "config-omp-auth: %s is missing the `key` field" $where) -}}{{- end -}}
{{-   $resolved := includeTemplate "resolve-op-refs-json.tmpl" (dict "value" $entry.key) | fromJson -}}
{{-   if not (kindIs "string" $resolved) -}}{{- fail (printf "config-omp-auth: %s field `key` must resolve to a string" $where) -}}{{- end -}}
{{-   if eq $resolved "" -}}{{- fail (printf "config-omp-auth: %s resolved to an empty value" $where) -}}{{- end -}}
{{-   $names = append $names $entry.variable -}}
{{-   $values = append $values ($resolved | b64enc) -}}
{{- end -}}
#!/usr/bin/env bash
# This script retries on every apply because its rendered secrets are not a safe
# onchange fingerprint input.
# Reconciles omp's managed environment credentials in its live-written dotenv
# file. The declared set is closed (see .chezmoidata/agents.yaml), so this script
# can never be steered into writing an arbitrary variable. Unrelated valid dotenv
# entries remain byte-identical. Managed duplicates are replaced by one safely
# quoted value. No credential backup is created.
set -euo pipefail

AUTH="${OMP_AGENT_ENV:-$HOME/.omp/agent/.env}"
AUTH_DIR=$(dirname "$AUTH")
KNOWN_MANAGED_NAMES=({{ range $allowed }}{{ . | quote }} {{ end }})
MANAGED_NAMES=({{ range $names }}{{ . | quote }} {{ end }})
MANAGED_VALUES_B64=({{ range $values }}{{ . | quote }} {{ end }})

if [[ -L "$AUTH" ]] || { [[ -e "$AUTH" ]] && [[ ! -f "$AUTH" ]]; }; then
  printf 'config-omp-auth: unsafe target: %s\n' "$AUTH" >&2
  exit 1
fi

mkdir -p "$AUTH_DIR"
if [[ -L "$AUTH_DIR" ]] || [[ ! -d "$AUTH_DIR" ]]; then
  printf 'config-omp-auth: unsafe auth directory: %s\n' "$AUTH_DIR" >&2
  exit 1
fi

decode_base64() {
  if printf '%s' "$1" | base64 --decode 2>/dev/null; then
    return
  fi
  printf '%s' "$1" | base64 -D
}

dotenv_quote() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\r'/\\r}
  value=${value//$'\n'/\\n}
  printf '"%s"' "$value"
}

is_managed() {
  local candidate=$1 name
  for name in "${KNOWN_MANAGED_NAMES[@]}"; do
    if [[ $name == "$candidate" ]]; then
      return 0
    fi
  done
  return 1
}

tmp=$(mktemp "$AUTH_DIR/.env.XXXXXX")
cleanup() {
  rm -f -- "$tmp"
}
trap cleanup EXIT HUP INT TERM
chmod 0600 "$tmp"

if [[ -f "$AUTH" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*$ ]] || [[ "$line" =~ ^[[:space:]]*# ]]; then
      printf '%s\n' "$line" >>"$tmp"
      continue
    fi
    if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)= ]]; then
      is_managed "${BASH_REMATCH[2]}" || printf '%s\n' "$line" >>"$tmp"
      continue
    fi
    printf 'config-omp-auth: refusing malformed dotenv line in %s\n' "$AUTH" >&2
    exit 1
  done <"$AUTH"
fi

for index in "${!MANAGED_NAMES[@]}"; do
  managed_value=$(decode_base64 "${MANAGED_VALUES_B64[$index]}")
  printf '%s=%s\n' "${MANAGED_NAMES[$index]}" "$(dotenv_quote "$managed_value")" >>"$tmp"
done
chmod 0600 "$tmp"
# run_after_ by contract, so publishing unconditionally rewrote a byte-identical
# credential file on every apply. The mode is still narrowed on the skip path: a
# converged file someone widened is drift, not convergence.
if [[ -f "$AUTH" ]] && cmp -s -- "$tmp" "$AUTH"; then
  chmod 0600 -- "$AUTH"
  rm -f -- "$tmp"
  trap - EXIT HUP INT TERM
  exit 0
fi
mv -f -- "$tmp" "$AUTH"
trap - EXIT HUP INT TERM
if [[ ${#MANAGED_NAMES[@]} -eq 0 ]]; then
  printf 'config-omp-auth: reconciled 0 variables in %s\n' "$AUTH"
else
  printf 'config-omp-auth: reconciled %s in %s\n' "${MANAGED_NAMES[*]}" "$AUTH"
fi
