{{- $ctx := . -}}
{{- $collection := index .agents.skills.collections "figma" -}}
{{- range $field := list "lockKey" "stagingPath" "ownershipStatePath" -}}
{{-   if not (hasKey $collection $field) -}}{{ fail (printf "install-figma-skills: collection is missing %s" $field) }}{{- end -}}
{{- end -}}
{{- $skillsJson := includeTemplate "release-lock-ref.tmpl" (dict "ctx" $ctx "tool" $collection.lockKey "field" "skillsJson") -}}
#!/usr/bin/env bash
# Transactionally reconciles the locked official Figma skill collection.
set -Eeuo pipefail

readonly SCHEMA='figma-skills-ownership/v1'
readonly DESIRED_SKILLS_JSON='{{ $skillsJson }}'
readonly DEFAULT_STAGE="$HOME/{{ $collection.stagingPath }}"
readonly DEFAULT_ROOT="$HOME/.agents/skills"
readonly DEFAULT_OWNERSHIP="$HOME/{{ $collection.ownershipStatePath }}"
stage=${FIGMA_SKILLS_STAGE:-$DEFAULT_STAGE}
root=${FIGMA_SKILLS_ROOT:-$DEFAULT_ROOT}
ownership=${FIGMA_SKILLS_OWNERSHIP:-$DEFAULT_OWNERSHIP}
journal="$ownership.journal"
lock="$ownership.lock"
lock_held=false
lock_token=
active=false
simulate_crash=false
txn=
txn_id=
touched_json='[]'
txn_phase=

die() { printf 'install-figma-skills: %s\n' "$*" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || die 'preflight: jq is required'

safe_name() { [[ $1 =~ ^figma-[a-z0-9]+(-[a-z0-9]+)*$ ]]; }
assert_no_symlink_components() {
  local path=$1 current=/ part
  IFS=/ read -r -a parts <<<"${path#/}"
  for part in "${parts[@]}"; do
    [[ -n $part ]] || continue
    current=${current%/}/$part
    [[ ! -L $current ]] || die "unsafe linked path component: $current"
  done
}
assert_tree() {
  local path=$1 label=$2 bad
  [[ -d $path && ! -L $path ]] || die "$label is not a real directory: $path"
  bad=$(find -P "$path" \( -type l -o \( ! -type f ! -type d \) \) -print -quit 2>/dev/null) || die "cannot inspect $label: $path"
  [[ -z $bad ]] || die "$label contains a link or unsupported entry: $bad"
}
atomic_json() {
  local path=$1 json=$2 temp="$1.tmp.$txn_id"
  printf '%s\n' "$json" >"$temp"
  sync
  mv -f -- "$temp" "$path"
  sync
}
write_journal() {
  local phase=$1 value
  value=$(jq -cn --arg schema "$SCHEMA" --arg transactionId "$txn_id" --arg phase "$phase" \
    --arg transactionDir "$txn" --argjson touched "$touched_json" \
    '{schema:$schema,transactionId:$transactionId,phase:$phase,transactionDir:$transactionDir,touched:$touched}')
  atomic_json "$journal" "$value"
  txn_phase=$phase
}
validate_manifest_file() {
  local path=$1
  jq -e --arg schema "$SCHEMA" '
    type=="object" and (keys|sort)==["schema","skills","transactionId"] and
    .schema==$schema and (.transactionId|type=="string" and length>0 and test("^[A-Za-z0-9._-]+$")) and
    (.skills|type=="array" and length>0 and .==sort and (length==(unique|length)) and
      all(.[]; type=="string" and test("^figma-[a-z0-9]+(-[a-z0-9]+)*$")))' "$path" >/dev/null 2>&1 ||
    die "invalid ownership manifest: $path"
}
validate_journal_file() {
  jq -e --arg schema "$SCHEMA" --arg root "$root/" '
    type=="object" and (keys|sort)==["phase","schema","touched","transactionDir","transactionId"] and
    .schema==$schema and (.transactionId|type=="string" and length>0 and test("^[A-Za-z0-9._-]+$")) and
    (.phase|IN("prepared","backed-up","installed","verified","committed")) and
    (.transactionDir|type=="string") and
    (.transactionDir == ($root + ".figma-skills-txn-" + .transactionId)) and
    (.touched|type=="array" and length>0 and .==sort and (length==(unique|length)) and
      all(.[]; type=="string" and test("^figma-[a-z0-9]+(-[a-z0-9]+)*$")))' "$journal" >/dev/null 2>&1 ||
    die "invalid transaction journal: $journal"
}
rollback_txn() {
  local name restore restored=0
  [[ -d $txn && ! -L $txn ]] || die "cannot roll back missing transaction directory: $txn"
  while IFS= read -r name; do
    restore="$txn/restore.$name"
    if [[ -d $txn/backups/$name && ! -L $txn/backups/$name ]]; then
      rm -rf -- "$restore"
      cp -pR -- "$txn/backups/$name" "$restore"
      rm -rf -- "${root:?}/${name:?}"
      mv -- "$restore" "$root/$name"
      restored=$((restored + 1))
      if [[ ${FIGMA_SKILLS_INJECT_FAILURE:-} == rollback-hard-crash && $restored -eq 1 ]]; then
        simulate_crash=true
        kill -KILL "$$"
      fi
    elif [[ $txn_phase != prepared ]]; then
      rm -rf -- "${root:?}/${name:?}"
    fi
  done < <(jq -r '.[]' <<<"$touched_json")
  if [[ -f $txn/ownership.before ]]; then
    cp -p -- "$txn/ownership.before" "$ownership.rollback.$txn_id"
    mv -f -- "$ownership.rollback.$txn_id" "$ownership"
  elif [[ -f $txn/ownership.absent ]]; then
    rm -f -- "$ownership"
  else
    die 'transaction lacks prior ownership evidence'
  fi
  rm -rf -- "$txn"
  rm -f -- "$journal"
}
recover() {
  local phase manifest_id=
  [[ -e $journal ]] || return 0
  [[ -f $journal && ! -L $journal ]] || die "unsafe transaction journal: $journal"
  validate_journal_file
  txn_id=$(jq -r '.transactionId' "$journal")
  phase=$(jq -r '.phase' "$journal")
  txn=$(jq -r '.transactionDir' "$journal")
  touched_json=$(jq -c '.touched' "$journal")
  txn_phase=$phase
  if [[ -f $ownership && ! -L $ownership ]]; then
    validate_manifest_file "$ownership"
    manifest_id=$(jq -r '.transactionId' "$ownership")
  fi
  if [[ $phase == committed || $manifest_id == "$txn_id" ]]; then
    rm -rf -- "$txn"
    rm -f -- "$journal"
  else
    rollback_txn
  fi
  txn='' txn_id='' txn_phase='' touched_json='[]'
}
lock_owner_is_live() {
  local directory=$1 pid expected_start token actual_start
  [[ -f $directory/owner && ! -L $directory/owner ]] || return 1
  {
    IFS= read -r pid
    IFS= read -r expected_start
    IFS= read -r token
  } <"$directory/owner" || return 1
  [[ $pid =~ ^[0-9]+$ && -n $expected_start && -n $token ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  actual_start=$(ps -p "$pid" -o lstart= 2>/dev/null) || return 1
  [[ $actual_start == "$expected_start" ]]
}
acquire_lock() {
  local owner_tmp stale marker attempts=0
  lock_token="$$.${RANDOM:-0}.$(date +%s)"
  while true; do
    set -- "$lock".reclaim.*
    marker=$1
    if [[ ! -e $lock && -e $marker ]]; then
      mv -- "$marker" "$lock" 2>/dev/null || true
      continue
    fi
    if mkdir -- "$lock" 2>/dev/null; then
      set -- "$lock".reclaim.*
      if [[ -e $1 ]]; then
        rm -rf -- "$lock"
        sleep .05
        continue
      fi
      owner_tmp="$lock/owner.tmp.$$"
      printf '%s\n%s\n%s\n' "$$" "$(ps -p $$ -o lstart=)" "$lock_token" >"$owner_tmp"
      mv -f -- "$owner_tmp" "$lock/owner"
      lock_held=true
      return
    fi
    [[ -d $lock && ! -L $lock ]] || die "unsafe reconciler lock: $lock"
    if lock_owner_is_live "$lock"; then die "another reconciler holds the root lock: $root"; fi
    if [[ ! -f $lock/owner && $attempts -lt 20 ]]; then
      attempts=$((attempts + 1))
      sleep .05
      continue
    fi
    attempts=0
    stale="$lock.reclaim.$$.$RANDOM"
    if mv -- "$lock" "$stale" 2>/dev/null; then
      if lock_owner_is_live "$stale"; then
        mv -- "$stale" "$lock" 2>/dev/null || die 'lost a live reconciler lock during stale-lock arbitration'
        die "another reconciler holds the root lock: $root"
      fi
      rm -rf -- "$stale"
    fi
  done
}
cleanup() {
  local status=$? owner_token=
  trap - EXIT ERR INT TERM
  if [[ $active == true && $simulate_crash == false ]]; then
    if [[ $txn_phase == preparing ]]; then rm -rf -- "$txn"; rm -f -- "$journal"; else rollback_txn || status=$?; fi
  fi
  if [[ $lock_held == true && -f $lock/owner ]]; then
    owner_token=$(sed -n '3p' "$lock/owner")
    if [[ $owner_token == "$lock_token" ]]; then rm -rf -- "$lock"; fi
  fi
  exit "$status"
}
trap cleanup EXIT ERR INT TERM

# The state directory is private transaction metadata, never the live skill root.
assert_no_symlink_components "$stage"
assert_no_symlink_components "$root"
assert_no_symlink_components "$ownership"
mkdir -p -- "$(dirname -- "$ownership")"
[[ -d $(dirname -- "$ownership") && ! -L $(dirname -- "$ownership") ]] || die 'unsafe ownership state directory'
acquire_lock
if [[ -n ${FIGMA_SKILLS_HOLD_LOCK_SECONDS:-} ]]; then sleep "$FIGMA_SKILLS_HOLD_LOCK_SECONDS"; fi
recover

# Complete staging and destination preflight happens before live-root mutation.
assert_tree "$stage" 'staging root'
desired=()
while IFS= read -r name; do desired[${#desired[@]}]=$name; done < <(jq -er '.[] | select(type=="string")' <<<"$DESIRED_SKILLS_JSON")
((${#desired[@]} > 0)) || die 'locked inventory is empty'
[[ $(printf '%s\n' "${desired[@]}" | LC_ALL=C sort -u | jq -Rsc 'split("\n")[:-1]') == "$DESIRED_SKILLS_JSON" ]] || die 'locked inventory is unsafe, duplicate, or unsorted'
for name in "${desired[@]}"; do safe_name "$name" || die "unsafe desired name: $name"; done
staged=()
while IFS= read -r name; do staged[${#staged[@]}]=$name; done < <(find "$stage" -mindepth 1 -maxdepth 1 -exec basename {} \; | LC_ALL=C sort)
[[ $(printf '%s\n' "${staged[@]}" | jq -Rsc 'split("\n")[:-1]') == "$DESIRED_SKILLS_JSON" ]] || die 'staging direct children differ from locked inventory'
for name in "${desired[@]}"; do assert_tree "$stage/$name" "staged skill $name"; [[ -f $stage/$name/SKILL.md && ! -L $stage/$name/SKILL.md ]] || die "$name lacks a regular SKILL.md"; done
if [[ -e $root ]]; then
  [[ -d $root && ! -L $root ]] || die "unsafe skills root: $root"
  duplicate_case=$(find "$root" -mindepth 1 -maxdepth 1 -exec basename {} \; | LC_ALL=C sort -f | awk '{k=tolower($0); if (seen[k]++ && prior[k]!=$0) {print $0; exit} prior[k]=$0}')
  [[ -z $duplicate_case ]] || die "case-ambiguous destination child: $duplicate_case"
fi
prior_json='[]'
manifest_absent=true
if [[ -e $ownership ]]; then
  [[ -f $ownership && ! -L $ownership ]] || die "unsafe ownership manifest: $ownership"
  validate_manifest_file "$ownership"
  prior_json=$(jq -c '.skills' "$ownership")
  manifest_absent=false
else
  for name in "${desired[@]}"; do [[ ! -e $root/$name && ! -L $root/$name ]] || die 'ownership manifest is missing alongside managed-looking destinations'; done
fi
while IFS= read -r name; do safe_name "$name" || die "unsafe prior-owned name: $name"; done < <(jq -r '.[]' <<<"$prior_json")
touched_json=$(jq -cn --argjson prior "$prior_json" --argjson desired "$DESIRED_SKILLS_JSON" '$prior + $desired | unique | sort')
while IFS= read -r name; do
  if [[ -e $root/$name || -L $root/$name ]]; then [[ -d $root/$name && ! -L $root/$name ]] || die "unsafe destination path type: $root/$name"; assert_tree "$root/$name" "destination $name"; fi
done < <(jq -r '.[]' <<<"$touched_json")

# Matching valid state is a byte- and mtime-preserving no-op.
match=true
[[ $prior_json == "$DESIRED_SKILLS_JSON" ]] || match=false
if [[ $match == true ]]; then for name in "${desired[@]}"; do diff -qr -- "$stage/$name" "$root/$name" >/dev/null 2>&1 || { match=false; break; }; done; fi
if [[ $match == true ]]; then active=false; exit 0; fi

mkdir -p -- "$root"
[[ -d $root && ! -L $root ]] || die "unsafe skills root after creation: $root"
txn_id="$(date +%s).$$.${RANDOM:-0}"
txn="$root/.figma-skills-txn-$txn_id"
mkdir -- "$txn" "$txn/new" "$txn/backups"
chmod 0700 "$txn"
active=true
txn_phase=preparing
if [[ $manifest_absent == true ]]; then : >"$txn/ownership.absent"; else cp -p -- "$ownership" "$txn/ownership.before"; fi
for name in "${desired[@]}"; do cp -pR -- "$stage/$name" "$txn/new/$name"; done
write_journal prepared

while IFS= read -r name; do if [[ -d $root/$name && ! -L $root/$name ]]; then mv -- "$root/$name" "$txn/backups/$name"; fi; done < <(jq -r '.[]' <<<"$touched_json")
write_journal backed-up
count=0
for name in "${desired[@]}"; do
  mv -- "$txn/new/$name" "$root/$name"
  count=$((count + 1))
  if [[ ${FIGMA_SKILLS_INJECT_FAILURE:-} == after-first-replacement && $count -eq 1 ]]; then die 'injected failure after first replacement'; fi
  if [[ ${FIGMA_SKILLS_INJECT_FAILURE:-} == hard-crash-after-first-replacement && $count -eq 1 ]]; then
    simulate_crash=true
    kill -KILL "$$"
  fi
done
write_journal installed
if [[ ${FIGMA_SKILLS_INJECT_FAILURE:-} == pre-commit-crash ]]; then simulate_crash=true; exit 86; fi
for name in "${desired[@]}"; do diff -qr -- "$stage/$name" "$root/$name" >/dev/null || die "verification failed for $name"; done
write_journal verified
next_manifest=$(jq -cn --arg schema "$SCHEMA" --arg transactionId "$txn_id" --argjson skills "$DESIRED_SKILLS_JSON" '{schema:$schema,transactionId:$transactionId,skills:$skills}')
atomic_json "$ownership" "$next_manifest"
write_journal committed
if [[ ${FIGMA_SKILLS_INJECT_FAILURE:-} == post-commit-crash ]]; then simulate_crash=true; exit 87; fi
rm -rf -- "$txn"
rm -f -- "$journal"
active=false
