{{- $settings := .agents.codex.settings -}}
{{- includeTemplate "codex-settings-validate.tmpl" (dict "ctx" . "settings" $settings) -}}
{{- /* One declared object from two owners. agents.codex.settings owns scalar
   leaves: each dotted path is expanded into nested tables here, because the
   reconciler overlays a nested object, not dotted keys. agents.mcp.servers owns
   each declared mcp_servers.<name> table, mapped from the neutral inventory into
   Codex's shape -- no `type` discriminator (a ~/.mcp.json shape Codex does not
   use) and `http_headers`, not `headers`. op:// header values are resolved at
   render time exactly as private_readonly_dot_mcp.json.tmpl resolves them. */ -}}
{{- $declared := dict -}}
{{- range $path, $value := $settings -}}
{{-   $segments := splitList "." $path -}}
{{-   $last := sub (len $segments) 1 -}}
{{-   $node := $declared -}}
{{-   range $i, $segment := $segments -}}
{{-     if eq $i $last -}}
{{-       $_ := set $node $segment $value -}}
{{-     else -}}
{{-       if not (hasKey $node $segment) -}}{{- $_ := set $node $segment dict -}}{{- end -}}
{{-       $node = index $node $segment -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $servers := dict -}}
{{- range includeTemplate "agent-mcp-servers-json.tmpl" (dict "ctx" . "harness" "codex") | fromJson -}}
{{-   $entry := dict -}}
{{-   if eq .transport "stdio" -}}
{{-     $entry = set $entry "command" .command -}}
{{-     $entry = set $entry "args" .args -}}
{{-     if hasKey . "env" -}}
{{-       $entry = set $entry "env" .env -}}
{{-     end -}}
{{-   else -}}
{{-     $entry = set $entry "url" .url -}}
{{-     if hasKey . "headers" -}}
{{-       $entry = set $entry "http_headers" (includeTemplate "resolve-op-refs-json.tmpl" (dict "value" (get . "headers")) | fromJson) -}}
{{-     end -}}
{{-   end -}}
{{-   $servers = set $servers .name $entry -}}
{{- end -}}
{{- if gt (len $servers) 0 -}}
{{-   $declared = set $declared "mcp_servers" $servers -}}
{{- end -}}
{{- /* One hooks leaf, declared by this script rather than through
   agents.codex.settings — the same shape as mcp_servers above, and for the same
   reason: the settings key owns scalar leaves and codex-settings-validate.tmpl
   rejects every Codex-owned prefix there. The reconciler's recursive overlay
   changes only declared values, so Codex's own records under hooks.state (there
   were 8 on the authoring host) survive untouched.
   Without this record Codex never runs the hook this checkout ships, and the
   failure is silent. See .chezmoitemplates/codex-hook-trust.tmpl. */ -}}
{{- $hookTrust := includeTemplate "codex-hook-trust.tmpl" (dict "ctx" .) | fromJson -}}
{{- $declared = set $declared "hooks" $hookTrust -}}
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env bash
# Asserts the declared Codex config.toml content into the live ~/.codex/config.toml
# on every apply: the scalar leaves of agents.codex.settings and one
# mcp_servers.<name> table per codex-eligible server in agents.mcp.servers.
#
# config.toml is deliberately NOT a chezmoi target: Codex writes project trust
# decisions, hook state, plugin and marketplace records, and `codex mcp add`
# results into it during ordinary use. A managed-readonly target would fight all
# of those. run_after rather than run_onchange because a live vendor edit does not
# change a chezmoi source fingerprint, so an onchange script would not re-assert a
# declared value the tool overwrote until the DATA changed.
#
# Ownership split: agents.codex.settings owns scalar leaves; agents.mcp.servers
# owns each declared mcp_servers.<name> table; Codex owns projects, hooks, plugins,
# marketplaces, and every undeclared mcp_servers.* entry. The reconciler's
# recursive overlay changes only declared values, so a hand-added [mcp_servers.foo]
# and every [projects."..."] table survive; it re-serializes the whole file through
# smol-toml, so comments and hand formatting in config.toml are not preserved.
# Removing a server from the inventory,
# or removing a leaf from the declaration, stops the assertion but restores and
# prunes nothing. Codex-owned prefixes are rejected at render time by
# codex-settings-validate.tmpl, not merely avoided by convention.
#
# An orphaned reconciler temp file would hold resolved 1Password header values, so
# stale ones are removed before the write.
set -euo pipefail

{{ if eq (len $declared) 0 -}}
printf '%s\n' 'config-codex-settings: agents.codex.settings declares no leaf and no server is eligible for codex; nothing to assert.' >&2
exit 0
{{- else -}}
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
RECONCILER="${RECONCILER:-$HOME/.local/bin/settings-reconcile}"
if [[ ! -x "$RECONCILER" ]]; then
  printf '%s\n' 'config-codex-settings: settings-reconcile is unavailable; run chezmoi apply --force after fixing its build.' >&2
  exit 1
fi
contracts="$("$RECONCILER" contracts)"
[[ "$contracts" == *'"settings":"settings-reconcile/v1"'* ]] || {
  printf '%s\n' 'config-codex-settings: installed reconciler has an incompatible settings contract.' >&2
  exit 1
}
if [[ -d "$CODEX_HOME" ]]; then
  find "$CODEX_HOME" -maxdepth 1 -type f -name '.config.toml.*.tmp' -delete
fi
scratch="${XDG_RUNTIME_DIR:-$HOME/.cache}/chezmoi-codex-settings"
mkdir -p "$scratch"
chmod 0700 "$scratch"
config="$(mktemp "$scratch/config.XXXXXX.json")"
cleanup() { rm -f -- "$config"; }
trap cleanup EXIT
chmod 0600 "$config"
cat >"$config" <<'JSON'
{{ $declared | toPrettyJson | trim }}
JSON
"$RECONCILER" settings "$CODEX_HOME" config.toml "$config"
{{- end }}
{{- end }}
