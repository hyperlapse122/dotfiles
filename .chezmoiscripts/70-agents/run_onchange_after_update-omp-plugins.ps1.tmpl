{{ if eq .chezmoi.os "windows" -}}
{{- $ctx := . -}}{{- $os := .chezmoi.os -}}{{- $home := .chezmoi.homeDir -}}{{- $sourceDir := .chezmoi.sourceDir -}}
{{- $fingerprintInputs := list ".chezmoidata/agents.yaml" ".chezmoidata/haptic.yaml" ".chezmoidata/releases.json" "dot_local/share/omp-plugins/dot_omp-plugin/marketplace.json" "dot_local/share/omp-plugins/plugins/mxm4-haptic/package.json.tmpl" "packages/package.json" "packages/bun.lock" "packages/vite.config.ts" "packages/mxm4-haptic/package.json" "packages/mxm4-haptic/tsconfig.json" "packages/mxm4-haptic/vite.config.ts" "packages/mxm4-haptic/src/**" -}}
{{- $ompVersion := trimPrefix "v" (includeTemplate "release-lock-ref.tmpl" (dict "ctx" $ctx "tool" "omp")) -}}
{{- $facts := includeTemplate "facts.tmpl" . | fromYaml -}}{{- $marketplaces := .agents.marketplaces -}}{{- $plugins := .agents.omp.plugins -}}
{{- $nameRe := "^[a-z0-9]([a-z0-9.-]{0,62}[a-z0-9])?$" -}}{{- $validOS := list "linux" "darwin" "windows" -}}
{{- $ceRef := includeTemplate "compound-engineering-ref.tmpl" $ctx -}}{{- $ceVersion := printf "v%s" (trimPrefix "compound-engineering-v" $ceRef) -}}
{{- $rows := list -}}{{- $seen := dict -}}
{{- range $i, $plugin := $plugins -}}
{{- $where := printf "agents.omp.plugins[%d]" $i -}}
{{- if or (ne (len $plugin) 2) (not (and (hasKey $plugin "name") (hasKey $plugin "marketplace"))) -}}{{ fail (printf "update-omp-plugins: %s must contain exactly {name, marketplace}" $where) }}{{- end -}}
{{- $name := printf "%v" (index $plugin "name") -}}{{- $market := printf "%v" (index $plugin "marketplace") -}}
{{- if not (regexMatch $nameRe $name) -}}{{ fail (printf "update-omp-plugins: %s has invalid plugin name %q" $where $name) }}{{- end -}}
{{- if not (regexMatch $nameRe $market) -}}{{ fail (printf "update-omp-plugins: %s has invalid marketplace name %q" $where $market) }}{{- end -}}
{{- $id := printf "%s@%s" $name $market -}}{{- if hasKey $seen $id -}}{{ fail (printf "update-omp-plugins: duplicate OMP plugin %q" $id) }}{{- end -}}{{- $_ := set $seen $id true -}}
{{- if not (hasKey $marketplaces $market) -}}{{ fail (printf "update-omp-plugins: %s references undefined marketplace %q" $where $market) }}{{- end -}}
{{- $authority := index $marketplaces $market -}}
{{- range $field := list "kind" "container" "os" -}}{{- if not (hasKey $authority $field) -}}{{ fail (printf "update-omp-plugins: marketplace %q is missing %s" $market $field) }}{{- end -}}{{- end -}}
{{- $kind := printf "%v" (index $authority "kind") -}}{{- if not (has $kind (list "localDir" "localArchive")) -}}{{ fail (printf "update-omp-plugins: marketplace %q has unsupported kind %q" $market $kind) }}{{- end -}}
{{- $container := printf "%v" (index $authority "container") -}}{{- if not (has $container (list "skip" "keep")) -}}{{ fail (printf "update-omp-plugins: marketplace %q has invalid container %q" $market $container) }}{{- end -}}
{{- $marketOS := list -}}{{- range $value := index $authority "os" -}}{{- $value = printf "%v" $value -}}{{- if not (has $value $validOS) -}}{{ fail (printf "update-omp-plugins: marketplace %q has invalid os %q" $market $value) }}{{- end -}}{{- $marketOS = append $marketOS $value -}}{{- end -}}
{{- $source := "" -}}
{{- if eq $kind "localDir" -}}
{{- if not (hasKey $authority "path") -}}{{ fail (printf "update-omp-plugins: localDir marketplace %q is missing path" $market) }}{{- end -}}
{{- $rel := printf "%v" (index $authority "path") -}}{{- if or (not (regexMatch "^[A-Za-z0-9_./-]+$" $rel)) (hasPrefix "/" $rel) (contains ".." $rel) -}}{{ fail (printf "update-omp-plugins: marketplace %q has unsafe path %q" $market $rel) }}{{- end -}}
{{- $source = printf "%s/%s" $home $rel -}}
{{- else -}}
{{- if ne $market "compound-engineering-plugin" -}}{{ fail (printf "update-omp-plugins: localArchive marketplace %q has no supported authority" $market) }}{{- end -}}
{{- if not (hasKey $authority "externalPath") -}}{{ fail "update-omp-plugins: compound-engineering marketplace is missing externalPath" }}{{- end -}}
{{- $rel := printf "%v" (index $authority "externalPath") -}}{{- if or (not (regexMatch "^[A-Za-z0-9_./-]+$" $rel)) (hasPrefix "/" $rel) (contains ".." $rel) -}}{{ fail "update-omp-plugins: compound-engineering externalPath is unsafe" }}{{- end -}}
{{- $source = printf "%s/%s/%s" $home $rel $ceVersion -}}{{- end -}}
{{- $strict := eq $id "mxm4-haptic@h82-dotfiles" -}}{{- if and (eq $name "mxm4-haptic") (not $strict) -}}{{ fail "update-omp-plugins: mxm4-haptic must use marketplace h82-dotfiles" }}{{- end -}}
{{- if and $strict (ne $kind "localDir") -}}{{ fail "update-omp-plugins: h82-dotfiles must be localDir" }}{{- end -}}
{{- if and (or (has $os $marketOS) (and (eq $os "windows") (eq $market "compound-engineering-plugin"))) (not (and $facts.container (eq $container "skip"))) -}}{{- $rows = append $rows (dict "name" $name "market" $market "kind" $kind "source" $source "strict" $strict) -}}{{- end -}}
{{- end -}}
# Reconciles every eligible agents.omp.plugins row; haptic replacement is proof-gated.
$ErrorActionPreference = 'Stop'
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" $fingerprintInputs) }}
$expectedOmpVersion = '{{ $ompVersion }}'
$legacyExtension = Join-Path $HOME '.omp/agent/extensions/mxm4-haptic.ts'
$plugins = @(
{{- range $row := $rows }}
  [pscustomobject]@{ Name = '{{ $row.name }}'; Market = '{{ $row.market }}'; Kind = '{{ $row.kind }}'; Source = '{{ $row.source }}'; Strict = ${{ $row.strict }} }
{{- end }}
)
function Fail([string]$Message) { throw "update-omp-plugins: $Message" }
if (-not $HOME -or -not (Test-Path -LiteralPath $HOME -PathType Container)) { Fail 'preflight: HOME is not a directory' }
if (-not (Get-Command omp -ErrorAction SilentlyContinue)) { Fail 'preflight: omp is not on PATH' }
if (-not (Get-Command bun -ErrorAction SilentlyContinue)) { Fail 'preflight: bun loader/hash tool is not on PATH' }
$ompVersion = (& omp --version 2>$null | Out-String).Trim()
if ($LASTEXITCODE -ne 0 -or $ompVersion -notmatch "(^|[^\d])$([regex]::Escape($expectedOmpVersion))([^\d-]|$)") { Fail "preflight: expected omp $expectedOmpVersion, got $ompVersion" }
$ompRoot = Join-Path $HOME '.omp'
$pluginRoot = Join-Path $ompRoot 'plugins'
$extensionRoot = Split-Path -Parent $legacyExtension
foreach ($path in @($ompRoot, $pluginRoot, $extensionRoot)) {
  $existing = $path
  while (-not (Test-Path -LiteralPath $existing)) { $existing = Split-Path -Parent $existing }
  try {
    $probe = Join-Path $existing ('.omp-write-probe-' + [guid]::NewGuid().ToString('N'))
    [IO.File]::WriteAllText($probe, ''); Remove-Item -LiteralPath $probe -Force
  } catch { Fail "preflight: user path is not writable below $existing" }
}
if ($plugins.Count -eq 0) { Write-Host 'update-omp-plugins: no eligible plugins'; exit 0 }
$helper = Join-Path ([IO.Path]::GetTempPath()) ('omp-haptic-validate-' + [guid]::NewGuid().ToString('N') + '.ts')
$helperSource = @'
{{ includeTemplate "omp-plugin-reconcile-helper.ts.tmpl" . }}
'@
[IO.File]::WriteAllText($helper, $helperSource, [Text.UTF8Encoding]::new($false))
try {
  $strictSource = $null
  foreach ($plugin in $plugins) {
    $manifest = if ($plugin.Kind -eq 'localDir') { Join-Path $plugin.Source '.omp-plugin/marketplace.json' } else { Join-Path $plugin.Source '.claude-plugin/marketplace.json' }
    if (-not (Test-Path -LiteralPath $manifest -PathType Leaf)) { Fail "preflight: marketplace manifest is missing: $manifest" }
    if ($plugin.Strict) { & bun $helper pre $plugin.Source $ompRoot $legacyExtension | Out-Null; if ($LASTEXITCODE -ne 0) { Fail 'precheck: staged haptic validation failed' }; $strictSource = $plugin.Source }
  }
  New-Item -ItemType Directory -Force -Path $extensionRoot, $pluginRoot | Out-Null
  foreach ($plugin in $plugins) {
    $id = "$($plugin.Name)@$($plugin.Market)"
    & omp plugin marketplace remove $plugin.Market 2>$null
    $global:LASTEXITCODE = 0
    & omp plugin marketplace add $plugin.Source; if ($LASTEXITCODE -ne 0) { Fail "marketplace add failed for $($plugin.Market)" }
    & omp plugin install --scope user --force $id; if ($LASTEXITCODE -ne 0) { Fail "plugin install failed for $id" }
    & omp plugin enable --scope user $id; if ($LASTEXITCODE -ne 0) { Fail "plugin enable failed for $id" }
  }
  if ($strictSource) {
    & bun $helper post $strictSource $ompRoot $legacyExtension | Out-Null; if ($LASTEXITCODE -ne 0) { Fail 'postcheck: haptic replacement proof failed' }
    Remove-Item -LiteralPath $legacyExtension -Force -ErrorAction SilentlyContinue
    & bun $helper final $strictSource $ompRoot $legacyExtension | Out-Null; if ($LASTEXITCODE -ne 0) { Fail 'final postcheck: fresh haptic loader proof failed' }
  }
} finally { Remove-Item -LiteralPath $helper -Force -ErrorAction SilentlyContinue }
{{ end -}}
