{{- $ctx := . -}}
{{- $sourceDir := .chezmoi.sourceDir -}}
{{- $fingerprintInputs := list ".chezmoidata/agents.yaml" ".chezmoidata/releases.json" -}}
{{- $rows := includeTemplate "agent-plugin-rows.tmpl" (dict "ctx" $ctx "harness" "agy" "field" "plugins") -}}
{{- $removedRows := includeTemplate "agent-plugin-rows.tmpl" (dict "ctx" $ctx "harness" "agy" "field" "pluginsRemoved") -}}
#!/usr/bin/env bash
# Reconciles every eligible agents.agy.plugins row into the Antigravity CLI.
#
# agy has no marketplace registry: `agy plugin install <path>` takes an
# agent-plugins bundle directory — a root plugin.json plus the component trees
# beside it — and copies it into ~/.gemini/config/plugins/<name>. Identity is the
# plugin name alone, so uninstall/enable take <name> while the marketplace stays a
# source-resolution detail of agents.marketplaces.
#
# WHY A DIRECT INSTALL. Upstream ships the bundle manifest at the archive root,
# and its own .agy/plugin.json symlink (-> ../plugin.json) is upstream declaring
# that root manifest to be the agy bundle manifest. The marketplace source is
# therefore already the bundle, so it is installed as-is. This repository used to
# strip that manifest from the external, which forced a staged copy; nothing
# strips it now, so the preflight below fails closed if it is ever absent rather
# than installing a source nobody vouched for.
#
# The whole eligible set is a render-time constant, so an empty set renders a
# notice and no loop at all rather than a runtime branch over an empty array.
set -euo pipefail

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/sbin:"*) ;;
  *) PATH="$HOME/.local/sbin:$PATH" ;;
esac
export PATH
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" $fingerprintInputs) }}
{{- if and (eq $rows "") (eq $removedRows "") }}
printf 'update-agy-plugins: %s\n' 'no eligible plugins or removals are declared for this host'
{{- else -}}
{{- if ne $rows "" }}

PLUGINS=(
{{ $rows }}
)
BUNDLE_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/agy-plugin-bundles"
{{- end }}
{{- if ne $removedRows "" }}
PLUGINS_REMOVED=(
{{ $removedRows }}
)
{{- end }}

die() { printf 'update-agy-plugins: %s\n' "$*" >&2; exit 1; }

[[ -n ${HOME:-} && -d $HOME && -w $HOME ]] || die 'preflight: HOME is not writable'
command -v agy >/dev/null 2>&1 || die 'preflight: agy is not on PATH'
for parent in "$HOME/.gemini" "$HOME/.gemini/config"; do
  if [[ -e $parent ]]; then
    [[ -d $parent && -w $parent ]] || die "preflight: user path is not writable: $parent"
  else
    ancestor=$parent
    while [[ ! -e $ancestor ]]; do ancestor=${ancestor%/*}; done
    [[ -d $ancestor && -w $ancestor ]] || die "preflight: cannot create user path below $ancestor"
  fi
done
mkdir -p "$HOME/.gemini/config" || die 'preflight: failed to create Antigravity user paths'
{{- if ne $removedRows "" }}

# Removals run first. agy uninstall is already idempotent, so a failure here is a
# real one and is not swallowed.
for row in "${PLUGINS_REMOVED[@]}"; do
  row=${row//\\t/$'\t'}
  IFS=$'\t' read -r name market <<<"$row"
  agy plugin uninstall "$name" >/dev/null 2>&1 ||
    printf 'update-agy-plugins: uninstall of %s (declared removed from %s) reported an error; continuing\n' \
      "$name" "$market" >&2
done
{{- end }}
{{- if ne $rows "" }}

# Preflight every row before the first mutation, then migrate and install in a
# second pass: a half-applied set would leave agy pointed at neither the
# superseded staged bundle nor the marketplace source.
for row in "${PLUGINS[@]}"; do
  row=${row//\\t/$'\t'}
  IFS=$'\t' read -r name market kind source <<<"$row"
  [[ -d $source ]] || die "preflight: $kind marketplace $market is missing: $source"
  manifest="$source/plugin.json"
  [[ -f $manifest ]] ||
    die "preflight: $market has no bundle root plugin.json: $manifest"
  name_re=${name//./\\.}
  grep -Eq "\"name\"[[:space:]]*:[[:space:]]*\"${name_re}\"" "$manifest" ||
    die "preflight: $manifest does not declare plugin $name; $market is not a single-plugin bundle"
done

for row in "${PLUGINS[@]}"; do
  row=${row//\\t/$'\t'}
  IFS=$'\t' read -r name market kind source <<<"$row"
  # One-time migration off the staged bundle this repository used to build. Its
  # presence is the only signal that agy is still pointed at the old path, so the
  # uninstall runs once and the directory it removes makes the next run a no-op.
  stale="$BUNDLE_ROOT/$market/$name"
  if [[ -d $stale ]]; then
    agy plugin uninstall "$name" >/dev/null 2>&1 || true
    rm -rf -- "$stale" || die "cannot remove superseded staged bundle: $stale"
    rmdir -- "${stale%/*}" "$BUNDLE_ROOT" 2>/dev/null || true
  fi
  agy plugin install "$source" || die "plugin install failed for $name ($market)"
  agy plugin enable "$name" || die "plugin enable failed for $name"
done
{{- end }}
{{- end }}
