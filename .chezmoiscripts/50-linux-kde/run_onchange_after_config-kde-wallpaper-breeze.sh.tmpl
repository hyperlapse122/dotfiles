{{ if eq .chezmoi.os "linux" -}}
{{ $sessionBusPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "session-bus-present") -}}
{{ $graphicalSessionPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "graphical-session-present") -}}
{{ $plasmashellRunning := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "plasmashell-running") -}}
{{ $wallpaperToolPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "plasma-apply-wallpaperimage-present") -}}
#!/usr/bin/env bash
#
# Fedora KDE Spin. De-brands the desktop wallpaper to Plasma's default
# (kde.wallpaper.theme — `Next`, the upstream Breeze wallpaper) so the branded
# distro wallpaper seeded into the per-user Plasma config is replaced.
#
# The theme is DATA, not script: .chezmoidata/kde.yaml `kde.wallpaper` is the
# single source of truth (see its header) — edit the yaml, not this file. The
# highest-resolution-image pick and the once-only stamp stay here.
#
# TWO KINDS OF GATE, and the difference is the whole point of the fact registry:
#
#   * WHICH HOST IS THIS — the kde-guard include below (the `desktop` fact,
#     .chezmoidata/facts.yaml). This fact separates host identity from session
#     state: XDG_CURRENT_DESKTOP is a SESSION variable, so on a KDE host it also
#     answers "is a Plasma session running", conflating the two. The fact answers
#     only the host identity.
#   * IS A SESSION RUNNING RIGHT NOW — the D-Bus / display-server /
#     `pgrep plasmashell` checks below. These stay bash: they are runtime state,
#     not host identity, and plasma-apply-wallpaperimage genuinely needs all
#     three. Losing them by "simplifying into the guard" would make this script
#     try to talk to a Plasma that is not there.
#
# ONE-SHOT + user-respecting: the wallpaper is a per-user Plasma setting, so this
# applies the default exactly once (tracked by a per-user stamp) and then never
# touches it again -- if the user later picks their own wallpaper, we do NOT keep
# reverting it on every apply.
#
# Live-session preconditions below are DECLARED transient-blocking and paired
# with cached capability tokens in the comment-only fingerprint block.

{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list
      (dict "name" "session-bus-present" "value" $sessionBusPresent)
      (dict "name" "graphical-session-present" "value" $graphicalSessionPresent)
      (dict "name" "plasmashell-running" "value" $plasmashellRunning)
      (dict "name" "plasma-apply-wallpaperimage-present" "value" $wallpaperToolPresent))) }}
set -euo pipefail

WALLPAPER_THEME={{ .kde.wallpaper.theme | quote }}
STAMP="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/wallpaper-debranded"

{{ includeTemplate "kde-guard.sh.tmpl" (dict "ctx" . "name" "config-kde-wallpaper-breeze.sh") -}}

# Already de-branded once -> respect the user's current choice.
if [[ -f "$STAMP" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "done_here" "script" "config-kde-wallpaper-breeze" "site" "stamp-present" "reason" "the wallpaper migration stamp is already present") | trim | indent 2 }}
fi

# --- Live KDE session guards -------------------------------------------------
# Runtime state only — the host-is-KDE question is already answered by kde-guard.
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-wallpaper-breeze" "site" "no-session-bus" "direction" "transient-blocking" "probe" "session-bus-present" "reason" "no D-Bus session bus is available; wallpaper configuration is deferred") | trim | indent 2 }}
fi
if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-wallpaper-breeze" "site" "no-display-server" "direction" "transient-blocking" "probe" "graphical-session-present" "reason" "no graphical display server is available; wallpaper configuration is deferred") | trim | indent 2 }}
fi
if ! pgrep -xu "$USER" plasmashell >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-wallpaper-breeze" "site" "plasmashell-not-running" "direction" "transient-blocking" "probe" "plasmashell-running" "reason" "plasmashell is not running; wallpaper configuration is deferred") | trim | indent 2 }}
fi
if ! command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-wallpaper-breeze" "site" "wallpaper-tool-absent" "direction" "transient-blocking" "probe" "plasma-apply-wallpaperimage-present" "reason" "the Plasma wallpaper tool is not installed; wallpaper configuration is deferred") | trim | indent 2 }}
fi

# Resolve the wallpaper package's image, preferring the highest-resolution one it
# ships. Skip (do NOT stamp) if the package is absent, so a later apply retries
# once it is installed.
WALL_DIR="/usr/share/wallpapers/${WALLPAPER_THEME}/contents/images"
img="$(find "$WALL_DIR" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' \) 2>/dev/null | sort -V | tail -n1)"
if [[ -z "$img" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-wallpaper-breeze" "site" "wallpaper-image-absent" "direction" "harmless" "reason" "the configured wallpaper image is not installed") | trim | indent 2 }}
fi

plasma-apply-wallpaperimage "$img"
echo "wallpaper-breeze: desktop wallpaper set to $WALLPAPER_THEME ($img)"

# Stamp so we never override the user's later choice.
mkdir -p "$(dirname "$STAMP")"
: > "$STAMP"
{{ end -}}
