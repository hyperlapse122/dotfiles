{{ if eq .chezmoi.os "linux" -}}
{{ $kconfigPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "kwriteconfig6-present") -}}
{{ $userManagerBusPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "user-manager-bus-present") -}}
#!/usr/bin/env bash
#
# Configures KDE Plasma desktop integration for cloud drives and PIM accounts:
#   - Baloo file indexing exclusions for cloud drive mount paths
#   - Dolphin Places sidebar entries (user-places.xbel)
#   - Thumbnail generation limits for remote/cloud mounts
#   - Akonadi resource agent registration and mode reconciliation
#   - Service reconciliation for rclone mounts and DavMail bridge instances
#
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "globs" (list
      ".chezmoidata/cloud.yaml"
      "dot_config/rclone/modify_private_rclone.conf.tmpl"
      "dot_config/davmail/private_corporate.properties.tmpl"
      "dot_config/davmail/private_personal.properties.tmpl"
      "dot_config/systemd/user/rclone-mount@.service.tmpl"
      "dot_config/systemd/user/davmail@.service.tmpl"
      "dot_config/akonadi/**") "values" (list
      (dict "name" "kwriteconfig6-present" "value" $kconfigPresent)
      (dict "name" "user-manager-bus-present" "value" $userManagerBusPresent))) }}
set -euo pipefail

{{ includeTemplate "kde-guard.sh.tmpl" (dict "ctx" . "name" "config-kde-cloud.sh") -}}

cleanup_fuse_mounts() {
  local exit_code=$?
  if [[ $exit_code -ne 0 ]]; then
    printf 'config-kde-cloud.sh: error encountered (exit code %d), cleaning up FUSE mounts...\n' "$exit_code" >&2
    local -a mount_dirs=(
      "$HOME/Cloud/gdrive"
      "$HOME/Cloud/onedrive"
      "$HOME/Cloud/onedrive-corp"
    )
    local m
    for m in "${mount_dirs[@]}"; do
      if command -v fusermount3 >/dev/null 2>&1; then
        fusermount3 -u -z "$m" 2>/dev/null || true
      elif command -v fusermount >/dev/null 2>&1; then
        fusermount -u -z "$m" 2>/dev/null || true
      fi
    done
  fi
}
trap cleanup_fuse_mounts ERR

preflight_checks() {
  mkdir -p "$HOME/Cloud/gdrive" \
           "$HOME/Cloud/onedrive" \
           "$HOME/Cloud/onedrive-corp" \
           "$HOME/.local/state/davmail"

  chmod 0700 "$HOME/.local/state/davmail" 2>/dev/null || true
  if [[ -f "$HOME/.local/state/davmail/corporate-tokens.properties" ]]; then
    chmod 0600 "$HOME/.local/state/davmail/corporate-tokens.properties" 2>/dev/null || true
  fi
  if [[ -f "$HOME/.local/state/davmail/personal-tokens.properties" ]]; then
    chmod 0600 "$HOME/.local/state/davmail/personal-tokens.properties" 2>/dev/null || true
  fi
}

is_rclone_remote_configured() {
  local remote=$1
  local rclone_conf="$HOME/.config/rclone/rclone.conf"
  [[ -f "$rclone_conf" ]] || return 1
  awk -v target="[$remote]" '
    $0 == target { in_section=1; next }
    /^\[/ { in_section=0 }
    in_section && /^[[:space:]]*token[[:space:]]*=/ { found=1; exit 0 }
    END { exit (found ? 0 : 1) }
  ' "$rclone_conf"
}

reconcile_services() {
  printf '  reconciling cloud systemd user services...\n'
  if ! systemctl --user show-environment >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-cloud" "site" "no-user-manager-bus" "direction" "transient-blocking" "probe" "user-manager-bus-present" "reason" "the user manager bus is unavailable; cloud service reconciliation is deferred") | trim | indent 4 }}
  fi

  systemctl --user daemon-reload || true

  # Reconcile rclone mount services
  local -a rclone_remotes=("gdrive" "onedrive" "onedrive-corp")
  local remote unit
  for remote in "${rclone_remotes[@]}"; do
    unit="rclone-mount@${remote}.service"
    if is_rclone_remote_configured "$remote"; then
      if ! systemctl --user is-enabled --quiet "$unit" 2>/dev/null; then
        systemctl --user enable "$unit" >/dev/null 2>&1 || true
        printf '  enabled %s\n' "$unit"
      fi
      if ! systemctl --user is-active --quiet "$unit" 2>/dev/null; then
        systemctl --user start "$unit" >/dev/null 2>&1 || true
        printf '  started %s\n' "$unit"
      fi
    else
      if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
        systemctl --user stop "$unit" >/dev/null 2>&1 || true
        printf '  stopped unconfigured %s\n' "$unit"
      fi
      if systemctl --user is-enabled --quiet "$unit" 2>/dev/null; then
        systemctl --user disable "$unit" >/dev/null 2>&1 || true
        printf '  disabled unconfigured %s\n' "$unit"
      fi
    fi
  done

  # Reconcile DavMail bridge services
  local -a davmail_instances=(
    "corporate:{{ .cloud.accounts.corporateMs.mode }}"
    "personal:{{ .cloud.accounts.personalMs.mode }}"
  )
  local entry instance mode token_file
  for entry in "${davmail_instances[@]}"; do
    IFS=':' read -r instance mode <<<"$entry"
    unit="davmail@${instance}.service"
    token_file="$HOME/.local/state/davmail/${instance}-tokens.properties"

    if [[ "$mode" == "bridge" ]] && [[ -f "$token_file" ]]; then
      if ! systemctl --user is-enabled --quiet "$unit" 2>/dev/null; then
        systemctl --user enable "$unit" >/dev/null 2>&1 || true
        printf '  enabled %s\n' "$unit"
      fi
      if ! systemctl --user is-active --quiet "$unit" 2>/dev/null; then
        systemctl --user start "$unit" >/dev/null 2>&1 || true
        printf '  started %s\n' "$unit"
      fi
    else
      if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
        systemctl --user stop "$unit" >/dev/null 2>&1 || true
        printf '  stopped %s\n' "$unit"
      fi
      if systemctl --user is-enabled --quiet "$unit" 2>/dev/null; then
        systemctl --user disable "$unit" >/dev/null 2>&1 || true
        printf '  disabled %s\n' "$unit"
      fi
    fi
  done
}

merge_baloo_exclusions() {
  printf '  configuring Baloo file indexer exclusions for cloud drives...\n'
  if command -v kreadconfig6 >/dev/null 2>&1 && command -v kwriteconfig6 >/dev/null 2>&1; then
    local current
    current="$(kreadconfig6 --file baloofilerc --group General --key "exclude folders" 2>/dev/null || true)"

    # Target mount paths with trailing slashes
    local -a targets=(
      "$HOME/Cloud/gdrive/"
      "$HOME/Cloud/onedrive/"
      "$HOME/Cloud/onedrive-corp/"
    )

    # Build deduplicated array preserving order
    local -a merged=()
    local -A seen=()

    if [[ -n "$current" ]]; then
      local IFS=','
      local -a existing=()
      read -r -a existing <<<"$current"
      local p
      for p in "${existing[@]}"; do
        p="${p#"${p%%[![:space:]]*}"}" # trim leading
        p="${p%"${p##*[![:space:]]}"}" # trim trailing
        [[ -n "$p" ]] || continue
        if [[ -z "${seen["$p"]:-}" ]]; then
          merged+=("$p")
          seen["$p"]=1
        fi
      done
    fi

    local t
    for t in "${targets[@]}"; do
      if [[ -z "${seen["$t"]:-}" ]]; then
        merged+=("$t")
        seen["$t"]=1
      fi
    done

    local new_value
    new_value="$(IFS=','; printf '%s' "${merged[*]}")"

    if [[ "$new_value" != "$current" ]]; then
      kwriteconfig6 --file baloofilerc --group General --key "exclude folders" "$new_value"
      printf '  set [General] exclude folders = %s in baloofilerc\n' "$new_value"
    else
      printf '  baloo exclusions already up to date in baloofilerc\n'
    fi
  else
    printf '  kreadconfig6/kwriteconfig6 not found; skipping baloo exclusions\n' >&2
  fi
}

merge_dolphin_places() {
  printf '  configuring Dolphin Places bookmarks for cloud drives...\n'
  if command -v /usr/bin/python3 >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; then
    local py_bin
    py_bin="$(command -v /usr/bin/python3 || command -v python3)"

    "$py_bin" - "$HOME" <<'EOF'
import os
import shutil
import sys
import tempfile
import xml.etree.ElementTree as ET
from pathlib import Path

home_dir = sys.argv[1]
xbel_path = Path(home_dir) / ".local/share/user-places.xbel"

bookmarks = [
    ("Google Drive", f"file://{home_dir}/Cloud/gdrive", "folder-gdrive"),
    ("OneDrive Personal", f"file://{home_dir}/Cloud/onedrive", "folder-cloud"),
    ("OneDrive Corporate", f"file://{home_dir}/Cloud/onedrive-corp", "folder-cloud"),
]

ET.register_namespace('bookmark', 'http://www.freedesktop.org/standards/desktop-bookmarks')
ET.register_namespace('kdepriv', 'http://www.kde.org/kdepriv')
ET.register_namespace('mime', 'http://www.freedesktop.org/standards/shared-mime-info')

xbel_path.parent.mkdir(parents=True, exist_ok=True)

if xbel_path.exists():
    tree = ET.parse(xbel_path)
    root = tree.getroot()
else:
    root = ET.fromstring("""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xbel>
<xbel xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" xmlns:kdepriv="http://www.kde.org/kdepriv" xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info">
 <info>
  <metadata owner="http://www.kde.org">
   <kde_places_version>4</kde_places_version>
   <GroupState-Places-IsHidden>false</GroupState-Places-IsHidden>
   <GroupState-Remote-IsHidden>false</GroupState-Remote-IsHidden>
   <GroupState-Devices-IsHidden>false</GroupState-Devices-IsHidden>
   <GroupState-RemovableDevices-IsHidden>false</GroupState-RemovableDevices-IsHidden>
   <GroupState-Tags-IsHidden>false</GroupState-Tags-IsHidden>
   <withRecentlyUsed>true</withRecentlyUsed>
   <GroupState-RecentlySaved-IsHidden>false</GroupState-RecentlySaved-IsHidden>
   <withBaloo>true</withBaloo>
   <GroupState-SearchFor-IsHidden>false</GroupState-SearchFor-IsHidden>
  </metadata>
 </info>
</xbel>""")
    tree = ET.ElementTree(root)

existing_hrefs = {bm.get("href", "").rstrip("/") for bm in root.findall(".//bookmark") if bm.get("href")}

changed = False
for title, href, icon in bookmarks:
    if href.rstrip("/") not in existing_hrefs:
        bm = ET.Element("bookmark", {"href": href})
        t = ET.SubElement(bm, "title")
        t.text = title
        info = ET.SubElement(bm, "info")
        meta = ET.SubElement(info, "metadata", {"owner": "http://freedesktop.org"})
        ET.SubElement(meta, "{http://www.freedesktop.org/standards/desktop-bookmarks}icon", {"name": icon})
        root.append(bm)
        existing_hrefs.add(href.rstrip("/"))
        changed = True

if changed or not xbel_path.exists():
    if xbel_path.exists():
        shutil.copy2(xbel_path, f"{xbel_path}.bak")
    ET.indent(root, space=" ", level=0)
    xml_bytes = ET.tostring(root, encoding="utf-8", xml_declaration=True)
    if b"<!DOCTYPE xbel>" not in xml_bytes:
        lines = xml_bytes.split(b"\n", 1)
        if len(lines) == 2 and lines[0].startswith(b"<?xml"):
            xml_bytes = lines[0] + b"\n<!DOCTYPE xbel>\n" + lines[1]
    
    with tempfile.NamedTemporaryFile(dir=xbel_path.parent, mode="wb", delete=False) as tf:
        tf.write(xml_bytes)
        tf.flush()
        os.fsync(tf.fileno())
        temp_name = tf.name

    os.chmod(temp_name, 0o644)
    os.replace(temp_name, xbel_path)
    print(f"  merged cloud bookmarks into {xbel_path}")
else:
    print(f"  cloud bookmarks already present in {xbel_path}")
EOF
  else
    printf '  python3 not found; skipping dolphin places merge\n' >&2
  fi
}

configure_thumbnail_exclusions() {
  printf '  configuring thumbnail preview limits for remote mounts...\n'
  if command -v kwriteconfig6 >/dev/null 2>&1; then
    local current_limit
    current_limit="$(kreadconfig6 --file kdeglobals --group PreviewSettings --key MaximumRemoteSize 2>/dev/null || true)"
    if [[ "$current_limit" != "0" ]]; then
      kwriteconfig6 --file kdeglobals --group PreviewSettings --key MaximumRemoteSize 0
      printf '  set [PreviewSettings] MaximumRemoteSize = 0 in kdeglobals\n'
    else
      printf '  thumbnail limits already configured in kdeglobals\n'
    fi
  else
    printf '  kwriteconfig6 not found; skipping thumbnail settings\n' >&2
  fi
}

reconcile_akonadi_agents() {
  printf '  reconciling Akonadi PIM agent instances...\n'
  local akonadi_dir="$HOME/.config/akonadi"
  local agentsrc="$akonadi_dir/agentsrc"
  local state_dir="$HOME/.local/state/davmail"
  local archive_dir="$state_dir/archive"

  mkdir -p "$akonadi_dir" "$state_dir"

  # Re-assert mode 0600 on all Akonadi agent configs owned by this feature
  local -a agent_configs=(
    "$akonadi_dir/agent_config_akonadi_davgroupware_resource_corporate"
    "$akonadi_dir/agent_config_akonadi_davgroupware_resource_personal"
    "$akonadi_dir/agent_config_akonadi_ical_resource_corporate"
    "$akonadi_dir/agent_config_akonadi_ical_resource_personal"
  )
  local cfg
  for cfg in "${agent_configs[@]}"; do
    if [[ -f "$cfg" ]]; then
      chmod 0600 "$cfg" 2>/dev/null || true
    fi
  done

  reconcile_ms_account() {
    local name=$1
    local mode=$2
    local dav_id="akonadi_davgroupware_resource_${name}"
    local ical_id="akonadi_ical_resource_${name}"
    local token_file="$state_dir/${name}-tokens.properties"

    if [[ "$mode" == "bridge" ]]; then
      # In bridge mode: remove superseded ical resource first, then register DAV resource if tokens exist
      if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file "$agentsrc" --group Instances --key "$ical_id" --delete 2>/dev/null || true
        kwriteconfig6 --file "$agentsrc" --group "$ical_id" --key AgentType --delete 2>/dev/null || true
        kwriteconfig6 --file "$agentsrc" --group "$ical_id" --key Autostart --delete 2>/dev/null || true
        if [[ -f "$token_file" ]]; then
          kwriteconfig6 --file "$agentsrc" --group Instances --key "$dav_id" "akonadi_davgroupware_resource"
          kwriteconfig6 --file "$agentsrc" --group "$dav_id" --key AgentType "akonadi_davgroupware_resource"
          kwriteconfig6 --file "$agentsrc" --group "$dav_id" --key Autostart true
          printf '  registered %s in %s\n' "$dav_id" "$agentsrc"
        fi
      fi
    elif [[ "$mode" == "read-only" ]]; then
      # In read-only mode: warn, tear down DAV resource, archive token cache, provision ical resource
      if [[ -f "$token_file" ]]; then
        printf '  warning: %s Microsoft account configured in read-only mode; un-synced local changes will not sync\n' "$name" >&2
      fi
      if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file "$agentsrc" --group Instances --key "$dav_id" --delete 2>/dev/null || true
        kwriteconfig6 --file "$agentsrc" --group "$dav_id" --key AgentType --delete 2>/dev/null || true
        kwriteconfig6 --file "$agentsrc" --group "$dav_id" --key Autostart --delete 2>/dev/null || true
      fi
      if [[ -f "$token_file" ]]; then
        mkdir -p "$archive_dir"
        chmod 0700 "$archive_dir"
        mv -f "$token_file" "$archive_dir/${name}-tokens-retired-$(date +%Y%m%d%H%M%S).properties" 2>/dev/null || true
        printf '  archived retired %s DavMail token file\n' "$name"
      fi
      if command -v kwriteconfig6 >/dev/null 2>&1; then
        kwriteconfig6 --file "$agentsrc" --group Instances --key "$ical_id" "akonadi_ical_resource"
        kwriteconfig6 --file "$agentsrc" --group "$ical_id" --key AgentType "akonadi_ical_resource"
        kwriteconfig6 --file "$agentsrc" --group "$ical_id" --key Autostart true
        printf '  registered %s (read-only) in %s\n' "$ical_id" "$agentsrc"
      fi
    fi
  }

  reconcile_ms_account "corporate" "{{ .cloud.accounts.corporateMs.mode }}"
  reconcile_ms_account "personal" "{{ .cloud.accounts.personalMs.mode }}"
}
reconcile_desktop() {
  if ! command -v kwriteconfig6 >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-cloud" "site" "kwriteconfig6-absent" "direction" "transient-blocking" "probe" "kwriteconfig6-present" "reason" "kwriteconfig6 is not installed; KDE desktop configuration is deferred") | trim | indent 4 }}
  fi

  merge_baloo_exclusions
  merge_dolphin_places
  configure_thumbnail_exclusions
  reconcile_akonadi_agents
}

main() {
  printf 'config-kde-cloud.sh: configuring KDE desktop integration for cloud drives and PIM...\n'
  preflight_checks
  reconcile_desktop
  reconcile_services
}

main
{{ end -}}
