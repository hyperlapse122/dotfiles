{{ if eq .chezmoi.os "linux" -}}
{{ $sessionBusPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "session-bus-present") -}}
{{ $graphicalSessionPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "graphical-session-present") -}}
{{ $plasmashellRunning := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "plasmashell-running") -}}
{{ $colorschemeToolPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "plasma-apply-colorscheme-present") -}}
#!/usr/bin/env bash
#
# Fedora KDE Spin. Applies the Breeze Dark COLOUR SCHEME, which is the half of
# "always dark" that .chezmoidata/kde.yaml structurally cannot own.
#
# WHY THIS IS A SCRIPT AND NOT A MANIFEST ROW. kdeglobals [General] ColorScheme is
# only a LABEL the Colors KCM reads -- on a dark desktop that key is absent from
# ~/.config/kdeglobals altogether. What Plasma paints from is the EXPANDED
# [Colors:Button], [Colors:View], [Colors:Window], [Colors:Header],
# [Colors:Selection], [Colors:Tooltip], [Colors:Complementary],
# [ColorEffects:Disabled] and [ColorEffects:Inactive] groups in that same file.
# Those group names carry a colon, which config-kde-settings' group-segment
# allowlist rejects -- and which its colon-delimited row format could not carry even
# if the allowlist were widened. Applying them also needs a live Plasma session.
# A setting with a precondition stays its own script; that is exactly the rule
# .chezmoidata/kde.yaml's header states, and this is the standing example of the
# colour half of the theme.
#
# WHY plasma-apply-colorscheme AND NOT plasma-apply-lookandfeel. The look-and-feel
# tool also applies wallpaper, splash and cursor, so it would fight
# config-kde-wallpaper-breeze's deliberate once-only wallpaper stamp. This tool
# touches the colours only. It also drives kded's GTK sync, which a raw
# kwriteconfig6 write does not -- that is what keeps GTK applications dark
# alongside Plasma ones.
#
# NO STAMP, unlike the wallpaper script, and be precise about what that buys. The
# wallpaper script stamps itself so it never revisits a preference the user later
# changed. This script does not, so it re-asserts the dark scheme whenever it runs
# -- but `run_onchange_` means it runs only when its own rendered content changes
# (in practice: an edit here, or one of the four capability tokens flipping). It is
# NOT a per-apply enforcer, and a colour scheme the user changes afterwards stays
# changed until something re-triggers this script. Turning that into true
# enforcement would mean dropping _onchange for a run_after_ lifecycle; the
# idempotence check below is what would keep that cheap.
#
# ORDERING IS LOAD-BEARING AND THE FILENAME IS WHAT ENFORCES IT. chezmoi runs the
# scripts in a directory in lexicographic filename order, and "theme-dark" sorts
# after "settings" -- so AutomaticLookAndFeel is already false by the time the
# colours are applied. Applying them while the day/night switcher is still live
# invites it to overwrite them. A rename must keep this file sorting after
# config-kde-settings; check with `ls .chezmoiscripts/50-linux-kde | LC_ALL=C sort`
# rather than assuming, because the obvious name ("colorscheme-dark") sorts BEFORE
# settings and silently breaks the invariant.
#
# TWO KINDS OF GATE, the same split config-kde-wallpaper-breeze documents:
#
#   * WHICH HOST IS THIS — the kde-guard include below (the `desktop` fact).
#   * IS A SESSION RUNNING RIGHT NOW — the D-Bus / display-server /
#     `pgrep plasmashell` checks. These stay bash: they are runtime state, not host
#     identity, and plasma-apply-colorscheme genuinely needs all three.
#
# Live-session preconditions below are DECLARED transient-blocking and paired with
# cached capability tokens in the comment-only fingerprint block.

{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list
      (dict "name" "session-bus-present" "value" $sessionBusPresent)
      (dict "name" "graphical-session-present" "value" $graphicalSessionPresent)
      (dict "name" "plasmashell-running" "value" $plasmashellRunning)
      (dict "name" "plasma-apply-colorscheme-present" "value" $colorschemeToolPresent))) }}
set -euo pipefail

# The scheme name lives beside the tool that consumes it: one literal, and no row
# shape to invent in the manifest for a single value config-kde-settings could not
# apply anyway.
COLOR_SCHEME=BreezeDark

{{ includeTemplate "kde-guard.sh.tmpl" (dict "ctx" . "name" "config-kde-theme-dark.sh") -}}

# --- Live KDE session guards -------------------------------------------------
# Runtime state only — the host-is-KDE question is already answered by kde-guard.
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-theme-dark" "site" "no-session-bus" "direction" "transient-blocking" "probe" "session-bus-present" "reason" "no D-Bus session bus is available; the dark colour scheme is deferred") | trim | indent 2 }}
fi
if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-theme-dark" "site" "no-display-server" "direction" "transient-blocking" "probe" "graphical-session-present" "reason" "no graphical display server is available; the dark colour scheme is deferred") | trim | indent 2 }}
fi
if ! pgrep -xu "$USER" plasmashell >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-theme-dark" "site" "plasmashell-not-running" "direction" "transient-blocking" "probe" "plasmashell-running" "reason" "plasmashell is not running; the dark colour scheme is deferred") | trim | indent 2 }}
fi
if ! command -v plasma-apply-colorscheme >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-theme-dark" "site" "colorscheme-tool-absent" "direction" "transient-blocking" "probe" "plasma-apply-colorscheme-present" "reason" "the Plasma colour-scheme tool is not installed; the dark colour scheme is deferred") | trim | indent 2 }}
fi

# Idempotence without a stamp: compare what Plasma will actually PAINT.
#
# DO NOT "simplify" this back to reading [General] ColorScheme. That key is a
# LABEL, and kreadconfig6 resolves it through the KConfig cascade -- so
# ~/.config/kdedefaults/kdeglobals answers it even when the user file carries no
# such key at all (verified on Plasma 6.7.4: the label read returns BreezeDark
# from the defaults layer while ~/.config/kdeglobals has no ColorScheme key).
# A label-based guard therefore reports "already dark" whenever the defaults
# layer says so, including after a half-finished apply that wrote the label but
# not the colours -- and then it skips forever. An absolute --file path does not
# escape this; the cascade is applied either way.
#
# BackgroundNormal is one of the expanded values plasma-apply-colorscheme writes,
# so comparing it against the scheme file answers the question that matters: are
# the colours on screen already this scheme? An unreadable scheme file, a missing
# kreadconfig6, or a host with no colours yet leaves `want` empty or the two
# unequal, which correctly falls through to applying.
SCHEME_FILE="/usr/share/color-schemes/${COLOR_SCHEME}.colors"
want="$(kreadconfig6 --file "$SCHEME_FILE" --group 'Colors:Window' --key BackgroundNormal 2>/dev/null || true)"
have="$(kreadconfig6 --file kdeglobals --group 'Colors:Window' --key BackgroundNormal 2>/dev/null || true)"

if [[ -n "$want" && "$have" == "$want" ]]; then
  printf 'config-kde-theme-dark.sh: colour scheme is already %s\n' "$COLOR_SCHEME"
else
  # Deliberately unguarded under `set -e`: a failure here aborts this apply and
  # strands the later phases for this run, which is the correct trade. Swallowing
  # it would let chezmoi record an unconverged host as done, and no capability
  # probe exists that would force the retry.
  plasma-apply-colorscheme "$COLOR_SCHEME"
  printf 'config-kde-theme-dark.sh: colour scheme set to %s\n' "$COLOR_SCHEME"
fi
{{ end -}}
