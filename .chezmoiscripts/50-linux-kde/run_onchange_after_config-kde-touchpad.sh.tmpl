{{ if eq .chezmoi.os "linux" -}}
{{ $busctlPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "busctl-present") -}}
{{ $sessionBusPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "session-bus-present") -}}
{{ $plasmashellRunning := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "plasmashell-running") -}}
#!/usr/bin/env bash
#
# Configures libinput touchpads via KWin's org.kde.KWin.InputDeviceManager:
#   naturalScroll          -> kde.touchpad.settings.naturalScroll
#   tapToClick             -> kde.touchpad.settings.tapToClick (if supported)
#   clickMethodClickfinger -> kde.touchpad.settings.clickMethodClickfinger
#   clickMethodAreas       -> kde.touchpad.settings.clickMethodAreas
#
# The device allowlist and the four values are DATA, not script:
# .chezmoidata/kde.yaml `kde.touchpad` is the single source of truth (see its
# header) — edit the yaml, not this file. The D-Bus walk and every per-device
# supports* CAPABILITY PROBE stay here: a device that cannot do clickfinger is
# still skipped rather than forced, whatever the data says.
#
# A touchpad is selected by WHAT IT IS, not by a name somebody remembered to add:
# any device KWin reports `touchpad=true` for. TOUCHPAD_DENY_NAMES is the escape
# hatch for one the operator wants left alone.
#
# A TRACKPOINT CANNOT BE SELECTED THAT WAY. KWin exposes no property separating a
# TrackPoint from an ordinary mouse, so "a pointer that is not a touchpad" is
# every mouse on every desktop in the fleet -- which is what the first version of
# this rewrite did. TRACKPOINT_MATCH_NAMES is therefore a positive glob list from
# kde.trackpoint.matchDevices, and TRACKPOINT_DENY_NAMES still excludes a matched
# device the operator wants left alone.
#
# The previous model was an exact-name allowlist and it failed the way allowlists
# fail: an unlisted model matched nothing, four managed settings were never
# applied, and the only sign was one line saying the device was not in the list.
# Skips cleanly when busctl is missing or no Plasma session owns org.kde.KWin.
#
# Capability fingerprints pair each transient-blocking declaration below with
# the cached precondition it names. Comment-only; never executed.
{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list
      (dict "name" "busctl-present" "value" $busctlPresent)
      (dict "name" "session-bus-present" "value" $sessionBusPresent)
      (dict "name" "plasmashell-running" "value" $plasmashellRunning))) }}
set -euo pipefail

{{ includeTemplate "kde-guard.sh.tmpl" (dict "ctx" . "name" "config-kde-touchpad.sh") -}}

TOUCHPAD_DENY_NAMES=(
{{ range .kde.touchpad.denyDevices }}  {{ . | quote }}
{{ end -}}
)

TRACKPOINT_MATCH_NAMES=(
{{ range .kde.trackpoint.matchDevices }}  {{ . | quote }}
{{ end -}}
)

TRACKPOINT_DENY_NAMES=(
{{ range .kde.trackpoint.denyDevices }}  {{ . | quote }}
{{ end -}}
)

# busctl's `b` (boolean) property type takes the literal true/false tokens.
NATURAL_SCROLL={{ .kde.touchpad.settings.naturalScroll | ternary "true" "false" }}
TAP_TO_CLICK={{ .kde.touchpad.settings.tapToClick | ternary "true" "false" }}
CLICK_METHOD_CLICKFINGER={{ .kde.touchpad.settings.clickMethodClickfinger | ternary "true" "false" }}
CLICK_METHOD_AREAS={{ .kde.touchpad.settings.clickMethodAreas | ternary "true" "false" }}

TP_NATURAL_SCROLL={{ .kde.trackpoint.settings.naturalScroll | ternary "true" "false" }}
TP_MIDDLE_EMULATION={{ .kde.trackpoint.settings.middleEmulation | ternary "true" "false" }}
TP_SCROLL_ON_BUTTON_DOWN={{ .kde.trackpoint.settings.scrollOnButtonDown | ternary "true" "false" }}

configure_touchpad() {
  printf 'config-kde-touchpad.sh: configuring KDE touchpad(s)...\n'

  if ! command -v busctl >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-touchpad" "site" "busctl-absent" "direction" "transient-blocking" "probe" "busctl-present" "reason" "busctl is not installed; touchpad configuration is deferred") | trim | indent 4 }}
  fi

  local SERVICE='org.kde.KWin'
  local MGR_PATH='/org/kde/KWin/InputDevice'
  local IFACE_MGR='org.kde.KWin.InputDeviceManager'
  local IFACE_DEV='org.kde.KWin.InputDevice'

  _dbus_get() {
    local path="$1" prop="$2"
    busctl --user get-property "$SERVICE" "$path" "$IFACE_DEV" "$prop" 2>/dev/null \
      | awk '{ $1=""; sub(/^ /, ""); print }'
  }

  _dbus_set_b() {
    local path="$1" prop="$2" value="$3"
    busctl --user set-property "$SERVICE" "$path" "$IFACE_DEV" "$prop" b "$value"
    printf '    set %-26s = %s\n' "$prop" "$value"
  }

  local raw
  if ! raw="$(busctl --user get-property "$SERVICE" "$MGR_PATH" "$IFACE_MGR" devicesSysNames 2>/dev/null)"; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "config-kde-touchpad" "site" "kwin-unreachable" "direction" "transient-blocking" "probe" "plasmashell-running" "reason" "KWin is unreachable on the session bus; touchpad configuration is deferred") | trim | indent 4 }}
  fi

  local sysnames=()
  local name
  while IFS= read -r name; do
    [[ -n "$name" ]] && sysnames+=("$name")
  done < <(printf '%s\n' "$raw" | grep -oE '"[^"]+"' | tr -d '"')

  _denied() {
    local candidate="$1"
    shift
    local entry
    for entry in "$@"; do
      [[ "$candidate" == "$entry" ]] && return 0
    done
    return 1
  }

  # Glob match, unlike _denied's exact match: a TrackPoint's libinput name varies
  # by vendor prefix ("TPPS/2 Elan TrackPoint", "Lenovo TrackPoint"), so the
  # patterns are globs and the comparison is deliberately unquoted on the right.
  _matched() {
    local candidate="$1"
    shift
    local pattern
    for pattern in "$@"; do
      # shellcheck disable=SC2053
      [[ "$candidate" == $pattern ]] && return 0
    done
    return 1
  }

  local count=0
  local sn path is_touchpad name_quoted
  for sn in "${sysnames[@]}"; do
    path="$MGR_PATH/$sn"
    is_touchpad="$(_dbus_get "$path" touchpad)"
    # `pointer` is asked only when the device is not a touchpad: a touchpad has
    # already qualified, and every property read is a round trip on the session
    # bus paid for each of the host's input devices -- keyboards and lid switches
    # included -- on every apply.
    if [[ "$is_touchpad" != "true" ]]; then
      [[ "$(_dbus_get "$path" pointer)" == "true" ]] || continue
    fi

    name_quoted="$(_dbus_get "$path" name)"
    name="${name_quoted#\"}"
    name="${name%\"}"

    # A non-touchpad pointer takes the TrackPoint set ONLY when its name matches
    # kde.trackpoint.matchDevices. Every other mouse is reported and left alone --
    # this script has never managed ordinary mice and must not start.
    if [[ "$is_touchpad" != "true" ]]; then
      if ! _matched "$name" ${TRACKPOINT_MATCH_NAMES[@]+"${TRACKPOINT_MATCH_NAMES[@]}"}; then
        printf '  skip: %s (%s) — a pointer, but no kde.trackpoint.matchDevices pattern matches it\n' "$name" "$sn"
        continue
      fi
      if _denied "$name" ${TRACKPOINT_DENY_NAMES[@]+"${TRACKPOINT_DENY_NAMES[@]}"}; then
        printf '  skip: %s (%s) — named in kde.trackpoint.denyDevices\n' "$name" "$sn"
        continue
      fi
      printf '  trackpoint: %s (%s)\n' "$name" "$sn"
      if [[ "$(_dbus_get "$path" supportsNaturalScroll)" == "true" ]]; then
        _dbus_set_b "$path" naturalScroll "$TP_NATURAL_SCROLL"
      else
        printf '    skip naturalScroll: not supported by device\n'
      fi
      if [[ "$(_dbus_get "$path" supportsMiddleEmulation)" == "true" ]]; then
        _dbus_set_b "$path" middleEmulation "$TP_MIDDLE_EMULATION"
      else
        printf '    skip middleEmulation: not supported by device\n'
      fi
      if [[ -n "$(_dbus_get "$path" scrollOnButtonDown)" ]]; then
        _dbus_set_b "$path" scrollOnButtonDown "$TP_SCROLL_ON_BUTTON_DOWN"
      else
        printf '    skip scrollOnButtonDown: not supported by device\n'
      fi
      count=$((count + 1))
      continue
    fi

    if _denied "$name" ${TOUCHPAD_DENY_NAMES[@]+"${TOUCHPAD_DENY_NAMES[@]}"}; then
      printf '  skip: %s (%s) — named in kde.touchpad.denyDevices\n' "$name" "$sn"
      continue
    fi

    printf '  touchpad: %s (%s)\n' "$name" "$sn"

    if [[ "$(_dbus_get "$path" supportsNaturalScroll)" == "true" ]]; then
      _dbus_set_b "$path" naturalScroll "$NATURAL_SCROLL"
    else
      printf '    skip naturalScroll: not supported by device\n'
    fi

    local tap_finger_count
    tap_finger_count="$(_dbus_get "$path" tapFingerCount)"
    if [[ -n "$tap_finger_count" && "$tap_finger_count" != "0" ]]; then
      _dbus_set_b "$path" tapToClick "$TAP_TO_CLICK"
    else
      printf '    skip tapToClick: not supported by device\n'
    fi

    if [[ "$(_dbus_get "$path" supportsClickMethodClickfinger)" == "true" ]]; then
      _dbus_set_b "$path" clickMethodClickfinger "$CLICK_METHOD_CLICKFINGER"
      if [[ "$(_dbus_get "$path" supportsClickMethodAreas)" == "true" ]]; then
        _dbus_set_b "$path" clickMethodAreas "$CLICK_METHOD_AREAS"
      fi
    else
      printf '    skip clickMethodClickfinger: not supported by device\n'
    fi

    count=$((count + 1))
  done

  if [[ "$count" -eq 0 ]]; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "config-kde-touchpad" "site" "no-target-touchpad" "reason" "no touchpad or trackpoint is present in this session") | trim | indent 6 }}
    )
    return 0
  fi

  printf '  configured %d touchpad(s).\n' "$count"
}

configure_touchpad
{{ end -}}
