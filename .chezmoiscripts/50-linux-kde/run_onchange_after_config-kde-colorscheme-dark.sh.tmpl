{{ if eq .chezmoi.os "linux" -}}
{{ $sessionBusPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "session-bus-present") -}}
{{ $graphicalSessionPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "graphical-session-present") -}}
{{ $plasmashellRunning := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "plasmashell-running") -}}
{{ $colorschemeToolPresent := includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "plasma-apply-colorscheme-present") -}}
#!/usr/bin/env bash
#
# Fedora KDE Spin. Applies the Breeze Dark COLOUR SCHEME, which is the half of
# "always dark" that .chezmoidata/kde.yaml structurally cannot own.
#
# WHY THIS IS A SCRIPT AND NOT A MANIFEST ROW. kdeglobals [General] ColorScheme is
# only a LABEL the Colors KCM reads -- on a dark desktop that key is absent from
# ~/.config/kdeglobals altogether. What Plasma paints from is the EXPANDED
# [Colors:Button], [Colors:View], [Colors:Window], [Colors:Header],
# [Colors:Selection], [Colors:Tooltip], [Colors:Complementary],
# [ColorEffects:Disabled] and [ColorEffects:Inactive] groups in that same file.
# Those group names carry a colon, which config-kde-settings' group-segment
# allowlist rejects -- and which its colon-delimited row format could not carry even
# if the allowlist were widened. Applying them also needs a live Plasma session.
# A setting with a precondition stays its own script; that is exactly the rule
# .chezmoidata/kde.yaml's header states, and this is the standing example of the
# colour half of the theme.
#
# WHY plasma-apply-colorscheme AND NOT plasma-apply-lookandfeel. The look-and-feel
# tool also applies wallpaper, splash and cursor, so it would fight
# config-kde-wallpaper-breeze's deliberate once-only wallpaper stamp. This tool
# touches the colours only. It also drives kded's GTK sync, which a raw
# kwriteconfig6 write does not -- that is what keeps GTK applications dark
# alongside Plasma ones.
#
# NO STAMP, unlike the wallpaper script. The wallpaper is a preference we set once
# and then leave to the user; the dark colour scheme is enforced. Re-running is
# free: the scheme is only applied when it is not already the current one.
#
# ORDERING. This file sorts after config-kde-settings, so AutomaticLookAndFeel is
# already false by the time the colours are applied. Applying them while the
# day/night switcher is still live would leave them to be overwritten at the next
# transition. Keep that ordering if this file is ever renamed.
#
# TWO KINDS OF GATE, the same split config-kde-wallpaper-breeze documents:
#
#   * WHICH HOST IS THIS — the kde-guard include below (the `desktop` fact).
#   * IS A SESSION RUNNING RIGHT NOW — the D-Bus / display-server /
#     `pgrep plasmashell` checks. These stay bash: they are runtime state, not host
#     identity, and plasma-apply-colorscheme genuinely needs all three.
#
# Live-session preconditions below are DECLARED transient-blocking and paired with
# cached capability tokens in the comment-only fingerprint block.

{{- includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list
      (dict "name" "session-bus-present" "value" $sessionBusPresent)
      (dict "name" "graphical-session-present" "value" $graphicalSessionPresent)
      (dict "name" "plasmashell-running" "value" $plasmashellRunning)
      (dict "name" "plasma-apply-colorscheme-present" "value" $colorschemeToolPresent))) }}
set -euo pipefail

# The scheme name lives beside the tool that consumes it: one literal, and no row
# shape to invent in the manifest for a single value config-kde-settings could not
# apply anyway.
COLOR_SCHEME=BreezeDark

{{ includeTemplate "kde-guard.sh.tmpl" (dict "ctx" . "name" "config-kde-colorscheme-dark.sh") -}}

# --- Live KDE session guards -------------------------------------------------
# Runtime state only — the host-is-KDE question is already answered by kde-guard.
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-colorscheme-dark" "site" "no-session-bus" "direction" "transient-blocking" "probe" "session-bus-present" "reason" "no D-Bus session bus is available; the dark colour scheme is deferred") | trim | indent 2 }}
fi
if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-colorscheme-dark" "site" "no-display-server" "direction" "transient-blocking" "probe" "graphical-session-present" "reason" "no graphical display server is available; the dark colour scheme is deferred") | trim | indent 2 }}
fi
if ! pgrep -xu "$USER" plasmashell >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-colorscheme-dark" "site" "plasmashell-not-running" "direction" "transient-blocking" "probe" "plasmashell-running" "reason" "plasmashell is not running; the dark colour scheme is deferred") | trim | indent 2 }}
fi
if ! command -v plasma-apply-colorscheme >/dev/null 2>&1; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_here" "script" "config-kde-colorscheme-dark" "site" "colorscheme-tool-absent" "direction" "transient-blocking" "probe" "plasma-apply-colorscheme-present" "reason" "the Plasma colour-scheme tool is not installed; the dark colour scheme is deferred") | trim | indent 2 }}
fi

# Idempotence without a stamp. plasma-apply-colorscheme declines to reselect the
# current scheme, and `set -e` would turn that refusal into a failed apply, so ask
# first. A missing kreadconfig6 or an unset key leaves `current` empty, which
# correctly falls through to applying.
current="$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null || true)"

if [[ "$current" == "$COLOR_SCHEME" ]]; then
  printf 'config-kde-colorscheme-dark.sh: colour scheme is already %s\n' "$COLOR_SCHEME"
else
  plasma-apply-colorscheme "$COLOR_SCHEME"
  printf 'config-kde-colorscheme-dark.sh: colour scheme set to %s\n' "$COLOR_SCHEME"
fi
{{ end -}}
