{{- $isFedora := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
{{- $isUbuntu := and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "pop")) -}}
{{- $isDarwin := eq .chezmoi.os "darwin" -}}
{{- if or $isFedora $isUbuntu $isDarwin -}}
{{- $dotnetPresent := "" -}}
{{- if $isFedora -}}
{{-   $dotnetPresent = includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "dotnet-present") -}}
{{- end -}}
#!/usr/bin/env bash

{{ if $isFedora -}}
# fingerprint: {{ includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list (dict "name" "dotnet-present" "value" $dotnetPresent))) }}
{{ end -}}
set -euo pipefail
{{ includeTemplate "facts-sh.tmpl" . }}
{{ if or $isFedora $isUbuntu -}}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-dotnet") }}
{{ includeTemplate "sudo-require-guard.sh.tmpl" "install-dotnet.sh" -}}
{{ end -}}

dotnet_tools=(
  csharp-ls
  git-credential-manager
  powershell
)

{{ if $isFedora -}}
DNF=("${SUDO[@]}" dnf)

install_dotnet_sdk() {
  if ! rpm -q dotnet-sdk-8.0 >/dev/null 2>&1 && ! rpm -q dotnet-sdk-10.0 >/dev/null 2>&1; then
    "${DNF[@]}" install -y dotnet-sdk-8.0 dotnet-sdk-10.0 2>/dev/null || "${DNF[@]}" install -y dotnet-sdk-8.0 || true
  fi
}

install_dotnet_tools() {
  if ! command -v dotnet >/dev/null 2>&1; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-dotnet-fedora" "site" "dotnet-absent" "direction" "transient-blocking" "probe" "dotnet-present" "reason" "dotnet is not installed; tools cannot be installed") | trim | indent 6 }}
    )
    return 0
  fi
  local installed tool
  installed="$(dotnet tool list -g 2>/dev/null || true)"
  for tool in "${dotnet_tools[@]}"; do
    if printf '%s\n' "${installed}" | awk '{print $1}' | grep -ixqF "${tool}"; then
      continue
    fi
    dotnet tool install -g "${tool}" || true
  done
}

install_dotnet_sdk
install_dotnet_tools

{{ else if $isUbuntu -}}
install_dotnet_sdk() {
  if ! command -v dotnet >/dev/null 2>&1; then
    "${SUDO[@]}" apt-get update -qq || true
    "${SUDO[@]}" apt-get install -y dotnet-sdk-8.0 2>/dev/null || true
  fi
}

install_dotnet_tools() {
  if command -v dotnet >/dev/null 2>&1; then
    local installed tool
    installed="$(dotnet tool list -g 2>/dev/null || true)"
    for tool in "${dotnet_tools[@]}"; do
      if printf '%s\n' "${installed}" | awk '{print $1}' | grep -ixqF "${tool}"; then
        continue
      fi
      dotnet tool install -g "${tool}" || true
    done
  fi
}

install_dotnet_sdk
install_dotnet_tools

{{ else if $isDarwin -}}
install_dotnet_tools() {
  if command -v dotnet >/dev/null 2>&1; then
    local installed tool
    installed="$(dotnet tool list -g 2>/dev/null || true)"
    for tool in "${dotnet_tools[@]}"; do
      if printf '%s\n' "${installed}" | awk '{print $1}' | grep -ixqF "${tool}"; then
        continue
      fi
      dotnet tool install -g "${tool}" || true
    done
  fi
}

install_dotnet_tools
{{ end -}}

{{ end -}}
