{{- $isFedora := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
{{- $isUbuntu := and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "pop")) -}}
{{- if or $isFedora $isUbuntu -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "facts-sh.tmpl" . }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-devtools") }}
{{ includeTemplate "sudo-elevation-guard.sh.tmpl" (dict "ctx" . "name" "install-devtools.sh") -}}

{{ if $isFedora -}}
DNF=("${SUDO[@]}" dnf)

dev_groups=(
  development-tools
  c-development
)

dev_coprs=(
)

dev_packages=(
  # Build tooling and language dependencies
  clang21-libs
  dbus-devel
  dkms
  expect
  gtk3-devel
  java-latest-openjdk-devel
  kernel-devel
  kernel-devel-matched
  kernel-headers
  libappindicator-gtk3-devel
  libffi-devel
  librsvg2-devel
  libxdo-devel
  libyaml-devel
  mesa-libGLU
  mingw64-gcc
  webkit2gtk4.1-devel

  # CLI utilities and system monitoring
  btop
  chezmoi
  fd-find
  ghostty
  libsecret
  lm_sensors
  nvtop
  python3-setools
  secilc
  setools-console
  systemd-container
  yp-tools
  # Smartcard / code signing
  opensc
  osslsigncode
  pcsc-lite
  pcsc-lite-ccid
  pcsc-tools
  pkcs11-provider
  yubikey-manager
)

setup_dev_repos() {
  for copr in "${dev_coprs[@]}"; do
    "${DNF[@]}" copr enable -y "${copr}" || true
  done

  if ! rpm -q terra-release >/dev/null 2>&1; then
    "${DNF[@]}" install -y --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release terra-gpg-keys || true
  fi
}

missing_dev_packages=()
compute_missing_dev_packages() {
  missing_dev_packages=()
  local pkg
  for pkg in "${dev_packages[@]}"; do
    rpm -q "${pkg}" >/dev/null 2>&1 || missing_dev_packages+=("${pkg}")
  done
}

# The installed-group listing is read from the local cache, so a converged host
# answers this without contacting a repository. When the listing command itself
# fails, every declared group is treated as missing for the attempt, and the
# post-attempt listing decides the verdict.
missing_dev_groups=()
compute_missing_dev_groups() {
  missing_dev_groups=()
  local group listing
  if listing="$(dnf -C -q group list --installed 2>/dev/null)"; then
    for group in "${dev_groups[@]}"; do
      printf '%s\n' "$listing" | awk '{print $1}' | grep -ixqF "$group" || missing_dev_groups+=("$group")
    done
  else
    missing_dev_groups=("${dev_groups[@]}")
  fi
}

report_devtools_missing() {
  if [[ "${#missing_dev_packages[@]}" -gt 0 ]]; then
    printf 'install-devtools-fedora.sh: dnf left these declared packages uninstalled: %s\n' "${missing_dev_packages[*]}" >&2
    printf '  sudo dnf install -y %s\n' "${missing_dev_packages[*]}" >&2
  fi
  if [[ "${#missing_dev_groups[@]}" -gt 0 ]]; then
    printf 'install-devtools-fedora.sh: dnf left these declared groups uninstalled: %s\n' "${missing_dev_groups[*]}" >&2
    printf '  sudo dnf group install -y %s\n' "${missing_dev_groups[*]}" >&2
  fi
  return 0
}

clear_devtools_skip_record() {
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "clear_record" "script" "install-devtools-fedora" "site" "dev-packages-not-installed") | trim | indent 2 }}
}

install_devtools() {
  compute_missing_dev_packages
  compute_missing_dev_groups

  if [[ "${#missing_dev_packages[@]}" -gt 0 || "${#missing_dev_groups[@]}" -gt 0 ]]; then
    if [[ "${#missing_dev_packages[@]}" -gt 0 ]]; then
      setup_dev_repos
    fi

    if [[ "${#missing_dev_groups[@]}" -gt 0 ]]; then
      if ! "${DNF[@]}" group install -y "${missing_dev_groups[@]}"; then :; fi
    fi

    if [[ "${#missing_dev_packages[@]}" -gt 0 ]]; then
      if ! "${DNF[@]}" install -y "${missing_dev_packages[@]}"; then :; fi
    fi

    compute_missing_dev_packages
    compute_missing_dev_groups
  fi

  if [[ "${#missing_dev_packages[@]}" -gt 0 || "${#missing_dev_groups[@]}" -gt 0 ]] && report_devtools_missing; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-devtools-fedora" "site" "dev-packages-not-installed" "direction" "operator-blocking" "reason" "dnf left declared devtools packages or groups uninstalled; the missing set and the by-hand install commands were printed above") | trim | indent 4 }}
  fi

  clear_devtools_skip_record
}

install_devtools

{{ else if $isUbuntu -}}
apt_installed() {
  local status
  status="$(dpkg-query -f '${db:Status-Status}' -W "$1" 2>/dev/null)" || return 1
  [[ "$status" == installed ]]
}

dev_packages=(
  build-essential
  default-jdk
  libdbus-1-dev
  libssl-dev
  opensc
  pcscd
)

missing_dev_packages=()
compute_missing_dev_packages() {
  missing_dev_packages=()
  local pkg
  for pkg in "${dev_packages[@]}"; do
    apt_installed "$pkg" || missing_dev_packages+=("$pkg")
  done
}

report_devtools_missing() {
  printf 'install-devtools-ubuntu.sh: apt-get left these declared packages uninstalled: %s\n' "${missing_dev_packages[*]}" >&2
  printf '  sudo apt-get install -y %s\n' "${missing_dev_packages[*]}" >&2
  return 0
}

clear_devtools_skip_record() {
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "clear_record" "script" "install-devtools-ubuntu" "site" "dev-packages-not-installed") | trim | indent 2 }}
}

install_devtools() {
  "${SUDO[@]}" apt-get update -qq || true
  local pkg
  for pkg in "${dev_packages[@]}"; do
    if ! apt_installed "$pkg"; then
      if ! "${SUDO[@]}" apt-get install -y "$pkg"; then
        printf 'install-devtools-ubuntu.sh: apt-get install failed for %s\n' "$pkg" >&2
      fi
    fi
  done

  compute_missing_dev_packages

  if [[ "${#missing_dev_packages[@]}" -gt 0 ]] && report_devtools_missing; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-devtools-ubuntu" "site" "dev-packages-not-installed" "direction" "operator-blocking" "reason" "apt-get left declared devtools packages uninstalled; the missing set and the by-hand install command were printed above") | trim | indent 4 }}
  fi

  clear_devtools_skip_record
}

install_devtools
{{ end -}}

{{ end -}}
