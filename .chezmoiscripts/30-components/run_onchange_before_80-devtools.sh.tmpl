{{- $isFedora := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
{{- $isUbuntu := and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "pop")) -}}
{{- if or $isFedora $isUbuntu -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "facts-sh.tmpl" . }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-devtools") }}
{{ includeTemplate "sudo-require-guard.sh.tmpl" "install-devtools.sh" -}}

{{ if $isFedora -}}
DNF=("${SUDO[@]}" dnf)

dev_groups=(
  development-tools
  c-development
)

dev_coprs=(
)

dev_packages=(
  # Build tooling and language dependencies
  clang21-libs
  dbus-devel
  dkms
  expect
  gtk3-devel
  java-latest-openjdk-devel
  kernel-devel
  kernel-devel-matched
  kernel-headers
  libappindicator-gtk3-devel
  libffi-devel
  librsvg2-devel
  libxdo-devel
  libyaml-devel
  mesa-libGLU
  mingw64-gcc
  webkit2gtk4.1-devel

  # CLI utilities and system monitoring
  btop
  chezmoi
  fd-find
  ghostty
  libsecret
  lm_sensors
  nvtop
  secilc
  systemd-container
  yp-tools
  # Smartcard / code signing
  opensc
  osslsigncode
  pcsc-lite
  pcsc-lite-ccid
  pcsc-tools
  pkcs11-provider
)

setup_dev_repos() {
  for copr in "${dev_coprs[@]}"; do
    "${DNF[@]}" copr enable -y "${copr}" || true
  done

  if ! rpm -q terra-release >/dev/null 2>&1; then
    "${DNF[@]}" install -y --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release terra-gpg-keys || true
  fi
}

install_devtools() {
  local -a missing=()
  local pkg
  for pkg in "${dev_packages[@]}"; do
    rpm -q "${pkg}" >/dev/null 2>&1 || missing+=("${pkg}")
  done

  # Install group packages
  "${DNF[@]}" group install -y "${dev_groups[@]}" 2>/dev/null || true

  if [[ "${#missing[@]}" -gt 0 ]]; then
    setup_dev_repos
    "${DNF[@]}" install -y "${missing[@]}" || true
  fi
}

install_devtools

{{ else if $isUbuntu -}}
install_apt() {
  local pkg=$1
  local status=''
  status="$(dpkg-query -f '${db:Status-Status}' -W "$pkg" 2>/dev/null)" || status=''
  if [[ "$status" != installed ]]; then
    "${SUDO[@]}" apt-get install -y "$pkg"
  fi
}

dev_packages=(
  build-essential
  default-jdk
  libdbus-1-dev
  libssl-dev
  opensc
  pcscd
)

"${SUDO[@]}" apt-get update -qq || true
for pkg in "${dev_packages[@]}"; do
  install_apt "$pkg"
done
{{ end -}}

{{ end -}}
