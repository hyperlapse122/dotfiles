{{- $isFedora := and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
{{- $isUbuntu := and (eq .chezmoi.os "linux") (or (eq .chezmoi.osRelease.id "ubuntu") (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "pop")) -}}
{{- if or $isFedora $isUbuntu -}}
{{- $nvidiaCtkPresent := "" -}}
{{- $akmodsKeyPresent := "" -}}
{{- $expectPresent := "" -}}
{{- $mokPassphrase := "" -}}
{{- if $isFedora -}}
{{-   $nvidiaCtkPresent = includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "nvidia-ctk-present") -}}
{{-   $akmodsKeyPresent = includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "akmods-signing-key-present") -}}
{{-   $expectPresent = includeTemplate "capabilities.tmpl" (dict "ctx" . "probe" "expect-present") -}}
{{- /* The MOK enrollment password is the LUKS passphrase the config already
     stores: the operator has to retype this value at the MokManager screen on the
     next boot, and a generated one would have to be recorded somewhere for them
     to look up. Read exactly the way run_onchange_after_luks-tpm2.sh.tmpl reads
     it -- the READ-ONLY key partial, so a host that stored a cipher and lost its
     keyring entry does not get a fresh key that cannot decrypt the old text. */ -}}
{{-   if and (hasKey . "luksPassphraseCipher") (ne .luksPassphraseCipher "") -}}
{{-     $secretsKey := includeTemplate "config-secrets-key.tmpl" . -}}
{{-     if ne $secretsKey "" }}{{ $mokPassphrase = decryptAES $secretsKey .luksPassphraseCipher }}{{ end -}}
{{-   end -}}
{{- end -}}
#!/usr/bin/env bash

{{ if $isFedora -}}
# fingerprint: {{ includeTemplate "fingerprint.tmpl" (dict "sourceDir" .chezmoi.sourceDir "values" (list (dict "name" "nvidia-ctk-present" "value" $nvidiaCtkPresent) (dict "name" "akmods-signing-key-present" "value" $akmodsKeyPresent) (dict "name" "expect-present" "value" $expectPresent))) }}
#
# SECURITY NOTES for the MOK enrollment passphrase below, identical in shape to
# run_onchange_after_luks-tpm2.sh.tmpl's, because it is the same stored secret:
#   * At rest the config carries only the AES ciphertext and the key never leaves
#     the user keyring. But when it decrypts, it is rendered (base64-wrapped for
#     shell safety, NOT secrecy) into this script's transient run-script file,
#     which chezmoi writes mode-0700 and deletes after execution. Avoid
#     `chezmoi apply --verbose` / `--dry-run` with a real passphrase stored --
#     those print rendered script contents.
#   * The passphrase is handed to expect through the environment ONLY, never
#     argv, so it is not visible in the process table.
#   * A blank prompt, an unreachable or locked keyring, or an absent expect all
#     render the declared skip path instead, so no passphrase is rendered at all.
#   * shim consumes MokAuth at boot and does not expose it as a runtime efivar,
#     so the queued hash has no persistent runtime read surface.
{{ end -}}
set -euo pipefail
{{ includeTemplate "facts-sh.tmpl" . }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-nvidia") }}
{{ includeTemplate "sudo-elevation-guard.sh.tmpl" (dict "ctx" . "name" "install-nvidia.sh") -}}

{{ if $isFedora -}}
DNF=("${SUDO[@]}" dnf)

# Branch policy — GENERATED from .chezmoidata/nvidia.yaml. Every package name,
# package source and module build system below is a data row, not a decision made
# here: the installer selects a set, it does not know which GPU needs which
# branch. Selection happens at RUN time on FACT_GPU_ARCH so one rendered script
# covers every branch, which is what lets the smoke harness assert both shapes
# from a single render.
nvidia_packages=(
{{- range .nvidia.currentBranch.packages }}
  {{ . }}
{{- end }}
)

nvidia_rpmfusion_excludes=(
{{- range .nvidia.currentBranchRpmfusionExcludes }}
  {{ . | quote }}
{{- end }}
)

# The mirror image, applied on a NON-cuda branch. Generated from
# .chezmoidata/nvidia.yaml for the same reason as the array above: which names the
# CUDA repository owns is policy, not a decision this installer makes.
nvidia_cuda_excludes=(
{{- range .nvidia.legacyBranchCudaExcludes }}
  {{ . | quote }}
{{- end }}
)

nvidia_branch=''
nvidia_branch_source=''
nvidia_build_system=''
nvidia_conflicting_packages=()

# One marker package per branch: its presence means that branch is installed.
{{ $markers := list .nvidia.currentBranch.marker -}}
{{- range $arch, $branch := .nvidia.branches -}}
{{-   $markers = mustAppend $markers $branch.marker -}}
{{- end }}
nvidia_branch_markers=(
{{- range ($markers | uniq | sortAlpha) }}
  {{ . }}
{{- end }}
)

# Resolve the branch this host's GPU architecture needs. Returns 1 when the
# architecture is unknown, which is every host whose device id the table does not
# list -- including a GPU newer than the table. The caller declares that as a skip
# naming the device, so an operator sees the row to add rather than a machine that
# quietly lost its driver.
resolve_nvidia_branch() {
  case "${FACT_GPU_ARCH:-}" in
{{- range $arch, $branch := .nvidia.branches }}
    {{ $arch }})
      nvidia_branch={{ $branch.name | quote }}
      nvidia_branch_source={{ $branch.source | quote }}
      nvidia_build_system={{ $branch.buildSystem | quote }}
{{- if and (hasKey $branch "packages") $branch.packages }}
      nvidia_packages=(
{{- range $branch.packages }}
        {{ . }}
{{- end }}
      )
      # This branch is served by its own package source, so the exclusions that
      # keep that source out of the way for the current branch must not apply.
      # configure_cuda_exclusions then puts the reciprocal exclusion on the CUDA
      # repository, so exactly one source can serve these names.
      nvidia_rpmfusion_excludes=()
{{- end }}
      ;;
{{- end }}
    *)
      return 1
      ;;
  esac
  # Everything that marks a DIFFERENT branch is a conflict for this host.
  local marker resolved_marker=''
  case "$nvidia_branch" in
{{- $branchesByName := dict .nvidia.currentBranch.name .nvidia.currentBranch.marker -}}
{{- range $arch, $branch := .nvidia.branches -}}
{{-   $_ := set $branchesByName $branch.name $branch.marker -}}
{{- end -}}
{{- range $name, $marker := $branchesByName }}
    {{ $name | quote }}) resolved_marker={{ $marker | quote }} ;;
{{- end }}
  esac
  nvidia_conflicting_packages=()
  for marker in "${nvidia_branch_markers[@]}"; do
    [[ "$marker" == "$resolved_marker" ]] && continue
    nvidia_conflicting_packages+=("$marker")
  done
  return 0
}

configure_rpmfusion_exclusions() {
  if ! "${DNF[@]}" -q repo list --all 'rpmfusion-nonfree*' | grep -q '^rpmfusion-nonfree'; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "rpmfusion-nonfree-absent" "direction" "harmless" "reason" "RPM Fusion nonfree repositories are not present; NVIDIA package exclusions are not needed") | trim | indent 4 }}
  fi

  local IFS=,
  "${DNF[@]}" config-manager setopt \
    "rpmfusion-nonfree*.excludepkgs=${nvidia_rpmfusion_excludes[*]}" || true
}

# UNCONDITIONAL ON THE REPOSITORY BEING PRESENT, unlike its RPM Fusion sibling. A
# legacy-branch host is very likely to carry cuda-fedora*.repo from an apply that
# predates the branch axis, when it was added to every NVIDIA host -- and skipping
# the ADD does nothing about a repofile that is already there. `config-manager
# setopt` on an absent repository is a no-op, so running it anyway costs nothing
# and is what repairs that host.
#
# SYMMETRIC IN BOTH DIRECTIONS: a cuda-branch host WRITES THE EMPTY VALUE rather
# than leaving whatever was set. Without that, a host that resolved to the legacy
# branch once and then resolves back after a hardware change would keep excluding
# the very packages its branch now needs.
configure_cuda_exclusions() {
  local IFS=,
  local excludes=''
  if [[ "$nvidia_branch_source" != 'cuda' ]]; then
    excludes="${nvidia_cuda_excludes[*]}"
  fi
  "${DNF[@]}" config-manager setopt \
    "cuda-fedora*.excludepkgs=${excludes}" || true
}

configure_nvidia_repo_policy() {
  configure_rpmfusion_exclusions
  configure_cuda_exclusions
}

# The vendor CUDA repository serves the CURRENT branch only; a legacy branch comes
# from RPM Fusion, which the exclusions above deliberately keep out of the way for
# a current-branch host. Adding the CUDA repository on a legacy host would put the
# two sources in competition for the same driver.
#
# Both sources are added from their own signed release repofile with package
# signature checking left at the distribution default. Content from here is
# compiled into a kernel module that the host then signs with its own machine
# owner key, so it ends up INSIDE the Secure Boot trust chain: never reach for
# --nogpgcheck or gpgcheck=0 to make an install succeed.
setup_nvidia_repos() {
  configure_nvidia_repo_policy
  if [[ "$nvidia_branch_source" == 'cuda' ]]; then
    "${DNF[@]}" config-manager addrepo --from-repofile https://developer.download.nvidia.com/compute/cuda/repos/fedora"$(rpm -E %fedora)"/x86_64/cuda-fedora"$(rpm -E %fedora)".repo --overwrite
  fi
  "${DNF[@]}" config-manager addrepo --from-repofile https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo --overwrite
  "${DNF[@]}" makecache -y
}

# A branch this host does not resolve to, but whose packages are installed. The
# two are alternatives -- they ship the same kernel module and the same libraries
# -- so installing over the top would leave the host with neither working. The
# repository does not remove packages (see AGENTS.md), so this reports and stops.
conflicting_nvidia_branch() {
  local installed
  for installed in "${nvidia_conflicting_packages[@]}"; do
    rpm -q "$installed" >/dev/null 2>&1 && { printf '%s' "$installed"; return 0; }
  done
  return 1
}

clear_nvidia_skip_record() {
  local site="$1"
  rm -f "${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi/skips/install-nvidia-fedora__${site}" 2>/dev/null || true
}

clear_nvidia_package_skips() {
  clear_nvidia_skip_record 'nvidia-branch-conflict'
  clear_nvidia_skip_record 'nvidia-package-availability-unknown'
  clear_nvidia_skip_record 'nvidia-branch-packages-unavailable'
}

install_nvidia_packages() {
  local -a missing=()
  local pkg conflict
  for pkg in "${nvidia_packages[@]}"; do
    rpm -q "${pkg}" >/dev/null 2>&1 || missing+=("${pkg}")
  done
  [[ "${#missing[@]}" -gt 0 ]] || clear_nvidia_package_skips
  if [[ "${#missing[@]}" -eq 0 ]]; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "done_here" "script" "install-nvidia-fedora" "site" "nvidia-packages-already-present" "reason" "all declared dnf packages are already installed") | trim | indent 6 }}
    )
    return 0
  fi

  if conflict="$(conflicting_nvidia_branch)" && report_branch_conflict "$conflict"; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "nvidia-branch-conflict" "direction" "operator-blocking" "reason" "a conflicting NVIDIA driver branch is installed; the operator command to clear it was printed and nothing was installed or removed") | trim | indent 4 }}
  fi
  clear_nvidia_skip_record 'nvidia-branch-conflict'

  setup_nvidia_repos

  # ONE dnf call, not one per package: each invocation re-loads repository and
  # plugin state and may touch the network, right after makecache already did.
  local -a unavailable=()
  local available
  # `|| true`, not `|| available=''`: dnf exits non-zero when ANY argument matches
  # nothing while still printing the ones that DID match, so discarding stdout on
  # a non-zero exit makes one genuinely missing package report every package as
  # unavailable.
  available="$("${DNF[@]}" -q list --available "${missing[@]}" 2>/dev/null || true)"
  # NO OUTPUT AT ALL is not the same answer as a package the sources do not
  # offer. dnf still prints the arguments that DID match when one of them misses,
  # so an entirely empty result means the probe itself did not answer -- a network
  # failure, an unreadable metadata cache, a dnf that could not start. Reporting
  # that as a declared package set the sources do not offer states a permanent
  # fact about the branch on the strength of a transient failure.
  if [[ -z "$available" ]] && report_unknown_availability; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "nvidia-package-availability-unknown" "direction" "operator-blocking" "reason" "the package availability probe returned no output at all, so availability could not be determined; nothing was installed") | trim | indent 4 }}
  fi
  clear_nvidia_skip_record 'nvidia-package-availability-unknown'
  for pkg in "${missing[@]}"; do
    printf '%s\n' "$available" | grep -qE "^${pkg}\\." || unavailable+=("$pkg")
  done
  if [[ "${#unavailable[@]}" -gt 0 ]] && report_unavailable_packages "${unavailable[@]}"; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "nvidia-branch-packages-unavailable" "direction" "operator-blocking" "reason" "the resolved branch declares packages the enabled package sources do not offer; nothing was installed") | trim | indent 4 }}
  fi
  clear_nvidia_skip_record 'nvidia-branch-packages-unavailable'

  "${DNF[@]}" install -y "${nvidia_packages[@]}"
}

configure_nvidia_support() {
  if ! command -v nvidia-ctk >/dev/null 2>&1; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "nvidia-ctk-absent" "direction" "transient-blocking" "probe" "nvidia-ctk-present" "reason" "nvidia-ctk is not installed; container toolkit cannot be configured") | trim | indent 4 }}
    )
    return 0
  fi

  "${SUDO[@]}" nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml 2>/dev/null || true
  "${SUDO[@]}" setsebool -P container_use_devices on 2>/dev/null || true
}

# WHICH certificate this host signs its module with follows the resolved branch's
# kernel-module build system, not a fixed path. The out-of-tree builder mints its
# own pair with kmodgenca on first use; DKMS keeps the pair this repository has
# always generated. Both are host-generated, so the installer selects a path and
# waits for the tool that owns it -- it never mints the other one's key.
mok_cert_path() {
  case "$nvidia_build_system" in
    akmod) printf '/etc/pki/akmods/certs/public_key.der' ;;
    *)     printf '/var/lib/dkms/mok.pub' ;;
  esac
}

# MokManager reads its password on a US-layout UEFI console with no input method,
# so only printable US-ASCII is typeable there. Pinned to LC_ALL=C: the character
# class is a byte range, and a UTF-8 locale would widen it to accept exactly the
# characters this rejects.
mok_passphrase_is_typeable() {
  printf '%s' "$1" | LC_ALL=C grep -qE '^[ -~]+$'
}

mok_key_path() {
  case "$nvidia_build_system" in
    akmod) printf '/etc/pki/akmods/private/private_key.priv' ;;
    *)     printf '/var/lib/dkms/mok.key' ;;
  esac
}

dkms_mok_state() {
  # shellcheck disable=SC2016 # $1 and $2 are positional parameters to sh -c.
  "${SUDO[@]}" sh -c '
    if [ -f "$1" ] && [ -f "$2" ]; then printf present
    elif [ -e "$1" ] || [ -e "$2" ]; then printf partial
    else printf absent
    fi' sh "$(mok_cert_path)" "$(mok_key_path)"
}

# MOKUTIL ANSWERS ON STDOUT AND ITS EXIT STATUS IS NOT THAT ANSWER. `mokutil
# --test-key` asks whether a key STILL NEEDS ENROLLING, so it exits non-zero for
# the key that is already enrolled -- and this script runs under `set -o
# pipefail`, where `mokutil --test-key ... | grep -q ...` therefore evaluates
# FALSE in exactly the case the guard exists to catch. The apply fell through to
# `mokutil --import`, which prints `SKIP: <cert> is already enrolled` and exits
# WITHOUT prompting; expect met eof where it wanted a password, returned 91, and
# the whole apply aborted on a host that had already converged. Capturing the
# output first keeps the status out of the decision, which is the same reason
# dkms_mok_state exists.
mok_key_is_enrolled() {
  local out=''
  out="$("${SUDO[@]}" mokutil --test-key "$1" 2>/dev/null)" || true
  [[ "$out" == *'is already enrolled'* ]]
}

# The pending list, read the same way for the same reason. `-F` because a SHA-1
# fingerprint is a fixed string, never a pattern.
mok_key_is_queued() {
  local out=''
  [[ -n "$1" ]] || return 1
  out="$(mokutil --list-new 2>/dev/null)" || true
  printf '%s' "$out" | grep -qiF "$1"
}

# A certificate enrolled for a branch this host no longer resolves to stays in
# firmware: MOK enrollment is not something this repository can withdraw, and it
# forbids teardown. Report it so the trust gap is visible rather than assumed
# away; withdrawing it is an operator action.
# marker package -> the certificate that branch's build system uses. GENERATED
# from .chezmoidata/nvidia.yaml, the same source resolve_nvidia_branch reads, so a
# future branch whose marker does not follow today's naming convention still
# resolves correctly.
cert_path_for_marker() {
  case "$1" in
{{- $buildByMarker := dict .nvidia.currentBranch.marker .nvidia.currentBranch.buildSystem -}}
{{- range $arch, $branch := .nvidia.branches -}}
{{-   $_ := set $buildByMarker $branch.marker $branch.buildSystem -}}
{{- end -}}
{{- range $marker, $buildSystem := $buildByMarker }}
    {{ $marker | quote }}) nvidia_build_system={{ $buildSystem | quote }} mok_cert_path ;;
{{- end }}
    *) return 1 ;;
  esac
}

report_stale_mok() {
  local marker cert
  for marker in "${nvidia_conflicting_packages[@]}"; do
    cert="$(cert_path_for_marker "$marker")" || continue
    [[ "$cert" == "$(mok_cert_path)" ]] && continue
    "${SUDO[@]}" test -f "$cert" 2>/dev/null || continue
    mok_key_is_enrolled "$cert" || continue
    printf 'install-nvidia-fedora.sh: %s is still enrolled but belongs to a branch this host no longer resolves to.\n' "$cert" >&2
    printf 'install-nvidia-fedora.sh: withdrawing it is an operator action: sudo mokutil --delete %s\n' "$cert" >&2
  done
}

ensure_dkms_mok_generated() {
  if [[ ! -d /sys/firmware/efi ]]; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "install-nvidia-fedora" "site" "mok-generate-no-efi" "reason" "not booted via UEFI; a MOK keypair is not applicable") | trim | indent 6 }}
    )
    return 0
  fi
  if ! mokutil --sb-state 2>/dev/null | grep -q 'SecureBoot enabled'; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "install-nvidia-fedora" "site" "mok-generate-secureboot-disabled" "reason" "Secure Boot is disabled; a MOK keypair is not applicable") | trim | indent 6 }}
    )
    return 0
  fi
  local state
  state="$(dkms_mok_state)" || return 1
  case "$state" in
    present)
      (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "done_here" "script" "install-nvidia-fedora" "site" "mok-keypair-present" "reason" "the DKMS MOK keypair already exists") | trim | indent 8 }}
      )
      return 0
      ;;
    partial)
      printf 'install-nvidia-fedora.sh: partial MOK keypair (%s / %s); remove manually to regenerate\n' \
        "$(mok_cert_path)" "$(mok_key_path)" >&2
      return 1
      ;;
  esac

  # THE BUILDER'S OWN GENERATOR, NOT A SECOND KEYPAIR. The out-of-tree builder
  # owns its keypair and mints it with kmodgenca -- literally the command
  # akmods-keygen@.service runs before akmods.service builds anything. Calling it
  # here therefore mints the SAME key the builder signs with, one apply earlier
  # rather than one reboot later, which is what lets this apply queue the
  # certificate for enrollment instead of asking for a second reboot. The DKMS
  # mint below stays out of it: this branch never reaches it.
  #
  # WAITING ALONE WAS A DEADLOCK. This used to do nothing but wait, on the
  # reasoning that the key is minted on the first module build. kmodgenca ships in
  # the `akmods` package, and on a host where that package's rpm scriptlet was
  # refused the package never installed -- so no first build was ever going to
  # happen, and the wait had nothing left that could clear it. The builder is a
  # declared package of the akmod branch for the same reason.
  #
  # TRANSIENT-BLOCKING, NOT HARMLESS. The wait survives for a host where the
  # generator is still missing or could not run. Its condition clears the moment
  # the builder is installed and mints its key, so `harmless` -- "this host will
  # never satisfy the condition" -- would record the unsigned host as converged and
  # never look again. And `transient-tolerable` cannot be used here either: it
  # exits 1, and this is a 30-components `before` script, so a non-zero exit
  # strands every later phase (skip.sh.tmpl reserves that stranding for the
  # elevation guard alone). Naming the akmods-signing-key-present probe is what
  # makes the rendered content change once the key appears, so chezmoi re-runs this
  # script by itself.
  if [[ "$nvidia_build_system" == 'akmod' ]]; then
    if command -v kmodgenca >/dev/null 2>&1; then
      "${SUDO[@]}" kmodgenca -a || true
    fi
    # Re-probed, never inferred from kmodgenca's exit status, for the same reason
    # the DKMS mint below is re-probed: a generator can fail while reporting
    # success, and `absent` on an unreadable probe would be the conflation
    # dkms_mok_state exists to refuse -- so an unreadable probe takes the wait.
    state="$(dkms_mok_state 2>/dev/null || printf absent)"
    if [[ "$state" != present ]] && report_awaiting_builder_key; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "mok-generate-awaiting-builder" "direction" "transient-blocking" "probe" "akmods-signing-key-present" "reason" "the out-of-tree module builder has not generated its signing keypair yet; enrollment resumes once its key generator is installed and the key appears") | trim | indent 6 }}
    fi
    return 0
  fi

  if [[ -x /usr/lib/dkms/mok_signing_setup ]]; then
    "${SUDO[@]}" /usr/lib/dkms/mok_signing_setup || true
  else
    "${SUDO[@]}" mkdir -p /var/lib/dkms
    "${SUDO[@]}" openssl req -new -x509 -newkey rsa:2048 \
      -keyout /var/lib/dkms/mok.key -outform DER -out /var/lib/dkms/mok.pub \
      -nodes -days 36500 \
      -subj '/CN=DKMS module signing key (chezmoi-managed)/' || true
    "${SUDO[@]}" chmod 600 /var/lib/dkms/mok.key || true
  fi

  if [[ "$(dkms_mok_state 2>/dev/null || printf absent)" != present ]]; then
    printf 'install-nvidia-fedora.sh: failed to create the DKMS MOK keypair at /var/lib/dkms/mok.{pub,key}; module signing cannot proceed.\n' >&2
    return 1
  fi
}

enroll_dkms_mok() {
  if [[ ! -d /sys/firmware/efi ]]; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "install-nvidia-fedora" "site" "mok-enroll-no-efi" "reason" "not booted via UEFI; MOK enrollment is not applicable") | trim | indent 6 }}
    )
    return 0
  fi
  if ! mokutil --sb-state 2>/dev/null | grep -q 'SecureBoot enabled'; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "not_applicable" "script" "install-nvidia-fedora" "site" "mok-enroll-secureboot-disabled" "reason" "Secure Boot is disabled; MOK enrollment is not applicable") | trim | indent 6 }}
    )
    return 0
  fi

  # BEFORE the early returns, not after the import. R10 requires that a
  # certificate enrolled for a branch this host no longer resolves to is
  # reported; as the last statement of this function it fired only on the single
  # apply that imported a key, so on a converged host -- the steady state -- the
  # trust gap it exists to surface was silent forever. The helper is read-only
  # (test -f plus mokutil --test-key), so it is safe on every path.
  report_stale_mok

  ensure_dkms_mok_generated || true
  local cert
  cert="$(mok_cert_path)"
  local mok_state
  mok_state="$(dkms_mok_state)" || mok_state=unreadable
  # dkms_mok_state IS THE WHOLE ANSWER. This used to add `|| ! -f "$cert"`, an
  # UNPRIVILEGED file test beside a probe that runs under sudo -- the same
  # conflation of "cannot look" with "not there" that dkms_mok_state exists to
  # refuse. The DKMS certificate is world-readable, so it never showed there;
  # kmodgenca creates /etc/pki/akmods/certs as 0750 root:akmods, so on the akmod
  # branch the test was false for a key that had just been minted and the host
  # recorded a not-applicable enrollment it was entirely eligible for. The probe
  # already reports `present` only when BOTH halves are readable as root, and
  # reports failure -- not `absent` -- when it could not look at all.
  #
  # NOT APPLICABLE WAS THE WRONG WORD, AND ONE SITE CANNOT CARRY BOTH BRANCHES.
  # Both honest opt-outs -- no EFI, Secure Boot off -- have already returned
  # above, so a host that arrives here IS eligible: the keypair could not be
  # made or could not be read. `not_applicable` said the opposite and deleted
  # its own record, so the host went silent while its module stayed untrusted.
  # The two build systems then want different directions. On the akmod branch
  # the builder mints the key on its own, and akmods-signing-key-present is
  # exactly that precondition, so the wait is transient-blocking and the record
  # retires itself. Everywhere else nothing here will produce the key without an
  # operator, so the record has to survive and name the action.
  #
  # `== absent`, NOT `!= present`, ON THE FIRST BRANCH. dkms_mok_state answers
  # present/partial/absent and this function records `unreadable` when it could
  # not run at all. Only `absent` is the self-healing wait. Sending `unreadable`
  # down the probe-backed branch would let the pruner retire the record the
  # moment the UNPRIVILEGED probe reads available, on a host whose PRIVILEGED
  # probe never answered -- the cannot-look/not-there conflation again. And
  # `partial` is an operator action by construction: ensure_dkms_mok_generated
  # refuses to regenerate it and prints a manual-removal instruction.
  if [[ "${mok_state}" == absent && "$nvidia_build_system" == 'akmod' ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "mok-enroll-awaiting-builder-key" "direction" "transient-blocking" "probe" "akmods-signing-key-present" "reason" "the out-of-tree module builder has not generated its signing keypair yet, so there is no certificate to enroll; enrollment resumes once its key generator mints the key") | trim | indent 4 }}
  fi
  if [[ "${mok_state}" != present ]]; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "mok-enroll-no-keypair" "direction" "operator-blocking" "reason" "the module signing keypair could not be created or could not be probed, so there is no certificate to enroll; remove any half-written pair first, then mint it by hand with sudo /usr/lib/dkms/mok_signing_setup (dkms) or sudo kmodgenca -a (akmods)") | trim | indent 4 }}
  fi
  clear_nvidia_skip_record 'mok-enroll-no-keypair'
  if mok_key_is_enrolled "${cert}"; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "done_here" "script" "install-nvidia-fedora" "site" "mok-already-enrolled" "reason" "DKMS MOK key is already enrolled") | trim | indent 6 }}
    )
    return 0
  fi
  local fp
  fp="$("${SUDO[@]}" openssl x509 -in "${cert}" -inform DER -noout -fingerprint -sha1 2>/dev/null | sed 's/.*=//')"
  if mok_key_is_queued "${fp}"; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "done_here" "script" "install-nvidia-fedora" "site" "mok-already-queued" "reason" "DKMS MOK key is already queued for enrollment") | trim | indent 6 }}
    )
    return 0
  fi

  # THE IMPORT NEEDS A TERMINAL AND AN APPLY HAS NONE. `mokutil --import` reads a
  # one-time enrollment password from the tty (`input password:` twice), so on a
  # non-interactive apply it fails -- and this call used to discard both the error
  # text and the exit status, so the apply reported success while no MokNew
  # variable was ever written. Secure Boot then rejected the signed module with
  # nothing on screen to say why.
  #
  # THE PASSWORD IS THE STORED LUKS PASSPHRASE. The operator must retype this
  # value at the MokManager screen on the next boot, so it has to be a value they
  # already know; a generated one would have to be recorded and looked up.
  # ONE RENDERED SHAPE, not a render-time fork. The passphrase renders as the
  # empty string when the config stores no cipher, or when the keyring could not
  # be reached to decrypt it, and every precondition is then a RUNTIME branch --
  # so the rendered script is identical in shape on a host with a stored
  # passphrase and one without, and the smoke harness can drive every path from a
  # single render. base64 keeps a shell-special character in the passphrase from
  # breaking the assignment; it is not secrecy, exactly as the LUKS wrapper
  # documents.
  local MOK_ENROLL_PASSPHRASE
  MOK_ENROLL_PASSPHRASE="$(printf '%s' {{ $mokPassphrase | b64enc | quote }} | base64 -d)"

  if [[ -z "$MOK_ENROLL_PASSPHRASE" ]]; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "mok-enroll-no-passphrase" "direction" "harmless" "reason" "no stored passphrase is available to answer the mokutil enrollment prompt; run the printed mokutil command by hand") | trim | indent 6 }}
    )
    report_manual_mok_import "$cert"
    return 0
  fi

  if ! command -v expect >/dev/null 2>&1; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "mok-enroll-no-expect" "direction" "transient-blocking" "probe" "expect-present" "reason" "expect is not installed, so the enrollment password cannot be supplied without a terminal; run the printed mokutil command by hand instead") | trim | indent 6 }}
    )
    report_manual_mok_import "$cert"
    return 0
  fi

  # Queueing a request the operator cannot complete is worse than not queueing
  # it: the machine reboots into a MokManager prompt it can never satisfy.
  if ! mok_passphrase_is_typeable "$MOK_ENROLL_PASSPHRASE"; then
    (
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "mok-enroll-passphrase-untypeable" "direction" "harmless" "reason" "the stored passphrase is not printable US-ASCII and could not be typed at the MokManager console; run the printed mokutil command by hand with a typeable password") | trim | indent 6 }}
    )
    report_manual_mok_import "$cert"
    return 0
  fi

  # EXPECT RUNS UNPRIVILEGED AND SPAWNS THE ELEVATION ITSELF, rather than running
  # under sudo. Handing the secret to a privileged child would mean either `sudo
  # -E` (which sudoers may strip) or `sudo env VAR=...` -- and that second form
  # puts the passphrase in env's ARGV, visible in the process table to every user
  # on the box. Inheriting it into an unprivileged expect keeps it in that
  # process's own environment, which only its owner and root can read.
  #
  # The exit status is PROPAGATED: a discarded one is the whole defect this
  # replaced.
  #
  # LC_ALL=C, an explicit timeout action, and {*} rather than eval. The prompt
  # strings below are matched literally, so a localized mokutil would defeat them
  # -- the same reason the fingerprint installer pins its authselect call. Without
  # a timeout action an unmatched prompt would fall through to `expect eof` and
  # then block in `wait` on a process still reading stdin, hanging the apply
  # instead of failing it. And `eval spawn $argv` would re-parse the certificate
  # path as Tcl; {*} expands the list without a second parse.
  #
  # THE INDENTATION IS LOAD-BEARING, unusually for Tcl. Every helper here is
  # extracted by `sed -n '<start>,/^}$/p'`, so a line that is exactly `}` at
  # column 0 inside this heredoc truncates enroll_dkms_mok at that brace and the
  # smoke harness drives half a function. Keep the closing braces indented.
  if ! MOK_ENROLL_PASSPHRASE="$MOK_ENROLL_PASSPHRASE" MOK_CERT="$cert" \
    MOK_SUDO="${SUDO[*]-}" LC_ALL=C expect -f - <<'EXPECT'; then
set timeout 30
set pw $env(MOK_ENROLL_PASSPHRASE)
set cert $env(MOK_CERT)
set argv [concat $env(MOK_SUDO) [list mokutil --import $cert]]
spawn -noecho {*}$argv
expect {
    "input password:" { send -- "$pw\r" }
    timeout { puts stderr "mokutil did not ask for the enrollment password"; exit 90 }
    eof { puts stderr "mokutil exited before asking for the enrollment password"; exit 91 }
  }
expect {
    "input password again:" { send -- "$pw\r" }
    timeout { puts stderr "mokutil did not ask for the password confirmation"; exit 92 }
    eof { puts stderr "mokutil exited before confirming the enrollment password"; exit 93 }
  }
expect {
    eof {}
    timeout { puts stderr "mokutil did not exit after the enrollment password"; exit 94 }
  }
catch wait result
exit [lindex $result 3]
EXPECT
    printf 'install-nvidia-fedora.sh: mokutil --import failed for %s; the certificate was NOT queued.\n' "$cert" >&2
    report_manual_mok_import "$cert"
    return 1
  fi
  MOK_ENROLL_PASSPHRASE=''
  printf 'install-nvidia-fedora.sh: %s is queued for enrollment.\n' "$cert"
  printf 'install-nvidia-fedora.sh: the MokManager screen on the next boot still needs a physical console: choose Enroll MOK and type the stored LUKS passphrase.\n'
}

# akmods.service is ordered Before=display-manager.service, so a kmod it has to
# compile at boot holds the login screen for the whole build -- measured at 1m50s
# for this driver on this laptop, against a 2m21s total boot. Building here moves
# that cost into an apply the operator is already watching.
#
# BARE `akmods`, NEVER `--force`. Without a flag the tool checks whether the kmods
# for the RUNNING kernel already exist and builds only what is missing, so this is
# a cheap no-op on every apply after the first; `--force` would recompile the
# driver every single time. The service stays enabled either way, because a kernel
# update no apply precedes still needs it.
#
# AFTER ENROLLMENT, so the key exists before anything is signed with it, and
# `|| true` because a build failure is not a reason to strand every later phase --
# the unbuilt module is reported by akmods itself and the service retries at boot.
build_akmod_modules() {
  if [[ "$nvidia_build_system" == 'akmod' ]] && command -v akmods >/dev/null 2>&1; then
    "${SUDO[@]}" akmods || true
  fi
}

enable_nvidia_services() {
  if [[ -n "$nvidia_branch" ]] && systemctl list-unit-files nvidia-persistenced.service 2>/dev/null | grep -q nvidia-persistenced; then
    "${SUDO[@]}" systemctl enable nvidia-persistenced 2>/dev/null || true
  fi
  # akmods.service is what actually builds and signs the module for the
  # out-of-tree branch, and nothing else on the host does. Its enablement comes
  # from the akmods rpm %post preset call -- the same scriptlet class a host can
  # refuse -- so an enabled-by-default unit is not something to assume. Enabling
  # it again costs nothing where the preset already ran.
  if [[ "$nvidia_build_system" == 'akmod' ]] && systemctl list-unit-files akmods.service 2>/dev/null | grep -q akmods; then
    "${SUDO[@]}" systemctl enable akmods.service 2>/dev/null || true
  fi
  # When NVreg_PreserveVideoMemoryAllocations=1 is set (gated on hybridGraphics in
  # system/linux/etc/modprobe.d/nvidia-hybrid-power.conf), the driver requires
  # systemd sleep units to invoke its procfs interface before kernel suspend.
  # Without these units, suspend aborts in the kernel with error -5.
  if [[ "${FACT_HYBRID_GRAPHICS:-0}" -eq 1 ]]; then
    local unit
    for unit in nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service nvidia-suspend-then-hibernate.service; do
      if systemctl list-unit-files "$unit" 2>/dev/null | grep -q "$unit"; then
        "${SUDO[@]}" systemctl enable "$unit" 2>/dev/null || true
      fi
    done
  fi
}

# Prints the guidance and always succeeds, so it can sit inside the condition of
# the branch its skip declares. The declaration has to be the FIRST line of that
# branch -- anything printed after it would be dead code, because skip_step
# returns immediately.
report_unlisted_gpu() {
  if [[ -n "${FACT_GPU_DEVICE_ID:-}" ]]; then
    printf 'install-nvidia-fedora.sh: NVIDIA device %s is not in nvidia.deviceArchitectures.\n' \
      "$FACT_GPU_DEVICE_ID" >&2
    printf 'install-nvidia-fedora.sh: add a row for it under the architecture it belongs to:\n' >&2
    printf '  .chezmoidata/nvidia.yaml   deviceArchitectures: "%s": <architecture>\n' \
      "$FACT_GPU_DEVICE_ID" >&2
  fi
}

report_branch_conflict() {
  printf 'install-nvidia-fedora.sh: %s is installed but this host resolves to the %s branch.\n' \
    "$1" "$nvidia_branch" >&2
  printf 'install-nvidia-fedora.sh: clear it first, then re-apply:\n' >&2
  printf '  sudo dnf remove %s\n' "$1" >&2
}

report_unavailable_packages() {
  printf 'install-nvidia-fedora.sh: the %s branch declares packages the enabled sources do not offer: %s\n' \
    "$nvidia_branch" "$*" >&2
}

report_unknown_availability() {
  printf 'install-nvidia-fedora.sh: dnf listed no available packages at all for the %s branch, so it could not be asked whether they exist.\n' \
    "$nvidia_branch" >&2
  printf 'install-nvidia-fedora.sh: check repository reachability, then re-run: sudo dnf makecache\n' >&2
}

# The fallback every skip path above takes. Printing the exact command is the
# whole point: the silent half of the original defect was that an operator saw
# nothing at all when the import did not happen.
report_manual_mok_import() {
  printf 'install-nvidia-fedora.sh: queue it by hand instead, then reboot and choose Enroll MOK:\n' >&2
  printf '  sudo mokutil --import %s\n' "$1" >&2
}

report_awaiting_builder_key() {
  printf 'install-nvidia-fedora.sh: %s has not been generated yet; kmodgenca, the akmods key generator that owns it, is absent or could not create it.\n' \
    "$(mok_cert_path)" >&2
  printf 'install-nvidia-fedora.sh: install the builder and mint the pair by hand, then re-apply:\n' >&2
  printf '  sudo dnf install akmods && sudo kmodgenca -a\n' >&2
}

main() {
  if ! resolve_nvidia_branch && report_unlisted_gpu; then
{{ includeTemplate "skip.sh.tmpl" (dict "ctx" . "form" "skip_step" "script" "install-nvidia-fedora" "site" "nvidia-architecture-unlisted" "direction" "harmless" "reason" "this NVIDIA device is not listed in the declared architecture table; the device id and the row to add were printed and no driver branch was selected") | trim | indent 4 }}
  fi

  install_nvidia_packages
  configure_nvidia_support
  enroll_dkms_mok
  build_akmod_modules
  enable_nvidia_services
}

main

{{ else if $isUbuntu -}}
install_apt() {
  local pkg=$1
  local status=''
  status="$(dpkg-query -f '${db:Status-Status}' -W "$pkg" 2>/dev/null)" || status=''
  if [[ "$status" != installed ]]; then
    "${SUDO[@]}" apt-get install -y "$pkg"
  fi
}

if [[ -f /etc/nv_tegra_release ]]; then
  if [[ -f /etc/apt/sources.list.d/nvidia-l4t-apt-source.list ]]; then
    "${SUDO[@]}" apt-get update -qq || true
    install_apt nvidia-jetpack
  fi
fi
{{ end -}}

