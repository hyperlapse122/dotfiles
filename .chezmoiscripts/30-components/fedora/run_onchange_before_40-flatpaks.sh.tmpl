{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "facts-sh.tmpl" . }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-flatpaks-fedora") }}
{{ includeTemplate "sudo-require-guard.sh.tmpl" "install-flatpaks-fedora.sh" -}}

DNF=("${SUDO[@]}" dnf)

flatpaks=(
  com.discordapp.Discord
  io.github.nroduit.Weasis
  org.telegram.desktop
)

install_flatpak_runtime() {
  if ! rpm -q flatpak >/dev/null 2>&1; then
    "${DNF[@]}" install flatpak -y
  fi

  "${SUDO[@]}" flatpak remote-add --if-not-exists --system flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo
}

install_flatpak_apps() {
  install_flatpak_runtime
  "${SUDO[@]}" flatpak install --system -y --noninteractive flathub "${flatpaks[@]}"
}

install_flatpak_apps

{{ end -}}
