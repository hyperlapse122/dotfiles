{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
#!/usr/bin/env bash

set -euo pipefail

{{ includeTemplate "facts-sh.tmpl" . }}
{{ includeTemplate "shared-host-guard.sh.tmpl" (dict "ctx" . "name" "install-podman-fedora") }}
{{ includeTemplate "sudo-require-guard.sh.tmpl" "install-podman-fedora.sh" -}}

DNF=("${SUDO[@]}" dnf)

podman_packages=(
  buildah
  containers-common
  fuse-overlayfs
  kubernetes-client
  passt
  podman
  podman-compose
  podman-docker
  slirp4netns
)

install_podman_packages() {
  local -a missing=()
  local pkg
  for pkg in "${podman_packages[@]}"; do
    rpm -q "${pkg}" >/dev/null 2>&1 || missing+=("${pkg}")
  done
  if [[ "${#missing[@]}" -gt 0 ]]; then
    "${DNF[@]}" install -y "${missing[@]}"
  fi
}

configure_user_namespaces() {
  local target_user
  target_user="${SUDO_USER:-$USER}"

  if getent group docker >/dev/null 2>&1; then
    "${SUDO[@]}" gpasswd -d "${target_user}" docker 2>/dev/null || true
  fi

  grep -q "^${target_user}:" /etc/subgid 2>/dev/null || "${SUDO[@]}" usermod --add-subgids 100000-165535 "${target_user}" 2>/dev/null || true
  grep -q "^${target_user}:" /etc/subuid 2>/dev/null || "${SUDO[@]}" usermod --add-subuids 100000-165535 "${target_user}" 2>/dev/null || true
}

configure_cgroup_delegation() {
  local delegate_conf=/etc/systemd/system/user@.service.d/delegate.conf
  local delegate_desired='[Service]
Delegate=cpu cpuset io memory pids'

  if [[ ! -f "$delegate_conf" ]] || [[ "$("${SUDO[@]}" cat "$delegate_conf" 2>/dev/null)" != "$delegate_desired" ]]; then
    printf '%s\n' "$delegate_desired" | "${SUDO[@]}" install -D -m 0644 /dev/stdin "$delegate_conf"
    "${SUDO[@]}" systemctl daemon-reload 2>/dev/null || true
  fi
}

install_podman_packages
configure_user_namespaces
configure_cgroup_delegation

{{ end -}}
