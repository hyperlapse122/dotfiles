{{ $facts := includeTemplate "facts.tmpl" . | fromYaml -}}
{{ if and (or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin")) (not $facts.container) -}}
{{ $cpa := .cliProxyApi -}}
{{ $sourceDir := .chezmoi.sourceDir -}}
#!/usr/bin/env bash
# provision-cli-proxy-api — dual-OS runtime provisioner for the CLIProxyAPI
# stack (Claude subscription rotation proxy + CPA-Manager-Plus panel).
#
# Contract (revives the removed reconciler's credential contract):
#   - The managed state never carries a secret. Credentials render into this
#     TRANSIENT script body at apply time through the secret-read shim and are
#     written only into 0600 runtime files under the data root. They are never
#     rendered into a chezmoi target, the fingerprint below (raw sources only),
#     or a service definition.
#   - Seeding is ONE-SHOT: an existing runtime config or credential file is
#     left alone. CPA bcrypt-rewrites a seeded secret-key on first start, so
#     the management secret is frozen at first start and CPAMP's matching
#     management-key file is seeded from the same value — both must be re-seeded
#     together or CPA and CPAMP drift apart. Rotation re-seed (delete the
#     listed runtime file(s), then chezmoi apply):
#       management secret  -> config/config.yaml AND cpamp/secrets/management-key
#       panel admin secret -> cpamp/secrets/admin-key
#       any non-secret edit -> config/config.yaml (CPA owns it; chezmoi cannot)
#     Non-secret drift from the template is warned about, never silently adopted.
#   - A non-empty auth/ at first seed means leftover credentials from the
#     removed binary integration; the provisioner warns (a stale account would
#     otherwise be silently adopted into rotation) and documents the purge.
#
# Linux rollout: daemon-reload always; pull + restart only when the pinned
# image refs changed since the last rollout (a stamp file), so rollouts never
# silently ride the sleep cycle and unrelated lock bumps do not bounce the
# services. An unreachable user manager or missing podman soft-skips with a
# warning — on a headless/SSH host the quadlets are installed and the next
# session apply completes the rollout.
#
# macOS rollout: seed the same data-root runtime config from the managed
# source config, then load/kickstart the launchd agent in the CURRENT login
# session (RunAtLoad alone leaves the agent unloaded until next login).
#
# run_onchange fingerprint: the quadlets, the macOS config source, the data
# file, and the release lock (raw sources — a digest bump re-triggers this
# script; a rotated 1Password credential re-triggers it through the rendered
# body).
{{ includeTemplate "fingerprint.tmpl" (dict "sourceDir" $sourceDir "globs" (list "dot_config/containers/systemd/cli-proxy-api.network" "dot_config/containers/systemd/cli-proxy-api.container.tmpl" "dot_config/containers/systemd/cpa-manager-plus.container.tmpl" ".chezmoidata/cli-proxy-api.yaml" ".chezmoidata/releases.json" "dot_config/cli-proxy-api/readonly_config.yaml")) }}

set -euo pipefail
umask 077

BASE="$HOME/{{ $cpa.dataRoot }}"
CONFIG_DIR="$BASE/config"
AUTH_DIR="$BASE/auth"
RUNTIME_CONFIG="$CONFIG_DIR/config.yaml"

warn() {
  printf 'provision-cli-proxy-api: %s\n' "$*" >&2
}

# Resolved at render time; see the contract header.
MGMT_SECRET=$(cat <<'CPA_SECRET_EOF'
{{ includeTemplate "secret-read.tmpl" (dict "ctx" . "ref" $cpa.management.credential) }}
CPA_SECRET_EOF
)

# YAML single-quoted scalar: literal except '' for an embedded quote.
yaml_quote() {
  local v=${1//\'/\'\'}
  printf "'%s'" "$v"
}

# Emit the source-owned, non-secret fields as stable path=value records.
# CLIProxyAPI owns this file after seeding and can rewrite comments, ordering,
# quotes, and secret-key. Keep this parser limited to the generated YAML
# subset. Fail closed on ambiguous YAML instead of treating it as equivalent.
managed_config_projection() {
  awk '
    function fail() { bad = 1 }
    function trim(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return value
    }
    function scalar(value, type, unquoted, quoted) {
      value = trim(value)
      if (value ~ /^["\047].*["\047]$/) {
        if (substr(value, 1, 1) != substr(value, length(value), 1)) fail()
        quoted = 1
        value = substr(value, 2, length(value) - 2)
      } else if (value ~ /^[&*!|>]/ || value ~ /[[:space:]]+#/) {
        fail()
      }
      if (quoted && type != "string") fail()
      if (type == "bool" && value !~ /^(true|false)$/) fail()
      if (type == "int" && value !~ /^[0-9]+$/) fail()
      if (type == "list") {
        unquoted = value
        gsub(/[[:space:]]/, "", unquoted)
        if (unquoted != "[]") fail()
        value = "[]"
      }
      return value
    }
    function keep(path, value, type) {
      if (++seen[path] != 1) fail()
      values[path] = scalar(value, type)
    }
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
    /^[[:space:]]*<<[[:space:]]*:/ { fail(); next }
    {
      match($0, /^[[:space:]]*/)
      indent = RLENGTH
      line = substr($0, indent + 1)
      split_at = index(line, ":")
      if (!split_at) { fail(); next }
      key = trim(substr(line, 1, split_at - 1))
      value = substr(line, split_at + 1)

      if (indent == 0) {
        if (trim(value) == "") parent = key
        else parent = ""
        if (key == "remote-management") {
          if (trim(value) != "" || ++remote_sections != 1) fail()
          next
        }
      }
      path = ""
      if (indent == 0) path = key
      else if (indent == 2) path = parent "." key

      if (path == "port") keep(path, value, "int")
      else if (path == "remote-management.allow-remote") keep(path, value, "bool")
      else if (path == "remote-management.disable-control-panel") keep(path, value, "bool")
      else if (path == "auth-dir") keep(path, value, "string")
      else if (path == "api-keys") keep(path, value, "list")
      else if (path == "debug") keep(path, value, "bool")
      else if (path == "logging-to-file") keep(path, value, "bool")
      else if (path == "usage-statistics-enabled") keep(path, value, "bool")
      else if ((key == "port" || key == "allow-remote" ||
                key == "disable-control-panel" || key == "auth-dir" ||
                key == "api-keys" || key == "debug" ||
                key == "logging-to-file" ||
                key == "usage-statistics-enabled") &&
               path != "remote-management.secret-key") fail()
    }
    END {
      paths[1] = "port"
      paths[2] = "remote-management.allow-remote"
      paths[3] = "remote-management.disable-control-panel"
      paths[4] = "auth-dir"
      paths[5] = "api-keys"
      paths[6] = "debug"
      paths[7] = "logging-to-file"
      paths[8] = "usage-statistics-enabled"
      if (remote_sections != 1) bad = 1
      for (i = 1; i <= 8; i++) {
        path = paths[i]
        if (seen[path] != 1) bad = 1
      }
      if (bad) exit 1
      for (i = 1; i <= 8; i++) {
        path = paths[i]
        print path "=" values[path]
      }
    }
  '
}

# Seed the runtime config when absent; warn on non-secret drift otherwise.
seed_config() {
  local desired=$1 desired_projection runtime_projection
  mkdir -p "$CONFIG_DIR" "$AUTH_DIR"
  chmod 700 "$CONFIG_DIR" "$AUTH_DIR" 2>/dev/null || true
  if [ ! -f "$RUNTIME_CONFIG" ]; then
    if [ -n "$(ls -A "$AUTH_DIR" 2>/dev/null)" ]; then
      warn "auth/ is not empty at first seed — leftover credentials from the removed integration may be adopted into rotation; purge with: rm -rf \"$AUTH_DIR\"/* and re-run the provider logins"
    fi
    printf '%s\n' "$desired" >"$RUNTIME_CONFIG.tmp"
    mv "$RUNTIME_CONFIG.tmp" "$RUNTIME_CONFIG"
    printf 'provision-cli-proxy-api: seeded runtime config %s\n' "$RUNTIME_CONFIG"
  elif ! desired_projection=$(printf '%s\n' "$desired" | managed_config_projection) ||
    ! runtime_projection=$(managed_config_projection <"$RUNTIME_CONFIG") ||
    [ "$desired_projection" != "$runtime_projection" ]; then
    warn "runtime config drifts from the managed template (non-secret fields); re-seed with: rm \"$RUNTIME_CONFIG\" && chezmoi apply"
  fi
}

{{ if eq .chezmoi.os "linux" -}}
DESIRED_CONFIG=$(cat <<CPA_CONFIG_EOF
# CLIProxyAPI runtime config (Linux container). Seeded once by
# provision-cli-proxy-api; to change it, edit the script template and re-seed
# (delete this file, then chezmoi apply) — it is not a chezmoi target.
port: {{ $cpa.ports.proxy }}
remote-management:
  # CPAMP reaches CPA by container name over the dedicated quadlet network,
  # so management must accept non-loopback peers; the port itself stays
  # published on 127.0.0.1 only.
  allow-remote: true
  secret-key: $(yaml_quote "$MGMT_SECRET")
  # The full-mode panel is the separate cpa-manager-plus container; CPA never
  # hosts or downloads a panel here (no runtime GitHub fetch).
  disable-control-panel: true
auth-dir: "/CLIProxyAPI/auth"
api-keys: []
debug: false
logging-to-file: false
# CPAMP request monitoring consumes CPA's usage statistics.
usage-statistics-enabled: true
CPA_CONFIG_EOF
)
seed_config "$DESIRED_CONFIG"

# CPAMP credential files (one-shot, 0600 via umask), read through the
# *_FILE environment variables in cpa-manager-plus.container.
CPAMP_DIR="$BASE/cpamp"
SECRETS_DIR="$CPAMP_DIR/secrets"
mkdir -p "$SECRETS_DIR"
chmod 700 "$CPAMP_DIR" "$SECRETS_DIR" 2>/dev/null || true
ADMIN_SECRET=$(cat <<'CPA_SECRET_EOF'
{{ includeTemplate "secret-read.tmpl" (dict "ctx" . "ref" $cpa.cpamp.adminCredential) }}
CPA_SECRET_EOF
)
seed_secret() {
  local target=$1 value=$2
  if [ ! -f "$target" ]; then
    printf '%s' "$value" >"$target"
    printf 'provision-cli-proxy-api: seeded credential %s\n' "$target"
  fi
}
seed_secret "$SECRETS_DIR/management-key" "$MGMT_SECRET"
seed_secret "$SECRETS_DIR/admin-key" "$ADMIN_SECRET"

if ! command -v podman >/dev/null 2>&1; then
  warn "podman not found; quadlets are installed but the container rollout was skipped"
  exit 0
fi
if ! systemctl --user daemon-reload 2>/dev/null; then
  warn "user systemd manager unreachable (no login session?); quadlets installed, rollout deferred until the next source change or 'chezmoi apply --force'"
  exit 0
fi

CPA_IMAGE={{ includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "cli-proxy-api" "field" "imageRef") | quote }}
CPAMP_IMAGE={{ includeTemplate "release-lock-ref.tmpl" (dict "ctx" . "tool" "cpa-manager-plus" "field" "imageRef") | quote }}
# Restart when the pinned image refs OR the rendered quadlet content changes —
# a Volume/PublishPort/Environment edit must roll out too, not just a digest
# bump. The deployed unit files are chezmoi targets already on disk before
# this onchange script runs.
QUADLET_DIR="$HOME/.config/containers/systemd"
quadlet_digest=$(cat "$QUADLET_DIR/cli-proxy-api.container" "$QUADLET_DIR/cli-proxy-api.network" "$QUADLET_DIR/cpa-manager-plus.container" 2>/dev/null | sha256sum | cut -d' ' -f1)
STAMP="$BASE/.rolled-out-refs"
DESIRED_REFS="cli-proxy-api=$CPA_IMAGE cpa-manager-plus=$CPAMP_IMAGE quadlets=$quadlet_digest"
if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP" 2>/dev/null)" != "$DESIRED_REFS" ]; then
  podman pull "$CPA_IMAGE"
  podman pull "$CPAMP_IMAGE"
  # One transaction: After= in the CPAMP unit keeps the stop CPAMP-first and
  # the start CPA-first. restart starts inactive services.
  systemctl --user restart cli-proxy-api.service cpa-manager-plus.service
  printf '%s\n' "$DESIRED_REFS" >"$STAMP"
  printf 'provision-cli-proxy-api: rolled out %s and %s\n' "$CPA_IMAGE" "$CPAMP_IMAGE"
fi

{{ else -}}
# macOS: binary + launchd delivery, same data-root convention. The managed
# source config deploys to ~/.config/cli-proxy-api/config.yaml (darwin-only)
# and serves as the seed template; it keeps secret-key: "" and the secret is
# injected only into this runtime copy.
SOURCE_CONFIG="$HOME/.config/cli-proxy-api/config.yaml"
if [ ! -f "$SOURCE_CONFIG" ]; then
  warn "managed source config missing: $SOURCE_CONFIG"
  exit 0
fi
source_content=$(cat "$SOURCE_CONFIG")
pattern='secret-key: ""'
replacement="secret-key: $(yaml_quote "$MGMT_SECRET")"
DESIRED_CONFIG=${source_content/"$pattern"/"$replacement"}
seed_config "$DESIRED_CONFIG"

LABEL=dev.h82.cli-proxy-api
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
if [ ! -f "$PLIST" ]; then
  warn "launchd plist missing: $PLIST"
  exit 0
fi
uid=$(id -u)
if launchctl print "gui/$uid/$LABEL" >/dev/null 2>&1; then
  launchctl kickstart -k "gui/$uid/$LABEL" ||
    warn "launchctl kickstart failed; the agent keeps its previous state"
else
  launchctl bootstrap "gui/$uid" "$PLIST" ||
    warn "launchctl bootstrap failed (no GUI session?); the agent loads at next login"
fi

{{ end -}}
{{ end -}}
