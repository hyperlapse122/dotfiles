{{- if eq .chezmoi.os "windows" -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$expectedFingerprint = '{{ .user.gpgPubKey }}'.Replace(' ', '').ToUpperInvariant()
$secretReference = 'op://tjlmijoc5qxj6vypdnvxf6s2sq/gmwqu34rldszc6qtas2i3ejiaq/4v5dbrerpkyiueq2st26sswzna'
$scratchRoot = if ($env:TEMP) { $env:TEMP } else { Join-Path $HOME 'AppData/Local/Temp' }
$scratch = Join-Path $scratchRoot ("chezmoi-gpg-" + [guid]::NewGuid().ToString('N'))
$keyFile = Join-Path $scratch 'private-key.asc'
$probeHome = Join-Path $scratch 'probe-gnupg'

try {
    New-Item -ItemType Directory -Path $scratch, $probeHome -Force | Out-Null
    & icacls $scratch '/inheritance:r' "/grant:r" "$($env:USERNAME):(OI)(CI)F" | Out-Null
    if ($LASTEXITCODE -ne 0) { throw 'gpg import: cannot restrict transient directory permissions' }
    & op read '--out-file' $keyFile $secretReference
    if ($LASTEXITCODE -ne 0 -or -not (Test-Path -LiteralPath $keyFile)) {
        throw 'gpg import: named human step required: sign in to the 1Password desktop app and enable CLI integration.'
    }
    $fingerprints = & gpg '--homedir' $probeHome '--batch' '--with-colons' '--import-options' 'show-only' '--import' $keyFile |
        Where-Object { $_ -like 'fpr:*' } |
        ForEach-Object { ($_ -split ':')[9].ToUpperInvariant() }
    if ($LASTEXITCODE -ne 0) { throw 'gpg import: cannot inspect the candidate key' }
    if ($fingerprints -notcontains $expectedFingerprint) {
        throw "gpg import: fingerprint mismatch; expected $expectedFingerprint"
    }
    & gpg '--batch' '--import' $keyFile | Out-Null
    if ($LASTEXITCODE -ne 0) { throw 'gpg import: key import failed' }
    "$expectedFingerprint`:6:" | & gpg '--batch' '--import-ownertrust'
    if ($LASTEXITCODE -ne 0) { throw 'gpg import: ownertrust import failed' }
} finally {
    if (Test-Path -LiteralPath $keyFile) {
        [IO.File]::WriteAllBytes($keyFile, [byte[]]::new(0))
    }
    if (Test-Path -LiteralPath $scratch) {
        Remove-Item -LiteralPath $scratch -Recurse -Force -ErrorAction SilentlyContinue
    }
}
{{- end -}}
