{
  "$schema": "https://t3.codes/schema/t3.json",
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Setup",
      "command": "mise trust -yq && mise install -yq && git config core.hooksPath .githooks",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Format",
      "command": "nix fmt",
      "icon": "lint"
    },
    {
      "name": "Flake check",
      "command": "nix flake check",
      "icon": "test"
    },
    {
      "name": "VM checks",
      "command": "nix build --no-link .#vmChecks.all",
      "icon": "test"
    }
  ]
}
