{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": ".ci/support-matrix.schema.json",
  "title": "Canonical cross-platform workstation support matrix snapshot",
  "description": "Strict schema for .ci/support-matrix.json. Covers exactly Fedora x64/arm64, Windows 11 x64/arm64, and macOS arm64 with exact hosted-runner labels. Moving aliases (any label containing 'latest') are rejected. Unknown or missing fields are rejected. The canonical digest of a matrix document is sha256 of its canonical JSON (object keys sorted recursively, no whitespace); device evidence binds to that digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotDate", "targets"],
  "properties": {
    "$schema": { "const": "./support-matrix.schema.json" },
    "schemaVersion": { "const": 1 },
    "snapshotDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "UTC date the snapshot was taken, YYYY-MM-DD."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "os": { "enum": ["fedora", "windows", "macos"] },
    "arch": { "enum": ["x64", "arm64"] },
    "runnerLabel": {
      "type": "string",
      "pattern": "^(?!.*latest)(?=.*[0-9])[a-z0-9][a-z0-9.-]*$",
      "description": "Exact pinned hosted-runner label; moving aliases such as macos-latest are rejected."
    },
    "runtimeArch": {
      "type": "string",
      "pattern": "^(x86_64|aarch64|amd64|AMD64|arm64|ARM64)$",
      "description": "Raw uname -m / PROCESSOR_ARCHITECTURE spelling asserted by the job."
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "arch", "kind", "runsOn", "container", "runtimeArch"],
          "properties": {
            "os": { "$ref": "#/$defs/os" },
            "arch": { "$ref": "#/$defs/arch" },
            "kind": { "const": "hosted" },
            "runsOn": { "$ref": "#/$defs/runnerLabel" },
            "container": {
              "type": "string",
              "pattern": "^fedora:[0-9]+$",
              "description": "Pinned Fedora container image tag; never a moving tag."
            },
            "runtimeArch": { "$ref": "#/$defs/runtimeArch" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "arch", "kind", "runsOn", "runtimeArch"],
          "properties": {
            "os": { "$ref": "#/$defs/os" },
            "arch": { "$ref": "#/$defs/arch" },
            "kind": { "const": "hosted" },
            "runsOn": { "$ref": "#/$defs/runnerLabel" },
            "runtimeArch": { "$ref": "#/$defs/runtimeArch" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "arch", "kind", "deviceId", "runtimeArch"],
          "properties": {
            "os": { "$ref": "#/$defs/os" },
            "arch": { "$ref": "#/$defs/arch" },
            "kind": { "const": "device" },
            "deviceId": { "$ref": "#/$defs/deviceId" },
            "runtimeArch": { "$ref": "#/$defs/runtimeArch" }
          }
        }
      ]
    }
  }
}
