#!/usr/bin/env bash
# Hermetic fake of macOS profiles(1) for the import-wifi-1password-macos
# fixtures. Logs its full argv (one call per line) to $TEST_LOG so the caller
# can scan for verb counts AND prove no secret ever rode a command line; never
# prints profile file contents.
#
# Controls (environment):
#   TEST_LOG                       required; argv log path.
#   TEST_STATE_DIR                 required for BLOCK/CONFLICT modes.
#   WIFI_FAKE_FAIL_STAGE=install|remove   exit 42 on every call with that verb.
#   WIFI_FAKE_INSTALL_CONFLICT_ONCE=1     first `install` exits 1 (simulating a
#                                         stale profile already present); the
#                                         retry after `remove` succeeds.
#   WIFI_FAKE_BLOCK=install               on `install`, touch
#                                         $TEST_STATE_DIR/blocked and wait for
#                                         $TEST_STATE_DIR/unblock (the
#                                         interruption fixture kills the tool
#                                         while this fake is parked here).
set -euo pipefail

printf 'profiles' >>"$TEST_LOG"
printf ' %q' "$@" >>"$TEST_LOG"
printf '\n' >>"$TEST_LOG"

verb=${1:-}

if [[ ${WIFI_FAKE_BLOCK:-} == "$verb" && -n "$verb" ]]; then
  : >"$TEST_STATE_DIR/blocked"
  # Also give up if the parent (the tool under test) died without unblocking,
  # so a fixture mistake can never hang a run.
  until [[ -f "$TEST_STATE_DIR/unblock" ]] || ! kill -0 "$PPID" 2>/dev/null; do sleep 0.05; done
fi

if [[ -n "$verb" && ${WIFI_FAKE_FAIL_STAGE:-} == "$verb" ]]; then
  exit 42
fi

case "$verb" in
  install)
    if [[ ${WIFI_FAKE_INSTALL_CONFLICT_ONCE:-} == 1 && ! -f "$TEST_STATE_DIR/install-conflicted" ]]; then
      : >"$TEST_STATE_DIR/install-conflicted"
      exit 1
    fi
    exit 0
    ;;
  remove)
    exit 0
    ;;
  *)
    exit 2
    ;;
esac
