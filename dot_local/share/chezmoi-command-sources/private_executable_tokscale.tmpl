#!/usr/bin/env bash

set -euo pipefail

if ! command -v mise >/dev/null 2>&1; then
  printf 'tokscale: `mise` not found on PATH\n' >&2
  exit 127
fi

extra_dirs="${TOKSCALE_EXTRA_DIRS:-}"
shopt -s nullglob dotglob
for sessions_dir in "$HOME"/.config/orca/codex-accounts/*/home/sessions; do
  [[ -d "$sessions_dir" ]] || continue
  extra_dirs="${extra_dirs:+$extra_dirs,}codex:$sessions_dir"
done

exec mise --no-config --no-env --no-hooks exec -y node -- env \
  TOKSCALE_EXTRA_DIRS="$extra_dirs" \
  TOKSCALE_DEVICE_NAME="{{ if eq .chezmoi.os "darwin" }}$(sysctl -n hw.model){{ else }}$(cat /sys/devices/virtual/dmi/id/product_name){{ end }}" \
  npx -y tokscale "$@"
