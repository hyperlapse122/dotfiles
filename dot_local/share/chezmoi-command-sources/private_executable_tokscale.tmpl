#!/usr/bin/env bash

set -euo pipefail

if ! command -v bun >/dev/null 2>&1; then
  printf 'tokscale: `bun` not found on PATH\n' >&2
  exit 127
fi

extra_dirs="${TOKSCALE_EXTRA_DIRS:-}"
shopt -s nullglob dotglob
for sessions_dir in "$HOME"/.config/orca/codex-accounts/*/home/sessions; do
  [[ -d "$sessions_dir" ]] || continue
  extra_dirs="${extra_dirs:+$extra_dirs,}codex:$sessions_dir"
done

TOKSCALE_EXTRA_DIRS="$extra_dirs" TOKSCALE_DEVICE_NAME="$(cat /sys/devices/virtual/dmi/id/product_name)" bun x tokscale@latest "$@"
