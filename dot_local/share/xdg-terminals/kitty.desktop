# ~/.local/share/xdg-terminals/kitty.desktop — managed by chezmoi.
#
# Declares kitty as a terminal provider for xdg-terminal-exec (the freedesktop
# default-terminal resolver). xdg-terminal-exec scans the `xdg-terminals`
# subdirectory of the XDG *data* search path — $XDG_DATA_HOME/xdg-terminals
# (here, ~/.local/share/xdg-terminals) and $XDG_DATA_DIRS/xdg-terminals
# (/usr/share/xdg-terminals) — NEVER XDG_CONFIG_HOME. A user-data-dir entry here
# has the HIGHEST precedence over system entries, so once the
# `xdg-terminal-exec` package (see packages.yaml) is installed this makes kitty
# the resolved default terminal for consumers that ask for one — GNOME's
# Terminal portal and the freedesktop default-terminal resolver (and Plasma
# 6.2+, as the KDE fallback when kdeglobals [General] TerminalApplication is not
# honored).
#
# This is a per-user drop-in (no sudo), mirroring the set-default-browser
# philosophy. App-data .desktop files belong under dot_local/share/ (see the
# existing applications/ entries), NOT dot_config/. Takes effect ONLY when
# xdg-terminal-exec is installed.
[Desktop Entry]
Type=Application
Name=kitty
Exec=kitty
Icon=kitty
NoDisplay=true
