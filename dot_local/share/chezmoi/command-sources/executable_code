#!/usr/bin/env bash
#
# code — VS Codium shim. Runs `codium` so the `code` command works in
# interactive and non-interactive shells.
#
# A real executable on PATH also covers scripts and tools that shell out to
# `code`, including editor settings and "open in editor" integrations.
#
# POSIX counterpart of code.ps1 (Windows).
#
# Dependencies: `codium` on PATH (VS Codium install).

set -euo pipefail

if ! command -v codium >/dev/null 2>&1; then
  printf 'code: `codium` not found on PATH (install VS Codium)\n' >&2
  exit 127
fi

exec codium "$@"
