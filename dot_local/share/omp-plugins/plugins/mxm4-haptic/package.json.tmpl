{{- $waveforms := list
  "SHARP STATE CHANGE" "DAMP STATE CHANGE" "SHARP COLLISION" "DAMP COLLISION"
  "SUBTLE COLLISION" "HAPPY ALERT" "ANGRY ALERT" "COMPLETED" "SQUARE" "WAVE"
  "FIREWORK" "MAD" "KNOCK" "JINGLE" "RINGING" "WHISPER COLLISION" -}}
{{- range $event, $waveform := .haptic.omp -}}
{{- if not (has $waveform $waveforms) -}}
{{- fail (printf "haptic.omp.%s = %q is not a known mxm4-haptic waveform; valid names: %s" $event $waveform (join ", " $waveforms)) -}}
{{- end -}}
{{- end -}}
{
  "name": "@h82/omp-mxm4-haptic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OMP lifecycle haptics delivered through the mxm4-hapticd daemon.",
  "license": "UNLICENSED",
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "mxm4Haptic": {
    "waveforms": {
      "settled": {{ .haptic.omp.settled | quote }},
      "failed": {{ .haptic.omp.failed | quote }},
      "question": {{ .haptic.omp.question | quote }}
    }
  }
}
