{{- $plugins := list -}}
{{- if hasKey .agents "agentPlugins" -}}
{{-   range .agents.agentPlugins.external -}}
{{-     $desc := printf "Portable Agent Plugin %s" .name -}}
{{-     if hasKey . "description" -}}{{- $desc = .description -}}{{- end -}}
{{-     $plugins = append $plugins (dict "name" .name "description" $desc "source" (printf "./plugins/%s" .name)) -}}
{{-   end -}}
{{- end -}}
{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "h82-dotfiles",
  "description": "Local OMP plugins deployed by this chezmoi repository.",
  "owner": {
    "name": "Joosung Park",
    "email": "iam@h82.dev"
  },
  "plugins": {{ toJson $plugins }}
}
