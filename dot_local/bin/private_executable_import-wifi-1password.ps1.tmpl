#!/usr/bin/env pwsh
#Requires -Version 5.1
<#
.SYNOPSIS
    import-wifi-1password.ps1 — provision Windows Wi-Fi profiles declaratively
    from .chezmoidata/networking.yaml (networking.wifi).

    import-wifi-1password.ps1              # add/overwrite every network in the manifest
    import-wifi-1password.ps1 -DryRun      # show what would change; change nothing
    import-wifi-1password.ps1 -Force       # delete + recreate existing profiles

.DESCRIPTION
    Windows native counterpart to the Linux import-wifi-1password (NetworkManager)
    tool: same manifest, same declarative model, same render-time 1Password
    resolution — but built on native Windows Wi-Fi APIs (CIM discovery and
    netsh wlan profile mutation), never on any Linux convention.

    MODEL: each run converges the per-user WLAN profile store to the manifest.
    A network with no matching profile is ADDED; one that already exists is
    OVERWRITTEN in place (`netsh wlan add profile` replaces a same-name profile
    without dropping an active link). -Force instead deletes each profile by
    name first and re-adds it for a guaranteed-clean slate.

    SECRETS — the load-bearing rules of this tool:
    * ssid/psk op:// references are resolved at chezmoi RENDER time and baked
      into the JSON manifest below — which is why this source is `private_`
      (owner-only) and Windows-gated in dot_local/bin/.chezmoiignore. There is
      NO 1Password / `op` dependency at runtime.
    * A PSK is NEVER placed on a command line: netsh learns the key from an
      owner-only TRANSIENT WLAN profile XML file, imported via
      `netsh wlan add profile filename=... user=current`. Nothing this tool
      invokes receives a secret argument, and no output it prints contains one.
    * The transient directory (random name under %TEMP%, ACL: inheritance
      disabled, only the current user FullControl) and every plaintext variable
      are destroyed in ONE shared `finally` path — reached on success, on a
      rejected manifest entry, on a failed netsh call, on Ctrl+C cancellation
      (PipelineStoppedException unwinds through finally), and on any error
      (ErrorActionPreference Stop). There is no second cleanup site.
    * After import the profile belongs to the OS store (WLAN AutoConfig, scoped
      user=current); this tool leaves its ownership and lifetime to Windows.

    PLATFORM LIMITS (native, by design): a netsh WLAN profile cannot carry DNS
    servers, and per-interface DNS (netsh interface ip / Set-DnsClientServerAddress)
    is live-interface state, not per-network profile state — so manifest DNS and
    ignoreAutoDns entries are warned about and IGNORED. `priority` is applied
    natively via `netsh wlan set profileorder`: networks with an explicit
    priority are ranked (highest first) into positions 1..k on the single
    wireless interface; unprioritized networks keep their existing order.

    APPLY INTEGRATION: -FromApply mirrors the Linux tool — quieter, and every
    "environment not ready" condition (no netsh, no wireless interface) exits 0
    so it can never abort an apply.

.NOTES
    Windows-only BY DESIGN: CIM and netsh wlan are native Windows API surfaces. The
    dot_local/bin/.chezmoiignore `*.ps1` gate keeps this file off POSIX hosts,
    so op:// secrets are never resolved into a macOS/Linux copy. Per the
    script-parity exception in AGENTS.md, the POSIX counterparts are separate
    native sources, not translations of this file.
#>
[CmdletBinding()]
param(
  [switch]$DryRun,
  [switch]$Force,
  [switch]$FromApply,
  # Test seam: production uses the locale-independent Win32_NetworkAdapter
  # CIM class. Fixtures inject equivalent typed adapter records, never text.
  [Parameter(DontShow)]
  [scriptblock]$WirelessInterfaceProvider = {
    @(Get-CimInstance -ClassName Win32_NetworkAdapter -Filter 'AdapterTypeID = 9 AND NetConnectionID IS NOT NULL')
  }
)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

# Counters (script scope; mutated by the per-network pass).
$script:Added = 0
$script:Skipped = 0
$script:Failed = 0

# Transient secret state — owned by the single finally path in Main. Both start
# empty; the finally removes the directory (if created) and clears every
# variable that ever held a plaintext PSK.
$script:TransientDir = $null
$script:Prioritized = $null

# Network manifest, rendered from .chezmoidata/networking.yaml with every op://
# ref resolved to its 1Password value (this is why the source is private_ —
# the JSON below holds the real PSKs). EDIT .chezmoidata/networking.yaml, never
# this deployed copy. The single-quoted PowerShell here-string does no
# expansion; resolve-op-refs-json.tmpl emits valid JSON (toJson-escaped) parsed
# by ConvertFrom-Json at runtime.
$script:WifiConfigJson = @'
{{ includeTemplate "resolve-op-refs-json.tmpl" (dict "value" .networking.wifi "ctx" $) }}
'@

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
function Write-ToolLog([string]$Message) {
  Write-Host "import-wifi-1password: $Message"
}
# Vlog: chatter suppressed under -FromApply to keep `chezmoi apply` quiet.
function Write-ToolVlog([string]$Message) {
  if (-not $FromApply) { Write-Host "import-wifi-1password: $Message" }
}
function Write-ToolWarn([string]$Message) {
  Write-Host "import-wifi-1password: $Message" -ForegroundColor Yellow
}

# ---------------------------------------------------------------------------
# Exit helpers
# ---------------------------------------------------------------------------

# "Environment not ready": clean skip (exit 0) under -FromApply; failure (exit 1)
# when run by hand. Never carries secret material.
function Exit-EnvironmentNotReady([string]$Message) {
  if ($FromApply) {
    [Console]::Error.WriteLine("import-wifi-1password: skipped ($Message)")
    exit 0
  }
  [Console]::Error.WriteLine("import-wifi-1password: $Message")
  exit 1
}

# ---------------------------------------------------------------------------
# Transient owner-only profile directory
# ---------------------------------------------------------------------------

# New-TransientDir: create the random-named transient directory under %TEMP%
# with an owner-only ACL (inheritance disabled and removed; only the current
# user keeps FullControl). Called lazily before the first profile write; the
# finally in Main removes it on EVERY exit path.
function New-TransientDir {
  if ($null -ne $script:TransientDir) { return }
  $name = 'wifi-import-{0}-{1}' -f $PID, ([Guid]::NewGuid().ToString('N').Substring(0, 12))
  $dir = Join-Path ([IO.Path]::GetTempPath()) $name
  New-Item -ItemType Directory -Path $dir | Out-Null
  $acl = Get-Acl -LiteralPath $dir
  $acl.SetAccessRuleProtection($true, $false) # disable inheritance, drop inherited rules
  foreach ($rule in @($acl.Access)) {
    $acl.RemoveAccessRule($rule) | Out-Null
  }
  $identity = [System.Security.Principal.WindowsIdentity]::GetCurrent().User
  $grant = New-Object System.Security.AccessControl.FileSystemAccessRule(
    $identity, 'FullControl',
    ([System.Security.AccessControl.InheritanceFlags]::ContainerInherit -bor
     [System.Security.AccessControl.InheritanceFlags]::ObjectInherit),
    [System.Security.AccessControl.PropagationFlags]::None,
    [System.Security.AccessControl.AccessControlType]::Allow)
  $acl.SetAccessRule($grant)
  Set-Acl -LiteralPath $dir -AclObject $acl
  $script:TransientDir = $dir
}

# ---------------------------------------------------------------------------
# netsh helpers — secrets NEVER appear in any argument list
# ---------------------------------------------------------------------------

# Invoke-Netsh <stage> <args...>: run netsh with output suppressed (netsh text
# is localized and carries no secrets, but nothing here is logged anyway).
# Throws a stage-named error on nonzero exit; the caller counts FAILED. The
# stage name and verb are the only things ever reported — never file contents.
function Invoke-Netsh([string]$Stage, [string[]]$Arguments) {
  & netsh @Arguments | Out-Null
  if ($LASTEXITCODE -ne 0) {
    throw "netsh $Stage failed (exit $LASTEXITCODE)"
  }
}

# Get-WirelessInterfaces: interface aliases from Win32_NetworkAdapter.
# AdapterTypeID 9 is the schema-defined wireless type, and NetConnectionID is
# the alias accepted by netsh profileorder. Both are typed CIM properties, so
# discovery is independent of localized netsh labels and output formatting.
# The provider parameter keeps this hardware query hermetically testable.
function Get-WirelessInterfaces {
  $names = New-Object System.Collections.Generic.List[string]
  try {
    $adapters = @(& $WirelessInterfaceProvider)
  } catch {
    return @()
  }
  foreach ($adapter in $adapters) {
    if ([int]$adapter.AdapterTypeID -ne 9) { continue }
    $name = [string]$adapter.NetConnectionID
    if (-not [string]::IsNullOrWhiteSpace($name)) { $names.Add($name) }
  }
  return $names.ToArray()
}

# ConvertTo-HexSsid <ssid>: UTF-8 bytes as lowercase hex, for the profile's
# SSIDConfig/SSID/hex element.
function ConvertTo-HexSsid([string]$Ssid) {
  $bytes = [System.Text.Encoding]::UTF8.GetBytes($Ssid)
  return ($bytes | ForEach-Object { $_.ToString('x2') }) -join ''
}

# Write-WlanProfileXml <ssid> <psk> : build the WLAN profile XML (WPA2-personal
# passPhrase when <psk> is non-empty, open/none otherwise) and write it to a
# file inside the owner-only transient directory. Returns the file path. The
# PSK appears ONLY inside that file — never in an argument, log, or output.
function Write-WlanProfileXml([string]$Ssid, [string]$Psk) {
  New-TransientDir
  $name = [System.Security.SecurityElement]::Escape($Ssid)
  $hex = ConvertTo-HexSsid $Ssid
  if ($Psk.Length -gt 0) {
    $key = [System.Security.SecurityElement]::Escape($Psk)
    $security = @"
      <authEncryption>
        <authentication>WPA2PSK</authentication>
        <encryption>AES</encryption>
        <useOneX>false</useOneX>
      </authEncryption>
      <sharedKey>
        <keyType>passPhrase</keyType>
        <protected>false</protected>
        <keyMaterial>$key</keyMaterial>
      </sharedKey>
"@
  } else {
    $security = @"
      <authEncryption>
        <authentication>open</authentication>
        <encryption>none</encryption>
        <useOneX>false</useOneX>
      </authEncryption>
"@
  }
  $xml = @"
<?xml version="1.0"?>
<WLANProfile xmlns="http://www.microsoft.com/networking/WLAN/profile/v1">
  <name>$name</name>
  <SSIDConfig>
    <SSID>
      <hex>$hex</hex>
      <name>$name</name>
    </SSID>
    <nonBroadcast>false</nonBroadcast>
  </SSIDConfig>
  <connectionType>ESS</connectionType>
  <connectionMode>auto</connectionMode>
  <MSM>
    <security>
$security
    </security>
  </MSM>
</WLANProfile>
"@
  $file = Join-Path $script:TransientDir ('profile-{0}.xml' -f $hex.Substring(0, [Math]::Min(16, $hex.Length)))
  [System.IO.File]::WriteAllText($file, $xml, (New-Object System.Text.UTF8Encoding($false)))
  return $file
}

# Get-Prop <obj> <name> : StrictMode-safe optional property read (manifest
# networks omit ipv4/ipv6/priority/psk keys, and StrictMode throws on a missing
# property access).
function Get-Prop($Obj, [string]$Name) {
  if ($null -eq $Obj) { return $null }
  $prop = $Obj.PSObject.Properties[$Name]
  if ($null -eq $prop) { return $null }
  return $prop.Value
}

# ---------------------------------------------------------------------------
# Per-network processing
# ---------------------------------------------------------------------------

# Process-Network <net> : one manifest network (defaults already merged by the
# main pass). Updates the script-scope counters. Never logs the PSK.
function Process-Network($Net) {
  $ssid = [string]($Net.ssid)
  $psk = [string]($Net.psk)
  $prio = $Net.priority
  $dns4 = @($Net.dns4)
  $dns6 = @($Net.dns6)
  $ignore = [bool]$Net.ignoreAutoDns

  if ([string]::IsNullOrEmpty($ssid)) {
    Write-ToolWarn 'a network entry has no ssid (empty after op:// resolution); skipping'
    $script:Failed++
    return
  }
  # netsh set profileorder takes positions 1..N; the manifest's NM-range
  # (-999..999) value is used only to RANK networks, so any integer is valid —
  # but a non-integer would make the sort meaningless, so warn and ignore.
  $prioRank = $null
  if ($null -ne $prio) {
    $asInt = 0
    if ([int]::TryParse([string]$prio, [ref]$asInt)) { $prioRank = $asInt }
    else { Write-ToolWarn "network `"$ssid`": priority `"$prio`" is not an integer; ignoring" }
  }

  if ($dns4.Count -gt 0 -or $dns6.Count -gt 0 -or $ignore) {
    Write-ToolWarn "network `"$ssid`": netsh WLAN profiles cannot carry DNS; ignoring dns/ignoreAutoDns (configure per-interface DNS separately)"
  }

  $desc = if ($psk.Length -gt 0) { 'wpa2-psk' } else { 'open' }
  if ($null -ne $prioRank) { $desc = "$desc, prio $prioRank" }

  if ($DryRun) {
    if ($Force) { Write-ToolLog "would replace `"$ssid`" ($desc)" }
    else { Write-ToolLog "would add/update `"$ssid`" ($desc)" }
    $script:Added++
  } else {
    try {
      if ($Force) {
        # Clean slate: delete by name first (an absent profile is not an error
        # for the converge model), then re-add.
        & netsh wlan delete profile name="$ssid" | Out-Null
      }
      $profileFile = Write-WlanProfileXml -Ssid $ssid -Psk $psk
      Invoke-Netsh -Stage 'add profile' -Arguments @('wlan', 'add', 'profile', "filename=$profileFile", 'user=current')
      Write-ToolVlog "added/updated `"$ssid`" ($desc)"
      $script:Added++
    } catch {
      Write-ToolWarn "failed to add `"$ssid`": $($_.Exception.Message)"
      $script:Failed++
    }
  }

  # Record the rank for the profileorder pass in Main (dry-run included, so
  # the plan is fully visible).
  if ($null -ne $prioRank) {
    $script:Prioritized.Add([pscustomobject]@{ Ssid = $ssid; Rank = $prioRank })
  }
}

# ---------------------------------------------------------------------------
# Main — the ONE cleanup path is the finally below
# ---------------------------------------------------------------------------
function Main {
  $script:Prioritized = New-Object System.Collections.Generic.List[object]
  try {
    # Preflight — all "environment not ready" -> clean skip under -FromApply.
    if (-not (Get-Command 'netsh' -ErrorAction SilentlyContinue)) {
      Exit-EnvironmentNotReady 'netsh not found'
    }
    $interfaces = @(Get-WirelessInterfaces)
    if ($interfaces.Count -eq 0) {
      Exit-EnvironmentNotReady 'no wireless interface on this system'
    }

    $config = $null
    try {
      $config = $script:WifiConfigJson | ConvertFrom-Json -ErrorAction Stop
    } catch {
      throw "embedded networking manifest is not valid JSON: $($_.Exception.Message)"
    }
    $networks = @(Get-Prop $config 'networks')
    if ($networks.Count -eq 0) {
      Write-ToolVlog 'no networks defined in networking.yaml; nothing to do'
      return
    }

    # Merge defaults into each network per-family (per-network ipv4.dns /
    # ipv6.dns / ignoreAutoDns win over defaults). Needed on Windows only to
    # decide whether to warn that DNS is unsupported — but merged exactly like
    # the Linux tool so the warning matches the effective manifest.
    $defaults = Get-Prop $config 'defaults'
    foreach ($net in $networks) {
      $dns4 = Get-Prop (Get-Prop $net 'ipv4') 'dns'
      if ($null -eq $dns4) { $dns4 = Get-Prop (Get-Prop $defaults 'ipv4') 'dns' }
      $dns6 = Get-Prop (Get-Prop $net 'ipv6') 'dns'
      if ($null -eq $dns6) { $dns6 = Get-Prop (Get-Prop $defaults 'ipv6') 'dns' }
      $ignoreAuto = Get-Prop $net 'ignoreAutoDns'
      if ($null -eq $ignoreAuto) { $ignoreAuto = Get-Prop $defaults 'ignoreAutoDns' }
      Process-Network ([pscustomobject]@{
        ssid          = [string](Get-Prop $net 'ssid')
        psk           = [string](Get-Prop $net 'psk')
        priority      = Get-Prop $net 'priority'
        dns4          = @($dns4)
        dns6          = @($dns6)
        ignoreAutoDns = [bool]$ignoreAuto
      })
    }

    # Autoconnect priority, applied natively: rank the networks that declare a
    # priority (highest first) into profileorder positions 1..k. Requires a
    # single wireless interface — with several, the target would be ambiguous.
    if ($script:Prioritized.Count -gt 0) {
      $ordered = $script:Prioritized | Sort-Object -Property Rank -Descending
      if ($DryRun) {
        $position = 1
        foreach ($entry in $ordered) {
          Write-ToolLog "would set profileorder `"$($entry.Ssid)`" -> position $position"
          $position++
        }
      } elseif ($interfaces.Count -eq 1) {
        $position = 1
        foreach ($entry in $ordered) {
          try {
            Invoke-Netsh -Stage 'set profileorder' -Arguments @(
              'wlan', 'set', 'profileorder', "name=`"$($entry.Ssid)`"",
              "interface=`"$($interfaces[0])`"", "priority=$position")
            $position++
          } catch {
            Write-ToolWarn "failed to order `"$($entry.Ssid)`": $($_.Exception.Message)"
            $script:Failed++
          }
        }
      } else {
        Write-ToolWarn "$($interfaces.Count) wireless interfaces; skipping profileorder (ambiguous target)"
        $script:Skipped++
      }
    }

    if ($DryRun) {
      Write-ToolLog "dry run — $script:Added would add/replace, $script:Skipped skipped, $script:Failed problem(s); no changes made"
      return
    }
    if ($FromApply) {
      if ($script:Added -gt 0 -or $script:Failed -gt 0) {
        Write-ToolLog "$script:Added added/updated, $script:Skipped skipped, $script:Failed failed"
      }
      return
    }
    Write-ToolLog "$script:Added added/updated, $script:Skipped skipped, $script:Failed failed"
    if ($script:Failed -gt 0) { exit 1 }
  } finally {
    # THE shared plaintext teardown: reached on success, rejected entries,
    # failed netsh calls, Ctrl+C cancellation, and any thrown error. Removes
    # the owner-only transient directory (every WLAN profile XML holding a
    # PSK) and drops every variable that held resolved secrets. Profile data
    # already imported lives on in the OS store, owned by Windows.
    if ($null -ne $script:TransientDir) {
      Remove-Item -LiteralPath $script:TransientDir -Recurse -Force -ErrorAction SilentlyContinue
      $script:TransientDir = $null
    }
    $script:WifiConfigJson = $null
    $script:Prioritized = $null
  }
}

Main
