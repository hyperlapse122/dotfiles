#!/usr/bin/env bash
#
# auth-cloud — interactive OAuth helper and service activator for cloud drives and PIM.
#
# Unified operator entry point for initial OAuth authentication, token refresh
# on expiry, service activation, and status inspection across Google, Personal
# Microsoft, and Corporate Microsoft accounts.
#
# Usage:
#   auth-cloud [-w|--web] [-d|--device] [-f|--force] [-s|--status] [target ...]
#
# Targets:
#   all               all cloud accounts (default)
#   gdrive            personal Google Drive rclone mount
#   onedrive          personal Microsoft OneDrive rclone mount
#   onedrive-corp     corporate Microsoft OneDrive for Business rclone mount
#   corporate         corporate Microsoft Exchange/Graph PIM (DavMail + Akonadi)
#   personal          personal Microsoft Outlook.com PIM (DavMail + Akonadi)
#   google            personal Google PIM (KDE Online Accounts / KAccounts)
#   entra-bootstrap   print copyable az CLI template for Entra app registration
#   status            probe token & service status across all accounts
#
# Flow:
#   --web             browser OAuth flow (default when a display is available)
#   --device          OAuth device authorization flow for headless / SSH sessions
#
set -euo pipefail

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$PATH:$HOME/.local/bin" ;;
esac
export PATH

RCLONE_CONFIG="${RCLONE_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/rclone/rclone.conf}"
DAVMAIL_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/davmail"
DAVMAIL_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/davmail"
DAVMAIL_JAR="${DAVMAIL_JAR_PATH:-$HOME/.local/lib/davmail/davmail.jar}"
AKONADI_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/akonadi"

usage() {
  cat <<'EOF'
Usage: auth-cloud [-w|--web] [-d|--device] [-f|--force] [-s|--status] [target ...]

Interactive OAuth login, token refresh, and service activation for cloud drives and PIM.

Options:
  -w, --web        browser OAuth flow (default when a display is available)
  -d, --device     OAuth device authorization flow for headless / SSH sessions
  -f, --force      re-authenticate even if already configured with valid tokens
  -s, --status     probe token and service health across all accounts
  -h, --help       show this help

Targets:
  all              all accounts (gdrive, onedrive, onedrive-corp, corporate, personal, google) [default]
  gdrive           personal Google Drive (rclone mount)
  onedrive         personal Microsoft OneDrive (rclone mount)
  onedrive-corp    corporate Microsoft OneDrive for Business (rclone mount)
  corporate        corporate Microsoft Exchange/Graph PIM (DavMail CalDAV + Akonadi)
  personal         personal Microsoft Outlook.com PIM (DavMail CalDAV + Akonadi)
  google           personal Google Calendar & Tasks (KDE Online Accounts)
  entra-bootstrap  print copyable Azure CLI command to register corporate Entra app
  status           inspect tokens, systemd services, and degradation state
EOF
}

flow=''
force=0
show_status=0
select_targets=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -w | --web) flow=web ;;
    -d | --device) flow=device ;;
    -f | --force) force=1 ;;
    -s | --status) show_status=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      printf 'auth-cloud: unknown option: %s\n\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    status)
      show_status=1
      ;;
    *)
      select_targets+=("$1")
      ;;
  esac
  shift
done

# Flow auto-detection: default to device flow in headless / SSH sessions, web otherwise.
if [[ -z "$flow" ]]; then
  if [[ "$(uname -s)" == "Linux" && -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
    flow=device
  else
    flow=web
  fi
fi

KNOWN_TARGETS=(
  all
  gdrive
  onedrive
  onedrive-corp
  corporate
  personal
  google
  entra-bootstrap
  status
)

is_known_target() {
  local t="$1"
  local k
  for k in "${KNOWN_TARGETS[@]}"; do
    [[ "$k" == "$t" ]] && return 0
  done
  return 1
}

# Validate targets
for t in ${select_targets[@]+"${select_targets[@]}"}; do
  if ! is_known_target "$t"; then
    printf 'auth-cloud: unknown target: %s\n' "$t" >&2
    printf 'known targets: %s\n' "${KNOWN_TARGETS[*]}" >&2
    exit 2
  fi
done

# Helper: check if rclone remote has a token in rclone.conf
rclone_has_token() {
  local remote="$1"
  [[ -f "$RCLONE_CONFIG" ]] || return 1
  awk -v remote="[$remote]" '
    $0 == remote { in_sec=1; next }
    /^\[/ { in_sec=0 }
    in_sec && /^[[:space:]]*token[[:space:]]*=/ { found=1 }
    END { exit !found }
  ' "$RCLONE_CONFIG" 2>/dev/null
}
# Helper: check if DavMail has tokens
davmail_has_token() {
  local instance="$1"
  local token_file="$DAVMAIL_STATE_DIR/${instance}-tokens.properties"
  [[ -f "$token_file" && -s "$token_file" ]]
}

# Helper: check systemd user service state
service_state() {
  local svc="$1"
  if command -v systemctl >/dev/null 2>&1; then
    local active enabled
    active="$(systemctl --user is-active "$svc" 2>/dev/null || true)"
    enabled="$(systemctl --user is-enabled "$svc" 2>/dev/null || true)"
    printf '%s (enabled: %s)' "${active:-unknown}" "${enabled:-unknown}"
  else
    printf 'systemctl unavailable'
  fi
}

# Helper: start & enable systemd user service
activate_service() {
  local svc="$1"
  printf 'auth-cloud: activating systemd user service: %s\n' "$svc"
  if command -v systemctl >/dev/null 2>&1; then
    if ! systemctl --user enable --now "$svc" 2>/dev/null; then
      systemctl --user start "$svc" 2>/dev/null || {
        printf 'auth-cloud: warning: failed to start service %s\n' "$svc" >&2
        return 1
      }
    fi
    printf 'auth-cloud: %s is active.\n' "$svc"
  else
    printf 'auth-cloud: systemctl not available; service activation skipped.\n' >&2
  fi
  return 0
}

# Helper: trigger Akonadi sync over D-Bus / CLI
trigger_akonadi_sync() {
  local agent_id="$1"
  local agentsrc="$AKONADI_CONFIG_DIR/agentsrc"

  # Register instance in agentsrc if kwriteconfig6 is available
  if command -v kwriteconfig6 >/dev/null 2>&1 && [[ -d "$AKONADI_CONFIG_DIR" ]]; then
    kwriteconfig6 --file "$agentsrc" --group Instances --key "$agent_id" "akonadi_davgroupware_resource" 2>/dev/null || true
    kwriteconfig6 --file "$agentsrc" --group "$agent_id" --key AgentType "akonadi_davgroupware_resource" 2>/dev/null || true
    kwriteconfig6 --file "$agentsrc" --group "$agent_id" --key Autostart true 2>/dev/null || true
  fi

  # Trigger sync if Akonadi is active
  if command -v akonadictl >/dev/null 2>&1; then
    if akonadictl status 2>/dev/null | grep -qi "running"; then
      akonadictl sync "$agent_id" 2>/dev/null || true
      printf 'auth-cloud: triggered Akonadi sync for %s.\n' "$agent_id"
    fi
  elif command -v qdbus >/dev/null 2>&1; then
    qdbus "org.freedesktop.Akonadi.Agent.$agent_id" / org.freedesktop.Akonadi.Agent.Status.synchronize 2>/dev/null || true
  fi
}

# Target: status
do_status() {
  printf '============================================================\n'
  printf 'Cloud Drive & PIM Integration Status\n'
  printf '============================================================\n\n'

  printf '%s\n' '--- File Mounts (rclone) ---'
  local remotes=(gdrive onedrive onedrive-corp)
  local r
  for r in "${remotes[@]}"; do
    local tok_status="NOT CONFIGURED / NO TOKEN"
    if rclone_has_token "$r"; then
      tok_status="TOKEN PRESENT"
    fi
    local svc_status
    svc_status="$(service_state "rclone-mount@${r}.service")"
    printf '  %-15s : %-20s [service: %s]\n' "$r" "$tok_status" "$svc_status"
  done
  printf '\n'

  printf '%s\n' '--- Microsoft PIM Bridges (DavMail Graph) ---'
  local instances=(corporate personal)
  local inst
  for inst in "${instances[@]}"; do
    local tok_status="NO TOKEN"
    if davmail_has_token "$inst"; then
      tok_status="TOKEN PRESENT"
    fi
    local svc_status
    svc_status="$(service_state "davmail@${inst}.service")"
    printf '  %-15s : %-20s [service: %s]\n' "$inst" "$tok_status" "$svc_status"
  done
  printf '\n'

  # Check for Graph 401/403 consent errors in corporate DavMail logs
  local corp_log="$DAVMAIL_STATE_DIR/corporate-davmail.log"
  local degraded_detected=0
  if [[ -f "$corp_log" ]]; then
    if grep -E -q '401 Unauthorized|403 Forbidden|AADSTS65001|AADSTS500011|unauthorized_client|access_denied|ConsentRequired' "$corp_log" 2>/dev/null; then
      degraded_detected=1
    fi
  fi

  if [[ "$degraded_detected" -eq 1 ]]; then
    printf '[!] Corporate Microsoft Graph permission / consent error detected (HTTP 401/403).\n'
    printf '    Guidance (R14): If tenant administrator consent cannot be obtained for the Entra app,\n'
    printf '    degrade corporate PIM to read-only calendar subscription mode by setting:\n'
    printf '      corporateMs:\n'
    printf '        mode: read-only\n'
    printf '    in .chezmoidata/cloud.yaml and re-running `chezmoi apply`.\n\n'
  fi

  printf '%s\n' '--- Google PIM (KDE Online Accounts) ---'
  local google_provider="${XDG_DATA_HOME:-$HOME/.local}/share/accounts/providers/kde/google.provider"
  local prov_status="OVERRIDE NOT FOUND"
  if [[ -f "$google_provider" ]]; then
    prov_status="CUSTOM PROVIDER DEPLOYED"
  elif [[ -f "$HOME/.local/share/accounts/providers/google.provider" ]]; then
    prov_status="CUSTOM PROVIDER DEPLOYED"
  fi
  printf '  %-15s : %s\n' "google.provider" "$prov_status"

  if command -v signond >/dev/null 2>&1 || [[ -f "/usr/bin/signond" ]]; then
    printf '  %-15s : AVAILABLE\n' "signond"
  else
    printf '  %-15s : NOT FOUND (install signond and kaccounts-integration)\n' "signond"
  fi
  printf '\n'

  return 0
}

# Helper: authenticate an rclone remote
auth_rclone_remote() {
  local remote="$1"
  local label="$2"
  printf 'auth-cloud: [%s] Checking %s...\n' "$remote" "$label"
  if [[ "$force" -eq 0 ]] && rclone_has_token "$remote"; then
    printf 'auth-cloud: %s: already authenticated with stored token (use --force to re-login).\n' "$remote"
    activate_service "rclone-mount@${remote}.service"
    return 0
  fi

  if ! command -v rclone >/dev/null 2>&1; then
    printf 'auth-cloud: %s: rclone command not found. Please install rclone.\n' "$remote" >&2
    return 1
  fi

  printf 'auth-cloud: %s: starting rclone OAuth authorization (flow: %s)...\n' "$remote" "$flow"
  local -a rclone_cmd=(rclone config reconnect "${remote}:")
  if [[ "$flow" == "device" ]]; then
    rclone_cmd+=(--auto-confirm)
  fi

  "${rclone_cmd[@]}" || {
    printf 'auth-cloud: %s: rclone reconnect failed.\n' "$remote" >&2
    return 1
  }

  if rclone_has_token "$remote"; then
    printf 'auth-cloud: %s: authentication successful.\n' "$remote"
    activate_service "rclone-mount@${remote}.service"
  else
    printf 'auth-cloud: %s: authentication completed but token not found in %s\n' "$remote" "$RCLONE_CONFIG" >&2
    return 1
  fi
}

# Helper: authenticate a DavMail instance
auth_davmail_instance() {
  local instance="$1"
  local label="$2"
  printf 'auth-cloud: [%s] Checking %s...\n' "$instance" "$label"

  local token_file="$DAVMAIL_STATE_DIR/${instance}-tokens.properties"
  local props_file="$DAVMAIL_CONFIG_DIR/${instance}.properties"
  local agent_id="akonadi_davgroupware_resource_${instance}"

  if [[ "$force" -eq 0 ]] && davmail_has_token "$instance"; then
    printf 'auth-cloud: %s: already authenticated with stored token at %s (use --force to re-auth).\n' "$instance" "$token_file"
    activate_service "davmail@${instance}.service"
    trigger_akonadi_sync "$agent_id"
    return 0
  fi

  if [[ ! -f "$props_file" ]]; then
    printf 'auth-cloud: %s: DavMail properties file not found: %s\n' "$instance" "$props_file" >&2
    printf 'auth-cloud: %s: run `chezmoi apply` to deploy configured properties.\n' "$instance" >&2
    return 1
  fi

  local java_bin
  if command -v java >/dev/null 2>&1; then
    java_bin="$(command -v java)"
  elif [[ -x "/usr/bin/java" ]]; then
    java_bin="/usr/bin/java"
  else
    printf 'auth-cloud: %s: java runtime not found. Please install java-latest-openjdk-devel.\n' "$instance" >&2
    return 1
  fi

  if [[ ! -f "$DAVMAIL_JAR" ]]; then
    printf 'auth-cloud: %s: DavMail jar not found at %s\n' "$instance" "$DAVMAIL_JAR" >&2
    printf 'auth-cloud: %s: run `chezmoi apply` to fetch DavMail external archive.\n' "$instance" >&2
    return 1
  fi

  mkdir -p "$DAVMAIL_STATE_DIR"
  chmod 0700 "$DAVMAIL_STATE_DIR"

  local davmail_mode="O365Interactive"
  if [[ "$flow" == "device" ]]; then
    davmail_mode="O365DeviceCode"
  fi

  printf 'auth-cloud: %s: launching DavMail initial OAuth authentication (%s)...\n' "$instance" "$davmail_mode"
  "$java_bin" -Xmx128m -Djava.awt.headless=true "-Ddavmail.mode=$davmail_mode" -jar "$DAVMAIL_JAR" "$props_file" || true

  if [[ -f "$token_file" ]]; then
    chmod 0600 "$token_file"
    printf 'auth-cloud: %s: DavMail token saved securely to %s\n' "$instance" "$token_file"
    activate_service "davmail@${instance}.service"
    trigger_akonadi_sync "$agent_id"
  else
    printf 'auth-cloud: %s: DavMail authentication failed or token file was not created.\n' "$instance" >&2
    if [[ "$instance" == "corporate" ]]; then
      printf 'auth-cloud: corporate: Note (R14): If tenant administrator consent is blocked by corporate policy,\n' >&2
      printf 'auth-cloud: corporate: degrade corporate PIM to read-only mode by setting:\n' >&2
      printf 'auth-cloud: corporate:   corporateMs:\n' >&2
      printf 'auth-cloud: corporate:     mode: read-only\n' >&2
      printf 'auth-cloud: corporate: in .chezmoidata/cloud.yaml and re-running `chezmoi apply`.\n' >&2
    fi
    return 1
  fi
  return 0
}

auth_gdrive() {
  auth_rclone_remote "gdrive" "personal Google Drive"
}

auth_onedrive() {
  auth_rclone_remote "onedrive" "personal Microsoft OneDrive"
}

auth_onedrive_corp() {
  printf 'auth-cloud: onedrive-corp: Note (R14): Corporate OneDrive authenticates independently via Microsoft Graph.\n'
  auth_rclone_remote "onedrive-corp" "corporate Microsoft OneDrive for Business"
}

auth_corporate() {
  printf 'auth-cloud: corporate: Validating corporate Entra tenant consent requirements (R14)...\n'
  printf 'auth-cloud: corporate: Delegated scopes needed: Calendars.ReadWrite, Tasks.ReadWrite, offline_access\n'
  auth_davmail_instance "corporate" "corporate Microsoft Exchange/Graph PIM bridge"
}

auth_personal() {
  auth_davmail_instance "personal" "personal Microsoft Outlook.com PIM bridge"
}

# Target: google (KAccounts)
auth_google() {
  printf 'auth-cloud: [google] Checking Google PIM (Calendar & Tasks) integration...\n'

  local has_signond=0
  if command -v signond >/dev/null 2>&1 || [[ -f "/usr/bin/signond" ]]; then
    has_signond=1
  fi

  if [[ "$has_signond" -eq 0 ]]; then
    printf 'auth-cloud: google: signond / kaccounts stack not detected.\n' >&2
    printf 'auth-cloud: google: diagnostic: verify kaccounts-integration and signond packages are installed.\n' >&2
    printf 'auth-cloud: google: recovery: install required KDE packages and re-run chezmoi apply.\n' >&2
  fi

  if [[ "$flow" == "device" || ( -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ) ]]; then
    printf 'auth-cloud: google: WARNING: Google PIM uses KDE Online Accounts (KAccounts) and requires a graphical desktop session.\n'
    printf 'auth-cloud: google: Google SSO uses QtWebEngine browser OAuth which cannot complete over headless SSH.\n'
    printf 'auth-cloud: google: To complete sign-in: log in to your KDE Plasma desktop session and run `auth-cloud google` or open System Settings -> Online Accounts.\n'
    return 0
  fi

  printf 'auth-cloud: google: Google PIM uses custom OAuth credentials configured via google.provider drop-in.\n'
  printf 'auth-cloud: google: Launching KDE Online Accounts panel...\n'
  printf 'auth-cloud: google: 1. In the Online Accounts window, select or add "Google".\n'
  printf 'auth-cloud: google: 2. Complete Google sign-in in the authentication prompt.\n'
  printf 'auth-cloud: google: 3. Ensure Calendar and Tasks synchronization are enabled.\n'

  if command -v kcmshell6 >/dev/null 2>&1; then
    kcmshell6 kcm_kaccounts >/dev/null 2>&1 &
    printf 'auth-cloud: google: opened kcmshell6 kcm_kaccounts.\n'
  else
    printf 'auth-cloud: google: kcmshell6 not found. Open KDE System Settings -> Online Accounts manually.\n'
  fi
  return 0
}

# Target: entra-bootstrap
do_entra_bootstrap() {
  cat <<'EOF'
================================================================================
Entra Application Registration Bootstrap (Corporate Microsoft Graph)
================================================================================

Run the following Azure CLI (`az`) command in your corporate tenant to register
the public client desktop application for DavMail Microsoft Graph integration:

az ad app create \
  --display-name "DavMail KDE PIM Bridge" \
  --is-fallback-public-client true \
  --public-client-redirect-uris \
    "http://localhost" \
    "http://localhost:1080" \
    "https://login.microsoftonline.com/common/oauth2/nativeclient" \
  --required-resource-accesses '[
    {
      "resourceAppId": "00000003-0000-0000-c000-000000000000",
      "resourceAccess": [
        {
          "id": "1ec2356d-1b15-4674-9b51-5e263309a6ee",
          "type": "Scope"
        },
        {
          "id": "22187372-9ee6-4e50-a924-a21b369c0d3a",
          "type": "Scope"
        },
        {
          "id": "7427e0e9-2fba-4249-9ac4-6eb8743e30f1",
          "type": "Scope"
        },
        {
          "id": "e1fe6dd8-ba31-4d61-89e7-88639da4683d",
          "type": "Scope"
        }
      ]
    }
  ]'

Key Parameters Explained:
  - Desktop / Public Client Flow : --is-fallback-public-client true
  - Redirect URIs               : http://localhost, http://localhost:1080
  - Delegated Graph Scopes:
      * Calendars.ReadWrite (1ec2356d-1b15-4674-9b51-5e263309a6ee)
      * Tasks.ReadWrite     (22187372-9ee6-4e50-a924-a21b369c0d3a)
      * offline_access      (7427e0e9-2fba-4249-9ac4-6eb8743e30f1)
      * User.Read           (e1fe6dd8-ba31-4d61-89e7-88639da4683d)

Tenant Consent Notes (R14):
  1. Record the output `appId` (Client ID) and `tenantId` into your 1Password vault:
     `op://Private/Microsoft/Corporate Entra Client ID`
     `op://Private/Microsoft/Corporate Tenant ID`
  2. If your tenant permits user consent for these delegated scopes, running
     `auth-cloud corporate` will prompt for consent interactively on first sign-in.
  3. If your tenant requires Administrator Consent, grant consent with:
     az ad app permission admin-consent --id <APP_ID>
  4. If administrator consent is denied by corporate policy, degrade corporate PIM
     to a read-only calendar subscription by declaring:
       corporateMs:
         mode: read-only
     in `.chezmoidata/cloud.yaml` and re-running `chezmoi apply`.
================================================================================
EOF
  return 0
}

# Main execution dispatch
main() {
  if [[ "$show_status" -eq 1 ]]; then
    do_status
    exit 0
  fi

  # Default to all if no target specified
  if [[ ${#select_targets[@]} -eq 0 ]]; then
    select_targets=(all)
  fi

  local targets_to_run=()
  local t
  for t in "${select_targets[@]}"; do
    if [[ "$t" == "all" ]]; then
      targets_to_run+=(gdrive onedrive onedrive-corp corporate personal google)
    else
      targets_to_run+=("$t")
    fi
  done

  local overall_status=0

  for t in "${targets_to_run[@]}"; do
    case "$t" in
      status)
        do_status || overall_status=1
        ;;
      gdrive)
        auth_gdrive || overall_status=1
        ;;
      onedrive)
        auth_onedrive || overall_status=1
        ;;
      onedrive-corp)
        auth_onedrive_corp || overall_status=1
        ;;
      corporate)
        auth_corporate || overall_status=1
        ;;
      personal)
        auth_personal || overall_status=1
        ;;
      google)
        auth_google || overall_status=1
        ;;
      entra-bootstrap)
        do_entra_bootstrap || overall_status=1
        ;;
    esac
  done

  exit "$overall_status"
}

main
