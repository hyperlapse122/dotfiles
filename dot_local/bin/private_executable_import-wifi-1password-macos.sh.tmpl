#!/usr/bin/env bash
# import-wifi-1password-macos — provision macOS Wi-Fi networks declaratively
# from .chezmoidata/networking.yaml (`networking.wifi`).
#
#   import-wifi-1password-macos              # install/replace every network profile
#   import-wifi-1password-macos --dry-run    # show what would change; change nothing
#   import-wifi-1password-macos --force      # remove each profile first, then install
#
# macOS native counterpart to the Linux import-wifi-1password (NetworkManager)
# tool: same manifest, same declarative model, same render-time 1Password
# resolution — built on the OFFICIAL macOS Wi-Fi mechanism, a user-scope
# Configuration Profile (com.apple.wifi.managed payload) installed with
# profiles(1), never on any Linux convention.
#
# MODEL: each run converges the profile store to the manifest. Every network
# gets a DETERMINISTIC PayloadIdentifier/PayloadUUID derived from its SSID, so
# a re-run targets the same profile. Default: `profiles install`; if the
# install is rejected (e.g. an older copy of that profile is already present),
# the stale profile is removed by identifier and the install retried once —
# the declarative overwrite. --force removes first unconditionally (a
# guaranteed-clean slate, which drops any current association). After install
# the profile belongs to the OS profile store; this tool leaves its ownership
# and lifetime to macOS.
#
# SECRETS — the load-bearing rules of this tool:
# * ssid/psk op:// references are resolved at chezmoi RENDER time and baked
#   into the JSON manifest below — which is why this source is `private_`
#   (deployed 0700, owner-only) and darwin-gated in dot_local/bin/.chezmoiignore.
#   There is NO 1Password / `op` dependency at runtime.
# * A PSK is NEVER placed on a command line: profiles(1) learns the key from an
#   owner-only TRANSIENT .mobileconfig file, installed via
#   `profiles install -path ...`. No command this tool invokes receives a secret
#   argument (manifest JSON / plist / profile files travel only inside the
#   transient directory), and no output it prints contains one.
# * The transient directory (mktemp, chmod 700) and the plaintext manifest
#   variable are destroyed in ONE shared EXIT-trap path — reached on success,
#   on a rejected manifest entry, on a failed profiles(1) call, and on
#   cancellation/interruption (INT/TERM/HUP are converted to exit so the EXIT
#   trap is the single teardown). There is no second cleanup site.
#
# PLATFORM LIMITS (native, by design): a com.apple.wifi.managed payload cannot
# carry DNS servers, and networksetup -setdnsservers is live service state, not
# per-network profile state — so manifest DNS and ignoreAutoDns entries are
# warned about and IGNORED. Preferred-network ORDER is likewise not expressible
# in the payload, so `priority` is warned about and IGNORED. profiles(1)
# install/remove require root (macOS 11+): a real run as a non-root user is an
# "environment not ready" bail (re-run with sudo); --dry-run needs no root.
#
# APPLY INTEGRATION: --from-apply mirrors the Linux tool — quieter, and every
# "environment not ready" condition (no profiles/plutil/PlistBuddy, not root)
# exits 0 so it can never abort an apply.
#
# macOS-only BY DESIGN: profiles(1)/plutil/PlistBuddy are macOS-only — gated out
# on non-darwin via dot_local/bin/.chezmoiignore, so op:// secrets are never
# resolved into a Linux/Windows copy. Per the script-parity exception in
# AGENTS.md there is no .ps1 counterpart in this file.

set -euo pipefail

# Configuration / counters (globals; set from argv).
DRY_RUN=false
FORCE=false
FROM_APPLY=false
ADDED=0
SKIPPED=0
FAILED=0

# Transient secret state — owned by the single EXIT-trap path below. Starts
# empty; the trap removes the directory (if created) and clears the variable
# that held the resolved manifest.
TRANSIENT_DIR=""
MANIFEST_PLIST=""

# Network manifest, rendered from .chezmoidata/networking.yaml with every op://
# ref resolved to its 1Password value (this is why the source is private_ 0700 —
# the JSON below holds the real PSKs). EDIT .chezmoidata/networking.yaml, never
# this deployed copy. `<<'WIFI_CONFIG_EOF'` is a literal heredoc (no shell
# expansion); resolve-op-refs-json.tmpl emits valid JSON (toJson-escaped) read
# via plutil/PlistBuddy at runtime.
WIFI_CONFIG_JSON=$(cat <<'WIFI_CONFIG_EOF'
{{ includeTemplate "resolve-op-refs-json.tmpl" (dict "value" .networking.wifi "ctx" $) }}
WIFI_CONFIG_EOF
)

# ---------------------------------------------------------------------------
# THE shared plaintext teardown. Signals are converted to `exit` so this EXIT
# trap is the ONLY cleanup path: success, rejected entries, failed profiles(1)
# calls, Ctrl+C cancellation, and interruption all pass through here. Removes
# the owner-only transient directory (manifest JSON/plist + every
# .mobileconfig holding a PSK) and clears the plaintext manifest variable.
# Profile data already installed lives on in the OS store, owned by macOS.
# ---------------------------------------------------------------------------
cleanup() {
  local rc=$?
  trap - EXIT INT TERM HUP
  if [[ -n "$TRANSIENT_DIR" && -d "$TRANSIENT_DIR" ]]; then
    rm -rf -- "$TRANSIENT_DIR"
  fi
  TRANSIENT_DIR=""
  MANIFEST_PLIST=""
  WIFI_CONFIG_JSON=""
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
log()  { printf 'import-wifi-1password-macos: %s\n' "$*"; }
# vlog: chatter suppressed under --from-apply to keep `chezmoi apply` quiet.
vlog() { "$FROM_APPLY" || printf 'import-wifi-1password-macos: %s\n' "$*"; }
warn() { printf 'import-wifi-1password-macos: %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
Usage: import-wifi-1password-macos [--dry-run] [--force]

Provision macOS Wi-Fi networks from .chezmoidata/networking.yaml
(networking.wifi) as user-scope configuration profiles (com.apple.wifi.managed
payload), one per network, via the official profiles(1) command. Each network
is installed; a stale copy of the same deterministic profile identifier is
removed and the install retried (the declarative overwrite).

Options:
  -n, --dry-run   Show what would change; make no changes (no root needed).
  -f, --force     Remove each profile first, then install (clean slate).
  -h, --help      Show this help and exit.

Wi-Fi passwords come from .chezmoidata/networking.yaml (op:// references
resolved at chezmoi render time), so no 1Password/op access is needed at
runtime; PSKs travel only inside an owner-only transient .mobileconfig, never
on a command line, and that file is deleted on every exit path. Installing or
removing profiles requires root on macOS 11+ — re-run with sudo. DNS and
autoconnect priority are not expressible in a Wi-Fi payload and are ignored
with a warning.
EOF
}

# ---------------------------------------------------------------------------
# Exit helpers
# ---------------------------------------------------------------------------

# bail_env <message> : "environment not ready". Clean skip (exit 0) under
# --from-apply; failure (exit 1) when run by hand.
bail_env() {
  if "$FROM_APPLY"; then
    printf 'import-wifi-1password-macos: skipped (%s)\n' "$1" >&2
    exit 0
  fi
  printf 'import-wifi-1password-macos: %s\n' "$1" >&2
  exit 1
}

# ---------------------------------------------------------------------------
# Transient directory + manifest parsing (plutil/PlistBuddy, both shipped with
# macOS — no jq/python/ruby dependency)
# ---------------------------------------------------------------------------

# new_transient_dir: mktemp + chmod 700 (owner-only), created once, lazily.
new_transient_dir() {
  [[ -n "$TRANSIENT_DIR" ]] && return 0
  transient_root=${TMPDIR:-"$HOME/Library/Caches"}
  mkdir -p "$transient_root"
  TRANSIENT_DIR=$(mktemp -d "$transient_root/wifi-import.XXXXXXXX")
  chmod 700 "$TRANSIENT_DIR"
}

# prepare_manifest: write the embedded JSON manifest into the transient
# directory (printf is a builtin — no secret touches an argv) and convert it
# to a plist for PlistBuddy reads.
prepare_manifest() {
  new_transient_dir
  printf '%s' "$WIFI_CONFIG_JSON" >"$TRANSIENT_DIR/manifest.json"
  MANIFEST_PLIST="$TRANSIENT_DIR/manifest.plist"
  plutil -convert xml1 -o "$MANIFEST_PLIST" -- "$TRANSIENT_DIR/manifest.json"
  rm -f -- "$TRANSIENT_DIR/manifest.json"
}

# pb <keypath> : PlistBuddy Print; fails (nonzero) when the key is absent.
pb() {
  /usr/libexec/PlistBuddy -c "Print :$1" "$MANIFEST_PLIST" 2>/dev/null
}

# plist_array_nonempty <keypath> : true when the (possibly absent) array at
# keypath has at least one entry. PlistBuddy prints an array as
# "Array {\n  item\n ... \n}"; an empty array prints exactly "Array {" and "}",
# so MORE THAN TWO non-blank lines means non-empty (a DNS entry is an IPv4/IPv6
# literal — never blank or a "}" line itself, so this cannot false-positive).
plist_array_nonempty() {
  local out
  out=$(pb "$1") || return 1
  [[ $(printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ') -gt 2 ]]
}

# xml_escape <string> : escape & < > for plist XML. sed sees only the PATTERN
# on its argv — the secret travels on stdin/stdout, never on a command line.
xml_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# uuid_for <seed> : deterministic UUID (v5-shaped) from the sha256 of <seed>,
# so a re-run targets the same profile. shasum ships with macOS; the seed is
# the SSID (not a secret).
uuid_for() {
  local h
  h=$(printf '%s' "$1" | shasum -a 256 | cut -d' ' -f1)
  printf '%s-%s-5%s-a%s-%s' "${h:0:8}" "${h:8:4}" "${h:13:3}" "${h:17:3}" "${h:20:12}"
}

# identifier_for <ssid> : deterministic reverse-DNS profile identifier.
identifier_for() {
  local h
  h=$(printf '%s' "$1" | shasum -a 256 | cut -d' ' -f1)
  printf 'local.chezmoi.wifi.%s' "${h:0:24}"
}

# ---------------------------------------------------------------------------
# Per-network processing
# ---------------------------------------------------------------------------

# write_mobileconfig <ssid> <psk> <file> <identifier> : build the user-scope configuration
# profile (com.apple.wifi.managed payload; WPA personal passPhrase when <psk>
# is non-empty, open otherwise) inside the transient directory. The PSK
# appears ONLY inside that file — never in an argument, log, or output.
write_mobileconfig() {
  local ssid="$1" psk="$2" file="$3" identifier="$4"
  local payload_uuid profile_uuid esc_ssid esc_psk
  payload_uuid=$(uuid_for "wifi-payload:$ssid")
  profile_uuid=$(uuid_for "wifi-profile:$ssid")
  esc_ssid=$(xml_escape "$ssid")
  local password_block=""
  if [[ -n "$psk" ]]; then
    esc_psk=$(xml_escape "$psk")
    password_block="    <key>Password</key>
    <string>$esc_psk</string>"
  fi
  cat >"$file" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>AutoJoin</key>
      <true/>
      <key>EncryptionType</key>
      <string>$(if [[ -n "$psk" ]]; then printf 'WPA'; else printf 'None'; fi)</string>
      <key>HIDDEN_NETWORK</key>
      <false/>
$password_block
      <key>PayloadDescription</key>
      <string>Wi-Fi settings for $esc_ssid (chezmoi networking.wifi)</string>
      <key>PayloadDisplayName</key>
      <string>Wi-Fi ($esc_ssid)</string>
      <key>PayloadIdentifier</key>
      <string>$identifier.payload</string>
      <key>PayloadType</key>
      <string>com.apple.wifi.managed</string>
      <key>PayloadUUID</key>
      <string>$payload_uuid</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>ProxyType</key>
      <string>None</string>
      <key>SSID_STR</key>
      <string>$esc_ssid</string>
    </dict>
  </array>
  <key>PayloadDescription</key>
  <string>chezmoi-managed Wi-Fi profile for $esc_ssid</string>
  <key>PayloadDisplayName</key>
  <string>chezmoi Wi-Fi — $esc_ssid</string>
  <key>PayloadIdentifier</key>
  <string>$identifier</string>
  <key>PayloadOrganization</key>
  <string>chezmoi dotfiles</string>
  <key>PayloadRemovalDisallowed</key>
  <false/>
  <key>PayloadScope</key>
  <string>User</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>$profile_uuid</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
EOF
}

# process_network <index> : one manifest network (defaults merged inline), by
# PlistBuddy index into :networks. Updates ADDED/FAILED.
process_network() {
  local i="$1" ssid psk prio
  ssid=$(pb "networks:$i:ssid") || ssid=""
  psk=$(pb "networks:$i:psk") || psk=""
  prio=$(pb "networks:$i:priority") || prio=""

  if [[ -z "$ssid" ]]; then
    warn "a network entry has no ssid (empty after op:// resolution); skipping"
    FAILED=$((FAILED + 1))
    return 0
  fi

  # Native limits, warned once per affected network. DNS: a Wi-Fi payload
  # cannot carry resolvers. Priority: payload cannot express network order.
  local dns4_key dns6_key ignore_auto
  dns4_key="defaults:ipv4:dns"; pb "networks:$i:ipv4:dns" >/dev/null 2>&1 && dns4_key="networks:$i:ipv4:dns"
  dns6_key="defaults:ipv6:dns"; pb "networks:$i:ipv6:dns" >/dev/null 2>&1 && dns6_key="networks:$i:ipv6:dns"
  ignore_auto=""
  if pb "networks:$i:ignoreAutoDns" >/dev/null 2>&1; then
    ignore_auto=$(pb "networks:$i:ignoreAutoDns")
  elif pb "defaults:ignoreAutoDns" >/dev/null 2>&1; then
    ignore_auto=$(pb "defaults:ignoreAutoDns")
  fi
  if plist_array_nonempty "$dns4_key" || plist_array_nonempty "$dns6_key" \
    || [[ "$ignore_auto" == "true" ]]; then
    warn "network \"$ssid\": a macOS Wi-Fi payload cannot carry DNS; ignoring dns/ignoreAutoDns (configure service DNS separately)"
  fi
  if [[ -n "$prio" ]]; then
    warn "network \"$ssid\": a macOS Wi-Fi payload cannot express network order; ignoring priority \"$prio\""
  fi

  local desc="open"
  [[ -n "$psk" ]] && desc="wpa-personal"
  local identifier
  identifier=$(identifier_for "$ssid")

  if "$DRY_RUN"; then
    if "$FORCE"; then
      log "would replace \"$ssid\" ($desc)"
    else
      log "would install \"$ssid\" ($desc)"
    fi
    ADDED=$((ADDED + 1))
    return 0
  fi

  new_transient_dir
  local profile_file="$TRANSIENT_DIR/profile-$i.mobileconfig"
  write_mobileconfig "$ssid" "$psk" "$profile_file" "$identifier"

  if "$FORCE"; then
    # Clean slate: remove by identifier first (absent profile is not an error
    # for the converge model), then install.
    profiles remove -identifier "$identifier" >/dev/null 2>&1 || true
    if profiles install -type configuration -path "$profile_file" >/dev/null; then
      log "replaced \"$ssid\" ($desc)"
      ADDED=$((ADDED + 1))
    else
      warn "failed to install \"$ssid\""
      FAILED=$((FAILED + 1))
    fi
    return 0
  fi

  # Default: install; on rejection, remove the stale copy and retry once (the
  # declarative overwrite — profiles(1) has no in-place modify).
  if profiles install -type configuration -path "$profile_file" >/dev/null; then
    vlog "installed \"$ssid\" ($desc)"
    ADDED=$((ADDED + 1))
    return 0
  fi
  profiles remove -identifier "$identifier" >/dev/null 2>&1 || true
  if profiles install -type configuration -path "$profile_file" >/dev/null; then
    vlog "replaced \"$ssid\" ($desc)"
    ADDED=$((ADDED + 1))
  else
    warn "failed to install \"$ssid\""
    FAILED=$((FAILED + 1))
  fi
  return 0
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n | --dry-run) DRY_RUN=true ;;
      -f | --force)   FORCE=true ;;
      --from-apply)   FROM_APPLY=true ;;
      -h | --help)    usage; exit 0 ;;
      *)
        printf 'import-wifi-1password-macos: unknown option: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
    esac
    shift
  done

  # Preflight — all "environment not ready" -> clean skip under apply.
  command -v profiles >/dev/null 2>&1 || bail_env "profiles(1) not found"
  command -v plutil >/dev/null 2>&1 || bail_env "plutil not found"
  [[ -x /usr/libexec/PlistBuddy ]] || bail_env "PlistBuddy not found"
  # profiles(1) install/remove require root on macOS 11+; --dry-run does not.
  if ! "$DRY_RUN" && [[ "$(id -u)" -ne 0 ]]; then
    bail_env "profiles(1) install/remove require root — re-run with sudo (or use --dry-run)"
  fi

  prepare_manifest

  # Iterate :networks by index until PlistBuddy reports the index absent.
  local i=0
  while pb "networks:$i" >/dev/null 2>&1; do
    process_network "$i"
    i=$((i + 1))
  done
  if [[ "$i" -eq 0 ]]; then
    vlog "no networks defined in networking.yaml; nothing to do"
    exit 0
  fi

  if "$DRY_RUN"; then
    log "dry run — ${ADDED} would install/replace, ${SKIPPED} skipped, ${FAILED} problem(s); no changes made"
    exit 0
  fi
  if "$FROM_APPLY"; then
    [[ "$ADDED" -gt 0 || "$FAILED" -gt 0 ]] \
      && log "${ADDED} installed/replaced, ${SKIPPED} skipped, ${FAILED} failed"
    exit 0
  fi
  log "${ADDED} installed/replaced, ${SKIPPED} skipped, ${FAILED} failed"
  [[ "$FAILED" -gt 0 ]] && exit 1
  exit 0
}

main "$@"
