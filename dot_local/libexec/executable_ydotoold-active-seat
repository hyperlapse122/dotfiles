#!/usr/bin/env bash
# dot_local/libexec/executable_ydotoold-active-seat
#
# KTD7: managed active-seat wrapper for ydotoold, run as ydotool.service
# (dot_config/systemd/user/ydotool.service). systemd's logind grants
# /dev/uinput write access via a `TAG+="uaccess"` udev rule
# (system/linux/etc/udev/rules.d/70-uinput-solaar.rules) to whichever UID
# currently owns the active seat — but that ACL does not revoke an
# already-open file descriptor. A formerly active user's ydotoold could
# therefore keep injecting input after a fast user switch unless something
# closes it. This wrapper is that something: it owns exactly one ydotoold
# child, polls this UID's write access to /dev/uinput every 250ms, starts
# the daemon only while that access exists, and unlinks its socket on the
# first poll after access is lost before it terminates the child — closing the
# retained descriptor instead of assuming the ACL change alone does it.
#
# One owned child at a time; %t/.ydotool_socket (mode 0600, ydotoold's own
# --socket-perm) is created only while the daemon runs and is removed by
# this wrapper, never left behind after a permission loss or a service stop.

set -euo pipefail

readonly DEVICE=/dev/uinput
readonly DAEMON=/usr/bin/ydotoold
: "${XDG_RUNTIME_DIR:?ydotoold-active-seat: XDG_RUNTIME_DIR is required}"
readonly SOCKET="$XDG_RUNTIME_DIR/.ydotool_socket"
readonly POLL_INTERVAL=0.25

child_pid=""

start_child() {
  "$DAEMON" "--socket-path=$SOCKET" --socket-perm=0600 &
  child_pid=$!
}

# Graceful-then-forced stop, bounded well under one poll interval: SIGTERM
# first, a short poll for exit, SIGKILL only if the daemon is still holding
# /dev/uinput open after that grace window. `wait` reaps the child so it
# never lingers as a zombie.
stop_child() {
  [[ -n "$child_pid" ]] || return 0
  local pid=$child_pid
  child_pid=""
  kill -TERM "$pid" 2>/dev/null || true
  for _ in 1 2 3 4 5; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.02
  done
  kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
}

# Access revoked: unlink the socket BEFORE terminating the child, so no new
# client can reach a daemon that is already being torn down, then stop it.
revoke_child() {
  rm -f -- "$SOCKET"
  stop_child
}

cleanup() {
  trap - EXIT INT TERM
  revoke_child
}
trap 'status=$?; cleanup; exit "$status"' EXIT
trap 'cleanup; exit 0' INT TERM

# An unrequested daemon exit while access is still present is a service
# failure, not a reason for this wrapper to hide the exit and spin a private
# restart loop. Reap the child, remove its stale socket, and propagate a
# nonzero status so the unit's Restart=on-failure policy owns recovery.
fail_exited_child() {
  local status
  if wait "$child_pid"; then
    status=1
  else
    status=$?
  fi
  child_pid=""
  rm -f -- "$SOCKET"
  exit "$status"
}

while true; do
  if [[ -w "$DEVICE" ]]; then
    if [[ -z "$child_pid" ]]; then
      start_child
    elif ! kill -0 "$child_pid" 2>/dev/null; then
      fail_exited_child
    fi
  elif [[ -n "$child_pid" ]]; then
    revoke_child
  fi
  sleep "$POLL_INTERVAL"
done
