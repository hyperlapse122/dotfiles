+    private func makeCookieFile(_ cookies: [HTTPCookie], parent: String?) throws -> URL? {
+        guard !cookies.isEmpty else { return nil }
+
+        let separators = CharacterSet(charactersIn: "\t\r\n")
+        let lines = try cookies.map { cookie in
+            let fields = [
+                cookie.domain,
+                cookie.domain.hasPrefix(".") ? "TRUE" : "FALSE",
+                cookie.path,
+                cookie.isSecure ? "TRUE" : "FALSE",
+                cookie.expiresDate.map { String(Int($0.timeIntervalSince1970)) } ?? "0",
+                cookie.name,
+                cookie.value,
+            ]
+            guard fields.allSatisfy({ $0.rangeOfCharacter(from: separators) == nil }) else {
+                throw XcodesKitError("Cannot prepare the download cookies.")
+            }
+            return fields.joined(separator: "\t")
+        }
+
+        let files = FileManager.default
+        let root = parent.map { URL(fileURLWithPath: $0, isDirectory: true) } ?? files.temporaryDirectory
+        let directory = root.appendingPathComponent(UUID().uuidString, isDirectory: true)
+        try files.createDirectory(at: directory, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        let file = directory.appendingPathComponent("cookies.txt")
+        let contents = Data((lines.joined(separator: "\n") + "\n").utf8)
+        guard files.createFile(atPath: file.path, contents: contents, attributes: [.posixPermissions: 0o600]) else {
+            try? files.removeItem(at: directory)
+            throw XcodesKitError("Cannot create the download cookie file.")
+        }
+        return file
     }
 }
